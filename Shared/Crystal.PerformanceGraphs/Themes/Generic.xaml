<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Crystal.PerformanceGraphs.Controls"
                    xmlns:graphs="clr-namespace:Crystal.PerformanceGraphs">

  <controls:ValueFormatConverter x:Key="ValueFormatConverter"/>

  <Style TargetType="{x:Type controls:PerformanceGraphView}">
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type controls:PerformanceGraphView}">
          <Grid Background="{TemplateBinding Background}">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header: Title (left) + MaxValue (right) -->
            <Grid Grid.Row="0" Margin="0,0,0,4">
              <TextBlock Text="{TemplateBinding Title}"
                         Foreground="{TemplateBinding Foreground}"
                         HorizontalAlignment="Left"/>
              <TextBlock Foreground="{TemplateBinding Foreground}"
                         HorizontalAlignment="Right">
                <TextBlock.Text>
                  <MultiBinding Converter="{StaticResource ValueFormatConverter}">
                    <Binding Path="MaxValue" RelativeSource="{RelativeSource TemplatedParent}"/>
                    <Binding Path="MaxValueFormat" RelativeSource="{RelativeSource TemplatedParent}"/>
                  </MultiBinding>
                </TextBlock.Text>
              </TextBlock>
            </Grid>

            <!-- Graph -->
            <graphs:PerformanceGraph x:Name="PART_Graph" Grid.Row="1"/>

            <!-- Footer: MaxTime (left) + MinTime (right) -->
            <Grid Grid.Row="2" Margin="0,4,0,0">
              <TextBlock Foreground="{TemplateBinding Foreground}"
                         HorizontalAlignment="Left">
                <TextBlock.Text>
                  <MultiBinding Converter="{StaticResource ValueFormatConverter}">
                    <Binding Path="MaxTime" RelativeSource="{RelativeSource TemplatedParent}"/>
                    <Binding Path="MaxTimeFormat" RelativeSource="{RelativeSource TemplatedParent}"/>
                  </MultiBinding>
                </TextBlock.Text>
              </TextBlock>
              <TextBlock Foreground="{TemplateBinding Foreground}"
                         HorizontalAlignment="Right">
                <TextBlock.Text>
                  <MultiBinding Converter="{StaticResource ValueFormatConverter}">
                    <Binding Path="MinTime" RelativeSource="{RelativeSource TemplatedParent}"/>
                    <Binding Path="MinTimeFormat" RelativeSource="{RelativeSource TemplatedParent}"/>
                  </MultiBinding>
                </TextBlock.Text>
              </TextBlock>
            </Grid>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
