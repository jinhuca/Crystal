<Window x:Class="Crystal.PerformanceGraphs.Demo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Crystal.PerformanceGraphs.Demo"
				xmlns:graphs="clr-namespace:Crystal.PerformanceGraphs;assembly=Crystal.PerformanceGraphs"
				xmlns:controls="clr-namespace:Crystal.PerformanceGraphs.Controls;assembly=Crystal.PerformanceGraphs"
        mc:Ignorable="d"
        Title="MainWindow" Height="620" Width="900" Background="Black">
	<Grid Margin="16">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="24"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
			<TextBlock Text="Render style:" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0"/>
			<RadioButton x:Name="LineModeRadio" GroupName="GraphKind" Content="Line" Foreground="White" IsChecked="True"
						 Checked="GraphKindRadio_Changed" Margin="0,0,12,0"/>
			<RadioButton x:Name="BarModeRadio" GroupName="GraphKind" Content="Bar" Foreground="White"
						 Checked="GraphKindRadio_Changed" Margin="0,0,12,0"/>
			<RadioButton x:Name="SegmentedBarModeRadio" GroupName="GraphKind" Content="Segmented Bar" Foreground="White"
						 Checked="GraphKindRadio_Changed"/>
		</StackPanel>

		<!-- % Utilization -->
		<controls:PerformanceGraphView x:Name="UtilizationView" Grid.Row="1" Height="260"
									   Title="% Utilization"
									   MaxValue="100" MaxValueFormat="{}{0}%"
									   MinValue="0"
									   MaxTime="60" MaxTimeFormat="{}{0} seconds"
									   MinTime="0"/>

		<!-- Voltage -->
		<controls:PerformanceGraphView x:Name="VoltageView" Grid.Row="3" Height="260"
									   Title="Voltage"
									   MaxValue="3" MaxValueFormat="{}{0}V"
									   MinValue="0"
									   MaxTime="60" MaxTimeFormat="{}{0} seconds"
									   MinTime="0"/>
	</Grid>
</Window>
