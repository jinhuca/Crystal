<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:graphs="clr-namespace:Crystal.Controls.PerformanceGraphs;assembly=Crystal.Controls"
    xmlns:converters="clr-namespace:Crystal.Controls.Converters;assembly=Crystal.Controls">

  <!--
    This file lives in Crystal.Controls.Demo, a DIFFERENT assembly than PerformanceGraph (which
    lives in Crystal.Controls) - that's why the xmlns above needs ";assembly=Crystal.Controls",
    the same reasoning documented in PerformanceGraphLiteStyles.xaml (its sibling file for
    PerformanceGraphLite) in this same folder.
  -->

  <converters:GridSquareRatioConverter x:Key="GridSquareRatioConverter"/>

  <!--
    Keyed: NOT applied automatically - opt in per instance via Style="{StaticResource
    SquareGridPerformanceGraphStyle}". Two things happen together here:

    1. GridColumns is bound to Capacity (RelativeSource=Self), so the grid always has exactly one
       column per plotted sample, whatever Capacity is set to.
    2. Height is derived from ActualWidth/GridRows/GridColumns via GridSquareRatioConverter, so
       every grid cell renders as a perfect square regardless of how wide the container makes this
       element - resize the window and the computed Height follows Width to keep cells square,
       the same live-MultiBinding behavior CapacityToRatioConverter already gives
       PerformanceGraphLite for its dot cells.

    Width itself is left alone - set HorizontalAlignment="Stretch" (or place this in a "*" Grid
    column) so a container actually hands this element a real ActualWidth to square against; see
    PerformanceGraphLite's own Grid-layout guidance for the same underlying MeasureOverride
    reasoning (this control's MeasureOverride derives an infinite-width fallback from Capacity,
    same as PerformanceGraphLite's does from its own Capacity).
  -->
	<Style x:Key="SquareGridPerformanceGraphStyle" TargetType="{x:Type graphs:PerformanceGraph}">
		<Setter Property="GridColumns">
			<Setter.Value>
				<Binding Path="Capacity" RelativeSource="{RelativeSource Self}"/>
			</Setter.Value>
		</Setter>
		<Setter Property="Height">
			<Setter.Value>
				<MultiBinding Converter="{StaticResource GridSquareRatioConverter}">
					<Binding Path="ActualWidth" RelativeSource="{RelativeSource Self}"/>
					<Binding Path="GridRows" RelativeSource="{RelativeSource Self}"/>
					<Binding Path="GridColumns" RelativeSource="{RelativeSource Self}"/>
				</MultiBinding>
			</Setter.Value>
		</Setter>
	</Style>

	<!--
    The PerformanceGraphMultipleDS counterpart of the style above - identical mechanism, since that
    control draws the same GridRenderer grid and now exposes the same
    PerformanceGraphMultipleDS.SquareGridAspectRatio math (so GridSquareRatioConverter, which only
    reads GridRows/GridColumns, is reused as-is). GridColumns is bound to Capacity so there's one
    column per plotted sample, and Height is derived from ActualWidth/GridRows/GridColumns so every
    grid cell stays square as the window resizes. As with the single-series version, leave Width
    alone and set HorizontalAlignment="Stretch" so the container hands this element a real
    ActualWidth to square against.
  -->
  <Style x:Key="SquareGridPerformanceGraphMultipleDSStyle" TargetType="{x:Type graphs:PerformanceGraphMultipleDS}">
    <Setter Property="GridColumns">
      <Setter.Value>
        <Binding Path="Capacity" RelativeSource="{RelativeSource Self}"/>
      </Setter.Value>
    </Setter>
    <Setter Property="Height">
      <Setter.Value>
        <MultiBinding Converter="{StaticResource GridSquareRatioConverter}">
          <Binding Path="ActualWidth" RelativeSource="{RelativeSource Self}"/>
          <Binding Path="GridRows" RelativeSource="{RelativeSource Self}"/>
          <Binding Path="GridColumns" RelativeSource="{RelativeSource Self}"/>
        </MultiBinding>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
