<Window x:Class="Crystal.Controls.Demo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Crystal.Controls.Demo"
				xmlns:graphs="clr-namespace:Crystal.Controls.PerformanceGraphs;assembly=Crystal.Controls"
				xmlns:controls="clr-namespace:Crystal.Controls.PerformanceGraphs.Controls;assembly=Crystal.Controls"
				xmlns:gaugeControls="clr-namespace:Crystal.Controls.MeterGauges.Controls;assembly=Crystal.Controls"
				xmlns:barControls="clr-namespace:Crystal.Controls.RangeBars.Controls;assembly=Crystal.Controls"
        mc:Ignorable="d"
        Title="MainWindow" Height="620" Width="1180" Background="Black">
	<Grid Margin="16">
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="*"/>
			<ColumnDefinition Width="280"/>
		</Grid.ColumnDefinitions>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,8">
			<TextBlock Text="Render style:" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0"/>
			<RadioButton x:Name="LineModeRadio" GroupName="GraphKind" Content="Line" Foreground="White" IsChecked="True"
						 Checked="GraphKindRadio_Changed" Margin="0,0,12,0"/>
			<RadioButton x:Name="BarModeRadio" GroupName="GraphKind" Content="Bar" Foreground="White"
						 Checked="GraphKindRadio_Changed" Margin="0,0,12,0"/>
			<RadioButton x:Name="SegmentedBarModeRadio" GroupName="GraphKind" Content="Segmented Bar" Foreground="White"
						 Checked="GraphKindRadio_Changed"/>
		</StackPanel>

		<!-- Voltage meter gauge -->
		<gaugeControls:MeterGaugeView x:Name="VoltageGaugeView" Grid.Row="1" Grid.RowSpan="2" Grid.Column="1"
									  Margin="16,0,0,0"
									  Title="Voltage" Unit="V"
									  MinValue="0" MaxValue="3"
									  ValueFormat="{}{0:0.00}"/>

		<!-- % Utilization -->
		<controls:PerformanceGraphView x:Name="UtilizationView" Grid.Row="1" Grid.Column="0" Height="260"
									   Title="% Utilization"
									   MaxValue="100" MaxValueFormat="{}{0}%"
									   MinValue="0"
									   MaxTime="60" MaxTimeFormat="{}{0} seconds"
									   MinTime="0"/>

		<!-- Voltage range bar -->
		<barControls:RangeBarView x:Name="VoltageBar" Grid.Row="2" Grid.Column="0" Height="48"
								  Margin="0,4,0,4"
								  Title="Voltage" Unit="V"
								  MinValue="0" MaxValue="3"
								  ValueFormat="{}{0:0.00}"/>

		<!-- Voltage -->
		<controls:PerformanceGraphView x:Name="VoltageView" Grid.Row="3" Grid.Column="0" Height="260"
									   Title="Voltage"
									   MaxValue="3" MaxValueFormat="{}{0}V"
									   MinValue="0"
									   MaxTime="60" MaxTimeFormat="{}{0} seconds"
									   MinTime="0"/>
	</Grid>
</Window>
