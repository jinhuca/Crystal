<Project>
	<PropertyGroup>
		<RepoRoot>$(MSBuildThisFileDirectory)</RepoRoot>

		<!-- SDK-style C# project settings -->
		<BaseOutputPath>$(RepoRoot)Build\</BaseOutputPath>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
		<BaseIntermediateOutputPath>$(RepoRoot)Build\Obj\$(MSBuildProjectName)\</BaseIntermediateOutputPath>
	</PropertyGroup>

	<!-- CsWin32 cannot generate architecture-specific P/Invokes for AnyCPU. Default the
	     managed platform target to x64 when no explicit platform is selected, so builds
	     (and test discovery) don't fall back to AnyCPU. Explicit x86/ARM64 builds are preserved. -->
	<PropertyGroup Condition="'$(MSBuildProjectExtension)'=='.csproj' and ('$(Platform)'=='' or '$(Platform)'=='AnyCPU')">
		<PlatformTarget>x64</PlatformTarget>
	</PropertyGroup>

	<!-- C++ (vcxproj) projects: same idea, different macro names -->
	<PropertyGroup Condition="'$(MSBuildProjectExtension)'=='.vcxproj'">
		<OutDir>$(RepoRoot)Build\$(Configuration)\</OutDir>
		<IntDir>$(RepoRoot)Build\Obj\$(MSBuildProjectName)\$(Platform)\$(Configuration)\</IntDir>
	</PropertyGroup>
</Project>
