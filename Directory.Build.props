<Project>
	<PropertyGroup>
		<RepoRoot>$(MSBuildThisFileDirectory)</RepoRoot>

		<!-- SDK-style C# project settings -->
		<BaseOutputPath>$(RepoRoot)Build\</BaseOutputPath>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
		<BaseIntermediateOutputPath>$(RepoRoot)Build\Obj\$(MSBuildProjectName)\</BaseIntermediateOutputPath>
	</PropertyGroup>

	<!-- C++ (vcxproj) projects: same idea, different macro names -->
	<PropertyGroup Condition="'$(MSBuildProjectExtension)'=='.vcxproj'">
		<OutDir>$(RepoRoot)Build\$(Configuration)\</OutDir>
		<IntDir>$(RepoRoot)Build\Obj\$(MSBuildProjectName)\$(Platform)\$(Configuration)\</IntDir>
	</PropertyGroup>
</Project>
