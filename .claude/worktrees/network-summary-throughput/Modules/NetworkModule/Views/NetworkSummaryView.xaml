<UserControl x:Class="NetworkModule.Views.NetworkSummaryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:graphs="clr-namespace:Crystal.Controls.PerformanceGraphs.Controls;assembly=Crystal.Controls"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d"
             d:DesignHeight="240" d:DesignWidth="380"
             Background="Transparent" Foreground="White"
             FontFamily="Segoe UI">
  <Border Background="Transparent" MouseLeftButtonDown="OnTileClick">
    <Grid Margin="10">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- Dense header bar: accent tick + title, thin divider rule below -->
      <Border Grid.Row="0" BorderBrush="#2A2A2A" BorderThickness="0,0,0,1"
              Padding="0,0,0,4" Margin="0,0,0,6">
        <StackPanel Orientation="Horizontal">
          <Border Width="3" Background="#3E9BE8" Margin="0,1,8,1"/>
          <TextBlock Text="NETWORK" Foreground="#E6E6E6" FontSize="12" FontWeight="SemiBold"
                     VerticalAlignment="Center"/>
        </StackPanel>
      </Border>

      <!-- Interface count -->
      <TextBlock Grid.Row="1" Foreground="#8A94A0" FontSize="11" FontFamily="Consolas"
                 Margin="0,0,0,8">
        <Run Text="{Binding Adapters.Count, Mode=OneWay}"/>
        <Run Text="active interface(s)"/>
      </TextBlock>

      <!-- Live throughput: download/upload readout + load-percentage graph -->
      <Grid Grid.Row="2">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="110"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" VerticalAlignment="Center">
          <TextBlock Text="download" Foreground="#8A94A0" FontSize="11" FontFamily="Consolas"/>
          <StackPanel Orientation="Horizontal" Margin="0,2,0,10">
            <TextBlock Text="&#x25BC; " Foreground="#3BD15A" FontSize="14" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding DownloadLabel}" Foreground="White" FontSize="14"
                       FontFamily="Consolas" VerticalAlignment="Center"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
            <TextBlock Text="&#x25B2; " Foreground="#E89B2A" FontSize="14" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding UploadLabel}" Foreground="White" FontSize="14"
                       FontFamily="Consolas" VerticalAlignment="Center"/>
          </StackPanel>
          <TextBlock Text="upload" Foreground="#8A94A0" FontSize="11" FontFamily="Consolas"/>
        </StackPanel>
        <graphs:PerformanceGraphView x:Name="UtilizationView" Grid.Column="1" Margin="8,0"
                                     Loaded="OnGraphLoaded"
                                     Title="Utilization Percentage" MinValue="0" MaxValue="100"
                                     MaxValueFormat="{}{0}%" MaxTime="60"
                                     MaxTimeFormat="{}{0}s" MinTime="0"/>
      </Grid>
    </Grid>
  </Border>
</UserControl>
