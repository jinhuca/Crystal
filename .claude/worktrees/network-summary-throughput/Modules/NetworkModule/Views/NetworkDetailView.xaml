<UserControl x:Class="NetworkModule.Views.NetworkDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:graphs="clr-namespace:Crystal.Controls.PerformanceGraphs.Controls;assembly=Crystal.Controls"
             xmlns:gauges="clr-namespace:Crystal.Controls.MeterGauges.Controls;assembly=Crystal.Controls"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="1100"
             Background="#101317" Foreground="White"
             FontFamily="Segoe UI">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- Header + Back control -->
    <Grid Grid.Row="0" Margin="0,0,0,16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Button Grid.Column="0" Content="&#x2190; Back" Padding="14,6"
              Background="#1E2A38" Foreground="White" BorderThickness="0"
              Command="{Binding ShowDashboardCommand}"/>
      <TextBlock Grid.Column="1" Text="Network" Foreground="#3E9BE8" FontSize="28"
                 FontWeight="SemiBold" VerticalAlignment="Center" Margin="16,0,0,0"/>
    </Grid>

    <!-- One panel per connected interface, wrapping across the available width -->
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <ItemsControl ItemsSource="{Binding Adapters}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel Orientation="Horizontal"/>
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Margin="8" Padding="18" Background="#161B22" CornerRadius="8"
                    Width="500" Height="260">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="{Binding Name}" Foreground="#3E9BE8"
                           FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>

                <!-- Throughput -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,12">
                  <StackPanel Orientation="Horizontal" Margin="0,0,24,0">
                    <TextBlock Text="&#x2193; " Foreground="#3BD15A"/>
                    <TextBlock Text="{Binding DownloadLabel}" Foreground="White"/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#x2191; " Foreground="#E89B2A"/>
                    <TextBlock Text="{Binding UploadLabel}" Foreground="White"/>
                  </StackPanel>
                </StackPanel>

                <!-- Live utilization: gauge + history graph -->
                <Grid Grid.Row="2">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <gauges:MeterGaugeView Grid.Column="0" Title="Utilization" Unit="%"
                                         MinValue="0" MaxValue="100" ValueFormat="{}{0:0}"
                                         Value="{Binding Load}"/>
                  <graphs:PerformanceGraphView Grid.Column="1" Margin="12,0"
                                               Loaded="OnGraphLoaded"
                                               Title="Utilization Percentage" MinValue="0" MaxValue="100"
                                               MaxValueFormat="{}{0}%" MaxTime="60"
                                               MaxTimeFormat="{}{0}s" MinTime="0"/>
                </Grid>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </Grid>
</UserControl>
