<UserControl x:Class="ResourceModule.Controls.Indicator.ValueBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ResourceModule.Controls.Indicator"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
  <UserControl.Resources>
    <VisualBrush x:Key="DashBrush" TileMode="Tile" Viewport="0,0,6,6" ViewportUnits="Absolute">
      <VisualBrush.Visual>
        <Canvas>
          <Rectangle Width="6" Height="10" Fill="Transparent"/>
          <Rectangle Width="5" Height="10" Fill="{Binding IndicatorBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
        </Canvas>
      </VisualBrush.Visual>
    </VisualBrush>
    <Style TargetType="ProgressBar">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Grid x:Name="Root">
              <!-- The Track (background of the bar) -->
              <Border x:Name="PART_Track" 
                    Background="LightGray" 
                    CornerRadius="4"/>
              <!-- The Indicator (the actual progress part) -->
              <Border x:Name="PART_Indicator" 
                    HorizontalAlignment="Left" 
                    Background="{StaticResource DashBrush}" 
                    CornerRadius="4"/>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>
  <Grid Height="{Binding IndicatorHeight, RelativeSource={RelativeSource AncestorType=UserControl}}" ShowGridLines="False">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="2.0cm"/>
      <ColumnDefinition Width="2.2cm"/>
      <ColumnDefinition Width="1.2cm"/>
      <!--<ColumnDefinition Width="0.3cm"/>-->
      <ColumnDefinition Width="1.2cm"/>
      <!--<ColumnDefinition Width="0.6cm"/>-->
      <ColumnDefinition Width="1.2cm"/>
    </Grid.ColumnDefinitions>
    <!-- (0) Title -->
    <TextBlock Grid.Column="0" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,0.1cm,0" 
               Text="{Binding Title, RelativeSource={RelativeSource AncestorType=UserControl}}"
               FontSize="{Binding TitleFontSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
               FontWeight="{Binding TitleFontWeight, RelativeSource={RelativeSource AncestorType=UserControl}}"
               Foreground="{Binding TitleForeground, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
    <!-- (1) ValueBar -->
    <ProgressBar Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,2,0,2"
                 Width="{Binding IndicatorWidth, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                 Height="{Binding IndicatorHeight, RelativeSource={RelativeSource AncestorType=UserControl}}"
                 Minimum="{Binding Minimum, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                 Maximum="{Binding Maximum, RelativeSource={RelativeSource AncestorType=UserControl}}"
                 Value="{Binding Value, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
    <!-- (2) Value Text -->
    <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="1,0,0,0"
               Text="{Binding Value, RelativeSource={RelativeSource AncestorType=UserControl}, StringFormat={}{0:F2}}" 
               FontSize="{Binding ValueFontSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
               FontWeight="{Binding ValueFontWeight, RelativeSource={RelativeSource AncestorType=UserControl}}"
               Foreground="{Binding ValueForeground, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
    <!-- (3) Separator -->
    <!--<Rectangle Grid.Column="3" RadiusX="1" RadiusY="1" Margin="1,4,0,4" HorizontalAlignment="Center"
               Height="{Binding IndicatorHeight, RelativeSource={RelativeSource AncestorType=UserControl}}"
               Width="{Binding SeparatorWidth, RelativeSource={RelativeSource AncestorType=UserControl}}" 
               Fill="{Binding SeparatorBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"/>-->
    <!-- (3) Min Value -->
    <TextBlock Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center" 
               Text="{Binding Minimum, RelativeSource={RelativeSource AncestorType=UserControl}, StringFormat={}{0:F2}}"
               FontSize="{Binding MinValueFontSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
               FontWeight="{Binding MinValueFontWeight, RelativeSource={RelativeSource AncestorType=UserControl}}"
               Foreground="{Binding MinValueBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
    <!-- (5) Separator -->
    <!--<TextBlock Grid.Column="5" Text="," Foreground="LightGray"
               FontSize="{Binding ValueFontSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
               FontWeight="{Binding ValueFontWeight, RelativeSource={RelativeSource AncestorType=UserControl}}"
               />-->
    <!--<Rectangle Grid.Column="5" RadiusX="1" RadiusY="1" Margin="1,4,0,4" HorizontalAlignment="Center"
               Height="{Binding IndicatorHeight, RelativeSource={RelativeSource AncestorType=UserControl}}"
               Width="{Binding SeparatorWidth, RelativeSource={RelativeSource AncestorType=UserControl}}" 
               Fill="{Binding SeparatorBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"/>-->
    <!-- (4) Max Value -->
    <TextBlock Grid.Column="4" HorizontalAlignment="Right" VerticalAlignment="Center" 
               Text="{Binding Maximum, RelativeSource={RelativeSource AncestorType=UserControl}, StringFormat={}{0:F2}}"
               FontSize="{Binding MaxValueFontSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
               FontWeight="{Binding MaxValueFontWeight, RelativeSource={RelativeSource AncestorType=UserControl}}"
               Foreground="{Binding MaxValueBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
  </Grid>
</UserControl>
