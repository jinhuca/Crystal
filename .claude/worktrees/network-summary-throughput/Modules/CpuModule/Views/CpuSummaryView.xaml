<UserControl x:Class="CpuModule.Views.CpuSummaryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:graphs="clr-namespace:Crystal.Controls.PerformanceGraphs.Controls;assembly=Crystal.Controls"
             xmlns:gauges="clr-namespace:Crystal.Controls.MeterGauges.Controls;assembly=Crystal.Controls"
             xmlns:local="clr-namespace:CpuModule.Views"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d"
             d:DesignHeight="240" d:DesignWidth="760"
             Background="Transparent" Foreground="White"
             FontFamily="Segoe UI">
  <UserControl.Resources>
    <local:LoadToBrushConverter x:Key="LoadToBrush"/>
  </UserControl.Resources>
  <Border Background="Transparent" MouseLeftButtonDown="OnTileClick">
    <Grid Margin="10">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- Dense header bar: accent tick + title + inline detail, thin divider rule below -->
      <Border Grid.Row="0" BorderBrush="#2A2A2A" BorderThickness="0,0,0,1" Padding="0,0,0,4">
        <StackPanel Orientation="Horizontal">
          <Border Width="3" Background="#3E9BE8" Margin="0,1,8,1"/>
          <TextBlock Text="CPU" Foreground="#E6E6E6" FontSize="12" FontWeight="SemiBold"
                     VerticalAlignment="Center" Margin="0,0,12,0"/>
          <TextBlock DataContext="{Binding SpecsViewModel}" Text="{Binding Brand}"
                     Foreground="#8A94A0" FontSize="11" FontFamily="Consolas"
                     VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
      </Border>

      <!-- Value gauge + load percentage graph + per-core load list -->
      <Grid Grid.Row="1" DataContext="{Binding SensorsViewModel}" Margin="0,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="110"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <gauges:MeterGaugeView Grid.Column="0" Title="Load" Unit="%"
                               MinValue="0" MaxValue="100" ValueFormat="{}{0:0}"
                               Value="{Binding Load}"/>
        <graphs:PerformanceGraphView x:Name="UtilizationView" Grid.Column="1" Margin="8,0"
                                     Title="Load Percentage" MinValue="0" MaxValue="100"
                                     MaxValueFormat="{}{0}%" MaxTime="60"
                                     MaxTimeFormat="{}{0}s" MinTime="0"/>

        <!-- Per-core load: "C## <load>% [bar 0-100]", 8 cores per column, wrapping rightward. -->
        <ScrollViewer Grid.Column="2" Margin="12,0,0,0"
                      VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding CoreLoads}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <!-- Fill each column top-to-bottom, then wrap into the next column.
                     ItemHeight * 8 caps a column at 8 cores; cores 9+ flow rightward. -->
                <WrapPanel Orientation="Vertical" MaxHeight="176" ItemHeight="22" ItemWidth="200"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,1,16,1">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="34"/>
                    <ColumnDefinition Width="56"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="{Binding Label}" Foreground="#8A94A0"
                             FontSize="11" FontFamily="Consolas" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="1" Text="{Binding Load, StringFormat={}{0:0.00}%}"
                             Foreground="{Binding Load, Converter={StaticResource LoadToBrush}}"
                             FontSize="11" FontFamily="Consolas"
                             TextAlignment="Right" Margin="0,0,8,0" VerticalAlignment="Center"/>
                  <ProgressBar Grid.Column="2" Minimum="0" Maximum="100" Value="{Binding Load}"
                               Height="9" VerticalAlignment="Center"
                               Background="#1A1A1A" BorderBrush="#3A3A3A"
                               Foreground="{Binding Load, Converter={StaticResource LoadToBrush}}"/>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>

      <!-- Instruction feature hint -->
      <TextBlock Grid.Row="2" DataContext="{Binding SpecsViewModel}"
                 Foreground="#8A94A0" FontSize="11" FontFamily="Consolas"
                 Text="{Binding LogicalCores, StringFormat=Instruction Feature · {0} logical cores}"/>
    </Grid>
  </Border>
</UserControl>
