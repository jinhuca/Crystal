<Window x:Class="Crystal.Shell.Shell"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:prism="http://prismlibrary.com/"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:const="clr-namespace:Crystal.Infrastructure.Constants;assembly=Crystal.Infrastructure.Constants"
        xmlns:local="clr-namespace:Crystal.Shell"
        mc:Ignorable="d"
        Title="Crystal" Height="1040" Width="1720"
        Background="Black"
        BorderBrush="#3E9BE8" BorderThickness="1">
    <!-- Strip the OS-drawn frame and its native caption buttons (GlassFrameThickness=0,
         UseAeroCaptionButtons=False) so the window's own 1dip BorderBrush is the only visible
         edge and we draw our own min/max/close buttons in the title bar below. -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="32"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Caption buttons: transparent so the title bar's window background shows through,
             with a hover fill. IsHitTestVisibleInChrome lets clicks land on the button instead
             of the WindowChrome drag region. -->
        <Style x:Key="CaptionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#DDDDDD"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2A2A2A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Close button gets the standard red hover instead of the neutral gray. -->
        <Style x:Key="CloseButtonStyle" TargetType="Button" BasedOn="{StaticResource CaptionButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title bar: shares the window's black content background; the left region is the drag
             surface, the right region holds the custom caption buttons. -->
        <Grid Grid.Row="0" Background="{Binding Background, RelativeSource={RelativeSource AncestorType=Window}}">
            <TextBlock Text="Crystal" Foreground="#8A94A0" FontFamily="Segoe UI" FontSize="12"
                       VerticalAlignment="Center" Margin="10,0,0,0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButtonStyle}"
                        Click="OnMinimizeClick" ToolTip="Minimize" Content="&#xE921;"/>
                <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButtonStyle}"
                        Click="OnMaximizeRestoreClick" ToolTip="Maximize" Content="&#xE922;"/>
                <Button x:Name="CloseButton" Style="{StaticResource CloseButtonStyle}"
                        Click="OnCloseClick" ToolTip="Close" Content="&#xE8BB;"/>
            </StackPanel>
        </Grid>

        <ContentControl Grid.Row="1"
                        prism:RegionManager.RegionName="{x:Static const:RegionNames.MainContentRegionName}"/>
    </Grid>
</Window>
