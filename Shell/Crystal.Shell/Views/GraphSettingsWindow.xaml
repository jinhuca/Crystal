<Window x:Class="Crystal.Shell.Views.GraphSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:vm="clr-namespace:Crystal.Shell.ViewModels"
        Title="Graph Settings"
        Width="1280" Height="560"
        WindowStartupLocation="CenterOwner"
        Background="Black"
        BorderBrush="{StaticResource AccentBrush}" BorderThickness="1"
        Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFontFamily}">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

    <!-- Custom caption buttons mirroring the shell's title bar (Segoe MDL2 Assets glyphs). -->
    <Style x:Key="SettingsCaptionButtonStyle" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Width" Value="46"/>
      <Setter Property="Height" Value="30"/>
      <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource DividerBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Dark, dense TextBox for the history-length input; accent border while focused, matching the
         app's flat chrome. Uses the default template (which honours these setters) so PART_ContentHost
         need not be re-declared. -->
    <Style x:Key="HistoryTextBoxStyle" TargetType="TextBox">
      <Setter Property="Width" Value="52"/>
      <Setter Property="Height" Value="22"/>
      <Setter Property="Background" Value="#1E2A38"/>
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="CaretBrush" Value="{StaticResource TextBrush}"/>
      <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="4,1"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="SnapsToDevicePixels" Value="True"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="BorderBrush" Value="#4A4A4A"/>
        </Trigger>
        <Trigger Property="IsKeyboardFocusWithin" Value="True">
          <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- Plain themed radio for category / kind selections. -->
    <Style x:Key="OptionRadioStyle" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Margin" Value="0,0,18,0"/>
    </Style>

    <!-- Colour swatch: a filled ellipse with a highlight ring when selected. The RadioButton's
         own bullet is templated away; the ellipse IS the control. -->
    <Style x:Key="ColorSwatchStyle" TargetType="RadioButton">
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Grid Width="24" Height="24">
              <Ellipse x:Name="Ring" Stroke="{StaticResource TextBrush}" StrokeThickness="2"
                       Visibility="Hidden"/>
              <Ellipse Margin="3" Fill="{Binding Swatch}"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Ring" Property="Visibility" Value="Visible"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Flat dark square button matching the app's detail chrome (DetailBackButtonStyle): dark
         surface, thin border, no rounded OS default, with hover/pressed feedback. -->
    <Style x:Key="DialogButtonStyle" TargetType="Button">
      <Setter Property="MinWidth" Value="84"/>
      <Setter Property="Height" Value="28"/>
      <Setter Property="Margin" Value="8,0,0,0"/>
      <Setter Property="Padding" Value="14,4"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="Background" Value="#1E2A38"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="SnapsToDevicePixels" Value="True"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#26394D"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#17324B"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Save = primary action: accent border + accent-tinted surface so it reads as the default. -->
    <Style x:Key="PrimaryDialogButtonStyle" TargetType="Button" BasedOn="{StaticResource DialogButtonStyle}">
      <Setter Property="Background" Value="{StaticResource AccentSelectionBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- Rainbow fill for the custom-colour picker, signalling "any colour". -->
    <LinearGradientBrush x:Key="RainbowBrush" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#E82A7A" Offset="0.0"/>
      <GradientStop Color="#E89B2A" Offset="0.2"/>
      <GradientStop Color="#3BD15A" Offset="0.45"/>
      <GradientStop Color="#3E9BE8" Offset="0.7"/>
      <GradientStop Color="#9B5AE8" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- Custom-colour picker: a rainbow disc with a small "+" that opens the colour dialog. -->
    <Style x:Key="CustomColorButtonStyle" TargetType="Button">
      <Setter Property="Margin" Value="6,0,8,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid Width="24" Height="24">
              <Ellipse Margin="3" Fill="{StaticResource RainbowBrush}"/>
              <Border x:Name="Badge" Width="12" Height="12" CornerRadius="6"
                      Background="#1A1A1A" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                <TextBlock Text="+" Foreground="White" FontSize="10" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Badge" Property="Background" Value="{StaticResource AccentBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="36" GlassFrameThickness="0" CornerRadius="0"
                        ResizeBorderThickness="6" UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="36"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Title bar: drag surface (left) + close button (right). -->
    <Grid Grid.Row="0" Background="Black">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center"
                  Margin="10,0,0,0">
        <TextBlock Text="Graph Settings" Foreground="{StaticResource LabelBrush}"
                   FontSize="14" VerticalAlignment="Center"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="CloseButton" Style="{StaticResource SettingsCaptionButtonStyle}"
                Click="OnCloseClick" Content="&#xE8BB;" ToolTip="Close"/>
      </StackPanel>
    </Grid>

    <StackPanel Grid.Row="1">
    <!-- General selectors: applied to every graph when changed; each row can still override. -->
    <StackPanel Orientation="Horizontal" Margin="16,12,16,8" VerticalAlignment="Center">
      <TextBlock Text="Category:" Foreground="{StaticResource LabelBrush}"
                 VerticalAlignment="Center" Margin="0,0,16,0"/>
      <RadioButton Content="No Frills" GroupName="GeneralCategory" Style="{StaticResource OptionRadioStyle}"
                   IsChecked="{Binding IsNoFrills}"/>
      <RadioButton Content="Full Graphs" GroupName="GeneralCategory" Style="{StaticResource OptionRadioStyle}"
                   IsChecked="{Binding IsFullGraph}"/>

      <TextBlock Text="Graph:" Foreground="{StaticResource LabelBrush}"
                 VerticalAlignment="Center" Margin="12,0,16,0"/>
      <RadioButton Content="Line" GroupName="GeneralKind" Style="{StaticResource OptionRadioStyle}"
                   IsChecked="{Binding IsFilledLine}"/>
      <RadioButton Content="Segmented Bar" GroupName="GeneralKind" Style="{StaticResource OptionRadioStyle}"
                   IsChecked="{Binding IsSegmentedBar}"/>
      <RadioButton Content="Dot" GroupName="GeneralKind" Style="{StaticResource OptionRadioStyle}"
                   IsChecked="{Binding IsDot}"/>

      <TextBlock Text="History:" Foreground="{StaticResource LabelBrush}"
                 VerticalAlignment="Center" Margin="12,0,6,0"/>
      <TextBox Style="{StaticResource HistoryTextBoxStyle}"
               Text="{Binding HistoryLength, UpdateSourceTrigger=LostFocus}"/>

      <Button x:Name="ResetButton" Command="{Binding ResetCommand}"
              Style="{StaticResource SettingsCaptionButtonStyle}" Margin="16,0,0,0"
              Content="&#xE72C;" ToolTip="Reset all graphs to defaults"/>
    </StackPanel>

    <!-- CPU core strip: global bar shape + colouring for the per-core load/clock/temp meters. These
         are not PerformanceGraphs, so they sit apart from the per-graph catalog below. -->
    <StackPanel Orientation="Horizontal" Margin="16,0,16,10" VerticalAlignment="Center">
      <TextBlock Text="CPU Cores:" Foreground="{StaticResource ValueBrush}" FontWeight="SemiBold"
                 VerticalAlignment="Center" Margin="0,0,16,0"/>
      <TextBlock Text="Bar style:" Foreground="{StaticResource LabelBrush}"
                 VerticalAlignment="Center" Margin="0,0,10,0"/>
      <RadioButton Content="Bar" GroupName="CoreBarStyle" Style="{StaticResource OptionRadioStyle}"
                   IsChecked="{Binding IsCoreBar}"/>
      <RadioButton Content="Segmented Bar" GroupName="CoreBarStyle" Style="{StaticResource OptionRadioStyle}"
                   IsChecked="{Binding IsCoreSegmentedBar}"/>

      <TextBlock Text="Colour:" Foreground="{StaticResource LabelBrush}"
                 VerticalAlignment="Center" Margin="12,0,10,0"/>
      <RadioButton Content="Colourful" GroupName="CoreBarColor" Style="{StaticResource OptionRadioStyle}"
                   IsChecked="{Binding IsCoreColorful}"/>
      <RadioButton Content="Grey" GroupName="CoreBarColor" Style="{StaticResource OptionRadioStyle}"
                   IsChecked="{Binding IsCoreGrey}"/>
    </StackPanel>
    </StackPanel>

    <!-- Per-graph rows, grouped by component. -->
    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="16,0,16,0">
      <ItemsControl ItemsSource="{Binding Groups}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <StackPanel Margin="0,4,0,10">
              <TextBlock Text="{Binding Component}" Foreground="{StaticResource ValueBrush}"
                         FontWeight="SemiBold" FontSize="14" Margin="0,0,0,4"/>
              <Border BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1"
                      Margin="0,0,0,6"/>
              <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="8,3,0,3">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                      </Grid.ColumnDefinitions>
                      <TextBlock Grid.Column="0" Text="{Binding Metric}"
                                 Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                      <!-- Category: chrome for this graph (separate panel = its own radio group). -->
                      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                  Margin="0,0,20,0">
                        <TextBlock Text="Category:" Foreground="{StaticResource LabelBrush}"
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <RadioButton Content="No Frills" Style="{StaticResource OptionRadioStyle}"
                                     IsChecked="{Binding IsNoFrills}"/>
                        <RadioButton Content="Full Graphs" Style="{StaticResource OptionRadioStyle}"
                                     IsChecked="{Binding IsFullGraph}"/>
                      </StackPanel>
                      <!-- Kind: exclusivity is data-driven (separate panel = its own group). -->
                      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                  Margin="0,0,20,0">
                        <TextBlock Text="Graph:" Foreground="{StaticResource LabelBrush}"
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <RadioButton Content="Line" Style="{StaticResource OptionRadioStyle}"
                                     IsChecked="{Binding IsFilledLine}"/>
                        <RadioButton Content="Segmented Bar" Style="{StaticResource OptionRadioStyle}"
                                     IsChecked="{Binding IsSegmentedBar}"/>
                        <RadioButton Content="Dot" Style="{StaticResource OptionRadioStyle}"
                                     IsChecked="{Binding IsDot}"/>
                      </StackPanel>
                      <!-- History length (x-axis span, sample count). -->
                      <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center"
                                  Margin="0,0,20,0">
                        <TextBlock Text="History:" Foreground="{StaticResource LabelBrush}"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox Style="{StaticResource HistoryTextBoxStyle}"
                                 Text="{Binding HistoryLength, UpdateSourceTrigger=LostFocus}"/>
                      </StackPanel>
                      <!-- Accent swatches + custom-colour picker and its display swatch. -->
                      <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                        <ItemsControl ItemsSource="{Binding AccentOptions}" VerticalAlignment="Center">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <RadioButton Style="{StaticResource ColorSwatchStyle}"
                                           IsChecked="{Binding IsSelected}"
                                           ToolTip="{Binding Accent}"/>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <!-- Custom-colour picker: opens the colour dialog. -->
                        <Button Style="{StaticResource CustomColorButtonStyle}"
                                Click="OnPickCustomColorClick"
                                ToolTip="Pick a custom colour…"/>
                        <!-- Display swatch: shows the selected custom colour (empty when none). -->
                        <Grid Width="24" Height="24" ToolTip="Custom colour">
                          <Ellipse Stroke="{StaticResource TextBrush}" StrokeThickness="2"
                                   Visibility="{Binding HasCustomColor, Converter={StaticResource BoolToVisibility}}"/>
                          <Ellipse Margin="3" Fill="{Binding CustomSwatch}"
                                   Stroke="{StaticResource DividerBrush}" StrokeThickness="1"/>
                        </Grid>
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <!-- Save / Cancel. -->
    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right"
                Margin="16,10,16,14">
      <Button Content="Cancel" Style="{StaticResource DialogButtonStyle}" Click="OnCancelClick"/>
      <Button Content="Save" Style="{StaticResource PrimaryDialogButtonStyle}" Click="OnSaveClick"/>
    </StackPanel>
  </Grid>
</Window>
