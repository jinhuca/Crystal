<UserControl x:Class="Crystal.Shell.Views.DashboardView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:prism="http://prismlibrary.com/"
						 xmlns:ctrls="clr-namespace:Crystal.Controls.Comet;assembly=Crystal.Controls"
             xmlns:const="clr-namespace:Crystal.Infrastructure.Constants;assembly=Crystal.Infrastructure.Constants"
             xmlns:local="clr-namespace:Crystal.Shell.Views;assembly=Crystal.Shell"
             mc:Ignorable="d"
             d:DesignHeight="860" d:DesignWidth="1600"
             Background="Black" Foreground="{StaticResource TextBrush}"
             FontFamily="{StaticResource UiFontFamily}">
  <UserControl.Resources>
    <Style x:Key="Tile" TargetType="Border">
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <!-- Uniform 1px on all sides so the gutter between tiles is identical horizontally and
           vertically: every neighbour gap becomes tile(1) + splitter track(1) + tile(1) = 3px,
           whether the tiles are split by a RowSplitter or a ColumnSplitter. -->
      <Setter Property="Margin" Value="3,1,3,1"/>
      <Setter Property="Background" Value="#FF151515"/>
    </Style>

    <!-- Horizontal grab bar between rows: a thin rule centered in a taller hit area so the target
         is comfortable but reads as a hairline, brightening to the accent on hover. Matches the
         master/detail splitter styling in the Processes view. -->
    <Style x:Key="RowSplitter" TargetType="GridSplitter">
      <Setter Property="Height" Value="2"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="ResizeBehavior" Value="PreviousAndNext"/>
      <Setter Property="ResizeDirection" Value="Rows"/>
      <Setter Property="ShowsPreview" Value="False"/>
      <Setter Property="Cursor" Value="SizeNS"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="GridSplitter">
            <Grid Background="{TemplateBinding Background}">
              <Border x:Name="Rule" Height="6" Background="Transparent" VerticalAlignment="Center"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Rule" Property="Background" Value="#553E9BE8"/>
                <Setter TargetName="Rule" Property="Height" Value="2"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Vertical grab bar between the row tiles: the column-oriented
         twin of RowSplitter, so the user can widen one tile at the expense of its neighbour. A thin
         rule centered in a wider hit area, brightening to the accent on hover. -->
    <Style x:Key="ColumnSplitter" TargetType="GridSplitter">
      <Setter Property="Width" Value="2"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="VerticalAlignment" Value="Stretch"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="ResizeBehavior" Value="PreviousAndNext"/>
      <Setter Property="ResizeDirection" Value="Columns"/>
      <Setter Property="ShowsPreview" Value="False"/>
      <Setter Property="Cursor" Value="SizeWE"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="GridSplitter">
            <Grid Background="{TemplateBinding Background}">
              <Border x:Name="Rule" Width="6" Background="Transparent" HorizontalAlignment="Center"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Rule" Property="Background" Value="#553E9BE8"/>
                <Setter TargetName="Rule" Property="Width" Value="2"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <!-- Four content rows separated by draggable splitters. Every content row is star-sized with a
       MinHeight, so the user can drag any boundary to enlarge one row (shrinking its neighbor) down
       to each row's floor. The components row (Memory/Storage/Network) and the bottom row
       (BIOS/Operating System/Processes) are each a nested grid of three columns with their own
       vertical splitters, so those tiles are independently resizable; the CPU and GPU rows span the
       full width. -->
  <Grid Margin="3" ShowGridLines="False">
    <Grid.RowDefinitions>
      <RowDefinition x:Name="CpuRow" Height="{Binding ElementName=Root, Path=CpuGpuSummaryViewDefaultHeight}"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition x:Name="GpuRow" Height="{Binding ElementName=Root, Path=GpuSummaryViewDefaultHeight}"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition x:Name="ComponentsRow" Height="{Binding ElementName=Root, Path=SummaryViewDefaultHeight}"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition x:Name="BottomRow" Height="{Binding ElementName=Root, Path=BiosSummaryViewDefaultHeight}"/>
    </Grid.RowDefinitions>

    <!-- Row 1: CPU, full width -->
    <Border Grid.Row="0" Style="{StaticResource Tile}" Margin="3,1">
      <ContentControl prism:RegionManager.RegionName="{x:Static const:RegionNames.CpuRegionName}"/>
    </Border>

    <GridSplitter Grid.Row="1" Style="{StaticResource RowSplitter}"/>

    <!-- Row 2: GPU, full width -->
    <Border Grid.Row="2" Style="{StaticResource Tile}">
      <ContentControl prism:RegionManager.RegionName="{x:Static const:RegionNames.GpuSummaryRegionName}"/>
    </Border>

    <GridSplitter Grid.Row="3" Style="{StaticResource RowSplitter}"/>

    <!-- Row 3: Memory + Storage + Network summary views. Nested in its own grid of three star
         columns separated by vertical splitters, so the user can widen one tile at its neighbour's
         expense (the outer grid stays full-width for the other rows). Each column has a MinWidth.
         Network is a narrower column (0.3 star) than the equal Memory/Storage pair. -->
    <Grid Grid.Row="4">
      <Grid.ColumnDefinitions>
				<ColumnDefinition x:Name="MemoryCol" Width="{Binding ElementName=Root, Path=MemorySummaryViewDefaultColumnWidth}" MinWidth="80"/>
        <ColumnDefinition Width="Auto"/>
				<ColumnDefinition x:Name="StorageCol" Width="{Binding ElementName=Root, Path=StorageSummaryViewDefaultColumnWidth}" MinWidth="80"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition x:Name="NetworkCol" Width="{Binding ElementName=Root, Path=NetworkSummaryViewDefaultColumnWidth}" MinWidth="80"/>
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Style="{StaticResource Tile}" Margin="3,1,1,1">
        <ContentControl prism:RegionManager.RegionName="{x:Static const:RegionNames.MemoryRegionName}"/>
      </Border>
      <GridSplitter Grid.Column="1" Style="{StaticResource ColumnSplitter}"/>
      <Border Grid.Column="2" Style="{StaticResource Tile}" Margin="1,1,1,1">
        <ContentControl prism:RegionManager.RegionName="{x:Static const:RegionNames.StorageRegionName}"/>
      </Border>
      <GridSplitter Grid.Column="3" Style="{StaticResource ColumnSplitter}"/>
      <Border Grid.Column="4" Style="{StaticResource Tile}" Margin="1,1,3,1">
        <ContentControl prism:RegionManager.RegionName="{x:Static const:RegionNames.NetworkSummaryRegionName}"/>
      </Border>
    </Grid>

    <GridSplitter Grid.Row="5" Style="{StaticResource RowSplitter}"/>

    <!-- Row 4: BIOS + Operating System + Processes summary views. Nested in its own grid of three
         star columns separated by vertical splitters, so the user can widen any tile at its
         neighbour's expense; each column has a MinWidth floor. Processes is a narrower column
         (0.3 star) than the equal BIOS/Operating System pair. -->
    <Grid Grid.Row="6">
      <Grid.ColumnDefinitions>
				<ColumnDefinition x:Name="BiosCol" Width="{Binding ElementName=Root, Path=BiosSummaryViewDefaultColumnWidth}" MinWidth="80"/>
        <ColumnDefinition Width="Auto"/>
				<ColumnDefinition x:Name="OsCol" Width="{Binding ElementName=Root, Path=OsSummaryViewColumnDefaultWidth}" MinWidth="80"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition x:Name="ProcessCol" Width="{Binding ElementName=Root, Path=ProcessSummaryViewColumnDefaultWidth}" MinWidth="80"/>
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Style="{StaticResource Tile}" Margin="3,1,1,5">
        <ContentControl prism:RegionManager.RegionName="{x:Static const:RegionNames.BiosRegionName}"/>
      </Border>
      <GridSplitter Grid.Column="1" Style="{StaticResource ColumnSplitter}"/>
      <Border Grid.Column="2" Style="{StaticResource Tile}" Margin="1,1,1,5">
        <ContentControl prism:RegionManager.RegionName="{x:Static const:RegionNames.OsRegionName}"/>
      </Border>
      <GridSplitter Grid.Column="3" Style="{StaticResource ColumnSplitter}"/>
      <Border Grid.Column="4" Style="{StaticResource Tile}" Margin="1,1,3,5">
        <ContentControl prism:RegionManager.RegionName="{x:Static const:RegionNames.ProcessesRegionName}"/>
      </Border>
    </Grid>
  </Grid>
</UserControl>
