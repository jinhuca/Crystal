<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Crystal.Provider.Telemetry (transitive) depends on Mono.Posix.NETStandard, whose only
         net-compatible assembly lives under runtimes/<rid>/lib. A RID-agnostic build resolves no
         runtime asset and omits it from deps.json, so the app throws FileNotFoundException at
         startup. Using both RuntimeIdentifier and RuntimeIdentifiers ensures both single-RID builds
         and multi-RID restores generate net10.0-windows/win-x64 target in project.assets.json. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <SelfContained>false</SelfContained>
    <!-- Ensure the build always uses RID-specific assets even when no -r is passed -->
    <UseRidGraph>true</UseRidGraph>
    <!-- Force a single UAC prompt at launch: the Processes tile's kernel ETW session and the ring-0
         MSR sensors both need administrator rights. See app.manifest for the rationale. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Crystal.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Crystal.Shell.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ship the icon so the window can load it at runtime via pack URI. -->
    <Resource Include="Crystal.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ship the fan-config folder next to the app so users can discover where to drop NBFC
         configs. The embedded controller scans <app>/Configs/Fan at runtime (AppContext.BaseDirectory);
         the help file makes an otherwise-empty, undocumented folder self-explanatory. -->
    <Content Include="Configs\Fan\HOW-TO-ADD-FAN-CONFIGS.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Ship our own hand-authored fan templates. Third-party NBFC configs are GPL and stay
         user-supplied drop-ins (see the help file), so they are deliberately not included here. -->
    <Content Include="Configs\Fan\Lenovo ThinkPad P1.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Prism.Core" Version="9.0.537" />
    <PackageReference Include="Prism.Unity" Version="9.0.537" />
    <PackageReference Include="Prism.Wpf" Version="9.0.537" />
    <PackageReference Include="System.Reactive" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Modules\Crystal.CpuModule\Crystal.CpuModule.csproj" />
    <ProjectReference Include="..\..\Modules\Crystal.GpuModule\Crystal.GpuModule.csproj" />
    <ProjectReference Include="..\..\Modules\Crystal.MemoryModule\Crystal.MemoryModule.csproj" />
    <ProjectReference Include="..\..\Modules\Crystal.StorageModule\Crystal.StorageModule.csproj" />
    <ProjectReference Include="..\..\Modules\Crystal.BiosModule\Crystal.BiosModule.csproj" />
    <ProjectReference Include="..\..\Modules\Crystal.NetworkModule\Crystal.NetworkModule.csproj" />
    <ProjectReference Include="..\..\Modules\Crystal.ProcessModule\Crystal.ProcessModule.csproj" />
    <ProjectReference Include="..\..\Modules\Crystal.OSModule\Crystal.OSModule.csproj" />
    <ProjectReference Include="..\..\UI\Crystal.Resources\Crystal.Resources.csproj" />
    <ProjectReference Include="..\..\Infrastructures\Crystal.Infrastructure.Constants\Crystal.Infrastructure.Constants.csproj" />
    <ProjectReference Include="..\..\Services\Crystal.Service.Sensors\Crystal.Service.Sensors.csproj" />
  </ItemGroup>

</Project>
