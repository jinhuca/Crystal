<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Crystal.Provider.Telemetry (transitive) depends on Mono.Posix.NETStandard, whose only
         net-compatible assembly lives under runtimes/<rid>/lib. A RID-agnostic build resolves no
         runtime asset and omits it from deps.json, so the app throws FileNotFoundException at
         startup. Pinning the RID makes NuGet resolve the win-x64 asset and copy it to output. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Prism.Core" Version="9.0.537" />
    <PackageReference Include="Prism.Unity" Version="9.0.537" />
    <PackageReference Include="Prism.Wpf" Version="9.0.537" />
    <PackageReference Include="System.Reactive" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Modules\CpuModule\CpuModule.csproj" />
  </ItemGroup>

</Project>
