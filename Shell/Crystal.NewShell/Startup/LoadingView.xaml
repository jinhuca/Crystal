<UserControl x:Class="Crystal.NewShell.Startup.LoadingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:startup="clr-namespace:Crystal.NewShell.Startup"
             mc:Ignorable="d"
             d:DesignHeight="860" d:DesignWidth="1600"
             Background="Black" Foreground="White"
             FontFamily="Segoe UI">
  <UserControl.Resources>
    <!-- Indeterminate spinner: a rotating arc shown while components load. -->
    <Storyboard x:Key="Spin" RepeatBehavior="Forever">
      <DoubleAnimation Storyboard.TargetName="SpinnerRotation"
                       Storyboard.TargetProperty="Angle"
                       From="0" To="360" Duration="0:0:1.1"/>
    </Storyboard>

    <DataTemplate x:Key="ComponentRow" DataType="{x:Type startup:LoadingComponentViewModel}">
      <Grid Margin="0,4">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="24"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Status glyph: check when done, x on failure, dot while pending/loading. -->
        <TextBlock Grid.Column="0" FontSize="14" VerticalAlignment="Center">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Text" Value="&#x2022;"/>
              <Setter Property="Foreground" Value="#666666"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsLoading}" Value="True">
                  <Setter Property="Text" Value="&#x2219;"/>
                  <Setter Property="Foreground" Value="#4FC3F7"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                  <Setter Property="Text" Value="&#x2713;"/>
                  <Setter Property="Foreground" Value="#66BB6A"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsFailed}" Value="True">
                  <Setter Property="Text" Value="&#x2717;"/>
                  <Setter Property="Foreground" Value="#EF5350"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>

        <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" FontSize="14">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Foreground" Value="#AAAAAA"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsLoading}" Value="True">
                  <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                  <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
      </Grid>
    </DataTemplate>
  </UserControl.Resources>

  <UserControl.Triggers>
    <EventTrigger RoutedEvent="Loaded">
      <BeginStoryboard Storyboard="{StaticResource Spin}"/>
    </EventTrigger>
  </UserControl.Triggers>

  <Grid>
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="360">
      <!-- Spinner -->
      <Grid Width="56" Height="56" HorizontalAlignment="Center" Margin="0,0,0,24">
        <Ellipse Width="56" Height="56" Stroke="#2A2A2A" StrokeThickness="4"/>
        <Path Stroke="#4FC3F7" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
              Data="M 28,2 A 26,26 0 0 1 54,28"
              RenderTransformOrigin="0.5,0.5">
          <Path.RenderTransform>
            <RotateTransform x:Name="SpinnerRotation" Angle="0"/>
          </Path.RenderTransform>
        </Path>
      </Grid>

      <TextBlock Text="Crystal" FontSize="28" FontWeight="Light"
                 HorizontalAlignment="Center" Margin="0,0,0,4"/>
      <TextBlock Text="{Binding Status}" FontSize="13" Foreground="#AAAAAA"
                 HorizontalAlignment="Center" Margin="0,0,0,20"/>

      <ProgressBar Height="4" Minimum="0" Maximum="100" Value="{Binding Percent, Mode=OneWay}"
                   Background="#1A1A1A" Foreground="#4FC3F7" BorderThickness="0"
                   Margin="0,0,0,24"/>

      <ItemsControl ItemsSource="{Binding Components}"
                    ItemTemplate="{StaticResource ComponentRow}"/>
    </StackPanel>
  </Grid>
</UserControl>
