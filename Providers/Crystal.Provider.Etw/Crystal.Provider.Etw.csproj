<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Crystal.Provider.Etw</RootNamespace>
    <AssemblyName>Crystal.Provider.Etw</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="3.1.16" />
    <PackageReference Include="System.Reactive" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Expose the pure DMA-event classifier (ClassifyDma/DmaKind) for direct unit testing. -->
    <InternalsVisibleTo Include="Crystal.Provider.Etw.Tests" />
  </ItemGroup>

</Project>
