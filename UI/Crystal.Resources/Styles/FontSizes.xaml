<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
  <!-- Font-size scale shared across views. Names describe the role, not the number, so a
       density change is one edit here. Values match the literals already in use. -->
  <sys:Double x:Key="MicroFontSize">10</sys:Double>
  <sys:Double x:Key="CaptionFontSize">11</sys:Double>
  <sys:Double x:Key="BodyFontSize">12</sys:Double>
  <sys:Double x:Key="SpecFontSize">13</sys:Double>
  <sys:Double x:Key="SubHeadingFontSize">14</sys:Double>
  <sys:Double x:Key="SectionFontSize">18</sys:Double>
  <sys:Double x:Key="ValueFontSize">22</sys:Double>
  <sys:Double x:Key="TitleFontSize">28</sys:Double>
  <sys:Double x:Key="HeroFontSize">30</sys:Double>
</ResourceDictionary>
