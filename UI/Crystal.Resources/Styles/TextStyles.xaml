<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Shared TextBlock styles used verbatim across module views. Brush values come from
       Palette.xaml, so restyling is a one-place change. Only styles that were byte-identical
       across every module are hoisted here; module-specific variants stay local. -->
  <!-- Palette must be merged into THIS dictionary's scope: StaticResource resolves within a
       dictionary and upward, never across sibling merged dictionaries, so the brush keys below
       are unreachable without this merge and would resolve to UnsetValue at layout time. -->
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/Crystal.Resources;component/Styles/Palette.xaml"/>
    <ResourceDictionary Source="/Crystal.Resources;component/Styles/FontSizes.xaml"/>
    <ResourceDictionary Source="/Crystal.Resources;component/Styles/Fonts.xaml"/>
  </ResourceDictionary.MergedDictionaries>

  <!-- Dashboard tile title line: an accent kind/slot caption beside the white product/brand name.
       Shared by the CPU header (Slot# / brand) and each GPU tile header (Integrated/Dedicated GPU /
       adapter name) so both read identically. -->
  <Style x:Key="TileTitleCaption" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
    <Setter Property="FontSize" Value="{StaticResource CaptionFontSize}"/>
    <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style x:Key="TileTitleBrand" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    <Setter Property="FontSize" Value="{StaticResource CaptionFontSize}"/>
    <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <!-- Metric readout beside a graph: big value, unit line, dim caption. -->
  <Style x:Key="MetricValue" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource ValueBrush}"/>
    <Setter Property="FontSize" Value="{StaticResource BigValueFontSize}"/>
    <Setter Property="FontFamily" Value="UiFontFamily"/>
  </Style>
  <Style x:Key="MetricUnit" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource UnitBrush}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="FontFamily" Value="Consolas"/>
		<Setter Property="VerticalAlignment" Value="Bottom"/>
		<Setter Property="Margin" Value="8,0,0,0"/>
  </Style>
  <!-- Graph subtitle: the metric label beside/above a history graph (Clock, Temperature,
       Utilization, Memory Used, ...). White, UI face, one step smaller than a title caption. -->
  <Style x:Key="MetricCaption" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    <Setter Property="FontSize" Value="{StaticResource MicroFontSize}"/>
    <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
    <Setter Property="VerticalAlignment" Value="Bottom"/>
  </Style>
  <!-- Compact value for a narrow dashboard tile header, where the title and value share one line:
       MetricValue at a smaller size so both fit without colliding. -->
  <Style x:Key="TileMetricValue" TargetType="TextBlock" BasedOn="{StaticResource MetricValue}">
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Margin" Value="0"/>
    <Setter Property="VerticalAlignment" Value="Bottom"/>
  </Style>

  <!-- Inline spec in a summary header row. -->
  <Style x:Key="HeaderSpec" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource LabelBrush}"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="FontFamily" Value="Consolas"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Margin" Value="0,0,12,0"/>
  </Style>

  <!-- Dim caption above a detail-view stat. -->
  <Style x:Key="StatCaption" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource LabelBrush}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Margin" Value="0,0,0,1"/>
  </Style>

  <!-- Detail-view stat cell: large light value below StatCaption. -->
  <Style x:Key="StatValue" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource ValueBrush}"/>
    <Setter Property="FontSize" Value="22"/>
    <Setter Property="FontWeight" Value="Light"/>
  </Style>

  <!-- Compact label:value spec row (right-hand identity column). -->
  <Style x:Key="SpecCaption" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource LabelBrush}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Margin" Value="0,3"/>
  </Style>
  <Style x:Key="SpecValue" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource SpecValueBrush}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Margin" Value="24,3,0,3"/>
  </Style>
</ResourceDictionary>
