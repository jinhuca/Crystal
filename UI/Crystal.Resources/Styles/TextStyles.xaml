<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Shared TextBlock styles used verbatim across module views. Brush values come from
       Palette.xaml, so restyling is a one-place change. Only styles that were byte-identical
       across every module are hoisted here; module-specific variants stay local. -->
  <!-- Palette must be merged into THIS dictionary's scope: StaticResource resolves within a
       dictionary and upward, never across sibling merged dictionaries, so the brush keys below
       are unreachable without this merge and would resolve to UnsetValue at layout time. -->
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/Crystal.Resources;component/Styles/Palette.xaml"/>
  </ResourceDictionary.MergedDictionaries>

  <!-- Metric readout beside a graph: big value, unit line, dim caption. -->
  <Style x:Key="MetricValue" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource ValueBrush}"/>
    <Setter Property="FontSize" Value="24"/>
    <Setter Property="FontFamily" Value="Consolas"/>
    <Setter Property="LineHeight" Value="26"/>
  </Style>
  <Style x:Key="MetricUnit" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource UnitBrush}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="FontFamily" Value="Consolas"/>
  </Style>
  <Style x:Key="MetricCaption" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource LabelBrush}"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="FontFamily" Value="Consolas"/>
  </Style>

  <!-- Inline spec in a summary header row. -->
  <Style x:Key="HeaderSpec" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource LabelBrush}"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="FontFamily" Value="Consolas"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Margin" Value="0,0,16,0"/>
  </Style>

  <!-- Dim caption above a detail-view stat. -->
  <Style x:Key="StatCaption" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource LabelBrush}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Margin" Value="0,0,0,1"/>
  </Style>
</ResourceDictionary>
