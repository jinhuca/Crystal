<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Single source for PerformanceGraph accent and chrome colors. Each accent has a base color,
       a flat solid brush (Bar/SegmentedBar fills, line strokes) and a vertical glow-gradient fill
       (Line kinds). Change a value here to restyle every graph sample style at once. -->

  <!-- Accent base colors -->
  <Color x:Key="GraphGreyColor">#FF8A94A0</Color>
  <Color x:Key="GraphRoseColor">#FFE82A7A</Color>
  <Color x:Key="GraphEmeraldColor">#FF3BD15A</Color>
  <Color x:Key="GraphSkyColor">#FF3E9BE8</Color>
  <Color x:Key="GraphAmberColor">#FFE89B2A</Color>
  <Color x:Key="GraphPurpleColor">#FF9B5AE8</Color>

  <!-- Flat solid accent brushes (line strokes; Bar / SegmentedBar segment fills) -->
  <SolidColorBrush x:Key="GraphGreyBrush" Color="{StaticResource GraphGreyColor}"/>
  <SolidColorBrush x:Key="GraphRoseBrush" Color="{StaticResource GraphRoseColor}"/>
  <SolidColorBrush x:Key="GraphEmeraldBrush" Color="{StaticResource GraphEmeraldColor}"/>
  <SolidColorBrush x:Key="GraphSkyBrush" Color="{StaticResource GraphSkyColor}"/>
  <SolidColorBrush x:Key="GraphAmberBrush" Color="{StaticResource GraphAmberColor}"/>
  <SolidColorBrush x:Key="GraphPurpleBrush" Color="{StaticResource GraphPurpleColor}"/>

  <!-- Vertical glow-gradient fills for Line kinds (opaque-ish top fading to translucent bottom) -->
  <LinearGradientBrush x:Key="GraphGreyFill" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#C08A94A0" Offset="0"/>
    <GradientStop Color="#508A94A0" Offset="1"/>
  </LinearGradientBrush>  
  <LinearGradientBrush x:Key="GraphRoseFill" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#C0E82A7A" Offset="0"/>
    <GradientStop Color="#50E82A7A" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="GraphEmeraldFill" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#C03BD15A" Offset="0"/>
    <GradientStop Color="#503BD15A" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="GraphSkyFill" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#C03E9BE8" Offset="0"/>
    <GradientStop Color="#503E9BE8" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="GraphAmberFill" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#C0E89B2A" Offset="0"/>
    <GradientStop Color="#50E89B2A" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="GraphPurpleFill" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#C09B5AE8" Offset="0"/>
    <GradientStop Color="#509B5AE8" Offset="1"/>
  </LinearGradientBrush>

  <!-- Chrome (grid lines, axis border, opaque plot background) -->
  <SolidColorBrush x:Key="GraphGridBrush" Color="#FF303030"/>
  <SolidColorBrush x:Key="GraphAxisBorderBrush" Color="#FF3E7BC4"/>
  <SolidColorBrush x:Key="GraphPlotBackgroundBrush" Color="#FF000000"/>
</ResourceDictionary>
