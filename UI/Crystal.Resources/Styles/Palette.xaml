<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<!-- Semantic palette shared by every module view. Change a value here to restyle the whole app.
       Names describe the role, not the color, so views read as intent. -->

	<!-- Text -->
	<SolidColorBrush x:Key="LabelBrush" Color="#8A94A0"/>
	<SolidColorBrush x:Key="ValueBrush" Color="#E6E6E6"/>
	<SolidColorBrush x:Key="UnitBrush" Color="#C0C0C0"/>
	<SolidColorBrush x:Key="TextBrush" Color="#FFFFFF"/>
	<SolidColorBrush x:Key="TextPrimaryBrush" Color="#DDDDDD"/>
	<SolidColorBrush x:Key="TextMutedBrush" Color="#C8C8C8"/>
	<SolidColorBrush x:Key="SpecValueBrush" Color="#C8D0D8"/>

	<!-- Accent / status -->
	<SolidColorBrush x:Key="AccentBrush" Color="#3E9BE8"/>
	<SolidColorBrush x:Key="AccentSelectionBrush" Color="#17324B"/>
	<SolidColorBrush x:Key="AccentHoverBrush" Color="#1C2530"/>
	<SolidColorBrush x:Key="OkBrush" Color="#3BD15A"/>
	<SolidColorBrush x:Key="WarningBrush" Color="#E8A33E"/>
	<SolidColorBrush x:Key="DangerBrush" Color="#C43C3C"/>

	<!-- Surfaces -->
	<SolidColorBrush x:Key="PanelBackgroundBrush" Color="#101317"/>
	<SolidColorBrush x:Key="SurfaceBackgroundBrush" Color="#161B22"/>

	<!-- Lines / borders -->
	<SolidColorBrush x:Key="DividerBrush" Color="#2A2A2A"/>
	<SolidColorBrush x:Key="BorderBrush" Color="#3A3A3A"/>

	<!-- Usage / capacity bars (used vs free of a total) -->
	<SolidColorBrush x:Key="UsageBarUsedBrush" Color="#2E7DD1"/>
	<SolidColorBrush x:Key="UsageBarFreeBrush" Color="#3A5068"/>
	<SolidColorBrush x:Key="UsageBarTrackBrush" Color="#12233A"/>
	<SolidColorBrush x:Key="UsageBarBorderBrush" Color="#2E4A6A"/>

	<!-- Clock sensor banded colors -->
	<SolidColorBrush x:Key="ClockAccentBandedBrush1" Color="#FFF5F5F5"/>
	<SolidColorBrush x:Key="ClockAccentBandedBrush2" Color="#FFE8F4E8"/>
	<SolidColorBrush x:Key="ClockAccentBandedBrush3" Color="#FFDCF3DC"/>
	<SolidColorBrush x:Key="ClockAccentBandedBrush4" Color="#FFCFF2CF"/>
	<SolidColorBrush x:Key="ClockAccentBandedBrush5" Color="#FFC2F2C2"/>
	<SolidColorBrush x:Key="ClockAccentBandedBrush6" Color="#FFB6F1B6"/>
	<SolidColorBrush x:Key="ClockAccentBandedBrush7" Color="#FFA9F0A9"/>
	<SolidColorBrush x:Key="ClockAccentBandedBrush8" Color="#FF9DEF9D"/>
	<SolidColorBrush x:Key="ClockAccentBandedBrush9" Color="#FF90EE90"/>

	<!-- Voltage sensor banded colors -->
	<SolidColorBrush x:Key="VoltageAccentBandedBrush1" Color="#FFF5F5F5"/>
	<SolidColorBrush x:Key="VoltageAccentBandedBrush2" Color="#FFDDDDEA"/>
	<SolidColorBrush x:Key="VoltageAccentBandedBrush3" Color="#FFC4C5DE"/>
	<SolidColorBrush x:Key="VoltageAccentBandedBrush4" Color="#FFACADD3"/>
	<SolidColorBrush x:Key="VoltageAccentBandedBrush5" Color="#FF9494C8"/>
	<SolidColorBrush x:Key="VoltageAccentBandedBrush6" Color="#FF7C7CBC"/>
	<SolidColorBrush x:Key="VoltageAccentBandedBrush7" Color="#FF6464B1"/>
	<SolidColorBrush x:Key="VoltageAccentBandedBrush8" Color="#FF4B4CA5"/>
	<SolidColorBrush x:Key="VoltageAccentBandedBrush9" Color="#FF33349A"/>

	<!-- Temperature sensor banded brushes -->
	<SolidColorBrush x:Key="TemperatureAccentBandedBrush1" Color="#FFF5F5F5"/>
	<SolidColorBrush x:Key="TemperatureAccentBandedBrush2" Color="#FFF6DDD9"/>
	<SolidColorBrush x:Key="TemperatureAccentBandedBrush3" Color="#FFF8C4BE"/>
	<SolidColorBrush x:Key="TemperatureAccentBandedBrush4" Color="#FFF9ACA2"/>
	<SolidColorBrush x:Key="TemperatureAccentBandedBrush5" Color="#FFFA9486"/>
	<SolidColorBrush x:Key="TemperatureAccentBandedBrush6" Color="#FFFB7B6A"/>
	<SolidColorBrush x:Key="TemperatureAccentBandedBrush7" Color="#FFFC634E"/>
	<SolidColorBrush x:Key="TemperatureAccentBandedBrush8" Color="#FFFE4A33"/>
	<SolidColorBrush x:Key="TemperatureAccentBandedBrush9" Color="#FFFF3217"/>

	<!-- Power sensor banded brushes -->
	<SolidColorBrush x:Key="PowerAccentBandedBrush1" Color="#FFF5F5F5"/>
	<SolidColorBrush x:Key="PowerAccentBandedBrush2" Color="#FFF4EAE2"/>
	<SolidColorBrush x:Key="PowerAccentBandedBrush3" Color="#FFF4DECE"/>
	<SolidColorBrush x:Key="PowerAccentBandedBrush4" Color="#FFF3D3BA"/>
	<SolidColorBrush x:Key="PowerAccentBandedBrush5" Color="#FFF2C8A7"/>
	<SolidColorBrush x:Key="PowerAccentBandedBrush6" Color="#FFF2BD94"/>
	<SolidColorBrush x:Key="PowerAccentBandedBrush7" Color="#FFF1B280"/>
	<SolidColorBrush x:Key="PowerAccentBandedBrush8" Color="#FFF1A66C"/>
	<SolidColorBrush x:Key="PowerAccentBandedBrush9" Color="#FFF09B59"/>

	<!-- Cpu sensor colors -->
	<Color x:Key="CpuPowerAccentBandedColor1">#FF90EE90</Color>
	<Color x:Key="CpuPowerAccentBandedColor9">#FFFF4556</Color>

	<Color x:Key="CpuTemperatureAccentBandedColor1">#FF90EE90</Color>
	<Color x:Key="CpuTemperatureAccentBandedColor9">#FFFF4556</Color>

	<Color x:Key="CpuClockAccentBandedColor1">#FF90EE90</Color>
	<Color x:Key="CpuClockAccentBandedColor9">#FFFF4556</Color>

	<Color x:Key="CpuVoltAccentBandedColor1">#FF90EE90</Color>
	<Color x:Key="CpuVoltAccentBandedColor9">#FFFF4556</Color>

	<Color x:Key="CpuFanAccentBandedColor1">#FF90EE90</Color>
	<Color x:Key="CpuFanAccentBandedColor9">#FFFF4556</Color>

	<!-- Gpu sensor colors -->
	<Color x:Key="GpuPowerBandedColor1">#FF2E7DD1</Color>
	<Color x:Key="GpuPowerBandedColor9">#FFFF2D2D</Color>

	<Color x:Key="GpuTemperatureBandedColor1">#FF2E7DD1</Color>
	<Color x:Key="GpuTemperatureBandedColor9">#FFFF2D2D</Color>

	<Color x:Key="GpuHotspotBandedColor1">#FF2E7DD1</Color>
	<Color x:Key="GpuHotspotBandedColor9">#FFFF2D2D</Color>

	<Color x:Key="GpuMemoryBandedColor1">#FF2E7DD1</Color>
	<Color x:Key="GpuMemoryBandedColor9">#FFFF2D2D</Color>

	<Color x:Key="GpuClockBandedColor1">#FF2E7DD1</Color>
	<Color x:Key="GpuClockBandedColor9">#FFFF2D2D</Color>

	<Color x:Key="Gpu3DBandedColor1">#FF2E7DD1</Color>
	<Color x:Key="Gpu3DBandedColor9">#FFFF2D2D</Color>

	<Color x:Key="GpuPCIeRxBandedColor1">#FF2E7DD1</Color>
	<Color x:Key="GpuPCIeRxBandedColor9">#FFFF2D2D</Color>

	<Color x:Key="GpuPCIeTxBandedColor1">#FF2E7DD1</Color>
	<Color x:Key="GpuPCIeTxBandedColor9">#FFFF2D2D</Color>

	<Color x:Key="GpuFanBandedColor1">#FF2E7DD1</Color>
	<Color x:Key="GpuFanBandedColor9">#FFFF2D2D</Color>

	<Color x:Key="GpuVoltBandedColor1">#FF2E7DD1</Color>
	<Color x:Key="GpuVoltBandedColor9">#FFFF2D2D</Color>

	<Color x:Key="GpuUtilizationBandedColor1">#FF2E7DD1</Color>
	<Color x:Key="GpuUtilizationBandedColor9">#FFFF2D2D</Color>
</ResourceDictionary>
