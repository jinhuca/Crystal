<Window x:Class="ControlDemos.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:borders="clr-namespace:Crystal.Controls.Borders;assembly=Crystal.Controls"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ControlDemos"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800" Background="#201D1B">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Grid Grid.Row="0" Margin="0,0,0,14">
      <TextBlock Text="Inner shadow border" FontSize="16" FontWeight="SemiBold"
                 Foreground="#E8E9EC" VerticalAlignment="Center"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
        <TextBlock x:Name="TierText" Foreground="#8A8C90" FontFamily="Consolas" FontSize="12"
                   VerticalAlignment="Center" Margin="0,0,16,0"/>
				<Border Background="#201D1B" BorderBrush="#3A3D44" BorderThickness="1" CornerRadius="4"
                Padding="10,3">
          <TextBlock x:Name="FpsText" Text="-- FPS" Foreground="#7FD08A" FontFamily="Consolas"
                     FontSize="13" FontWeight="SemiBold"/>
        </Border>
      </StackPanel>
    </Grid>

		<borders:InnerShadowBorder 
      x:Name="Shadow"
      Style="{StaticResource InnerShadowBorderStyle}"
      Grid.Row="1">

			<Border Width="300" Height="150" Margin="28"
              HorizontalAlignment="Left" VerticalAlignment="Center"
              CornerRadius="1" Background="#26241F" BorderBrush="#34322C" BorderThickness="1">
        <Border.Effect>
          <DropShadowEffect Color="#000000" BlurRadius="18" ShadowDepth="5" Direction="315" Opacity="0.6"/>
        </Border.Effect>
        <TextBlock Text="Content" Foreground="#8A8C90" FontSize="12"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
    </borders:InnerShadowBorder>

    <Grid Grid.Row="2" Margin="0,16,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="220"/>
        <ColumnDefinition Width="40"/>
        <ColumnDefinition Width="60"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="220"/>
        <ColumnDefinition Width="40"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>

      <TextBlock Grid.Column="0" Text="Shadow spread" VerticalAlignment="Center" Margin="0,0,10,0"
                 Foreground="White"/>
      <Slider Grid.Column="1" x:Name="SpreadSlider" Minimum="0" Maximum="30" Value="10"
          VerticalAlignment="Center" TickFrequency="1" IsSnapToTickEnabled="True"/>
      <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=SpreadSlider, StringFormat={}{0:0}}"
             VerticalAlignment="Center" Margin="8,0,0,0" Foreground="White"/>

      <TextBlock Grid.Column="4" Text="Blur" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="White"/>
      <Slider Grid.Column="5" x:Name="BlurSlider" Minimum="0" Maximum="40" Value="18"
          VerticalAlignment="Center" TickFrequency="1" IsSnapToTickEnabled="True"/>
      <TextBlock Grid.Column="6" Text="{Binding Value, ElementName=BlurSlider, StringFormat={}{0:0}}"
             VerticalAlignment="Center" Margin="8,0,0,0" Foreground="White"/>

      <CheckBox Grid.Column="8" x:Name="StressToggle" Content="Stress (animate blur)"
            Foreground="#C8CAD0" VerticalAlignment="Center"
            Checked="StressToggle_Checked" Unchecked="StressToggle_Unchecked"/>
    </Grid>
  </Grid>
</Window>
