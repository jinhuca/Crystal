<Window x:Class="RangeBarDemo.TemperatureTileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RangeBarDemo"
        xmlns:bars="clr-namespace:Crystal.Controls.RangeBars;assembly=Crystal.Controls"
        xmlns:graphs="clr-namespace:Crystal.Controls.PerformanceGraphs;assembly=Crystal.Controls"
        mc:Ignorable="d"
        Title="Temperature Tile — pattern applied" Height="320" Width="900"
        Background="#111114" FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="Ink"       Color="#F2F2F5"/>
        <SolidColorBrush x:Key="InkSecond" Color="#B9BEC7"/>
        <SolidColorBrush x:Key="InkMuted"  Color="#6E7480"/>
        <SolidColorBrush x:Key="Accent"    Color="#3E9BE8"/>
        <SolidColorBrush x:Key="Panel"     Color="#16161A"/>

        <Style x:Key="Col" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource InkSecond}"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="28">
        <TextBlock Text="TEMPERATURE" Foreground="{StaticResource InkMuted}" FontWeight="Bold"
                   FontSize="11" Margin="2,0,0,6"/>
        <Border Background="{StaticResource Panel}" CornerRadius="8" Padding="18,14"
                BorderBrush="#26262C" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT: header, hero, sparkline, meter -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Width="400">
                    <TextBlock Text="Temperature" Foreground="{StaticResource Accent}" FontWeight="Bold" FontSize="16"/>

                    <!-- Hero: number dominates; unit muted; trend + avg as quiet context -->
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="48.3" Foreground="{StaticResource Ink}" FontSize="44" FontWeight="SemiBold"/>
                        <TextBlock Text="&#x00B0;C" Foreground="{StaticResource InkMuted}" FontSize="18" VerticalAlignment="Bottom" Margin="8,0,10,10"/>
                        <TextBlock Text="&#x25B2;" Foreground="{StaticResource InkMuted}" FontSize="13" VerticalAlignment="Bottom" Margin="0,0,10,14"/>
                        <TextBlock Text="avg 52.1 &#x00B0;C" Foreground="{StaticResource InkMuted}" FontSize="12" VerticalAlignment="Bottom" Margin="0,0,0,15"/>
                    </StackPanel>

                    <!-- Sparkline: identity blue, single color -->
                    <graphs:PerformanceGraphLite x:Name="Spark" Height="26" Width="400"
                                                 HorizontalAlignment="Left" Margin="0,2,0,10"
                                                 Rows="6" Capacity="48"
                                                 MinValue="0" MaxValue="90"
                                                 ColorMode="SingleColor" DotColor="#3E9BE8" CornerRadius="1"/>

                    <!-- Meter: 0..Tjmax scale, accent-gradient fill. peak and the Tjmax throttle
                         limit are first-class RangeBar markers. A single limit needs no LabelLine
                         stacking — the pattern scales down to one marker just as cleanly. -->
                    <bars:RangeBar x:Name="TempMeter" Height="40" Width="360" HorizontalAlignment="Left"
                                   MinValue="0" MaxValue="100" Value="48.3"
                                   AccentColor="#3E9BE8"
                                   LowestAlpha="120" HighestAlpha="255"
                                   BarBackground="Transparent"
                                   TrackBrush="#21303D"
                                   BorderThickness="0"
                                   LabelHeight="18">
                        <bars:RangeBar.Markers>
                            <bars:RangeBarMarker Value="35.4" Brush="#6E7480" Label="min 35"   LabelBrush="#6E7480"/>
                            <bars:RangeBarMarker Value="78.2" Brush="#6E7480" Label="peak 78"  LabelBrush="#6E7480"/>
                            <bars:RangeBarMarker Value="100"  Brush="#E8564E" Label="Tjmax 100" LabelBrush="#E8564E"/>
                        </bars:RangeBar.Markers>
                    </bars:RangeBar>
                </StackPanel>

                <!-- RIGHT: per-sensor Value/Min/Max -->
                <Grid Grid.Column="2" VerticalAlignment="Center" TextOptions.TextFormattingMode="Ideal">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="72"/>
                        <ColumnDefinition Width="72"/>
                        <ColumnDefinition Width="72"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="Value" Style="{StaticResource Col}" Foreground="{StaticResource InkMuted}"/>
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Min"   Style="{StaticResource Col}" Foreground="{StaticResource InkMuted}"/>
                    <TextBlock Grid.Row="0" Grid.Column="3" Text="Max"   Style="{StaticResource Col}" Foreground="{StaticResource InkMuted}"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Package" Foreground="{StaticResource InkSecond}" Margin="0,0,20,0" FontSize="13"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="48.3" Style="{StaticResource Col}" Foreground="{StaticResource Ink}"/>
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="35.4" Style="{StaticResource Col}" Foreground="{StaticResource InkMuted}"/>
                    <TextBlock Grid.Row="1" Grid.Column="3" Text="78.2" Style="{StaticResource Col}"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Core Max" Foreground="{StaticResource InkSecond}" FontSize="13"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="52.0" Style="{StaticResource Col}" Foreground="{StaticResource Ink}"/>
                    <TextBlock Grid.Row="2" Grid.Column="2" Text="37.1" Style="{StaticResource Col}" Foreground="{StaticResource InkMuted}"/>
                    <TextBlock Grid.Row="2" Grid.Column="3" Text="81.0" Style="{StaticResource Col}"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Core Avg" Foreground="{StaticResource InkSecond}" FontSize="13"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="45.6" Style="{StaticResource Col}" Foreground="{StaticResource Ink}"/>
                    <TextBlock Grid.Row="3" Grid.Column="2" Text="33.8" Style="{StaticResource Col}" Foreground="{StaticResource InkMuted}"/>
                    <TextBlock Grid.Row="3" Grid.Column="3" Text="71.4" Style="{StaticResource Col}"/>
                </Grid>
            </Grid>
        </Border>
    </StackPanel>
</Window>
