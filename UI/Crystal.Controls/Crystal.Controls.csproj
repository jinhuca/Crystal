<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Crystal.Controls</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Expose internal visibility-gate members (RenderSuspended/HasPendingRender/ApplyVisibility)
         to the test project so the off-screen render suspension can be tested deterministically. -->
    <InternalsVisibleTo Include="Crystal.Controls.Tests" />
  </ItemGroup>

</Project>
