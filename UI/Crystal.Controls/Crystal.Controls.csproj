<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Crystal.Controls</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Expose internal visibility-gate members (RenderSuspended/HasPendingRender/ApplyVisibility)
         to the test project so the off-screen render suspension can be tested deterministically. -->
    <InternalsVisibleTo Include="Crystal.Controls.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shared palette: control themes (scrollbar, loading host) pull their brushes from the
         solution-wide palette instead of inlining hex, so a color change is one edit. -->
    <ProjectReference Include="..\Crystal.Resources\Crystal.Resources.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Comet\" />
  </ItemGroup>

</Project>
