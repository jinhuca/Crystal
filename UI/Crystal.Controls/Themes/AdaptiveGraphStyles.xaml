<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:graphs="clr-namespace:Crystal.Controls.PerformanceGraphs"
                    xmlns:converters="clr-namespace:Crystal.Controls.Converters">
  <converters:GraphRenderModeToDisplayModeConverter x:Key="GraphRenderModeToDisplayModeConverter"/>
  <converters:GraphRenderModeToChromeConverter x:Key="GraphRenderModeToChromeConverter"/>

  <!--
    The dashboard summary graph. Replaces the former AdaptiveGraph: its DisplayMode is bound to the
    global GraphAppearance.Current.Mode (the shell's title-bar Line/Dot toggle) through the converter
    above, so flipping the toggle re-renders every tile's graph in place. Chrome (opaque plot
    background, grid, axis border) shows in Line mode, matching the old ShowChrome="True"; in Dot mode
    the grid and border are hidden so the scatter reads clean (Grid/Border bind to the same global
    mode through GraphRenderModeToChromeConverter). The brush / thickness values reproduce what
    AdaptiveGraph applied via GraphThemes.FromAccent, so an accent-driven tile reads identically after
    migration. Accent itself now also drives the line, dot, and a vertical glow fill on the control,
    so tiles need only set Accent (+ any band colors).
  -->
  <Style x:Key="AdaptiveGraphStyle" TargetType="graphs:PerformanceGraph">
    <Setter Property="BandedLine" Value="False"/>
    <Setter Property="MinHeight" Value="40"/>
    <Setter Property="LineThickness" Value="1.0"/>
    <Setter Property="GraphBackground" Value="#FF000000"/>
    <Setter Property="GridBrush" Value="#FF303030"/>
    <Setter Property="GridThickness" Value="0.6"/>
    <Setter Property="BorderBrush" Value="#FF3E7BC4"/>
    <Setter Property="BorderThickness" Value="0.8"/>
    <Setter Property="DisplayMode">
      <Setter.Value>
        <Binding Source="{x:Static graphs:GraphAppearance.Current}" Path="Mode"
                 Converter="{StaticResource GraphRenderModeToDisplayModeConverter}"/>
      </Setter.Value>
    </Setter>
    <Setter Property="Grid">
      <Setter.Value>
        <Binding Source="{x:Static graphs:GraphAppearance.Current}" Path="Mode"
                 Converter="{StaticResource GraphRenderModeToChromeConverter}"/>
      </Setter.Value>
    </Setter>
    <Setter Property="Border">
      <Setter.Value>
        <Binding Source="{x:Static graphs:GraphAppearance.Current}" Path="Mode"
                 Converter="{StaticResource GraphRenderModeToChromeConverter}"/>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
    ShowChrome="False" counterpart: same global-mode DisplayMode binding, but no plot background,
    grid, or border - just the plotted data. Used by tiles that embed the graph in their own frame
    (e.g. the CPU clock strip).
  -->
  <Style x:Key="AdaptiveGraphNoChromeStyle" TargetType="graphs:PerformanceGraph"
         BasedOn="{StaticResource AdaptiveGraphStyle}">
    <Setter Property="GraphBackground" Value="Transparent"/>
    <Setter Property="Grid" Value="False"/>
    <Setter Property="Border" Value="False"/>
  </Style>
</ResourceDictionary>
