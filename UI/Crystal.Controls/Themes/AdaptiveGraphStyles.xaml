<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:graphs="clr-namespace:Crystal.Controls.PerformanceGraphs">
  <Style x:Key="AdaptiveGraphStyle" TargetType="graphs:AdaptiveGraph">
    <Setter Property="BandedLine" Value="False"/>
    <Setter Property="ShowChrome" Value="True"/>
    <Setter Property="MinHeight" Value="40"/>
  </Style>
</ResourceDictionary>