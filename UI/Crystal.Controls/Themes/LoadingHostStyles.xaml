<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:loading="clr-namespace:Crystal.Controls.Loading">
  <!-- Palette merged into this dictionary's own scope so the StaticResource brush keys resolve
       (a sibling merged dictionary is never searched). -->
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/Crystal.Controls;component/Styles/Palette.xaml"/>
  </ResourceDictionary.MergedDictionaries>

  <!-- Indeterminate spinner: a rotating arc shown while a tile warms. -->
  <Style TargetType="{x:Type loading:LoadingHost}">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="VerticalContentAlignment" Value="Stretch"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type loading:LoadingHost}">
          <Grid Background="{TemplateBinding Background}">
            <!-- Live content, shown once ready. -->
            <ContentPresenter x:Name="PART_Content" Visibility="Collapsed"/>

            <!-- Spinner + label, shown while loading. -->
            <StackPanel x:Name="PART_Loading" Orientation="Horizontal"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
              <Grid Width="28" Height="28" Margin="0,0,10,0">
                <Ellipse Width="28" Height="28" Stroke="{StaticResource DividerBrush}" StrokeThickness="3"/>
                <Path Stroke="#4FC3F7" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Data="M 14,1.5 A 12.5,12.5 0 0 1 26.5,14" RenderTransformOrigin="0.5,0.5">
                  <Path.RenderTransform>
                    <RotateTransform x:Name="SpinnerRotation" Angle="0"/>
                  </Path.RenderTransform>
                  <Path.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                      <BeginStoryboard>
                        <Storyboard RepeatBehavior="Forever">
                          <DoubleAnimation Storyboard.TargetName="SpinnerRotation"
                                           Storyboard.TargetProperty="Angle"
                                           From="0" To="360" Duration="0:0:1.1"/>
                        </Storyboard>
                      </BeginStoryboard>
                    </EventTrigger>
                  </Path.Triggers>
                </Path>
              </Grid>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{TemplateBinding Label}" Foreground="{StaticResource ValueBrush}"
                           FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold"/>
                <TextBlock Text="Loading..." Foreground="{StaticResource LabelBrush}"
                           FontFamily="Segoe UI" FontSize="11"/>
              </StackPanel>
            </StackPanel>

            <!-- Failure marker, shown when warming threw. -->
            <StackPanel x:Name="PART_Failed" Orientation="Horizontal" Visibility="Collapsed"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
              <TextBlock Text="&#x2717;" Foreground="#EF5350" FontSize="16"
                         VerticalAlignment="Center" Margin="0,0,10,0"/>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{TemplateBinding Label}" Foreground="{StaticResource ValueBrush}"
                           FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold"/>
                <TextBlock Text="Unavailable" Foreground="{StaticResource LabelBrush}"
                           FontFamily="Segoe UI" FontSize="11"/>
              </StackPanel>
            </StackPanel>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="State" Value="Ready">
              <Setter TargetName="PART_Content" Property="Visibility" Value="Visible"/>
              <Setter TargetName="PART_Loading" Property="Visibility" Value="Collapsed"/>
            </Trigger>
            <Trigger Property="State" Value="Failed">
              <Setter TargetName="PART_Loading" Property="Visibility" Value="Collapsed"/>
              <Setter TargetName="PART_Failed" Property="Visibility" Value="Visible"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
