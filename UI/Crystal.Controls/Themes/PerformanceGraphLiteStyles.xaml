<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:graphs="clr-namespace:Crystal.Controls.PerformanceGraphs"
    xmlns:converters="clr-namespace:Crystal.Controls.Converters">

  <!--
    This file lives in the SAME assembly as PerformanceGraphLite and CapacityToRatioConverter, so the
    xmlns above deliberately omit ";assembly=Crystal.Controls" - including it mid-compile triggers
    MC3066 (the markup compiler tries to load the assembly currently being built). It's merged into
    app scope via this assembly's Themes/Generic.xaml, so the keyed style below resolves through
    StaticResource from any view in any module that references Crystal.Controls.
  -->

  <converters:CapacityToRatioConverter x:Key="CapacityToRatioConverter"/>
  <converters:SquareDotWidthConverter x:Key="SquareDotWidthConverter"/>

  <!--
    Keyed, opt-in: the PerformanceGraphLite counterpart of PerformanceGraph's
    SquareGridPerformanceGraphStyle. Derives Height from ActualWidth/Capacity/Rows via
    CapacityToRatioConverter (the control's own SquareDotAspectRatio math) so every plotted dot
    renders square as its container resizes, and stretches horizontally so there's a real
    ActualWidth to square against. Value range (MinValue/MaxValue), MinHeight floor, and any Flip
    are left to each consuming tile, exactly as the sibling PerformanceGraph tiles set them.
  -->
  <Style x:Key="SquareDotGraphLiteStyle" TargetType="{x:Type graphs:PerformanceGraphLite}">
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="CornerRadius" Value="1"/>
    <Setter Property="Height">
      <Setter.Value>
        <MultiBinding Converter="{StaticResource CapacityToRatioConverter}">
          <Binding Path="ActualWidth" RelativeSource="{RelativeSource Self}"/>
          <Binding Path="Capacity" RelativeSource="{RelativeSource Self}"/>
          <Binding Path="Rows" RelativeSource="{RelativeSource Self}"/>
        </MultiBinding>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
    Shared dot-cell size for the CPU/GPU utilization graphs. One tunable number: every graph that
    uses UtilizationGraphLiteStyle pins this Height and derives its Width from it, so all of them
    end up with the identical row/column pitch (hence identical dot cells) regardless of their
    Capacity. A 120-sample graph therefore renders exactly twice as wide as a 60-sample one. Bump
    this single value to scale all utilization graphs together.
  -->
  <sys:Double x:Key="UtilizationGraphHeight">56</sys:Double>

  <!--
    Shared dot pitch for the dashboard summary graphs. Bound to each tile's AdaptiveGraph.CellPitch
    (the stretch-to-fill fixed-pitch dot mode), so every dashboard dot graph renders its dots at
    this one pixel size regardless of the tile's width, height, or Capacity - unlike the
    width/Capacity-derived sizing, where a wider tile or lower Capacity produced visibly larger
    dots. Bump this single value to scale every dashboard graph's dots together.
  -->
  <sys:Double x:Key="DashboardDotPitch">10</sys:Double>

  <!--
    Fixed-cell counterpart of SquareDotGraphLiteStyle: instead of stretching to fill and deriving
    Height from the (container-dependent) Width, it pins a fixed Height and derives Width, so dot
    cells come out the same size across graphs of different Capacity - see SquareDotWidthConverter.
    Horizontal/vertical alignment and margins are left to each consuming tile.
  -->
  <Style x:Key="UtilizationGraphLiteStyle" TargetType="{x:Type graphs:PerformanceGraphLite}">
    <Setter Property="CornerRadius" Value="1"/>
    <Setter Property="Height" Value="{StaticResource UtilizationGraphHeight}"/>
    <Setter Property="Width">
      <Setter.Value>
        <MultiBinding Converter="{StaticResource SquareDotWidthConverter}">
          <Binding Path="Height" RelativeSource="{RelativeSource Self}"/>
          <Binding Path="Capacity" RelativeSource="{RelativeSource Self}"/>
          <Binding Path="Rows" RelativeSource="{RelativeSource Self}"/>
        </MultiBinding>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
