<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.MergedDictionaries>
    <!-- Merging Generic.xaml into app scope via the Shell's App.xaml makes every keyed style resolve through StaticResource, 
		     and lets the XAML tooling discover them from any project that references Crystal.Controls. -->
    <ResourceDictionary Source="/Crystal.Controls;component/Themes/PerformanceGraphStyles.xaml"/>
    <ResourceDictionary Source="/Crystal.Controls;component/Themes/RangeBarStyles.xaml"/>
    <ResourceDictionary Source="/Crystal.Controls;component/RangeBars/Styles/SummaryRangeBarStyle.xaml"/>
    <ResourceDictionary Source="/Crystal.Controls;component/Themes/ScrollBarStyles.xaml"/>
    <ResourceDictionary Source="/Crystal.Controls;component/Themes/LoadingHostStyles.xaml"/>
    <ResourceDictionary Source="/Crystal.Controls;component/Themes/InnerShadowBorderStyles.xaml"/>
  </ResourceDictionary.MergedDictionaries>
</ResourceDictionary>
