<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:controls="clr-namespace:Crystal.Controls.PerformanceGraphs.Controls"
                    xmlns:graphs="clr-namespace:Crystal.Controls.PerformanceGraphs"
                    xmlns:converters="clr-namespace:Crystal.Controls.Converters">

  <!--
    All PerformanceGraph styling, consolidated (formerly split across PerformanceGraphStyles,
    AdaptiveGraphStyles, PerformanceGraphLiteStyles and PerformanceGraphSampleStyles). Merged into
    app scope via this assembly's Themes/Generic.xaml, so every keyed style resolves through
    StaticResource from any view in any module that references Crystal.Controls.

    The graphs:/converters:/controls: xmlns deliberately omit ";assembly=Crystal.Controls": these
    types live in the assembly being compiled, and naming it mid-compile triggers MC3066.

    GraphPalette.xaml is merged below (not merely app-wide) because a StaticResource inside this
    dictionary resolves against this dictionary's own merged scope, not sibling dictionaries merged
    elsewhere in App.xaml. It supplies the Graph* accent brushes the sample line styles use. The
    per-sensor banded ramps (ClockAccentBandedBrush* etc.) come from Crystal.Resources' Palette.xaml
    at app scope instead, exactly as before.
  -->
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/Crystal.Controls;component/Styles/GraphPalette.xaml"/>
  </ResourceDictionary.MergedDictionaries>

  <!-- ===== Converters ===== -->
  <controls:GraphValueFormatConverter x:Key="ValueFormatConverter"/>
  <converters:CapacityToRatioConverter x:Key="CapacityToRatioConverter"/>
  <converters:SquareDotWidthConverter x:Key="SquareDotWidthConverter"/>
  <converters:GraphRenderModeToDisplayModeConverter x:Key="GraphRenderModeToDisplayModeConverter"/>
  <converters:GraphRenderModeToChromeConverter x:Key="GraphRenderModeToChromeConverter"/>

  <!--
    Shared dot-cell size for the CPU/GPU utilization graphs. One tunable number: every graph that
    uses UtilizationGraphLiteStyle pins this Height and derives its Width from it, so all of them
    end up with the identical row/column pitch (hence identical dot cells) regardless of their
    Capacity. A 120-sample graph therefore renders exactly twice as wide as a 60-sample one.
  -->
  <sys:Double x:Key="UtilizationGraphHeight">56</sys:Double>

  <!--
    Shared dot pitch for the dashboard summary graphs. Bound to each tile's CellPitch (the
    stretch-to-fill fixed-pitch dot mode), so every dashboard dot graph renders its dots at this one
    pixel size regardless of the tile's width, height, or Capacity. Bump this single value to scale
    every dashboard graph's dots together.
  -->
  <sys:Double x:Key="DashboardDotPitch">10</sys:Double>

  <!-- ============================================================================================
       PerformanceGraphView: the titled chrome wrapper (header title + max value, footer time axis)
       hosting a PerformanceGraph. The default (implicit) style provides its control template.
       ============================================================================================ -->
  <Style TargetType="{x:Type controls:PerformanceGraphView}">
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type controls:PerformanceGraphView}">
          <Grid Background="{TemplateBinding Background}">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header: Title (left) + MaxValue (right) -->
            <Grid Grid.Row="0" Margin="0,0,0,4">
              <TextBlock Text="{TemplateBinding Title}"
                         Foreground="{TemplateBinding Foreground}"
                         HorizontalAlignment="Left"/>
              <TextBlock Foreground="{TemplateBinding Foreground}"
                         HorizontalAlignment="Right">
                <TextBlock.Text>
                  <MultiBinding Converter="{StaticResource ValueFormatConverter}">
                    <Binding Path="MaxValue" RelativeSource="{RelativeSource TemplatedParent}"/>
                    <Binding Path="MaxValueFormat" RelativeSource="{RelativeSource TemplatedParent}"/>
                  </MultiBinding>
                </TextBlock.Text>
              </TextBlock>
            </Grid>

            <!-- Graph -->
            <graphs:PerformanceGraph x:Name="PART_Graph" Grid.Row="1"/>

            <!-- Footer: MaxTime (left) + MinTime (right) -->
            <Grid Grid.Row="2" Margin="0,4,0,0">
              <TextBlock Foreground="{TemplateBinding Foreground}"
                         HorizontalAlignment="Left">
                <TextBlock.Text>
                  <MultiBinding Converter="{StaticResource ValueFormatConverter}">
                    <Binding Path="MaxTime" RelativeSource="{RelativeSource TemplatedParent}"/>
                    <Binding Path="MaxTimeFormat" RelativeSource="{RelativeSource TemplatedParent}"/>
                  </MultiBinding>
                </TextBlock.Text>
              </TextBlock>
              <TextBlock Foreground="{TemplateBinding Foreground}"
                         HorizontalAlignment="Right">
                <TextBlock.Text>
                  <MultiBinding Converter="{StaticResource ValueFormatConverter}">
                    <Binding Path="MinTime" RelativeSource="{RelativeSource TemplatedParent}"/>
                    <Binding Path="MinTimeFormat" RelativeSource="{RelativeSource TemplatedParent}"/>
                  </MultiBinding>
                </TextBlock.Text>
              </TextBlock>
            </Grid>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="{x:Type controls:PerformanceGraphView}" x:Key="UtilizationGraphStyle">

  </Style>

  <!-- ============================================================================================
       Dashboard summary graph. DisplayMode is bound to the global
       GraphAppearance.Current.Mode (the shell's title-bar Line/Dot toggle) through the converter, so
       flipping the toggle re-renders every tile's graph in place. Chrome (opaque plot background,
       grid, axis border) shows in Line mode; in Dot mode the grid and border are hidden so the
       scatter reads clean (Grid/Border bind to the same global mode through the chrome converter).
       The brush / thickness values reproduce what applied via GraphThemes.FromAccent,
       so an accent-driven tile reads identically after migration. Accent itself now also drives the
       line, dot, and a vertical glow fill on the control, so tiles need only set Accent (+ any band
       colors).
       ============================================================================================ -->
  <Style x:Key="SummaryTileGraphStyle" TargetType="graphs:PerformanceGraph">
    <Setter Property="BandedLine" Value="False"/>
    <Setter Property="MinHeight" Value="40"/>
    <Setter Property="LineThickness" Value="1.0"/>
    <Setter Property="GraphBackground" Value="#FF000000"/>
    <Setter Property="GridBrush" Value="#FF303030"/>
    <Setter Property="GridThickness" Value="0.6"/>
    <Setter Property="BorderBrush" Value="#FF3E7BC4"/>
    <Setter Property="BorderThickness" Value="0.8"/>
    <Setter Property="DisplayMode">
      <Setter.Value>
        <Binding Source="{x:Static graphs:GraphAppearance.Current}" Path="Mode"
                 Converter="{StaticResource GraphRenderModeToDisplayModeConverter}"/>
      </Setter.Value>
    </Setter>
    <Setter Property="Grid">
      <Setter.Value>
        <Binding Source="{x:Static graphs:GraphAppearance.Current}" Path="Mode"
                 Converter="{StaticResource GraphRenderModeToChromeConverter}"/>
      </Setter.Value>
    </Setter>
    <Setter Property="Border">
      <Setter.Value>
        <Binding Source="{x:Static graphs:GraphAppearance.Current}" Path="Mode"
                 Converter="{StaticResource GraphRenderModeToChromeConverter}"/>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
    ShowChrome="False" counterpart: same global-mode DisplayMode binding, but no plot background,
    grid, or border - just the plotted data. Used by tiles that embed the graph in their own frame
    (e.g. the CPU clock strip).
  -->
  <Style x:Key="AdaptiveGraphNoChromeStyle" TargetType="graphs:PerformanceGraph"
         BasedOn="{StaticResource SummaryTileGraphStyle}">
    <Setter Property="GraphBackground" Value="Transparent"/>
    <Setter Property="Grid" Value="False"/>
    <Setter Property="Border" Value="False"/>
  </Style>

  <!-- ============================================================================================
       Square-dot (Dot-mode) tile styles. SquareDotGraphLiteStyle stretches to fill and derives
       Height from ActualWidth/Capacity/Rows (the control's own SquareDotAspectRatio math) so every
       plotted dot renders square as its container resizes. The banded variants layer the per-sensor
       9-band ramp (ClockAccentBandedBrush* etc. from Crystal.Resources' Palette.xaml at app scope).
       ============================================================================================ -->
  <Style x:Key="SquareDotGraphLiteStyle" TargetType="{x:Type graphs:PerformanceGraph}">
    <Setter Property="DisplayMode" Value="Dot"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="CornerRadius" Value="1"/>
    <Setter Property="Height">
      <Setter.Value>
        <MultiBinding Converter="{StaticResource CapacityToRatioConverter}">
          <Binding Path="ActualWidth" RelativeSource="{RelativeSource Self}"/>
          <Binding Path="Capacity" RelativeSource="{RelativeSource Self}"/>
          <Binding Path="Rows" RelativeSource="{RelativeSource Self}"/>
        </MultiBinding>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="BandedSquareDotGraphLiteStyle" TargetType="{x:Type graphs:PerformanceGraph}"
         BasedOn="{StaticResource SquareDotGraphLiteStyle}">
    <Setter Property="ColorMode" Value="Banded"/>
  </Style>

  <Style x:Key="ClockBandedSquareDotGraphLiteStyle" TargetType="{x:Type graphs:PerformanceGraph}"
         BasedOn="{StaticResource BandedSquareDotGraphLiteStyle}">
    <Setter Property="Color1" Value="{StaticResource ClockAccentBandedBrush1}"/>
    <Setter Property="Color2" Value="{StaticResource ClockAccentBandedBrush2}"/>
    <Setter Property="Color3" Value="{StaticResource ClockAccentBandedBrush3}"/>
    <Setter Property="Color4" Value="{StaticResource ClockAccentBandedBrush4}"/>
    <Setter Property="Color5" Value="{StaticResource ClockAccentBandedBrush5}"/>
    <Setter Property="Color6" Value="{StaticResource ClockAccentBandedBrush6}"/>
    <Setter Property="Color7" Value="{StaticResource ClockAccentBandedBrush7}"/>
    <Setter Property="Color8" Value="{StaticResource ClockAccentBandedBrush8}"/>
    <Setter Property="Color9" Value="{StaticResource ClockAccentBandedBrush9}"/>
  </Style>

  <Style x:Key="VoltageBandedSquareDotGraphLiteStyle" TargetType="{x:Type graphs:PerformanceGraph}"
         BasedOn="{StaticResource BandedSquareDotGraphLiteStyle}">
    <Setter Property="Color1" Value="{StaticResource VoltageAccentBandedBrush1}"/>
    <Setter Property="Color2" Value="{StaticResource VoltageAccentBandedBrush2}"/>
    <Setter Property="Color3" Value="{StaticResource VoltageAccentBandedBrush3}"/>
    <Setter Property="Color4" Value="{StaticResource VoltageAccentBandedBrush4}"/>
    <Setter Property="Color5" Value="{StaticResource VoltageAccentBandedBrush5}"/>
    <Setter Property="Color6" Value="{StaticResource VoltageAccentBandedBrush6}"/>
    <Setter Property="Color7" Value="{StaticResource VoltageAccentBandedBrush7}"/>
    <Setter Property="Color8" Value="{StaticResource VoltageAccentBandedBrush8}"/>
    <Setter Property="Color9" Value="{StaticResource VoltageAccentBandedBrush9}"/>
  </Style>

  <Style x:Key="TemperatureBandedSquareDotGraphLiteStyle" TargetType="{x:Type graphs:PerformanceGraph}"
         BasedOn="{StaticResource BandedSquareDotGraphLiteStyle}">
    <Setter Property="Color1" Value="{StaticResource TemperatureAccentBandedBrush1}"/>
    <Setter Property="Color2" Value="{StaticResource TemperatureAccentBandedBrush2}"/>
    <Setter Property="Color3" Value="{StaticResource TemperatureAccentBandedBrush3}"/>
    <Setter Property="Color4" Value="{StaticResource TemperatureAccentBandedBrush4}"/>
    <Setter Property="Color5" Value="{StaticResource TemperatureAccentBandedBrush5}"/>
    <Setter Property="Color6" Value="{StaticResource TemperatureAccentBandedBrush6}"/>
    <Setter Property="Color7" Value="{StaticResource TemperatureAccentBandedBrush7}"/>
    <Setter Property="Color8" Value="{StaticResource TemperatureAccentBandedBrush8}"/>
    <Setter Property="Color9" Value="{StaticResource TemperatureAccentBandedBrush9}"/>
  </Style>

  <Style x:Key="PowerBandedSquareDotGraphLiteStyle" TargetType="{x:Type graphs:PerformanceGraph}"
         BasedOn="{StaticResource BandedSquareDotGraphLiteStyle}">
    <Setter Property="Color1" Value="{StaticResource PowerAccentBandedBrush1}"/>
    <Setter Property="Color2" Value="{StaticResource PowerAccentBandedBrush2}"/>
    <Setter Property="Color3" Value="{StaticResource PowerAccentBandedBrush3}"/>
    <Setter Property="Color4" Value="{StaticResource PowerAccentBandedBrush4}"/>
    <Setter Property="Color5" Value="{StaticResource PowerAccentBandedBrush5}"/>
    <Setter Property="Color6" Value="{StaticResource PowerAccentBandedBrush6}"/>
    <Setter Property="Color7" Value="{StaticResource PowerAccentBandedBrush7}"/>
    <Setter Property="Color8" Value="{StaticResource PowerAccentBandedBrush8}"/>
    <Setter Property="Color9" Value="{StaticResource PowerAccentBandedBrush9}"/>
  </Style>

  <!--
    Fixed-cell counterpart of SquareDotGraphLiteStyle: instead of stretching to fill and deriving
    Height from the (container-dependent) Width, it pins a fixed Height and derives Width, so dot
    cells come out the same size across graphs of different Capacity - see SquareDotWidthConverter.
    Horizontal/vertical alignment and margins are left to each consuming tile.
  -->
  <Style x:Key="UtilizationGraphLiteStyle" TargetType="{x:Type graphs:PerformanceGraph}">
    <Setter Property="DisplayMode" Value="Dot"/>
    <Setter Property="CornerRadius" Value="1"/>
    <Setter Property="Height" Value="{StaticResource UtilizationGraphHeight}"/>
    <Setter Property="Width">
      <Setter.Value>
        <MultiBinding Converter="{StaticResource SquareDotWidthConverter}">
          <Binding Path="Height" RelativeSource="{RelativeSource Self}"/>
          <Binding Path="Capacity" RelativeSource="{RelativeSource Self}"/>
          <Binding Path="Rows" RelativeSource="{RelativeSource Self}"/>
        </MultiBinding>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="SampleStyle" TargetType="{x:Type graphs:PerformanceGraph}">
    <Setter Property="BandedLine" Value="True"/>
    <Setter Property="BandStartColor" Value="WhiteSmoke"/>
    <Setter Property="BandEndColor" Value="Red"/>
  </Style>

  <!-- ============================================================================================
       Named, opt-in line/category sample styles. Apply one with, e.g.,
         <graphs:PerformanceGraph Style="{StaticResource RoseLineGraphStyle}"/>
       Colors come from the GraphPalette.xaml merged at the top of this dictionary.

       The category base styles (NoFrillsGraphStyle / FullGraphStyle) are intentionally partial:
       they set only the chrome (border / grid / background). DisplayMode and accent are layered on
       per graph by the dashboard's graph-settings feature.
       ============================================================================================ -->
  <Style TargetType="{x:Type graphs:PerformanceGraph}" x:Key="NoFrillsGraphStyle">
    <Setter Property="GraphBackground" Value="Transparent"/>
    <Setter Property="GridBrush" Value="Transparent"/>
    <Setter Property="GridThickness" Value="0"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="MinHeight" Value="{StaticResource SummaryGraphMinHeight}"/>
  </Style>

  <Style TargetType="{x:Type graphs:PerformanceGraph}" x:Key="FullGraphStyle">
    <Setter Property="GraphBackground" Value="{StaticResource GraphPlotBackgroundBrush}"/>
    <Setter Property="GridBrush" Value="{StaticResource GraphGridBrush}"/>
    <Setter Property="GridThickness" Value="0.6"/>
    <Setter Property="BorderBrush" Value="{StaticResource GraphAxisBorderBrush}"/>
    <Setter Property="BorderThickness" Value="0.8"/>
    <Setter Property="MinHeight" Value="{StaticResource SummaryGraphMinHeight}"/>
  </Style>

  <!-- NoFrill Styles - No Border, No Grid, No Background -->
  <Style TargetType="{x:Type graphs:PerformanceGraph}" x:Key="NoFillStyle">
    <Setter Property="GraphBackground" Value="Transparent"/>
    <Setter Property="GridBrush" Value="Transparent"/>
    <Setter Property="GridThickness" Value="0"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="MinHeight" Value="{StaticResource SummaryGraphMinHeight}"/>
  </Style>

  <Style TargetType="{x:Type graphs:PerformanceGraph}" x:Key="NoFillLineStyle"
         BasedOn="{StaticResource NoFillStyle}">
    <Setter Property="DisplayMode" Value="Line"/>
  </Style>

  <Style TargetType="{x:Type graphs:PerformanceGraph}" x:Key="NoFillBarStyle"
         BasedOn="{StaticResource NoFillStyle}">
    <Setter Property="DisplayMode" Value="Line"/>
  </Style>

  <Style TargetType="{x:Type graphs:PerformanceGraph}" x:Key="NoFillSegStyle"
         BasedOn="{StaticResource NoFillStyle}">
    <Setter Property="DisplayMode" Value="Line"/>
  </Style>

  <!-- Load Graph Styles -->
  <Style TargetType="{x:Type graphs:PerformanceGraph}" x:Key="LoadGraph30BaseStyle"
         BasedOn="{StaticResource NoFillStyle}">
    <Setter Property="HistoryLength" Value="30"/>
    <Setter Property="MinValue" Value="0"/>
    <Setter Property="MaxValue" Value="100"/>
  </Style>

  <Style TargetType="{x:Type graphs:PerformanceGraph}" x:Key="SegLoadGraph30Style"
         BasedOn="{StaticResource LoadGraph30BaseStyle}">
    <Setter Property="DisplayMode" Value="Line"/>
  </Style>

  <Style TargetType="{x:Type graphs:PerformanceGraph}" x:Key="LineLoadGraph30Style"
         BasedOn="{StaticResource LoadGraph30BaseStyle}">
    <Setter Property="DisplayMode" Value="Line"/>
  </Style>

  <Style TargetType="{x:Type graphs:PerformanceGraph}" x:Key="SegBarLoadGraphGreyStyle030"
         BasedOn="{StaticResource SegLoadGraph30Style}">
    <Setter Property="LineBrush" Value="{StaticResource GraphGreyBrush}"/>
    <Setter Property="FillBrush" Value="{StaticResource GraphGreyBrush}"/>
  </Style>

  <Style TargetType="{x:Type graphs:PerformanceGraph}" x:Key="SegBarLoadGraphRoseStyle030"
         BasedOn="{StaticResource SegLoadGraph30Style}">
