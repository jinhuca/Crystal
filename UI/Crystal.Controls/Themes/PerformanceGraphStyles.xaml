    <Setter Property="FillBrush" Value="{StaticResource GraphSkyBrush}"/>
  </Style>

  <Style TargetType="{x:Type graphs:PerformanceGraph}" x:Key="SegBarLoadGraphAmberStyle030"
         BasedOn="{StaticResource SegLoadGraph30Style}">
    <Setter Property="LineBrush" Value="{StaticResource GraphAmberBrush}"/>
    <Setter Property="FillBrush" Value="{StaticResource GraphAmberBrush}"/>
  </Style>

  <Style TargetType="{x:Type graphs:PerformanceGraph}" x:Key="LineLoadGraphGreyStyle030"
         BasedOn="{StaticResource LineLoadGraph30Style}">
    <Setter Property="LineBrush" Value="{StaticResource GraphGreyBrush}"/>
    <Setter Property="FillBrush" Value="{StaticResource GraphGreyFill}"/>
    <Setter Property="LineThickness" Value="1.0"/>
  </Style>

  <Style TargetType="{x:Type graphs:PerformanceGraph}" x:Key="LineLoadGraphRoseStyle030"
