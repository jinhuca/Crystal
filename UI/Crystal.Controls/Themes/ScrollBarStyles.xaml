<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Flat, dark, sharp-edged scrollbar matching the HWiNFO tile palette: no arrow buttons,
       no rounded corners, a thin muted thumb that brightens toward the accent on hover/drag.
       Keyed (not implicit) so it's opt-in per control via BasedOn or Style="{StaticResource ...}". -->
  <Style x:Key="CrystalScrollThumbStyle" TargetType="Thumb">
    <Setter Property="OverridesDefaultStyle" Value="True"/>
    <Setter Property="IsTabStop" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Border x:Name="Th" Background="#3A3A3A" BorderBrush="#2A2A2A" BorderThickness="1"
                  SnapsToDevicePixels="True"/>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Th" Property="Background" Value="#4A5560"/>
            </Trigger>
            <Trigger Property="IsDragging" Value="True">
              <Setter TargetName="Th" Property="Background" Value="#3E9BE8"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="CrystalScrollBarStyle" TargetType="ScrollBar">
    <Setter Property="OverridesDefaultStyle" Value="True"/>
    <Setter Property="Background" Value="#0A0A0A"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Grid x:Name="Root" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.Thumb>
                <Thumb Style="{StaticResource CrystalScrollThumbStyle}"/>
              </Track.Thumb>
              <!-- Invisible page buttons so click-in-trough paging still works. -->
              <Track.IncreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageDownCommand" Background="Transparent"
                              BorderThickness="0" Focusable="False" IsTabStop="False" Opacity="0"/>
              </Track.IncreaseRepeatButton>
              <Track.DecreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageUpCommand" Background="Transparent"
                              BorderThickness="0" Focusable="False" IsTabStop="False" Opacity="0"/>
              </Track.DecreaseRepeatButton>
            </Track>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
              <Setter TargetName="Root" Property="Height" Value="10"/>
              <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
            </Trigger>
            <Trigger Property="Orientation" Value="Vertical">
              <Setter TargetName="Root" Property="Width" Value="10"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
