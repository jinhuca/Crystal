<UserControl x:Class="CpuModule.Views.CpuSummaryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:graphs="clr-namespace:Crystal.Controls.PerformanceGraphs.Controls;assembly=Crystal.Controls"
             xmlns:gauges="clr-namespace:Crystal.Controls.MeterGauges.Controls;assembly=Crystal.Controls"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d"
             d:DesignHeight="240" d:DesignWidth="760"
             Background="Transparent" Foreground="White"
             FontFamily="Segoe UI"
             ToolTip="Double-click to open the CPU detail view">
  <Border Background="Transparent" MouseLeftButtonDown="OnTileClick">
    <Grid Margin="14">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- Header: title + brand -->
      <StackPanel Grid.Row="0" Orientation="Horizontal">
        <TextBlock Text="CPU" Foreground="#3E9BE8" FontSize="20" FontWeight="SemiBold"
                   VerticalAlignment="Center" Margin="0,0,16,0"/>
        <TextBlock DataContext="{Binding SpecsViewModel}" Text="{Binding Brand}"
                   Foreground="#DDDDDD" FontSize="13" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis"/>
      </StackPanel>

      <!-- Value gauge + load percentage graph -->
      <Grid Grid.Row="1" DataContext="{Binding SensorsViewModel}" Margin="0,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="110"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <gauges:MeterGaugeView Grid.Column="0" Title="Load" Unit="%"
                               MinValue="0" MaxValue="100" ValueFormat="{}{0:0}"
                               Value="{Binding Load}"/>
        <graphs:PerformanceGraphView x:Name="UtilizationView" Grid.Column="1" Margin="8,0"
                                     Title="Load Percentage" MinValue="0" MaxValue="100"
                                     MaxValueFormat="{}{0}%" MaxTime="60"
                                     MaxTimeFormat="{}{0}s" MinTime="0"/>
      </Grid>

      <!-- Instruction feature hint -->
      <TextBlock Grid.Row="2" DataContext="{Binding SpecsViewModel}"
                 Foreground="#9AA0A6" FontSize="12"
                 Text="{Binding LogicalCores, StringFormat=Instruction Feature · {0} logical cores}"/>
    </Grid>
  </Border>
</UserControl>
