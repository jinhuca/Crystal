<UserControl x:Class="CpuModule.Views.CpuDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:graphs="clr-namespace:Crystal.Controls.PerformanceGraphs.Controls;assembly=Crystal.Controls"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d"
             d:DesignHeight="820" d:DesignWidth="1600"
             Background="Black" Foreground="White"
             FontFamily="Segoe UI">
  <UserControl.Resources>
    <!-- Module-specific: CPU's spec value is the OK-green readout, distinct from other modules'
         neutral SpecValue. Label tone is slightly lighter than the shared LabelBrush by design. -->
    <Style x:Key="SpecLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#9AA0A6"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Margin" Value="0,1"/>
    </Style>
    <Style x:Key="SpecValue" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource OkBrush}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Margin" Value="6,1,0,1"/>
    </Style>
  </UserControl.Resources>

  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- ============ Header: back + title + static spec readout ============ -->
    <Grid Grid.Row="0" Margin="0,0,0,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <Button Grid.Column="0" Content="&#x2190; Back" Command="{Binding ShowDashboardCommand}"
              VerticalAlignment="Top" Margin="0,0,20,0" Padding="10,4"
              Background="#1E1E1E" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderBrush}"/>

      <Grid Grid.Column="1" DataContext="{Binding SpecsViewModel}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Column="0" Text="CPU" Foreground="{StaticResource AccentBrush}" FontSize="26"
                   FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,32,0"/>

        <!-- Identity block -->
        <Grid Grid.Column="1" Margin="0,0,28,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Grid.Column="0" Text="Vendor:" Style="{StaticResource SpecLabel}"/>
          <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Vendor}" Style="{StaticResource SpecValue}"/>
          <TextBlock Grid.Row="1" Grid.Column="0" Text="Socket:" Style="{StaticResource SpecLabel}"/>
          <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Socket}" Style="{StaticResource SpecValue}"/>
        </Grid>

        <!-- Brand / topology block -->
        <Grid Grid.Column="2" Margin="0,0,28,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Grid.Column="0" Text="Brand:" Style="{StaticResource SpecLabel}"/>
          <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Brand}" Style="{StaticResource SpecValue}"/>
          <TextBlock Grid.Row="1" Grid.Column="0" Text="Physical Cores:" Style="{StaticResource SpecLabel}"/>
          <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PhysicalCores}" Style="{StaticResource SpecValue}"/>
        </Grid>

        <!-- Family / logical block -->
        <Grid Grid.Column="3" Margin="0,0,28,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Grid.Column="0" Text="Family:" Style="{StaticResource SpecLabel}"/>
          <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Family}" Style="{StaticResource SpecValue}"/>
          <TextBlock Grid.Row="1" Grid.Column="0" Text="Logical Cores:" Style="{StaticResource SpecLabel}"/>
          <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding LogicalCores}" Style="{StaticResource SpecValue}"/>
        </Grid>

        <!-- Model / stepping / cache block -->
        <Grid Grid.Column="4" Margin="0,0,28,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Grid.Column="0" Text="Model:" Style="{StaticResource SpecLabel}"/>
          <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Model}" Style="{StaticResource SpecValue}"/>
          <TextBlock Grid.Row="1" Grid.Column="0" Text="Stepping:" Style="{StaticResource SpecLabel}"/>
          <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Stepping}" Style="{StaticResource SpecValue}"/>
          <TextBlock Grid.Row="2" Grid.Column="0" Text="L1 Cache Size:" Style="{StaticResource SpecLabel}"/>
          <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource SpecValue}"
                     Text="{Binding L1CacheKb, StringFormat={}{0:0.00} KB}"/>
        </Grid>

        <!-- Speeds / cache / virtualization block -->
        <Grid Grid.Column="5">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="40"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <TextBlock Grid.Row="0" Grid.Column="0" Text="Base Speed:" Style="{StaticResource SpecLabel}"/>
          <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource SpecValue}"
                     Text="{Binding BaseSpeedMHz, StringFormat={}{0:0.00} MHz}"/>
          <TextBlock Grid.Row="1" Grid.Column="0" Text="Bus Speed:" Style="{StaticResource SpecLabel}"/>
          <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource SpecValue}"
                     Text="{Binding BusSpeedMHz, StringFormat={}{0:0.00} MHz}"/>
          <TextBlock Grid.Row="2" Grid.Column="0" Text="Line Size:" Style="{StaticResource SpecLabel}"/>
          <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource SpecValue}"
                     Text="{Binding LineSizeBytes, StringFormat={}{0} B}"/>

          <TextBlock Grid.Row="0" Grid.Column="3" Text="L2 Cache Size:" Style="{StaticResource SpecLabel}"/>
          <TextBlock Grid.Row="0" Grid.Column="4" Style="{StaticResource SpecValue}"
                     Text="{Binding L2CacheKb, StringFormat={}{0:0.00} KB}"/>
          <TextBlock Grid.Row="1" Grid.Column="3" Text="L3 Cache Size:" Style="{StaticResource SpecLabel}"/>
          <TextBlock Grid.Row="1" Grid.Column="4" Style="{StaticResource SpecValue}"
                     Text="{Binding L3CacheKb, StringFormat={}{0:0.00} KB}"/>
          <TextBlock Grid.Row="2" Grid.Column="3" Text="Virtualization:" Style="{StaticResource SpecLabel}"/>
          <TextBlock Grid.Row="2" Grid.Column="4" Text="{Binding Virtualization}" Style="{StaticResource SpecValue}"/>
        </Grid>
      </Grid>
    </Grid>

    <!-- ============ Gauges + history graphs ============ -->
    <Grid Grid.Row="1" DataContext="{Binding SensorsViewModel}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="130"/>
        <ColumnDefinition Width="2*"/>
        <ColumnDefinition Width="130"/>
        <ColumnDefinition Width="2*"/>
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- Left column: Load / Voltage / Speed readouts + Utilization / Voltage / Clock graphs -->
      <StackPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="8,0">
        <TextBlock Text="{Binding Load, StringFormat={}{0:0.00}}" Style="{StaticResource MetricValue}"/>
        <TextBlock Text="%" Style="{StaticResource MetricUnit}"/>
        <TextBlock Text="Load" Style="{StaticResource MetricCaption}"/>
      </StackPanel>
      <graphs:PerformanceGraphView x:Name="UtilizationView" Grid.Row="0" Grid.Column="1" Margin="8,4"
                                   Title="% Utilization" MinValue="0" MaxValue="100" MaxValueFormat="{}{0}%"
                                   MaxTime="60" MaxTimeFormat="{}{0} seconds" MinTime="0"/>

      <StackPanel Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="8,0">
        <TextBlock Text="{Binding Voltage, StringFormat={}{0:0.00}}" Style="{StaticResource MetricValue}"/>
        <TextBlock Text="V" Style="{StaticResource MetricUnit}"/>
        <TextBlock Text="Voltage" Style="{StaticResource MetricCaption}"/>
      </StackPanel>
      <graphs:PerformanceGraphView x:Name="VoltageView" Grid.Row="1" Grid.Column="1" Margin="8,4"
                                   Title="Voltage" MinValue="0" MaxValue="3" MaxValueFormat="{}{0}V"
                                   MaxTime="60" MaxTimeFormat="{}{0} seconds" MinTime="0"/>

      <StackPanel Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="8,0">
        <TextBlock Text="{Binding SpeedGhz, StringFormat={}{0:0.00}}" Style="{StaticResource MetricValue}"/>
        <TextBlock Text="GHz" Style="{StaticResource MetricUnit}"/>
        <TextBlock Text="Speed" Style="{StaticResource MetricCaption}"/>
      </StackPanel>
      <graphs:PerformanceGraphView x:Name="ClockView" Grid.Row="2" Grid.Column="1" Margin="8,4"
                                   Title="Clock" MinValue="0" MaxValue="6" MaxValueFormat="{}{0} GHz"
                                   MaxTime="60" MaxTimeFormat="{}{0} seconds" MinTime="0"/>

      <!-- Right column: Power / Temperature readouts + graphs -->
      <StackPanel Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" Margin="8,0">
        <TextBlock Text="{Binding Power, StringFormat={}{0:0.00}}" Style="{StaticResource MetricValue}"/>
        <TextBlock Text="W" Style="{StaticResource MetricUnit}"/>
        <TextBlock Text="Power" Style="{StaticResource MetricCaption}"/>
      </StackPanel>
      <graphs:PerformanceGraphView x:Name="PowerView" Grid.Row="0" Grid.Column="3" Margin="8,4"
                                   Title="Power" MinValue="0" MaxValue="100" MaxValueFormat="{}{0}W"
                                   MaxTime="60" MaxTimeFormat="{}{0} seconds" MinTime="0"/>

      <StackPanel Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" Margin="8,0">
        <TextBlock Text="{Binding Temperature, StringFormat={}{0:0.00}}" Style="{StaticResource MetricValue}"/>
        <TextBlock Text="&#x00B0;C" Style="{StaticResource MetricUnit}"/>
        <TextBlock Text="Temperature" Style="{StaticResource MetricCaption}"/>
      </StackPanel>
      <graphs:PerformanceGraphView x:Name="TemperatureView" Grid.Row="1" Grid.Column="3" Margin="8,4"
                                   Title="Temperature" MinValue="0" MaxValue="120" MaxValueFormat="{}{0}&#x00B0;C"
                                   MaxTime="60" MaxTimeFormat="{}{0} seconds" MinTime="0"/>

      <!-- Shown while the ring-0 PawnIO driver is absent (or the process is unelevated):
           Voltage / Speed / Power / Temperature read from MSRs and stay empty without it. -->
      <Border Grid.Row="0" Grid.RowSpan="3" Grid.Column="0" Grid.ColumnSpan="4"
              VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,4,0,0"
              Background="#3A1F1F" BorderBrush="#C0553A" BorderThickness="1"
              CornerRadius="4" Padding="12,6">
        <Border.Style>
          <Style TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
              <DataTrigger Binding="{Binding MsrSensorsAvailable}" Value="False">
                <Setter Property="Visibility" Value="Visible"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="&#x26A0;" Foreground="{StaticResource WarningBrush}" FontSize="14"
                     VerticalAlignment="Center" Margin="0,0,8,0"/>
          <TextBlock Foreground="#E7B7A8" FontSize="12" VerticalAlignment="Center"
                     Text="MSR driver not available — Voltage, Speed, Power and Temperature require the PawnIO driver and Administrator privileges."/>
        </StackPanel>
      </Border>
    </Grid>

    <!-- ============ Instruction set grid ============ -->
    <StackPanel Grid.Row="2" Margin="0,10,0,0">
      <TextBlock Text="Instruction Set Features Available:" Foreground="{StaticResource TextMutedBrush}"
                 FontSize="14" Margin="0,0,0,6"/>
      <ItemsControl DataContext="{Binding SpecsViewModel}" ItemsSource="{Binding InstructionSet}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel Orientation="Vertical" Height="90"/>
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold"
                       Width="96" Margin="0,1,12,1">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Foreground" Value="#4A4A4A"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsAvailable}" Value="True">
                      <Setter Property="Foreground" Value="{StaticResource OkBrush}"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </Grid>
</UserControl>
