<UserControl x:Class="GpuModule.Views.GpuSummaryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:graphs="clr-namespace:Crystal.Controls.PerformanceGraphs;assembly=Crystal.Controls"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d"
             d:DesignHeight="240" d:DesignWidth="760"
             Background="Transparent" Foreground="White"
             FontFamily="Segoe UI">
  <UserControl.Resources>
    <!-- Metric readout to the right of each graph: big value, unit on the next line, dim caption. -->
    <Style x:Key="MetricValue" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#E6E6E6"/>
      <Setter Property="FontSize" Value="24"/>
      <Setter Property="FontFamily" Value="Consolas"/>
      <Setter Property="LineHeight" Value="26"/>
    </Style>
    <Style x:Key="MetricUnit" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#C0C0C0"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontFamily" Value="Consolas"/>
    </Style>
    <Style x:Key="MetricCaption" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#8A94A0"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontFamily" Value="Consolas"/>
    </Style>

    <!-- Per-adapter identity shown as a header above that adapter's graphs. -->
    <Style x:Key="SpecKind" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#3E9BE8"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="SpecName" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#DDDDDD"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
  </UserControl.Resources>

  <Border Background="Transparent" MouseLeftButtonDown="OnTileClick">
    <Grid Margin="10">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- Dense header bar: accent tick + title, thin divider rule below. -->
      <Border Grid.Row="0" BorderBrush="#2A2A2A" BorderThickness="0,0,0,1"
              Padding="0,0,0,4" Margin="0,0,0,6">
        <StackPanel Orientation="Horizontal">
          <Border Width="3" Background="#3E9BE8" Margin="0,1,8,1"/>
          <TextBlock Text="GPU" Foreground="#E6E6E6" FontSize="12" FontWeight="SemiBold"
                     VerticalAlignment="Center"/>
        </StackPanel>
      </Border>

      <!-- One block per adapter, laid out side by side. Each adapter shows an inline identity
           header, then two graph columns (Utilization + Temperature | Clock + Power) that span
           the adapter's full width; the static spec block now lives in the detail view. -->
      <ItemsControl Grid.Row="1" ItemsSource="{Binding Adapters}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Rows="1"/>
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Grid Margin="0,0,16,0" VerticalAlignment="Top">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>

              <!-- Inline identity header: kind + name. -->
              <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="{Binding KindLabel}" Style="{StaticResource SpecKind}"/>
                <TextBlock Text="{Binding Name}" Style="{StaticResource SpecName}" Margin="8,0,0,0"/>
              </StackPanel>

              <!-- Two graph columns spanning the adapter's full width. -->
              <Grid Grid.Row="1" VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Utilization (top) + Temperature (bottom) stacked graphs. -->
                <Grid Grid.Column="0" VerticalAlignment="Top" Margin="0,0,16,0">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="66"/>
                    <RowDefinition Height="66"/>
                  </Grid.RowDefinitions>

                  <Grid Grid.Row="0" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <graphs:PerformanceGraph Grid.Column="0"
                                             Loaded="OnLoadGraphLoaded"
                                             MinHeight="40" MinValue="0" MaxValue="100"/>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0" Width="96" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Load, StringFormat={}{0:0.00}}" Style="{StaticResource MetricValue}"/>
                      <TextBlock Text="%" Style="{StaticResource MetricUnit}"/>
                      <TextBlock Text="Utilization" Style="{StaticResource MetricCaption}"/>
                    </StackPanel>
                  </Grid>

                  <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <graphs:PerformanceGraph Grid.Column="0"
                                             Loaded="OnTemperatureGraphLoaded"
                                             MinHeight="40" MinValue="0" MaxValue="120"/>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0" Width="96" VerticalAlignment="Center">
                      <TextBlock Text="{Binding TemperatureC, StringFormat={}{0:0.00}, TargetNullValue=0.00}" Style="{StaticResource MetricValue}"/>
                      <TextBlock Text="°C" Style="{StaticResource MetricUnit}"/>
                      <TextBlock Text="Temperature" Style="{StaticResource MetricCaption}"/>
                    </StackPanel>
                  </Grid>
                </Grid>

                <!-- Right: Clock (top) + Power (bottom) stacked graphs. -->
                <Grid Grid.Column="1" VerticalAlignment="Top">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="66"/>
                    <RowDefinition Height="66"/>
                  </Grid.RowDefinitions>

                  <Grid Grid.Row="0" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <graphs:PerformanceGraph Grid.Column="0"
                                             Loaded="OnClockGraphLoaded"
                                             MinHeight="40" MinValue="0" MaxValue="3000"/>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0" Width="96" VerticalAlignment="Center">
                      <TextBlock Text="{Binding ClockMhz, StringFormat={}{0:0}, TargetNullValue=—}" Style="{StaticResource MetricValue}"/>
                      <TextBlock Text="MHz" Style="{StaticResource MetricUnit}"/>
                      <TextBlock Text="Clock" Style="{StaticResource MetricCaption}"/>
                    </StackPanel>
                  </Grid>

                  <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <graphs:PerformanceGraph Grid.Column="0"
                                             Loaded="OnPowerGraphLoaded"
                                             MinHeight="40" MinValue="0" MaxValue="450"/>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0" Width="96" VerticalAlignment="Center">
                      <TextBlock Text="{Binding PowerW, StringFormat={}{0:0.0}, TargetNullValue=—}" Style="{StaticResource MetricValue}"/>
                      <TextBlock Text="Watts" Style="{StaticResource MetricUnit}"/>
                      <TextBlock Text="Power" Style="{StaticResource MetricCaption}"/>
                    </StackPanel>
                  </Grid>
                </Grid>
              </Grid>
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Grid>
  </Border>
</UserControl>
