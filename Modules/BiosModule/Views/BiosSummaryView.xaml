<UserControl x:Class="BiosModule.Views.BiosSummaryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d"
             d:DesignHeight="140" d:DesignWidth="1100"
             Background="Transparent" Foreground="White"
             FontFamily="Segoe UI"
             ToolTip="Double-click to open the BIOS detail view">
  <Border Background="Transparent" MouseLeftButtonDown="OnTileClick">
    <Grid Margin="14">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <TextBlock Grid.Row="0" Text="BIOS" Foreground="#3E9BE8" FontSize="20"
                 FontWeight="SemiBold" Margin="0,0,0,12"/>

      <!-- Full-width strip: key fields laid out horizontally per the reference design -->
      <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">
        <StackPanel Margin="0,0,56,0">
          <TextBlock Text="Manufacturer" Foreground="#8A94A0" FontSize="12"/>
          <TextBlock Text="{Binding Manufacturer}" FontSize="16"/>
        </StackPanel>
        <StackPanel Margin="0,0,56,0">
          <TextBlock Text="Version" Foreground="#8A94A0" FontSize="12"/>
          <TextBlock Text="{Binding Version}" FontSize="16"/>
        </StackPanel>
        <StackPanel Margin="0,0,56,0">
          <TextBlock Text="Release date" Foreground="#8A94A0" FontSize="12"/>
          <TextBlock Text="{Binding ReleaseDate}" FontSize="16"/>
        </StackPanel>
        <StackPanel>
          <TextBlock Text="SMBIOS" Foreground="#8A94A0" FontSize="12"/>
          <TextBlock Text="{Binding SmbiosSpecVersion}" FontSize="16"/>
        </StackPanel>
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
