<UserControl x:Class="BiosModule.Views.BiosDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:graphs="clr-namespace:Crystal.Controls.PerformanceGraphs;assembly=Crystal.Controls"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="1100"
             Background="{StaticResource PanelBackgroundBrush}" Foreground="White"
             FontFamily="Segoe UI">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="0,0,0,16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Button Grid.Column="0" Content="&#x2190; Back" Padding="14,6"
              Background="#1E2A38" Foreground="White" BorderThickness="0"
              Command="{Binding ShowDashboardCommand}"/>
      <TextBlock Grid.Column="1" Text="BIOS" Foreground="{StaticResource AccentBrush}" FontSize="28"
                 FontWeight="SemiBold" VerticalAlignment="Center" Margin="16,0,0,0"/>
    </Grid>

    <Border Grid.Row="1" VerticalAlignment="Top" Padding="24" Background="{StaticResource SurfaceBackgroundBrush}" CornerRadius="8">
      <Border.Resources>
        <ResourceDictionary>
          <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="/BiosModule;component/Views/BiosResources.xaml"/>
          </ResourceDictionary.MergedDictionaries>
          <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource BiosAccentBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,14,0,4"/>
          </Style>
          <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource BiosLabelBrush}"/>
            <Setter Property="Margin" Value="0,4"/>
          </Style>
          <Style x:Key="FieldValue" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
          </Style>
          <!-- Full-size rail trend graph; Y-axis is nominal ±10% (set per rail on the instance).
               MarkerBrush turns on the session low/high dashed reference lines; MarkerFormat labels
               them with two-decimal volts (board temp / fan override this per-instance). -->
          <Style x:Key="RailGraph" TargetType="graphs:PerformanceGraph">
            <Setter Property="Height" Value="48"/>
            <Setter Property="MarkerBrush" Value="#6E7681"/>
            <Setter Property="MarkerFormat" Value="0.00"/>
          </Style>
        </ResourceDictionary>
      </Border.Resources>
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <!-- ── BIOS / firmware ─────────────────────────────────────── -->
          <TextBlock Text="Firmware" Style="{StaticResource SectionHeader}" Margin="0,0,0,4"/>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="220"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Manufacturer" Style="{StaticResource FieldLabel}"/>
            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Manufacturer}" Style="{StaticResource FieldValue}"/>
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Version" Style="{StaticResource FieldLabel}"/>
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Version}" Style="{StaticResource FieldValue}"/>
            <TextBlock Grid.Row="2" Grid.Column="0" Text="Release date" Style="{StaticResource FieldLabel}"/>
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ReleaseDate}" Style="{StaticResource FieldValue}"/>
            <TextBlock Grid.Row="3" Grid.Column="0" Text="Firmware interface" Style="{StaticResource FieldLabel}"/>
            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding FirmwareInterface}" Style="{StaticResource FieldValue}"/>
            <TextBlock Grid.Row="4" Grid.Column="0" Text="ROM size" Style="{StaticResource FieldLabel}"/>
            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding RomSize}" Style="{StaticResource FieldValue}"/>
            <TextBlock Grid.Row="5" Grid.Column="0" Text="BIOS revision" Style="{StaticResource FieldLabel}"/>
            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding BiosRevision}" Style="{StaticResource FieldValue}"/>
            <TextBlock Grid.Row="6" Grid.Column="0" Text="EC firmware revision" Style="{StaticResource FieldLabel}"/>
            <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding EmbeddedControllerRevision}" Style="{StaticResource FieldValue}"/>
            <TextBlock Grid.Row="7" Grid.Column="0" Text="SMBIOS version" Style="{StaticResource FieldLabel}"/>
            <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding SmbiosSpecVersion}" Style="{StaticResource FieldValue}"/>
            <TextBlock Grid.Row="8" Grid.Column="0" Text="Serial number" Style="{StaticResource FieldLabel}"/>
            <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding SerialNumber}" Style="{StaticResource FieldValue}"/>
            <TextBlock Grid.Row="9" Grid.Column="0" Text="Status" Style="{StaticResource FieldLabel}"/>
            <TextBlock Grid.Row="9" Grid.Column="1" Text="{Binding Status}" Style="{StaticResource FieldValue}"/>
          </Grid>

          <!-- ── System / baseboard / chassis ────────────────────────── -->
          <TextBlock Text="System &amp; baseboard" Style="{StaticResource SectionHeader}"/>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="220"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="System manufacturer" Style="{StaticResource FieldLabel}"/>
            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SystemManufacturer}" Style="{StaticResource FieldValue}"/>
            <TextBlock Grid.Row="1" Grid.Column="0" Text="System product" Style="{StaticResource FieldLabel}"/>
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SystemProduct}" Style="{StaticResource FieldValue}"/>
            <TextBlock Grid.Row="2" Grid.Column="0" Text="Baseboard manufacturer" Style="{StaticResource FieldLabel}"/>
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding BaseboardManufacturer}" Style="{StaticResource FieldValue}"/>
            <TextBlock Grid.Row="3" Grid.Column="0" Text="Baseboard product" Style="{StaticResource FieldLabel}"/>
            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding BaseboardProduct}" Style="{StaticResource FieldValue}"/>
            <TextBlock Grid.Row="4" Grid.Column="0" Text="Chassis type" Style="{StaticResource FieldLabel}"/>
            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding ChassisType}" Style="{StaticResource FieldValue}"/>
          </Grid>

          <!-- ── Capabilities ────────────────────────────────────────── -->
          <TextBlock Text="Capabilities" Style="{StaticResource SectionHeader}"/>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="220"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Flash upgradeable" Style="{StaticResource FieldLabel}"/>
            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding FlashUpgradeable}" Style="{StaticResource FieldValue}"/>
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Selectable boot" Style="{StaticResource FieldLabel}"/>
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectableBoot}" Style="{StaticResource FieldValue}"/>
            <TextBlock Grid.Row="2" Grid.Column="0" Text="Boot from CD" Style="{StaticResource FieldLabel}"/>
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding BootFromCd}" Style="{StaticResource FieldValue}"/>
          </Grid>

          <!-- ── Security / TPM / boot ───────────────────────────────── -->
          <TextBlock Text="Security &amp; boot" Style="{StaticResource SectionHeader}"/>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="220"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Secure Boot" Style="{StaticResource FieldLabel}"/>
            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SecureBoot}" Style="{StaticResource FieldValue}"/>
            <TextBlock Grid.Row="1" Grid.Column="0" Text="TPM" Style="{StaticResource FieldLabel}"/>
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Tpm}" Style="{StaticResource FieldValue}"/>
            <TextBlock Grid.Row="2" Grid.Column="0" Text="TPM manufacturer" Style="{StaticResource FieldLabel}"/>
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding TpmManufacturer}" Style="{StaticResource FieldValue}"/>
            <TextBlock Grid.Row="3" Grid.Column="0" Text="Administrator password" Style="{StaticResource FieldLabel}"/>
            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding AdministratorPassword}" Style="{StaticResource FieldValue}"/>
            <TextBlock Grid.Row="4" Grid.Column="0" Text="Power-on password" Style="{StaticResource FieldLabel}"/>
            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding PowerOnPassword}" Style="{StaticResource FieldValue}"/>
            <TextBlock Grid.Row="5" Grid.Column="0" Text="Boot status" Style="{StaticResource FieldLabel}"/>
            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding BootStatus}" Style="{StaticResource FieldValue}"/>
          </Grid>

          <!-- ── Firmware inventory (SMBIOS Type 45) ─────────────────── -->
          <TextBlock Text="Firmware inventory" Style="{StaticResource SectionHeader}"
                     Visibility="{Binding HasFirmwareInventory, Converter={StaticResource BoolToVisibility}}"/>
          <ListView ItemsSource="{Binding FirmwareInventory}" Margin="0,4,0,0"
                    Background="{StaticResource PanelBackgroundBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1"
                    Foreground="#D6D6D6" FontFamily="Consolas"
                    Visibility="{Binding HasFirmwareInventory, Converter={StaticResource BoolToVisibility}}">
            <ListView.View>
              <GridView>
                <GridViewColumn Header="Component" Width="320" DisplayMemberBinding="{Binding Name}"/>
                <GridViewColumn Header="Version" Width="200" DisplayMemberBinding="{Binding Version}"/>
                <GridViewColumn Header="Date" Width="140" DisplayMemberBinding="{Binding ReleaseDate}"/>
                <GridViewColumn Header="State" Width="120" DisplayMemberBinding="{Binding State}"/>
              </GridView>
            </ListView.View>
          </ListView>

          <!-- ── Live board sensors (shared SensorMonitor, 1s cadence) ─── -->
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="Board sensors (live)" Style="{StaticResource SectionHeader}"/>
            <!-- Resets the session health log and trend-graph buffers for a fresh observation
                 window. Shown only when there's history to clear. -->
            <Button Content="Clear history" Padding="8,2" Margin="12,10,0,0" FontSize="11"
                    Background="#1E2A38" Foreground="#9DB2C8" BorderThickness="0"
                    Click="OnClearHistory"
                    Visibility="{Binding HasBoardSensors, Converter={StaticResource BoolToVisibility}}"/>
            <!-- Whole-board health rollup, matching the summary tile. Hidden while healthy so it
                 only draws the eye when a rail or the CMOS cell is out of tolerance. -->
            <TextBlock VerticalAlignment="Center" Margin="10,10,0,0" FontSize="11" FontWeight="SemiBold"
                       ToolTip="{Binding BoardHealthDetail}"
                       Foreground="{Binding BoardHealth, Converter={StaticResource SeverityToBrush}}">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Visibility" Value="Collapsed"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding BoardHealth}" Value="Warning">
                      <Setter Property="Visibility" Value="Visible"/>
                      <Setter Property="Text" Value="WARNING"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding BoardHealth}" Value="Critical">
                      <Setter Property="Visibility" Value="Visible"/>
                      <Setter Property="Text" Value="CRITICAL"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </StackPanel>
          <TextBlock Text="{Binding BoardSensorStatus}" Style="{StaticResource FieldLabel}"
                     TextWrapping="Wrap"
                     Visibility="{Binding HasBoardSensorStatus, Converter={StaticResource BoolToVisibility}}"/>
          <!-- Column headers are clickable to re-sort; the default order (set in the view model) is
               worst-severity first. Sort keys are numeric (Value/Min/Max) so "10 V" ranks above
               "9 V", not lexically below it. -->
          <ListView x:Name="BoardSensorList" ItemsSource="{Binding BoardSensors}" Margin="0,4,0,0"
                    Background="{StaticResource PanelBackgroundBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1"
                    Foreground="#D6D6D6" FontFamily="Consolas"
                    GridViewColumnHeader.Click="OnBoardSensorHeaderClick"
                    Visibility="{Binding HasBoardSensors, Converter={StaticResource BoolToVisibility}}">
            <ListView.View>
              <GridView>
                <GridViewColumn Header="Sensor" Width="320" DisplayMemberBinding="{Binding Name}"/>
                <GridViewColumn Header="Value" Width="160">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Value}"
                                 Foreground="{Binding Severity, Converter={StaticResource SeverityToBrush}}"/>
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Header="Min" Width="160">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Min}"
                                 Foreground="{Binding MinSeverity, Converter={StaticResource SeverityToBrush}}"/>
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Header="Max" Width="160">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Max}"
                                 Foreground="{Binding MaxSeverity, Converter={StaticResource SeverityToBrush}}"/>
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
              </GridView>
            </ListView.View>
          </ListView>

          <!-- ── Board health events (this session) ──────────────────── -->
          <!-- Durable trail of out-of-spec episodes: a rail that dipped critical then recovered
               still shows here after it vanishes from the live table. Hidden until something first
               leaves spec, so a healthy board never draws an empty log. -->
          <StackPanel Visibility="{Binding HasHealthEvents, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="Health events (this session)" Style="{StaticResource SectionHeader}"/>
              <!-- Compact count of logged episodes, e.g. "3 events · 1 ongoing"; empty when none. -->
              <TextBlock Text="{Binding HealthEventsSummary}" VerticalAlignment="Center"
                         Margin="10,10,0,0" FontSize="11" Foreground="{StaticResource BiosDimBrush}"/>
              <!-- "+N older dropped" once the retention cap evicts the oldest events; collapses until then. -->
              <TextBlock Text="{Binding HealthEventsCapNote}" VerticalAlignment="Center"
                         Margin="8,10,0,0" FontSize="11" FontStyle="Italic"
                         Foreground="{StaticResource BiosDimBrush}">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding HealthEventsCapNote}" Value="">
                        <Setter Property="Visibility" Value="Collapsed"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
              <!-- Copies the log as tab-separated text so a fault trail can be pasted into a bug report. -->
              <Button Content="Copy" Padding="8,2" Margin="12,10,0,0" FontSize="11"
                      Background="#1E2A38" Foreground="#9DB2C8" BorderThickness="0"
                      IsEnabled="{Binding HasHealthEvents}"
                      Click="OnCopyHealthEvents"/>
              <!-- Writes the same tab-separated log to a file the user picks, for archiving/attaching. -->
              <Button Content="Save…" Padding="8,2" Margin="6,10,0,0" FontSize="11"
                      Background="#1E2A38" Foreground="#9DB2C8" BorderThickness="0"
                      IsEnabled="{Binding HasHealthEvents}"
                      Click="OnSaveHealthEvents"/>
              <!-- Narrows the table to critical episodes only; the count/peak still reflect the full
                   log, so this is a view filter, not a data change. -->
              <CheckBox Content="Critical only" VerticalAlignment="Center" Margin="12,10,0,0"
                        FontSize="11" Foreground="{StaticResource BiosDimBrush}"
                        IsChecked="{Binding ShowCriticalOnly, Mode=TwoWay}"/>
              <!-- "N hidden" when the filter is suppressing rows, so the narrowed table doesn't read
                   as empty. Collapses when nothing is hidden. -->
              <TextBlock Text="{Binding HealthEventsFilterHint}" VerticalAlignment="Center"
                         Margin="6,10,0,0" FontSize="11" FontStyle="Italic"
                         Foreground="{StaticResource BiosDimBrush}">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding HealthEventsFilterHint}" Value="">
                        <Setter Property="Visibility" Value="Collapsed"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </StackPanel>
            <!-- Column headers are clickable to re-sort; the default order (set in the view model) is
                 ongoing-first then newest. Started/Duration sort on numeric keys (ticks/seconds) and
                 Peak on the severity enum, so ordering is chronological/by-length/by-severity rather
                 than lexical. -->
            <ListView x:Name="HealthEventList" ItemsSource="{Binding HealthEvents}" Margin="0,4,0,0"
                      Background="{StaticResource PanelBackgroundBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1"
                      Foreground="#D6D6D6" FontFamily="Consolas"
                      GridViewColumnHeader.Click="OnHealthEventHeaderClick">
              <!-- Hovering a row shows its full detail (full-date start/end, peak, duration) that the
                   abbreviated columns leave out. -->
              <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                  <Setter Property="ToolTip" Value="{Binding Detail}"/>
                </Style>
              </ListView.ItemContainerStyle>
              <ListView.View>
                <GridView>
                  <GridViewColumn Header="Started" Width="120" DisplayMemberBinding="{Binding Started}"/>
                  <!-- Relative age of the episode start, ticking forward each refresh; sorts on the
                       same StartedSort key as Started, so newest-first == youngest-age-first. -->
                  <GridViewColumn Header="Age" Width="100" DisplayMemberBinding="{Binding Age}"/>
                  <GridViewColumn Header="Sensor" Width="200" DisplayMemberBinding="{Binding SensorName}"/>
                  <!-- Peak severity band plus the actual reading captured at that moment, both tinted
                       so the number that triggered the fault reads at the row's severity color. -->
                  <GridViewColumn Header="Peak" Width="120">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Severity}"
                                   Foreground="{Binding Severity, Converter={StaticResource SeverityToBrush}}"/>
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn Header="Reading" Width="120">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding PeakValue}"
                                   Foreground="{Binding Severity, Converter={StaticResource SeverityToBrush}}"/>
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <!-- When the peak reading was captured (may be after the episode started, if it
                       escalated). Sorts on the numeric tick key, not the HH:mm:ss string. -->
                  <GridViewColumn Header="Peak at" Width="100" DisplayMemberBinding="{Binding PeakAt}"/>
                  <GridViewColumn Header="Duration" Width="160" DisplayMemberBinding="{Binding Duration}"/>
                </GridView>
              </ListView.View>
            </ListView>
          </StackPanel>

          <!-- ── Rail voltage trends ─────────────────────────────────── -->
          <!-- Each graph's Y-axis is nominal ±10%, so the plot edges mark the critical band and a
               healthy rail tracks the centerline. Shown only when live board sensors are present. -->
          <StackPanel Visibility="{Binding HasBoardSensors, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="Rail trends (live)" Style="{StaticResource SectionHeader}"/>
            <!-- Board temperature: 20–90 °C so the 60/70 °C warn/critical bands sit in the upper
                 portion and a healthy idle board tracks the lower third. -->
            <Grid Margin="0,4,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="70"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="90"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="Board" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
              <graphs:PerformanceGraph Grid.Column="1" x:Name="BoardTempGraph" Style="{StaticResource RailGraph}"
                                       Loaded="OnBoardTempGraphLoaded" MinValue="20" MaxValue="90" MarkerFormat="0.0"/>
              <TextBlock Grid.Column="2" Text="{Binding BoardTemperature}" Style="{StaticResource FieldValue}"
                         VerticalAlignment="Center" TextAlignment="Right"
                         Foreground="{Binding BoardTemperatureSeverity, Converter={StaticResource SeverityToBrush}}"/>
            </Grid>
            <Grid Margin="0,4,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="70"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="90"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="+3.3V" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
              <graphs:PerformanceGraph Grid.Column="1" x:Name="Rail3V3Graph" Style="{StaticResource RailGraph}"
                                       Loaded="OnGraphLoaded" MinValue="2.97" MaxValue="3.63"/>
              <TextBlock Grid.Column="2" Text="{Binding Rail3V3}" Style="{StaticResource FieldValue}"
                         VerticalAlignment="Center" TextAlignment="Right"
                         Foreground="{Binding Rail3V3Severity, Converter={StaticResource SeverityToBrush}}"/>
            </Grid>
            <Grid Margin="0,4,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="70"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="90"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="+5V" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
              <graphs:PerformanceGraph Grid.Column="1" x:Name="Rail5VGraph" Style="{StaticResource RailGraph}"
                                       Loaded="OnGraphLoaded" MinValue="4.5" MaxValue="5.5"/>
              <TextBlock Grid.Column="2" Text="{Binding Rail5V}" Style="{StaticResource FieldValue}"
                         VerticalAlignment="Center" TextAlignment="Right"
                         Foreground="{Binding Rail5VSeverity, Converter={StaticResource SeverityToBrush}}"/>
            </Grid>
            <Grid Margin="0,4,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="70"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="90"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="+12V" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
              <graphs:PerformanceGraph Grid.Column="1" x:Name="Rail12VGraph" Style="{StaticResource RailGraph}"
                                       Loaded="OnGraphLoaded" MinValue="10.8" MaxValue="13.2"/>
              <TextBlock Grid.Column="2" Text="{Binding Rail12V}" Style="{StaticResource FieldValue}"
                         VerticalAlignment="Center" TextAlignment="Right"
                         Foreground="{Binding Rail12VSeverity, Converter={StaticResource SeverityToBrush}}"/>
            </Grid>
            <!-- Chassis fan trend: 0–2500 RPM, so a stall drops the line to the floor. Shown only
                 when the board exposes a chassis/system fan. -->
            <Grid Margin="0,4,0,0"
                  Visibility="{Binding HasChassisFan, Converter={StaticResource BoolToVisibility}}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="70"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="90"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="Fan" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
              <graphs:PerformanceGraph Grid.Column="1" x:Name="FanGraph" Style="{StaticResource RailGraph}"
                                       Loaded="OnFanGraphLoaded" MinValue="0" MaxValue="2500" MarkerFormat="0"/>
              <TextBlock Grid.Column="2" Text="{Binding ChassisFanRpm}" Style="{StaticResource FieldValue}"
                         VerticalAlignment="Center" TextAlignment="Right"
                         Foreground="{Binding ChassisFanSeverity, Converter={StaticResource SeverityToBrush}}"/>
            </Grid>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Border>
  </Grid>
</UserControl>
