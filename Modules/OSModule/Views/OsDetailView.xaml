<UserControl x:Class="OSModule.Views.OsDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d"
             d:DesignHeight="820" d:DesignWidth="1100"
             Background="{StaticResource PanelBackgroundBrush}" Foreground="White"
             FontFamily="Segoe UI">
  <UserControl.Resources>
    <!-- StatCaption removed: byte-identical to the shared StatCaption in Crystal.Resources. -->
    <!-- Task Manager-style stat cell: large light value below the shared caption. -->
    <Style x:Key="StatValue" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource ValueBrush}"/>
      <Setter Property="FontSize" Value="22"/>
      <Setter Property="FontWeight" Value="Light"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <!-- Compact label:value row used in the identity grid. -->
    <Style x:Key="SpecCaption" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource LabelBrush}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Margin" Value="0,4"/>
    </Style>
    <Style x:Key="SpecValue" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource SpecValueBrush}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontFamily" Value="Consolas"/>
      <Setter Property="Margin" Value="24,4,0,4"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
  </UserControl.Resources>

  <Grid Margin="24,18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>   <!-- back + title + name -->
      <RowDefinition Height="Auto"/>   <!-- headline stat tiles -->
      <RowDefinition Height="*"/>      <!-- identity grid -->
    </Grid.RowDefinitions>

    <!-- ============ Header: back + title + OS name ============ -->
    <Grid Grid.Row="0" Margin="0,0,0,18">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Button Grid.Column="0" Content="&#x2190; Back"
              VerticalAlignment="Center" Margin="0,0,20,0"
              Style="{StaticResource DetailBackButtonStyle}"
              Command="{Binding ShowDashboardCommand}"/>
      <TextBlock Grid.Column="1" Text="Operating System" Foreground="{StaticResource AccentBrush}" FontSize="30"
                 FontWeight="SemiBold" VerticalAlignment="Center"/>
      <TextBlock Grid.Column="2" Text="{Binding OsName}" Foreground="{StaticResource SpecValueBrush}"
                 FontSize="18" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                 Margin="0,0,0,4"/>
    </Grid>

    <!-- ============ Headline stat tiles ============ -->
    <Grid Grid.Row="1" Margin="0,0,0,22">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0">
        <TextBlock Text="Version" Style="{StaticResource StatCaption}"/>
        <TextBlock Text="{Binding DisplayVersion}" Style="{StaticResource StatValue}"/>
      </StackPanel>
      <StackPanel Grid.Column="1">
        <TextBlock Text="Build" Style="{StaticResource StatCaption}"/>
        <TextBlock Text="{Binding BuildLabel}" Style="{StaticResource StatValue}"/>
      </StackPanel>
      <StackPanel Grid.Column="2">
        <TextBlock Text="Architecture" Style="{StaticResource StatCaption}"/>
        <TextBlock Text="{Binding Architecture}" Style="{StaticResource StatValue}"/>
      </StackPanel>
      <StackPanel Grid.Column="3">
        <TextBlock Text="Uptime" Style="{StaticResource StatCaption}"/>
        <TextBlock Text="{Binding UptimeLabel}" Style="{StaticResource StatValue}"/>
      </StackPanel>
    </Grid>

    <!-- ============ Full identity grid (two label:value columns) ============ -->
    <Grid Grid.Row="2" VerticalAlignment="Top">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="2*"/>
        <ColumnDefinition Width="60"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="2*"/>
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- Left column -->
      <TextBlock Grid.Row="0" Grid.Column="0" Text="Edition:" Style="{StaticResource SpecCaption}"/>
      <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Edition}" Style="{StaticResource SpecValue}"/>
      <TextBlock Grid.Row="1" Grid.Column="0" Text="OS version:" Style="{StaticResource SpecCaption}"/>
      <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding VersionLabel}" Style="{StaticResource SpecValue}"/>
      <TextBlock Grid.Row="2" Grid.Column="0" Text="Install date:" Style="{StaticResource SpecCaption}"/>
      <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding InstallDateLabel}" Style="{StaticResource SpecValue}"/>
      <TextBlock Grid.Row="3" Grid.Column="0" Text="Last boot:" Style="{StaticResource SpecCaption}"/>
      <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding LastBootTimeLabel}" Style="{StaticResource SpecValue}"/>
      <TextBlock Grid.Row="4" Grid.Column="0" Text="System time:" Style="{StaticResource SpecCaption}"/>
      <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding CurrentTimeLabel}" Style="{StaticResource SpecValue}"/>
      <TextBlock Grid.Row="5" Grid.Column="0" Text="System dir:" Style="{StaticResource SpecCaption}"/>
      <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SystemDirectory}" Style="{StaticResource SpecValue}"/>

      <!-- Right column -->
      <TextBlock Grid.Row="0" Grid.Column="3" Text="Computer name:" Style="{StaticResource SpecCaption}"/>
      <TextBlock Grid.Row="0" Grid.Column="4" Text="{Binding MachineName}" Style="{StaticResource SpecValue}"/>
      <TextBlock Grid.Row="1" Grid.Column="3" Text="Current user:" Style="{StaticResource SpecCaption}"/>
      <TextBlock Grid.Row="1" Grid.Column="4" Text="{Binding UserName}" Style="{StaticResource SpecValue}"/>
      <TextBlock Grid.Row="2" Grid.Column="3" Text="Registered to:" Style="{StaticResource SpecCaption}"/>
      <TextBlock Grid.Row="2" Grid.Column="4" Text="{Binding RegisteredOwner}" Style="{StaticResource SpecValue}"/>
      <TextBlock Grid.Row="3" Grid.Column="3" Text="Organization:" Style="{StaticResource SpecCaption}"/>
      <TextBlock Grid.Row="3" Grid.Column="4" Text="{Binding RegisteredOrganization}" Style="{StaticResource SpecValue}"/>
      <TextBlock Grid.Row="4" Grid.Column="3" Text="Locale:" Style="{StaticResource SpecCaption}"/>
      <TextBlock Grid.Row="4" Grid.Column="4" Text="{Binding Locale}" Style="{StaticResource SpecValue}"/>
      <TextBlock Grid.Row="5" Grid.Column="3" Text="Time zone:" Style="{StaticResource SpecCaption}"/>
      <TextBlock Grid.Row="5" Grid.Column="4" Text="{Binding TimeZone}" Style="{StaticResource SpecValue}"/>
    </Grid>
  </Grid>
</UserControl>
