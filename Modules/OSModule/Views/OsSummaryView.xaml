<UserControl x:Class="OSModule.Views.OsSummaryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d"
             d:DesignHeight="240" d:DesignWidth="380"
             Background="Transparent" Foreground="White"
             FontFamily="Segoe UI">
  <UserControl.Resources>
    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#8A94A0"/>
      <Setter Property="FontSize" Value="11"/>
    </Style>
    <Style x:Key="FieldValue" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#E6E6E6"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontFamily" Value="Consolas"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
      <Setter Property="Margin" Value="0,0,16,0"/>
    </Style>
    <Style x:Key="FieldCell" TargetType="StackPanel">
      <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>
  </UserControl.Resources>

  <Border Background="Transparent" MouseLeftButtonDown="OnTileClick">
    <Grid Margin="10">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- Dense header bar: accent tick + title + inline OS name, thin divider rule below. -->
      <Border Grid.Row="0" BorderBrush="#2A2A2A" BorderThickness="0,0,0,1"
              Padding="0,0,0,4" Margin="0,0,0,8">
        <StackPanel Orientation="Horizontal">
          <Border Width="3" Background="#3E9BE8" Margin="0,1,8,1"/>
          <TextBlock Text="OPERATING SYSTEM" Foreground="#E6E6E6" FontSize="12" FontWeight="SemiBold"
                     VerticalAlignment="Center" Margin="0,0,16,0"/>
          <TextBlock Text="{Binding OsName}" Foreground="#E6E6E6" FontSize="11" FontFamily="Consolas"
                     VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
      </Border>

      <StackPanel Grid.Row="1" VerticalAlignment="Top">
        <!-- Version / build / architecture triplet -->
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Style="{StaticResource FieldCell}">
            <TextBlock Text="Version" Style="{StaticResource FieldLabel}"/>
            <TextBlock Text="{Binding DisplayVersion}" Style="{StaticResource FieldValue}"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Style="{StaticResource FieldCell}">
            <TextBlock Text="Build" Style="{StaticResource FieldLabel}"/>
            <TextBlock Text="{Binding BuildLabel}" Style="{StaticResource FieldValue}"/>
          </StackPanel>
          <StackPanel Grid.Column="2" Style="{StaticResource FieldCell}">
            <TextBlock Text="Architecture" Style="{StaticResource FieldLabel}"/>
            <TextBlock Text="{Binding Architecture}" Style="{StaticResource FieldValue}"/>
          </StackPanel>
        </Grid>

        <!-- Uptime section rule + header. Uptime is the live value (green tick); last boot and
             install date are the fixed timestamps that frame it. -->
        <Border BorderBrush="#2A2A2A" BorderThickness="0,1,0,0" Margin="0,2,0,8" Padding="0,8,0,0">
          <StackPanel Orientation="Horizontal">
            <Border Width="6" Height="6" CornerRadius="3" Background="#3BD15A"
                    VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBlock Text="UPTIME" Foreground="#8A94A0" FontSize="10" FontWeight="SemiBold"
                       VerticalAlignment="Center"/>
          </StackPanel>
        </Border>

        <!-- Live uptime, prominent across the width. -->
        <StackPanel Style="{StaticResource FieldCell}">
          <TextBlock Text="Uptime" Style="{StaticResource FieldLabel}"/>
          <TextBlock Text="{Binding UptimeLabel}" Style="{StaticResource FieldValue}" FontSize="18"/>
        </StackPanel>

        <!-- Fixed timestamps: last boot + install date. -->
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Style="{StaticResource FieldCell}">
            <TextBlock Text="Last boot" Style="{StaticResource FieldLabel}"/>
            <TextBlock Text="{Binding LastBootTimeLabel}" Style="{StaticResource FieldValue}"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Style="{StaticResource FieldCell}">
            <TextBlock Text="Installed" Style="{StaticResource FieldLabel}"/>
            <TextBlock Text="{Binding InstallDateLabel}" Style="{StaticResource FieldValue}"/>
          </StackPanel>
        </Grid>
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
