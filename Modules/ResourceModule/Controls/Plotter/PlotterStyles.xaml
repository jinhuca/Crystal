<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:brushes="clr-namespace:ResourceModule"
                    xmlns:local="clr-namespace:ResourceModule.Controls.Plotter">
  <Style x:Key="PlotterBaseStyle"
         TargetType="{x:Type local:PlotterControl}">
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="VerticalAlignment" Value="Stretch"/>
    <Setter Property="Margin" Value="0"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="Black"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="PlotStroke" Value="Black"/>
    <Setter Property="RangeAreaBrush" Value="LightGray"/>
    <Setter Property="Width" Value="Auto"/>
    <Setter Property="Height" Value="5.00cm"/>
  </Style>

  <Style x:Key="LoadPlotterStyle" 
       TargetType="{x:Type local:PlotterControl}"
       BasedOn="{StaticResource PlotterBaseStyle}">
    <Setter Property="PlotStroke" Value="{DynamicResource LoadSolidColorBrush}"/>
    <Setter Property="RangeAreaBrush" Value="{DynamicResource LoadRangeLinearGradientBrush}"/>
    <Setter Property="YMin" Value="0"/>
    <Setter Property="YMax" Value="100"/>
    <Setter Property="TitleText" Value="% Utilization"/>
    <Setter Property="ValueText" Value="100%"/>
  </Style>

  <Style x:Key="PowerPlotterStyle" 
       TargetType="{x:Type local:PlotterControl}"
       BasedOn="{StaticResource PlotterBaseStyle}">
    <Setter Property="PlotStroke" Value="{StaticResource PowerSolidColorBrush}"/>
    <Setter Property="RangeAreaBrush" Value="{StaticResource PowerRangeLinearGradientBrush}"/>
    <Setter Property="YMin" Value="0"/>
    <Setter Property="YMax" Value="100"/>
    <Setter Property="TitleText" Value="Power"/>
    <Setter Property="ValueText" Value="100W"/>
  </Style>

  <Style x:Key="VoltagePlotterStyle"
         TargetType="{x:Type local:PlotterControl}"
         BasedOn="{StaticResource PlotterBaseStyle}">
    <Setter Property="PlotStroke" Value="{StaticResource VoltageSolidColorBrush}"/>
    <Setter Property="RangeAreaBrush" Value="{StaticResource VoltageRangeLinearGradientBrush}"/>
    <Setter Property="YMin" Value="0"/>
    <Setter Property="YMax" Value="3"/>
    <Setter Property="TitleText" Value="Voltage"/>
    <Setter Property="ValueText" Value="3V"/>
  </Style>

  <Style x:Key="TemperaturePlotterStyle"
         TargetType="{x:Type local:PlotterControl}"
         BasedOn="{StaticResource PlotterBaseStyle}">
    <Setter Property="PlotStroke" Value="{StaticResource TemperatureSolidColorBrush}"/>
    <Setter Property="RangeAreaBrush" Value="{StaticResource TemperatureRangeLinearGradientBrush}"/>
    <Setter Property="YMin" Value="0"/>
    <Setter Property="YMax" Value="120"/>
    <Setter Property="TitleText" Value="Temperature"/>
    <Setter Property="ValueText" Value="120°C"/>
  </Style>

  <Style x:Key="ClockPlotterStyle"
         TargetType="{x:Type local:PlotterControl}"
         BasedOn="{StaticResource PlotterBaseStyle}">
    <Setter Property="PlotStroke" Value="{StaticResource ClockSolidColorBrush}"/>
    <Setter Property="RangeAreaBrush" Value="{StaticResource ClockRangeLinearGradientBrush}"/>
    <Setter Property="YMin" Value="0"/>
    <Setter Property="YMax" Value="6"/>
    <Setter Property="TitleText" Value="Clock"/>
    <Setter Property="ValueText" Value="6 GHz"/>
  </Style>
</ResourceDictionary>