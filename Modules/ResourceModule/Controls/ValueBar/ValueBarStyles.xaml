<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:brushes="clr-namespace:ResourceModule"
                    xmlns:local="clr-namespace:ResourceModule.Controls.Indicator">
  <Style x:Key="BaseValueBarStyle" 
         TargetType="{x:Type local:ValueBar}">
    <Setter Property="TitleForeground" Value="White"/>
    <Setter Property="ValueForeground" Value="{StaticResource StaticValueTextBrush}"/>
    <Setter Property="IndicatorHeight" Value="12"/>
    <Setter Property="IndicatorWidth" Value="4.5cm"/>
    <Setter Property="IndicatorBrush" Value="Green"/>
    <Setter Property="MinValueBrush" Value="Gray"/>
    <Setter Property="MaxValueBrush" Value="Gray"/>
  </Style>
  <Style x:Key="VoltageIndicatorStyle" 
         TargetType="{x:Type local:ValueBar}" 
         BasedOn="{StaticResource BaseValueBarStyle}">
    <Setter Property="IndicatorBrush" Value="{StaticResource VoltageSolidColorBrush}"/>
    
  </Style>

  <Style x:Key="PowerIndicatorStyle"
         TargetType="{x:Type local:ValueBar}" 
         BasedOn="{StaticResource BaseValueBarStyle}"> 
    <!--<Setter Property="TitleForeground" Value="White"/>
    <Setter Property="ValueForeground" Value="White"/>-->
    <!--<Setter Property="MinValueBrush" Value="White"/>
    <Setter Property="MaxValueBrush" Value="White"/>-->
    <Setter Property="IndicatorBrush" Value="{StaticResource PowerSolidColorBrush}"/>
  </Style>
  <Style x:Key="TemperatureIndicatorStyle" 
         TargetType="{x:Type local:ValueBar}" 
         BasedOn="{StaticResource BaseValueBarStyle}">
    <Setter Property="IndicatorBrush" Value="{StaticResource TemperatureSolidColorBrush}"/>
  </Style>
  <Style x:Key="ClocksIndicatorStyle" 
         TargetType="{x:Type local:ValueBar}" 
         BasedOn="{StaticResource BaseValueBarStyle}">
    <Setter Property="IndicatorBrush" Value="{StaticResource ClockSolidColorBrush}"/>
  </Style>
  <Style x:Key="LoadsIndicatorStyle" 
         TargetType="{x:Type local:ValueBar}" 
         BasedOn="{StaticResource BaseValueBarStyle}">
    <Setter Property="IndicatorBrush" Value="{StaticResource LoadSolidColorBrush}"/>
  </Style>
</ResourceDictionary>