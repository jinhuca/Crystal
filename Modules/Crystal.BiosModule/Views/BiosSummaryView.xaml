<UserControl x:Class="Crystal.BiosModule.Views.BiosSummaryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:graphs="clr-namespace:Crystal.Controls.PerformanceGraphs;assembly=Crystal.Controls"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d"
             d:DesignHeight="240" d:DesignWidth="1100"
             Background="Transparent" Foreground="{StaticResource TextBrush}"
             FontFamily="{StaticResource UiFontFamily}">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Crystal.BiosModule;component/Views/BiosResources.xaml"/>
      </ResourceDictionary.MergedDictionaries>
      <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource LabelBrush}"/>
        <Setter Property="FontSize" Value="{StaticResource CaptionFontSize}"/>
      </Style>
      <Style x:Key="FieldValue" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource SpecFontSize}"/>
        <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="Margin" Value="0,0,16,0"/>
      </Style>
      <Style x:Key="FieldCell" TargetType="StackPanel">
        <Setter Property="Margin" Value="0,0,0,10"/>
      </Style>
      <!-- Dim min–max sub-line under a rail. Hidden (not Collapsed) when a bound is missing so the
           line's height is still reserved: otherwise a rail with no range would pull its sparkline
           up a line and break horizontal alignment with the neighbouring rails' graphs. -->
      <Style x:Key="RangeHint" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource BiosDimBrush}"/>
        <Setter Property="FontSize" Value="{StaticResource MicroFontSize}"/>
        <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}"/>
        <Setter Property="Margin" Value="0,-1,16,0"/>
        <Style.Triggers>
          <Trigger Property="Text" Value="">
            <Setter Property="Visibility" Value="Hidden"/>
          </Trigger>
        </Style.Triggers>
      </Style>
      <!-- Compact per-rail sparkline: fixed height, no border, right-margin matches the rail
           value/range columns. Its accent theme is applied per severity in code-behind. -->
      <Style x:Key="RailSpark" TargetType="graphs:PerformanceGraph">
        <Setter Property="Height" Value="16"/>
        <Setter Property="Margin" Value="0,2,16,0"/>
      </Style>
    </ResourceDictionary>
  </UserControl.Resources>
  <Border Background="Transparent" MouseLeftButtonDown="OnTileClick">
    <Grid Margin="10">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- Dense header bar: accent tick + title, thin divider rule below -->
      <Border Grid.Row="0" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1"
              Padding="0,0,0,4" Margin="0,0,0,8">
        <StackPanel Orientation="Horizontal">
          <Border Width="3" Background="{StaticResource AccentBrush}" Margin="0,1,8,1"/>
          <TextBlock Text="BIOS" Foreground="{StaticResource ValueBrush}" FontSize="{StaticResource BodyFontSize}" FontWeight="SemiBold"
                     VerticalAlignment="Center" Margin="0,0,16,0"/>
          <TextBlock Text="{Binding Manufacturer}" Style="{StaticResource HeaderSpec}"
                     TextTrimming="CharacterEllipsis"/>
          <TextBlock Text="{Binding Version, StringFormat=Version {0}}" Style="{StaticResource HeaderSpec}"/>
        </StackPanel>
      </Border>

      <!-- Essential static identity (top) + live board telemetry (bottom). -->
      <StackPanel Grid.Row="1" VerticalAlignment="Top">
        <!-- Firmware interface + security posture (manufacturer/version now ride in the header). -->
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="0" Style="{StaticResource FieldCell}">
            <TextBlock Text="Interface" Style="{StaticResource FieldLabel}"/>
            <TextBlock Text="{Binding FirmwareInterface}" Style="{StaticResource FieldValue}"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Style="{StaticResource FieldCell}">
            <TextBlock Text="Secure Boot" Style="{StaticResource FieldLabel}"/>
            <TextBlock Text="{Binding SecureBoot}" Style="{StaticResource FieldValue}"/>
          </StackPanel>
        </Grid>

        <!-- Board section rule + header. The dot and label track live state: green "LIVE BOARD" only
             when readings are actually arriving, otherwise a dim "BOARD" so the pulse never implies
             live data the machine can't produce (common on laptops with no Super I/O sensors). -->
        <Border BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0" Margin="0,2,0,8" Padding="0,8,0,0">
          <!-- Tooltip names the offending rails; only shown when something is out of tolerance. -->
          <StackPanel Orientation="Horizontal" Background="Transparent"
                      ToolTip="{Binding BoardHealthDetail}">
            <StackPanel.Style>
              <Style TargetType="StackPanel">
                <Setter Property="ToolTipService.IsEnabled" Value="True"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding BoardHealthDetail}" Value="">
                    <Setter Property="ToolTipService.IsEnabled" Value="False"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </StackPanel.Style>
            <Border Width="6" Height="6" CornerRadius="3" VerticalAlignment="Center" Margin="0,0,6,0">
              <Border.Style>
                <Style TargetType="Border">
                  <!-- Dim until sensors arrive; then green healthy, amber/red as BoardHealth
                       worsens. Ordered so the critical trigger wins when several match. -->
                  <Setter Property="Background" Value="#3A424C"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding HasBoardSensors}" Value="True">
                      <Setter Property="Background" Value="{StaticResource OkBrush}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding BoardHealth}" Value="Warning">
                      <Setter Property="Background" Value="#E8B33E"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding BoardHealth}" Value="Critical">
                      <Setter Property="Background" Value="#E85C5C"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Border.Style>
            </Border>
            <TextBlock Foreground="{StaticResource BiosDimBrush}" FontSize="{StaticResource MicroFontSize}" FontWeight="SemiBold"
                       VerticalAlignment="Center">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <!-- Dim "BOARD" until sensors arrive, "LIVE BOARD" once they do. The severity
                       count rides in the badge to the right rather than in this label. -->
                  <Setter Property="Text" Value="BOARD"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding HasBoardSensors}" Value="True">
                      <Setter Property="Text" Value="LIVE BOARD"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <!-- Severity-count badge, e.g. "1 critical · 2 warnings"; tinted by worst severity and
                 hidden while the board is healthy so it only draws the eye when something's wrong. -->
            <TextBlock FontSize="{StaticResource MicroFontSize}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,0,0"
                       Text="{Binding BoardHealthSummary}"
                       Foreground="{Binding BoardHealth, Converter={StaticResource SeverityToBrush}}">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Visibility" Value="Visible"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding BoardHealthSummary}" Value="">
                      <Setter Property="Visibility" Value="Collapsed"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <!-- Session worst-peak badge, e.g. "peak +12V 10.4 V", tinted by that episode's severity.
                 Persists after a transient fault recovers (unlike the live count above, which clears),
                 so the tile still records the session's worst moment. Hidden until something's logged. -->
            <TextBlock FontSize="{StaticResource MicroFontSize}" VerticalAlignment="Center" Margin="10,0,0,0"
                       Foreground="{Binding SessionPeakSeverity, Converter={StaticResource SeverityToBrush}}">
              <Run Text="peak" Foreground="{StaticResource BiosDimBrush}"/>
              <Run Text="{Binding SessionPeak, Mode=OneWay}"/>
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Visibility" Value="Visible"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding SessionPeak}" Value="">
                      <Setter Property="Visibility" Value="Collapsed"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </StackPanel>
        </Border>

        <!-- Driver/availability note shown in place of the readings when the board can't be read -->
        <TextBlock Text="{Binding BoardSensorStatus}" Foreground="{StaticResource LabelBrush}" FontSize="{StaticResource CaptionFontSize}"
                   TextWrapping="Wrap" Margin="0,0,0,8"
                   Visibility="{Binding HasBoardSensorStatus, Converter={StaticResource BoolToVisibility}}"/>

        <!-- Backfill: with no live sensors the readings grid collapses, so surface static firmware
             detail here to keep the tile dense. Shown exactly when the status note is (no sensors). -->
        <Grid Visibility="{Binding HasBoardSensorStatus, Converter={StaticResource BoolToVisibility}}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="0" Style="{StaticResource FieldCell}">
            <TextBlock Text="ROM size" Style="{StaticResource FieldLabel}"/>
            <TextBlock Text="{Binding RomSize}" Style="{StaticResource FieldValue}"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Style="{StaticResource FieldCell}">
            <TextBlock Text="Release date" Style="{StaticResource FieldLabel}"/>
            <TextBlock Text="{Binding ReleaseDate}" Style="{StaticResource FieldValue}"/>
          </StackPanel>
          <StackPanel Grid.Column="2" Style="{StaticResource FieldCell}">
            <TextBlock Text="TPM" Style="{StaticResource FieldLabel}"/>
            <TextBlock Text="{Binding Tpm}" Style="{StaticResource FieldValue}"/>
          </StackPanel>
        </Grid>

        <Grid Visibility="{Binding HasBoardSensors, Converter={StaticResource BoolToVisibility}}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <!-- Row 0: chassis fan / board temp / CMOS battery -->
          <StackPanel Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldCell}">
            <TextBlock Text="Chassis fan" Style="{StaticResource FieldLabel}"/>
            <TextBlock Text="{Binding ChassisFanRpm}" Style="{StaticResource FieldValue}"
                       Foreground="{Binding ChassisFanSeverity, Converter={StaticResource SeverityToBrush}}"/>
            <graphs:PerformanceGraph x:Name="ChassisFanSpark" Style="{StaticResource RailSpark}"
                                     graphs:GraphIdentity.Id="Bios.ChassisFan"
                                     Loaded="OnFanSparkLoaded" MinValue="0" MaxValue="2500"
                                     Visibility="{Binding HasChassisFan, Converter={StaticResource BoolToVisibility}}"/>
          </StackPanel>
          <StackPanel Grid.Row="0" Grid.Column="1" Style="{StaticResource FieldCell}">
            <TextBlock Text="Board temp" Style="{StaticResource FieldLabel}"/>
            <TextBlock Text="{Binding BoardTemperature}" Style="{StaticResource FieldValue}"
                       Foreground="{Binding BoardTemperatureSeverity, Converter={StaticResource SeverityToBrush}}"/>
            <graphs:PerformanceGraph x:Name="BoardTempSpark" Style="{StaticResource RailSpark}"
                                     graphs:GraphIdentity.Id="Bios.BoardTemp"
                                     Loaded="OnBoardTempSparkLoaded" MinValue="20" MaxValue="90"/>
          </StackPanel>
          <StackPanel Grid.Row="0" Grid.Column="2" Style="{StaticResource FieldCell}">
            <TextBlock Text="CMOS battery" Style="{StaticResource FieldLabel}"/>
            <TextBlock Text="{Binding CmosVoltage}" Style="{StaticResource FieldValue}"
                       Foreground="{Binding CmosSeverity, Converter={StaticResource SeverityToBrush}}"/>
            <graphs:PerformanceGraph x:Name="CmosSpark" Style="{StaticResource RailSpark}"
                                     graphs:GraphIdentity.Id="Bios.CmosBattery"
                                     Loaded="OnCmosSparkLoaded" MinValue="2.3" MaxValue="3.4"/>
          </StackPanel>

          <!-- Row 1: voltage rails, each with a dim min–max stability sub-line and a compact
               sparkline. The graph's Y-axis is nominal ±10%, so the plot edges are the critical
               band — a rail hugging the centerline reads as rock-steady at a glance. -->
          <StackPanel Grid.Row="1" Grid.Column="0">
            <TextBlock Text="+3.3V" Style="{StaticResource FieldLabel}"/>
            <TextBlock Text="{Binding Rail3V3}" Style="{StaticResource FieldValue}"
                       Foreground="{Binding Rail3V3Severity, Converter={StaticResource SeverityToBrush}}"/>
            <TextBlock Text="{Binding Rail3V3Range}" Style="{StaticResource RangeHint}"/>
            <graphs:PerformanceGraph x:Name="Rail3V3Spark" Style="{StaticResource RailSpark}"
                                     graphs:GraphIdentity.Id="Bios.Rail3V3"
                                     Loaded="OnGraphLoaded" MinValue="2.97" MaxValue="3.63"/>
          </StackPanel>
          <StackPanel Grid.Row="1" Grid.Column="1">
            <TextBlock Text="+5V" Style="{StaticResource FieldLabel}"/>
            <TextBlock Text="{Binding Rail5V}" Style="{StaticResource FieldValue}"
                       Foreground="{Binding Rail5VSeverity, Converter={StaticResource SeverityToBrush}}"/>
            <TextBlock Text="{Binding Rail5VRange}" Style="{StaticResource RangeHint}"/>
            <graphs:PerformanceGraph x:Name="Rail5VSpark" Style="{StaticResource RailSpark}"
                                     graphs:GraphIdentity.Id="Bios.Rail5V"
                                     Loaded="OnGraphLoaded" MinValue="4.5" MaxValue="5.5"/>
          </StackPanel>
          <StackPanel Grid.Row="1" Grid.Column="2">
            <TextBlock Text="+12V" Style="{StaticResource FieldLabel}"/>
            <TextBlock Text="{Binding Rail12V}" Style="{StaticResource FieldValue}"
                       Foreground="{Binding Rail12VSeverity, Converter={StaticResource SeverityToBrush}}"/>
            <TextBlock Text="{Binding Rail12VRange}" Style="{StaticResource RangeHint}"/>
            <graphs:PerformanceGraph x:Name="Rail12VSpark" Style="{StaticResource RailSpark}"
                                     graphs:GraphIdentity.Id="Bios.Rail12V"
                                     Loaded="OnGraphLoaded" MinValue="10.8" MaxValue="13.2"/>
          </StackPanel>
        </Grid>
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
