<UserControl x:Class="Crystal.BiosModule.Views.BiosSummaryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:sv="clr-namespace:Crystal.BiosModule.Views.SummaryViews"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d"
             d:DesignHeight="240" d:DesignWidth="1100"
             Background="Transparent" Foreground="{StaticResource TextBrush}"
             FontFamily="{StaticResource UiFontFamily}">
  <!-- Layout only: the header and each section live in Views/SummaryViews. Every sub-view inherits
       the root IBiosViewModel; the board-readings view self-registers its sparklines on load. -->
  <Border Background="Transparent" MouseLeftButtonDown="OnTileClick">
    <Grid Margin="10">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <sv:BiosHeaderView Grid.Row="0"/>

      <!-- Essential static identity (top) + live board telemetry (bottom). -->
      <StackPanel Grid.Row="1" VerticalAlignment="Top">
        <sv:BiosFirmwareView/>
        <sv:BiosBoardStatusView/>
        <sv:BiosBoardReadingsView/>
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
