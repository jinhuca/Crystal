<UserControl x:Class="Crystal.BiosModule.Views.SummaryViews.BiosBoardReadingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:graphs="clr-namespace:Crystal.Controls.PerformanceGraphs;assembly=Crystal.Controls"
             mc:Ignorable="d"
             d:DesignWidth="1100"
             Background="Transparent" Foreground="{StaticResource TextBrush}"
             FontFamily="{StaticResource UiFontFamily}">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Crystal.BiosModule;component/Views/SummaryViews/BiosSummaryResources.xaml"/>
        <ResourceDictionary Source="/Crystal.Controls;component/Metrics/MetricEnrichmentResources.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>
  <!-- Static firmware backfill (when no live sensors) + live board telemetry with sparklines.
       Inherits the root IBiosViewModel from the host tile; each graph self-attaches on load. -->
  <StackPanel>
    <!-- Backfill: with no live sensors the readings grid collapses, so surface static firmware
         detail here to keep the tile dense. Shown exactly when the status note is (no sensors). -->
    <Grid Visibility="{Binding HasBoardSensorStatus, Converter={StaticResource BoolToVisibility}}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0" Style="{StaticResource FieldCell}">
        <TextBlock Text="ROM size" Style="{StaticResource FieldLabel}"/>
        <TextBlock Text="{Binding RomSize}" Style="{StaticResource FieldValue}"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Style="{StaticResource FieldCell}">
        <TextBlock Text="Release date" Style="{StaticResource FieldLabel}"/>
        <TextBlock Text="{Binding ReleaseDate}" Style="{StaticResource FieldValue}"/>
      </StackPanel>
      <StackPanel Grid.Column="2" Style="{StaticResource FieldCell}">
        <TextBlock Text="TPM" Style="{StaticResource FieldLabel}"/>
        <TextBlock Text="{Binding Tpm}" Style="{StaticResource FieldValue}"/>
      </StackPanel>
    </Grid>

    <Grid Visibility="{Binding HasBoardSensors, Converter={StaticResource BoolToVisibility}}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- Row 0: chassis fan / board temp / CMOS battery -->
      <StackPanel Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldCell}">
        <TextBlock Text="Chassis fan" Style="{StaticResource FieldLabel}"/>
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="{Binding ChassisFanRpm}" Style="{StaticResource FieldValue}"
                     Foreground="{Binding ChassisFanSeverity, Converter={StaticResource SeverityToBrush}}"/>
          <TextBlock Text="{Binding ChassisFanRow.Trend, Converter={StaticResource TrendToGlyph}}"
                     Foreground="{Binding ChassisFanRow.Trend, Converter={StaticResource TrendToBrush}}"
                     VerticalAlignment="Center" Margin="6,0,0,0"/>
        </StackPanel>
      </StackPanel>
      <StackPanel Grid.Row="0" Grid.Column="1" Style="{StaticResource FieldCell}">
        <TextBlock Text="Board temp" Style="{StaticResource FieldLabel}"/>
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="{Binding BoardTemperature}" Style="{StaticResource FieldValue}"
                     Foreground="{Binding BoardTemperatureSeverity, Converter={StaticResource SeverityToBrush}}"/>
          <TextBlock Text="{Binding BoardTempRow.Trend, Converter={StaticResource TrendToGlyph}}"
                     Foreground="{Binding BoardTempRow.Trend, Converter={StaticResource TrendToBrush}}"
                     VerticalAlignment="Center" Margin="6,0,0,0"/>
        </StackPanel>
      </StackPanel>
      <StackPanel Grid.Row="0" Grid.Column="2" Style="{StaticResource FieldCell}"
                  Visibility="{Binding ShowVoltageRails, Converter={StaticResource BoolToVisibility}}">
        <TextBlock Text="CMOS battery" Style="{StaticResource FieldLabel}"/>
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="{Binding CmosVoltage}" Style="{StaticResource FieldValue}"
                     Foreground="{Binding CmosSeverity, Converter={StaticResource SeverityToBrush}}"/>
          <TextBlock Text="{Binding CmosRow.Trend, Converter={StaticResource TrendToGlyph}}"
                     Foreground="{Binding CmosRow.Trend, Converter={StaticResource TrendToBrush}}"
                     VerticalAlignment="Center" Margin="6,0,0,0"/>
        </StackPanel>
      </StackPanel>

      <!-- Row 1: voltage rails, each with a dim min–max stability sub-line and a compact
           sparkline. The graph's Y-axis is nominal ±10%, so the plot edges are the critical
           band — a rail hugging the centerline reads as rock-steady at a glance. -->
      <StackPanel Grid.Row="1" Grid.Column="0"
                  Visibility="{Binding ShowVoltageRails, Converter={StaticResource BoolToVisibility}}">
        <TextBlock Text="+3.3V" Style="{StaticResource FieldLabel}"/>
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="{Binding Rail3V3}" Style="{StaticResource FieldValue}"
                     Foreground="{Binding Rail3V3Severity, Converter={StaticResource SeverityToBrush}}"/>
          <TextBlock Text="{Binding Rail3V3Row.Trend, Converter={StaticResource TrendToGlyph}}"
                     Foreground="{Binding Rail3V3Row.Trend, Converter={StaticResource TrendToBrush}}"
                     VerticalAlignment="Center" Margin="6,0,0,0"/>
        </StackPanel>
        <TextBlock Text="{Binding Rail3V3Range}" Style="{StaticResource RangeHint}"/>
      </StackPanel>
      <StackPanel Grid.Row="1" Grid.Column="1"
                  Visibility="{Binding ShowVoltageRails, Converter={StaticResource BoolToVisibility}}">
        <TextBlock Text="+5V" Style="{StaticResource FieldLabel}"/>
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="{Binding Rail5V}" Style="{StaticResource FieldValue}"
                     Foreground="{Binding Rail5VSeverity, Converter={StaticResource SeverityToBrush}}"/>
          <TextBlock Text="{Binding Rail5VRow.Trend, Converter={StaticResource TrendToGlyph}}"
                     Foreground="{Binding Rail5VRow.Trend, Converter={StaticResource TrendToBrush}}"
                     VerticalAlignment="Center" Margin="6,0,0,0"/>
        </StackPanel>
        <TextBlock Text="{Binding Rail5VRange}" Style="{StaticResource RangeHint}"/>
      </StackPanel>
      <StackPanel Grid.Row="1" Grid.Column="2"
                  Visibility="{Binding ShowVoltageRails, Converter={StaticResource BoolToVisibility}}">
        <TextBlock Text="+12V" Style="{StaticResource FieldLabel}"/>
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="{Binding Rail12V}" Style="{StaticResource FieldValue}"
                     Foreground="{Binding Rail12VSeverity, Converter={StaticResource SeverityToBrush}}"/>
          <TextBlock Text="{Binding Rail12VRow.Trend, Converter={StaticResource TrendToGlyph}}"
                     Foreground="{Binding Rail12VRow.Trend, Converter={StaticResource TrendToBrush}}"
                     VerticalAlignment="Center" Margin="6,0,0,0"/>
        </StackPanel>
        <TextBlock Text="{Binding Rail12VRange}" Style="{StaticResource RangeHint}"/>
      </StackPanel>
    </Grid>
  </StackPanel>
</UserControl>
