<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:Crystal.BiosModule.Views">
  <!-- Module-only resources shared across the BIOS summary tile and detail view. Colors that
       match the solution-wide palette (accent/label/value/rule) are referenced directly from
       Crystal.Resources; only the module-specific severity converter and dim sub-line brush
       live here. Field styles stay per-view (the tile is denser than the detail view). -->
  <views:ReadingSeverityToBrushConverter x:Key="SeverityToBrush"/>

  <!-- Dim grey for min–max sub-lines / peak markers; not part of the shared palette. -->
  <SolidColorBrush x:Key="BiosDimBrush" Color="#5A6470"/>
</ResourceDictionary>
