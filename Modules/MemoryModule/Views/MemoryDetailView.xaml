<UserControl x:Class="MemoryModule.Views.MemoryDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="1100"
             Background="#101317" Foreground="White"
             FontFamily="Segoe UI">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="0,0,0,16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Button Grid.Column="0" Content="&#x2190; Back" Padding="14,6"
              Background="#1E2A38" Foreground="White" BorderThickness="0"
              Command="{Binding ShowDashboardCommand}"/>
      <TextBlock Grid.Column="1" Text="Memory" Foreground="#3E9BE8" FontSize="28"
                 FontWeight="SemiBold" VerticalAlignment="Center" Margin="16,0,0,0"/>
    </Grid>

    <!-- Rolled-up totals -->
    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,20">
      <StackPanel Margin="0,0,48,0">
        <TextBlock Text="{Binding TotalCapacityLabel}" FontSize="30" FontWeight="Light"/>
        <TextBlock Text="Total installed" Foreground="#8A94A0" FontSize="12"/>
      </StackPanel>
      <StackPanel Margin="0,0,48,0">
        <TextBlock Text="{Binding SlotsLabel}" FontSize="30" FontWeight="Light"/>
        <TextBlock Text="Slots" Foreground="#8A94A0" FontSize="12"/>
      </StackPanel>
      <StackPanel>
        <TextBlock Text="{Binding MaxSpeedLabel}" FontSize="30" FontWeight="Light"/>
        <TextBlock Text="Max speed" Foreground="#8A94A0" FontSize="12"/>
      </StackPanel>
    </StackPanel>

    <!-- Per-slot module list -->
    <ItemsControl Grid.Row="2" ItemsSource="{Binding Modules}">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Border Margin="0,0,0,10" Padding="16" Background="#161B22" CornerRadius="8">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <StackPanel Grid.Row="0" Orientation="Horizontal">
                <TextBlock Text="{Binding SlotLabel}" Foreground="#3E9BE8" FontSize="16"
                           FontWeight="SemiBold" Width="140"/>
                <TextBlock Text="{Binding CapacityLabel}" FontSize="16" Width="100"/>
                <TextBlock Text="{Binding SpeedLabel}" Foreground="#C8C8C8" Width="120"/>
                <TextBlock Text="{Binding FormFactor}" Foreground="#C8C8C8"/>
              </StackPanel>
              <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                <StackPanel Width="260">
                  <TextBlock Text="Manufacturer" Foreground="#8A94A0" FontSize="11"/>
                  <TextBlock Text="{Binding Manufacturer}"/>
                </StackPanel>
                <StackPanel Width="260">
                  <TextBlock Text="Part number" Foreground="#8A94A0" FontSize="11"/>
                  <TextBlock Text="{Binding PartNumber}"/>
                </StackPanel>
                <StackPanel>
                  <TextBlock Text="Configured speed" Foreground="#8A94A0" FontSize="11"/>
                  <TextBlock Text="{Binding ConfiguredSpeedLabel}"/>
                </StackPanel>
              </StackPanel>
            </Grid>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </Grid>
</UserControl>
