<UserControl x:Class="Crystal.CpuModule.Views.CpuSummaryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:sv="clr-namespace:Crystal.CpuModule.Views.SummaryViews"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d"
             d:DesignHeight="240" d:DesignWidth="1000"
             Background="Transparent" Foreground="{StaticResource TextBrush}"
             FontFamily="{StaticResource UiFontFamily}">
  <!-- Layout only: the header and each metric tile live in Views/SummaryViews.
       The body grid sets DataContext to SensorsViewModel so every metric tile inherits it;
       the header inherits the root ICpuViewModel (it needs both SpecsViewModel and SensorsViewModel).
       Three columns per CpuSV.png: (1/4) fixed-size value-banded metric tiles aligned left,
       (1/2) the full CPU-utilization graph in the middle, (1/4) the live per-core strip aligned
       right. History graphs for clock/voltage/temperature/power/fan now live in the detail view. -->
  <Border Background="Transparent" MouseLeftButtonDown="OnTileClick">
    <Grid Margin="5" ShowGridLines="False">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
			</Grid.RowDefinitions>
      <sv:CpuHeaderView Grid.Row="0"/>
      <Grid Grid.Row="1" DataContext="{Binding SensorsViewModel}" Margin="10,5,0,5" ShowGridLines="False">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1.1*"/>
          <ColumnDefinition Width="2*"/>
          <ColumnDefinition Width="1.4*"/>
        </Grid.ColumnDefinitions>
        <!-- Column 0: fixed-size metric tiles, aligned left. -->
        <Grid Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,10,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <sv:CpuClockView       Grid.Row="0" Grid.Column="0" Margin="0,0,42,15"/>
          <sv:CpuTemperatureView Grid.Row="0" Grid.Column="1" Margin="0,0,42,15"/>
          <sv:CpuPowerView       Grid.Row="0" Grid.Column="2" Margin="0,0,0,15"/>
          <sv:CpuVoltageView     Grid.Row="1" Grid.Column="0" Margin="0,0,42,0"/>
          <sv:CpuFanView         Grid.Row="1" Grid.Column="1" Margin="0,0,42,0"/>
        </Grid>

        <!-- Column 1: full CPU-utilization graph, centered. -->
        <sv:CpuUtilizationView Grid.Column="1" Margin="10,0,10,0"/>

        <!-- Column 2: live per-core strip, aligned right. -->
        <sv:CpuCoreStripView Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"/>
      </Grid>
    </Grid>
  </Border>
</UserControl>
