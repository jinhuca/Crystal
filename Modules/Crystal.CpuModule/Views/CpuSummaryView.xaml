<UserControl x:Class="Crystal.CpuModule.Views.CpuSummaryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:sv="clr-namespace:Crystal.CpuModule.Views.SummaryViews"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d"
             d:DesignHeight="240" d:DesignWidth="1000"
             Background="Transparent" Foreground="{StaticResource TextBrush}"
             FontFamily="{StaticResource UiFontFamily}">
  <!-- Layout only: the header and each metric tile live in Views/SummaryViews. 
       The body grid sets DataContext to SensorsViewModel so every metric tile inherits it; 
       the header inherits the root ICpuViewModel (it needs both SpecsViewModel and SensorsViewModel). 
       Each metric tile that owns a history graph self-registers it with the view model on load. -->
  <Border Background="Transparent" MouseLeftButtonDown="OnTileClick">
    <Grid Margin="5">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <sv:CpuHeaderView Grid.Row="0"/>

      <Grid Grid.Row="1" DataContext="{Binding SensorsViewModel}" Margin="10,5,0,5">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Column 0: Clock (top) + Voltage (bottom) -->
        <Grid Grid.Column="0" Margin="0,0,10,0" VerticalAlignment="Top">
          <Grid.RowDefinitions>
            <RowDefinition Height="1"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="1"/>
          </Grid.RowDefinitions>
          <sv:CpuClockView Grid.Row="1"/>
          <sv:CpuVoltageView Grid.Row="3"/>
        </Grid>

        <!-- Column 1: Temperature (top) + Power (bottom) -->
        <Grid Grid.Column="1" Margin="0,0,10,0" VerticalAlignment="Top">
          <Grid.RowDefinitions>
            <RowDefinition Height="1"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="1"/>
          </Grid.RowDefinitions>
          <sv:CpuTemperatureView Grid.Row="1"/>
          <sv:CpuPowerView Grid.Row="3"/>
        </Grid>

        <!-- Column 2: Utilization (top) + CPU Fan (bottom) -->
        <Grid Grid.Column="2" Margin="0,0,10,0" VerticalAlignment="Top">
          <Grid.RowDefinitions>
            <RowDefinition Height="1"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="1"/>
          </Grid.RowDefinitions>
          <sv:CpuUtilizationView Grid.Row="1"/>
          <sv:CpuFanView Grid.Row="3"/>
        </Grid>

        <!-- Column 3: per-core strip -->
        <sv:CpuCoreStripView Grid.Column="3"/>
      </Grid>
    </Grid>
  </Border>
</UserControl>
