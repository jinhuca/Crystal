<UserControl x:Class="Crystal.CpuModule.Views.CpuSummaryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:sv="clr-namespace:Crystal.CpuModule.Views.SummaryViews"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d"
             d:DesignHeight="240" d:DesignWidth="1000"
             Background="Transparent" Foreground="{StaticResource TextBrush}"
             FontFamily="{StaticResource UiFontFamily}">
  <!-- Layout only: the header and each metric tile live in Views/SummaryViews.
       The body grid sets DataContext to SensorsViewModel so every metric tile inherits it;
       the header inherits the root ICpuViewModel (it needs both SpecsViewModel and SensorsViewModel).
       Three columns per CpuSV.png: (1/4) fixed-size value-banded metric tiles aligned left,
       (1/2) the full CPU-utilization graph in the middle, (1/4) the live per-core strip aligned
       right. History graphs for clock/voltage/temperature/power/fan now live in the detail view. -->
  <Border Background="Transparent" MouseLeftButtonDown="OnTileClick">
    <Grid Margin="5" ShowGridLines="False">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
			</Grid.RowDefinitions>
      <sv:CpuHeaderView Grid.Row="0"/>
      <Grid Grid.Row="1" DataContext="{Binding SensorsViewModel}" Margin="10,2,0,2" ShowGridLines="False">
        <Grid.RowDefinitions>
          <RowDefinition/>
          <RowDefinition/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1*"/>
          <ColumnDefinition Width="1*"/>
          <ColumnDefinition Width="1*"/>
          <ColumnDefinition Width="0.6*"/>
        </Grid.ColumnDefinitions>
        
        <sv:CpuClockView       Grid.Row="0" Grid.Column="0" Margin="0,10,10,10"/>
        <sv:CpuTemperatureView Grid.Row="0" Grid.Column="1" Margin="10,10,10,10"/>
        <sv:CpuPowerView       Grid.Row="1" Grid.Column="2" Margin="10,10,20,10"/>
        <sv:CpuVoltageView     Grid.Row="1" Grid.Column="0" Margin="0,10,10,10"/>
        <sv:CpuFanView         Grid.Row="1" Grid.Column="1" Margin="10,10,10,10"/>

        <!-- CPU-utilization graph -->
        <sv:CpuUtilizationView Grid.Column="2" Margin="10,10,20,10"/>

        <!-- live per-core strip -->
        <sv:CpuCoreStripView Grid.Column="3" Grid.Row="0" Grid.RowSpan="2" HorizontalAlignment="Center" VerticalAlignment="Top"/>

        <!-- Instruction set features: compact single-line strip across the bottom. Sourced from the
             root VM's SpecsViewModel (the body grid's DataContext is SensorsViewModel), each ISA
             extension lit green when available, dimmed when not. -->
        <ItemsControl Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="4" Margin="0,6,0,0"
                      VerticalAlignment="Center"
                      DataContext="{Binding DataContext.SpecsViewModel, RelativeSource={RelativeSource AncestorType=UserControl}}"
                      ItemsSource="{Binding InstructionSet}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel Orientation="Horizontal"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Name}" FontSize="9" FontWeight="SemiBold"
                         Margin="0,0,5,0">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="#4A4A4A"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsAvailable}" Value="True">
                        <Setter Property="Foreground" Value="{StaticResource OkBrush}"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

      </Grid>
    </Grid>
  </Border>
</UserControl>
