<UserControl x:Class="Crystal.CpuModule.Views.SummaryViews.CpuVoltageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:graphs="clr-namespace:Crystal.Controls.PerformanceGraphs;assembly=Crystal.Controls"
             mc:Ignorable="d"
             d:DesignHeight="90" d:DesignWidth="320">
  <!-- DataContext is the CPU SensorsViewModel, inherited from the host tile. -->
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>
    <graphs:PerformanceGraphLite x:Name="CpuVoltageGraph" Grid.Column="0"
                                 graphs:GraphIdentity.Id="Cpu.Voltage"
                                 Style="{StaticResource SquareDotGraphLiteStyle}"
                                 MinHeight="{StaticResource SummaryGraphMinHeight}"
                                 Margin="0,1,0,1" MinValue="0" MaxValue="2"/>
    <StackPanel Grid.Column="1" Style="{StaticResource SummaryStackPanelStyle}">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="{Binding Voltage, StringFormat={}{0:0.00}}" Style="{StaticResource MetricValue}" FontSize="{StaticResource BigValueFontSize}"/>
        <TextBlock Text="Volt" Style="{StaticResource MetricUnit}"/>
      </StackPanel>
      <TextBlock Text="Voltage" Style="{StaticResource MetricCaption}"/>
      <TextBlock Text="{Binding SocVoltage, StringFormat=SoC {0:0.00} V}" Style="{StaticResource MetricCaption}"/>
    </StackPanel>
  </Grid>
</UserControl>
