<UserControl x:Class="Crystal.CpuModule.Views.SummaryViews.CpuClockView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:graphs="clr-namespace:Crystal.Controls.PerformanceGraphs;assembly=Crystal.Controls"
             mc:Ignorable="d"
             d:DesignHeight="120" d:DesignWidth="260">
  <!-- DataContext is the CPU SensorsViewModel, inherited from the host tile. Clock history graph,
       titled in the utilization pattern: metric label + inline sub-details (left), live value (right).
       Self-registers under "Cpu.Clock" so the view model feeds it on each poll. -->
  <Grid VerticalAlignment="Stretch" Background="Transparent">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="0,0,0,4">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Bottom">
        <TextBlock Text="Clock" Style="{StaticResource MetricCaption}" Foreground="{StaticResource TextBrush}"/>
        <TextBlock Text="{Binding EffectiveSpeedGhz, StringFormat=eff {0:0.00} GHz}" Style="{StaticResource MetricCaption}" Margin="10,0,0,0"/>
        <TextBlock Text="{Binding BusSpeedMHz, StringFormat=BCLK {0:0.0} MHz}" Style="{StaticResource MetricCaption}" Margin="10,0,0,0"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
        <TextBlock Text="{Binding SpeedGhz, StringFormat={}{0:0.00}}" Style="{StaticResource UtilizationCaption}" VerticalAlignment="Bottom"/>
        <TextBlock Text="GHz" Style="{StaticResource MetricUnit}" VerticalAlignment="Bottom"/>
      </StackPanel>
    </Grid>

    <graphs:AdaptiveGraph x:Name="ClockGraph" Grid.Row="1"
                          graphs:GraphIdentity.Id="Cpu.Clock"
                          Capacity="120" MinValue="0" MaxValue="6"
                          Accent="{StaticResource GraphPurpleColor}" 
                          ShowChrome="True" 
                          MinHeight="40"
                          CellPitch="{StaticResource DashboardDotPitch}"/>
  </Grid>
</UserControl>
