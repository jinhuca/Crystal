<UserControl x:Class="Crystal.CpuModule.Views.SummaryViews.CpuClockView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:graphs="clr-namespace:Crystal.Controls.PerformanceGraphs;assembly=Crystal.Controls"
             mc:Ignorable="d"
             d:DesignHeight="120" d:DesignWidth="520">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Crystal.Controls;component/Metrics/MetricEnrichmentResources.xaml"/>
        <ResourceDictionary Source="/Crystal.Resources;component/Styles/BorderStyles.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>
  <!-- DataContext is the CPU SensorsViewModel, inherited from the host tile. Two columns:
       (left) the metric title — label + inline BCLK, live value on the right — over the clock
       history graph; (right) the clock-domain breakdown table (Core / Effective) with each
       domain's value and session min/max in GHz. The graph self-registers under "Cpu.Clock" so
       the view model feeds it each poll. -->
  <Border Style="{StaticResource SummaryTileBorderStyle}">
    <Grid MinHeight="60" ShowGridLines="False">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- Left column: title + history graph -->
      <Grid Grid.Column="0" VerticalAlignment="Stretch">
        <Grid.RowDefinitions>
          <RowDefinition Height="20"/>
          <RowDefinition Height="1.6*"/>
          <RowDefinition Height=".7*"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="4,0,0,4">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Bottom">
            <TextBlock Text="Clock" Style="{StaticResource SummaryTileTitleTextBlockStyle}"/>
            <TextBlock Text="{Binding BusSpeedMHz, StringFormat=BCLK {0:0.0} MHz}" Style="{StaticResource SummaryTileSubtitleTextBlockStyle}" Margin="10,0,0,0"/>
          </StackPanel>
        </Grid>
        <Grid Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" ShowGridLines="False">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="60"/>
            <ColumnDefinition Width="40"/>
            <ColumnDefinition Width="40"/>
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" 
                     Text="{Binding SpeedGhz, StringFormat={}{0:0.00}}" Style="{StaticResource TileMetricValue}"/>
          <TextBlock Grid.Column="1"
                     Text="GHz" Style="{StaticResource MetricUnit}"/>
          <TextBlock Grid.Column="2" 
                     Text="{Binding ClockRows[0].Trend, Converter={StaticResource TrendToGlyph}}"
                     Foreground="{Binding ClockRows[0].Trend, Converter={StaticResource TrendToBrush}}"
                     Style="{StaticResource MetricUnit}" Margin="4,0,0,0"/>
        </Grid>
        <StackPanel Grid.Row="2" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,0,0,0">
          <TextBlock Style="{StaticResource MetricStatLine}">
          <Run Text="min " Foreground="{StaticResource AccentBrush}"/><Run Text="{Binding ClockRows[0].Min, StringFormat={}{0:0.00}}"/>
          <Run Text="   avg " Foreground="{StaticResource AccentBrush}"/><Run Text="{Binding ClockRows[0].Avg, StringFormat={}{0:0.00}}"/>
          <Run Text="   max " Foreground="{StaticResource AccentBrush}"/><Run Text="{Binding ClockRows[0].Max, StringFormat={}{0:0.00}}"/>
          </TextBlock>
        </StackPanel>
      </Grid>

      <!-- Right column: clock-domain table -->
      <Grid Grid.Column="1" Margin="0,0,0,0" VerticalAlignment="Top" HorizontalAlignment="Right" ShowGridLines="False">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Column headers -->
        <TextBlock Grid.Row="0" Grid.Column="1" Text="Value" Style="{StaticResource MetricTableHeader}"/>
        <TextBlock Grid.Row="0" Grid.Column="2" Text="Min"   Style="{StaticResource MetricTableHeader}"/>
        <TextBlock Grid.Row="0" Grid.Column="3" Text="Max"   Style="{StaticResource MetricTableHeader}"/>

        <!-- Core -->
        <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding ClockRows[0].Label}" Style="{StaticResource MetricTableLabel}"/>
        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ClockRows[0].Value, StringFormat={}{0:0.00}}" Style="{StaticResource MetricTableValue}"/>
        <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding ClockRows[0].Min, StringFormat={}{0:0.00}}"   Style="{StaticResource MetricTableValue}"/>
        <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding ClockRows[0].Max, StringFormat={}{0:0.00}}"   Style="{StaticResource MetricTableValue}"/>

        <!-- Effective -->
        <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding ClockRows[1].Label}" Style="{StaticResource MetricTableLabel}"/>
        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ClockRows[1].Value, StringFormat={}{0:0.00}}" Style="{StaticResource MetricTableValue}"/>
        <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding ClockRows[1].Min, StringFormat={}{0:0.00}}"   Style="{StaticResource MetricTableValue}"/>
        <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding ClockRows[1].Max, StringFormat={}{0:0.00}}"   Style="{StaticResource MetricTableValue}"/>
      </Grid>
    </Grid>
  </Border>
</UserControl>
