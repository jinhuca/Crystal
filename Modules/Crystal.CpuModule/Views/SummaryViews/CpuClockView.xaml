<UserControl x:Class="Crystal.CpuModule.Views.SummaryViews.CpuClockView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:graphs="clr-namespace:Crystal.Controls.PerformanceGraphs;assembly=Crystal.Controls"
             mc:Ignorable="d"
             d:DesignHeight="120" d:DesignWidth="520">
  <!-- DataContext is the CPU SensorsViewModel, inherited from the host tile. Two columns:
       (left) the metric title — label + inline BCLK, live value on the right — over the clock
       history graph; (right) the clock-domain breakdown table (Core / Effective) with each
       domain's value and session min/max in GHz. The graph self-registers under "Cpu.Clock" so
       the view model feeds it each poll. -->
  <Grid Background="Transparent">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>

    <!-- Left column: title + history graph -->
    <Grid Grid.Column="0" VerticalAlignment="Stretch">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <Grid Grid.Row="0" Margin="0,0,0,4">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Bottom">
          <TextBlock Text="Clock" Style="{StaticResource MetricCaption}" Foreground="{StaticResource TextBrush}"/>
          <TextBlock Text="{Binding BusSpeedMHz, StringFormat=BCLK {0:0.0} MHz}" Style="{StaticResource MetricCaption}" Margin="10,0,0,0"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
          <TextBlock Text="{Binding SpeedGhz, StringFormat={}{0:0.00}}" Style="{StaticResource TileMetricValue}"/>
          <TextBlock Text="GHz" Style="{StaticResource MetricUnit}"/>
        </StackPanel>
      </Grid>

      <graphs:AdaptiveGraph x:Name="ClockGraph" Grid.Row="1"
                            graphs:GraphIdentity.Id="Cpu.Clock"
                            Capacity="90" MinValue="0" MaxValue="6"
                            BandedLine="False" ShowChrome="True" MinHeight="40"
                            Accent="{StaticResource GraphAccentClock}" 
                            CellPitch="{StaticResource DashboardDotPitch}"/>
    </Grid>

    <!-- Right column: clock-domain table -->
    <Grid Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Top" HorizontalAlignment="Right">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- Column headers -->
      <TextBlock Grid.Row="0" Grid.Column="1" Text="Value" Style="{StaticResource MetricTableHeader}"/>
      <TextBlock Grid.Row="0" Grid.Column="2" Text="Min"   Style="{StaticResource MetricTableHeader}"/>
      <TextBlock Grid.Row="0" Grid.Column="3" Text="Max"   Style="{StaticResource MetricTableHeader}"/>

      <!-- Core -->
      <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding ClockRows[0].Label}" Style="{StaticResource MetricTableLabel}"/>
      <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ClockRows[0].Value, StringFormat={}{0:0.00}}" Style="{StaticResource MetricTableValue}"/>
      <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding ClockRows[0].Min, StringFormat={}{0:0.00}}"   Style="{StaticResource MetricTableValue}"/>
      <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding ClockRows[0].Max, StringFormat={}{0:0.00}}"   Style="{StaticResource MetricTableValue}"/>

      <!-- Effective -->
      <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding ClockRows[1].Label}" Style="{StaticResource MetricTableLabel}"/>
      <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ClockRows[1].Value, StringFormat={}{0:0.00}}" Style="{StaticResource MetricTableValue}"/>
      <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding ClockRows[1].Min, StringFormat={}{0:0.00}}"   Style="{StaticResource MetricTableValue}"/>
      <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding ClockRows[1].Max, StringFormat={}{0:0.00}}"   Style="{StaticResource MetricTableValue}"/>
    </Grid>

    <!-- Full-height accent divider: closes the group in the Clock graph's accent color, separating
         it from the next metric group. -->
    <Border Grid.Column="2" Width="2" Margin="12,0,0,0" VerticalAlignment="Stretch">
      <Border.Background><SolidColorBrush Color="{StaticResource GraphAccentClock}"/></Border.Background>
    </Border>
  </Grid>
</UserControl>
