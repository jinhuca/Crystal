<UserControl x:Class="Crystal.CpuModule.Views.SummaryViews.CpuClockView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:graphs="clr-namespace:Crystal.Controls.PerformanceGraphs;assembly=Crystal.Controls"
             mc:Ignorable="d"
             d:DesignHeight="90" d:DesignWidth="320">
  <!-- DataContext is the CPU SensorsViewModel, inherited from the host tile. -->
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>
    <graphs:PerformanceGraphLite x:Name="CpuClockGraph" Grid.Column="0"
                                 graphs:GraphIdentity.Id="Cpu.Clock"
                                 Style="{StaticResource SquareDotGraphLiteStyle}"
                                 MinValue="0" MaxValue="6"
                                 MinHeight="{StaticResource SummaryGraphMinHeight}"/>
    <StackPanel Grid.Column="1" Style="{StaticResource SummaryStackPanelStyle}">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="{Binding SpeedGhz, StringFormat={}{0:0.00}}" Style="{StaticResource MetricValue}"/>
        <TextBlock Text="GHz" Style="{StaticResource MetricUnit}"/>
      </StackPanel>
      <TextBlock Text="Clock" Style="{StaticResource MetricCaption}"/>
      <TextBlock Text="{Binding EffectiveSpeedGhz, StringFormat=eff {0:0.00} GHz}" Style="{StaticResource MetricCaption}"/>
      <TextBlock Text="{Binding BusSpeedMHz, StringFormat=BCLK {0:0.0} MHz}" Style="{StaticResource MetricCaption}"/>
    </StackPanel>
  </Grid>
</UserControl>
