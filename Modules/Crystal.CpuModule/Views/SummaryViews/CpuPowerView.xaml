<UserControl x:Class="Crystal.CpuModule.Views.SummaryViews.CpuPowerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:graphs="clr-namespace:Crystal.Controls.PerformanceGraphs;assembly=Crystal.Controls"
             mc:Ignorable="d"
             d:DesignHeight="90" d:DesignWidth="320">
  <!-- DataContext is the CPU SensorsViewModel, inherited from the host tile. -->
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>
    <graphs:PerformanceGraphLite x:Name="CpuPowerGraph" Grid.Column="0"
                                 graphs:GraphIdentity.Id="Cpu.Power"
                                 Style="{StaticResource SquareDotGraphLiteStyle}"
                                 MinHeight="{StaticResource SummaryGraphMinHeight}"
                                 Margin="0,1,0,1" MinValue="0" MaxValue="100"/>
    <StackPanel Grid.Column="1" Style="{StaticResource SummaryStackPanelStyle}">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="{Binding Power, StringFormat={}{0:0.00}}" Style="{StaticResource MetricValue}"/>
        <TextBlock Text="Watts" Style="{StaticResource MetricUnit}"/>
      </StackPanel>
      <TextBlock Text="Power" Style="{StaticResource MetricCaption}"/>
      <!-- Intel RAPL power limits; hidden when not exposed (read 0 on AMD). -->
      <TextBlock Text="{Binding PowerLimitLongW, StringFormat=PL1 {0:0} W}">
        <TextBlock.Style>
          <Style TargetType="TextBlock" BasedOn="{StaticResource MetricCaption}">
            <Style.Triggers>
              <DataTrigger Binding="{Binding PowerLimitLongW}" Value="0">
                <Setter Property="Visibility" Value="Collapsed"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>
      <TextBlock Text="{Binding PowerLimitShortW, StringFormat=PL2 {0:0} W}">
        <TextBlock.Style>
          <Style TargetType="TextBlock" BasedOn="{StaticResource MetricCaption}">
            <Style.Triggers>
              <DataTrigger Binding="{Binding PowerLimitShortW}" Value="0">
                <Setter Property="Visibility" Value="Collapsed"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>
      <!-- AMD SMU package current; hidden when not exposed (read 0 on Intel). -->
      <TextBlock Text="{Binding TdcAmps, StringFormat=TDC {0:0} A}">
        <TextBlock.Style>
          <Style TargetType="TextBlock" BasedOn="{StaticResource MetricCaption}">
            <Style.Triggers>
              <DataTrigger Binding="{Binding TdcAmps}" Value="0">
                <Setter Property="Visibility" Value="Collapsed"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>
      <TextBlock Text="{Binding EdcAmps, StringFormat=EDC {0:0} A}">
        <TextBlock.Style>
          <Style TargetType="TextBlock" BasedOn="{StaticResource MetricCaption}">
            <Style.Triggers>
              <DataTrigger Binding="{Binding EdcAmps}" Value="0">
                <Setter Property="Visibility" Value="Collapsed"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>
    </StackPanel>
  </Grid>
</UserControl>
