<UserControl x:Class="Crystal.CpuModule.Views.SummaryViews.CpuPowerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:graphs="clr-namespace:Crystal.Controls.PerformanceGraphs;assembly=Crystal.Controls"
             mc:Ignorable="d"
             d:DesignHeight="120" d:DesignWidth="520">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Crystal.Controls;component/Metrics/MetricEnrichmentResources.xaml"/>
        <ResourceDictionary Source="/Crystal.Resources;component/Styles/BorderStyles.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>
  <!-- DataContext is the CPU SensorsViewModel, inherited from the host tile. Two columns:
       (left) the metric title — label + inline limits/currents (PL1/PL2 on Intel, TDC/EDC on AMD),
       live value on the right — over the power history graph; (right) the
       per-rail breakdown table (Package / Cores / GT / DRAM) with each rail's value and session
       min/max. The graph self-registers under "Cpu.Power" so the view model feeds it each poll. -->
  <Border Style="{StaticResource SummaryTileBorderStyle}">
    <Grid HorizontalAlignment="Stretch" ShowGridLines="False">
      <Grid.RowDefinitions>
        <RowDefinition Height="18"/>
        <RowDefinition Height="50"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="60"/>
        <ColumnDefinition Width="140"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <!-- Header -->
      <TextBlock Grid.Row="0" Grid.Column="0" Text="Power" Style="{StaticResource SummaryTileTitleTextBlockStyle}"/>
      <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource MetricStatLine}">
          <Run FontFamily="Segoe Fluent Icons" Text="&#xE70D; " Foreground="LightGreen"/><Run Text="{Binding PowerRails[0].Min, StringFormat={}{0:0.0}}"/>
          <Run FontFamily="Segoe Fluent Icons" Text=" &#xE738; " Foreground="{StaticResource AccentBrush}"/><Run Text="{Binding PowerRails[0].Avg, StringFormat={}{0:0.0}}"/>
          <Run FontFamily="Segoe Fluent Icons" Text=" &#xE70E; " Foreground="Crimson"/><Run Text="{Binding PowerRails[0].Max, StringFormat={}{0:0.0}}"/>
      </TextBlock>
      <TextBlock Grid.Row="0" Grid.Column="2" Text="NOW" Style="{StaticResource MetricTableHeader}"/>
      <TextBlock Grid.Row="0" Grid.Column="3" Text="MIN" Style="{StaticResource MetricTableHeader}"/>
      <TextBlock Grid.Row="0" Grid.Column="4" Text="MAX" Style="{StaticResource MetricTableHeader}"/>
      <!-- Content -->
      <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="5" Background="Transparent" VerticalAlignment="Center" ShowGridLines="False">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="42"/>
          <ColumnDefinition Width="40"/>
          <ColumnDefinition Width="40"/>
          <ColumnDefinition Width="40"/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0" Grid.ColumnSpan="2" ShowGridLines="False">
          <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="18"/>
          </Grid.RowDefinitions>
          <Grid Grid.Row="0" HorizontalAlignment="Left" VerticalAlignment="Center" ShowGridLines="False">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="60"/>
              <ColumnDefinition Width="40"/>
              <ColumnDefinition Width="40"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding Power, StringFormat={}{0:0.00}}" Style="{StaticResource TileMetricValue}"/>
            <TextBlock Grid.Column="1" Text="Watts" Style="{StaticResource MetricUnit}"/>
            <TextBlock Grid.Column="2" 
               Text="{Binding PowerRails[0].Trend, Converter={StaticResource TrendToGlyph}}"
               Foreground="{Binding PowerRails[0].Trend, Converter={StaticResource TrendToBrush}}"
               Style="{StaticResource MetricUnit}" />
          </Grid>
          <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" 
                      HorizontalAlignment="Left" VerticalAlignment="Center" Orientation="Horizontal">
            <!-- Intel RAPL power limits; hidden when not exposed (read 0 on AMD). -->
            <TextBlock Text="{Binding PowerLimitLongW, StringFormat=PL1 {0:0} W}" Margin="0,0,0,0">
              <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource SummaryTileSubtitleTextBlockStyle}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding PowerLimitLongW}" Value="0">
                      <Setter Property="Visibility" Value="Collapsed"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <TextBlock Text="{Binding PowerLimitShortW, StringFormat=PL2 {0:0} W}" Margin="10,0,0,0">
              <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource SummaryTileSubtitleTextBlockStyle}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding PowerLimitShortW}" Value="0">
                      <Setter Property="Visibility" Value="Collapsed"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <!-- AMD SMU package current; hidden when not exposed (read 0 on Intel). -->
            <TextBlock Text="{Binding TdcAmps, StringFormat=TDC {0:0} A}" Margin="10,0,0,0">
              <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource SummaryTileSubtitleTextBlockStyle}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding TdcAmps}" Value="0">
                      <Setter Property="Visibility" Value="Collapsed"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <TextBlock Text="{Binding EdcAmps, StringFormat=EDC {0:0} A}" Margin="10,0,0,0">
              <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource SummaryTileSubtitleTextBlockStyle}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding EdcAmps}" Value="0">
                      <Setter Property="Visibility" Value="Collapsed"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </StackPanel>
        </Grid>
        
        <Grid Grid.Column="1" Grid.ColumnSpan="4">
          <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
          </Grid.ColumnDefinitions>
          <!-- Package -->
          <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding PowerRails[0].Label}" Style="{StaticResource MetricTableLabel}"/>
          <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding PowerRails[0].Value, StringFormat={}{0:0.00}}" Style="{StaticResource MetricTableValue}"/>
          <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding PowerRails[0].Min, StringFormat={}{0:0.00}}"   Style="{StaticResource MetricTableValue}"/>
          <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding PowerRails[0].Max, StringFormat={}{0:0.00}}"   Style="{StaticResource MetricTableValue}"/>

          <!-- Cores -->
          <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding PowerRails[1].Label}" Style="{StaticResource MetricTableLabel}"/>
          <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PowerRails[1].Value, StringFormat={}{0:0.00}}" Style="{StaticResource MetricTableValue}"/>
          <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding PowerRails[1].Min, StringFormat={}{0:0.00}}"   Style="{StaticResource MetricTableValue}"/>
          <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding PowerRails[1].Max, StringFormat={}{0:0.00}}"   Style="{StaticResource MetricTableValue}"/>

          <!-- DRAM -->
          <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding PowerRails[3].Label}" Style="{StaticResource MetricTableLabel}"/>
          <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding PowerRails[3].Value, StringFormat={}{0:0.00}}" Style="{StaticResource MetricTableValue}"/>
          <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding PowerRails[3].Min, StringFormat={}{0:0.00}}"   Style="{StaticResource MetricTableValue}"/>
          <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding PowerRails[3].Max, StringFormat={}{0:0.00}}"   Style="{StaticResource MetricTableValue}"/>
        </Grid>
      </Grid>

      <!-- Dot-style power history strip across the bottom of the tile. Self-registers under
           "Cpu.Power" (the same feed key the detail-view history graph uses; GraphFeedRegistry fans
           one sample out to every live graph on that key), so the SensorsViewModel feeds it each
           poll. SingleColor + accent blue instead of the default green→red gauge ramp. -->
      <graphs:PerformanceGraphLite Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="5" GraphBackground="Transparent"
                                   Loaded="OnGraphLoaded" graphs:GraphIdentity.Id="Cpu.Power"
                                   HorizontalAlignment="Stretch" VerticalAlignment="Top"
                                   Height="15" Rows="5" Capacity="120"
                                   MinValue="0" MaxValue="100" CornerRadius="1"
                                   ColorMode="SingleColor" DotColor="{StaticResource AccentBrush}"
                                   Margin="0,6,0,0"/>
    </Grid>
  </Border>
</UserControl>
