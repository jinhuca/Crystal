<UserControl x:Class="Crystal.CpuModule.Views.SummaryViews.CpuPowerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:bars="clr-namespace:Crystal.Controls.RangeBars;assembly=Crystal.Controls"
             xmlns:conv="clr-namespace:Crystal.Controls.Converters;assembly=Crystal.Controls"
             mc:Ignorable="d"
             d:DesignHeight="90" d:DesignWidth="130">
  <!-- DataContext is the CPU SensorsViewModel, inherited from the host tile.
       Value-banded segmented range bar over the live power; the history graph moved to the detail view. -->
  <UserControl.Resources>
    <conv:ValueToBrushConverter x:Key="PowerFill" Minimum="0" Step="20" Fallback="#9AA0A6">
      <SolidColorBrush Color="#22B14C"/>
      <SolidColorBrush Color="#E8C22A"/>
      <SolidColorBrush Color="#FF7F27"/>
      <SolidColorBrush Color="#ED1C24"/>
      <SolidColorBrush Color="#B0171F"/>
    </conv:ValueToBrushConverter>
  </UserControl.Resources>
  <StackPanel Width="120" HorizontalAlignment="Left">
    <bars:RangeBar Height="5" Margin="0,0,0,4"
                   MinValue="0" MaxValue="100" Value="{Binding Power}"
                   Segmented="True" SegmentWidth="4" SegmentGap="2"
                   BarBackground="#141414" TrackBrush="#1E1E1E"
                   BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                   FillBrush="{Binding Value, RelativeSource={RelativeSource Self}, Converter={StaticResource PowerFill}}"/>
    <StackPanel Orientation="Horizontal">
      <TextBlock Text="{Binding Power, StringFormat={}{0:0.00}}" Style="{StaticResource MetricValue}"/>
      <TextBlock Text="Watts" Style="{StaticResource MetricUnit}"/>
    </StackPanel>
    <TextBlock Text="Power" Style="{StaticResource MetricCaption}"/>
    <!-- Intel RAPL power limits; hidden when not exposed (read 0 on AMD). -->
    <TextBlock Text="{Binding PowerLimitLongW, StringFormat=PL1 {0:0} W}">
      <TextBlock.Style>
        <Style TargetType="TextBlock" BasedOn="{StaticResource MetricCaption}">
          <Style.Triggers>
            <DataTrigger Binding="{Binding PowerLimitLongW}" Value="0">
              <Setter Property="Visibility" Value="Collapsed"/>
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </TextBlock.Style>
    </TextBlock>
    <TextBlock Text="{Binding PowerLimitShortW, StringFormat=PL2 {0:0} W}">
      <TextBlock.Style>
        <Style TargetType="TextBlock" BasedOn="{StaticResource MetricCaption}">
          <Style.Triggers>
            <DataTrigger Binding="{Binding PowerLimitShortW}" Value="0">
              <Setter Property="Visibility" Value="Collapsed"/>
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </TextBlock.Style>
    </TextBlock>
    <!-- AMD SMU package current; hidden when not exposed (read 0 on Intel). -->
    <TextBlock Text="{Binding TdcAmps, StringFormat=TDC {0:0} A}">
      <TextBlock.Style>
        <Style TargetType="TextBlock" BasedOn="{StaticResource MetricCaption}">
          <Style.Triggers>
            <DataTrigger Binding="{Binding TdcAmps}" Value="0">
              <Setter Property="Visibility" Value="Collapsed"/>
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </TextBlock.Style>
    </TextBlock>
    <TextBlock Text="{Binding EdcAmps, StringFormat=EDC {0:0} A}">
      <TextBlock.Style>
        <Style TargetType="TextBlock" BasedOn="{StaticResource MetricCaption}">
          <Style.Triggers>
            <DataTrigger Binding="{Binding EdcAmps}" Value="0">
              <Setter Property="Visibility" Value="Collapsed"/>
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </TextBlock.Style>
    </TextBlock>
  </StackPanel>
</UserControl>
