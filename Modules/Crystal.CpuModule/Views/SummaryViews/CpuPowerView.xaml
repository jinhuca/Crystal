<UserControl x:Class="Crystal.CpuModule.Views.SummaryViews.CpuPowerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:graphs="clr-namespace:Crystal.Controls.PerformanceGraphs;assembly=Crystal.Controls"
             mc:Ignorable="d"
             d:DesignHeight="120" d:DesignWidth="520">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Crystal.Controls;component/Metrics/MetricEnrichmentResources.xaml"/>
        <ResourceDictionary Source="/Crystal.Resources;component/Styles/BorderStyles.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>
  <!-- DataContext is the CPU SensorsViewModel, inherited from the host tile. Two columns:
       (left) the metric title — label + inline limits/currents (PL1/PL2 on Intel, TDC/EDC on AMD),
       live value on the right — over the power history graph; (right) the
       per-rail breakdown table (Package / Cores / GT / DRAM) with each rail's value and session
       min/max. The graph self-registers under "Cpu.Power" so the view model feeds it each poll. -->
  <Border Style="{StaticResource SummaryTileBorderStyle}">
    <!-- One shared grid for the whole tile so the NOW/MIN/MAX header cells and the per-rail value
         cells live in the same columns (2/3/4) and line up exactly; the big value block spans the
         table's rows on the left. Row 0 = header, rows 1-3 = the rail table, row 4 = the history
         strip. -->
    <Grid HorizontalAlignment="Stretch" ShowGridLines="False">
      <Grid.RowDefinitions>
        <RowDefinition Height="18"/>
        <RowDefinition Height="16"/>
        <RowDefinition Height="16"/>
        <RowDefinition Height="16"/>
        <RowDefinition Height="26"/>
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="34"/>
        <ColumnDefinition Width="34"/>
        <ColumnDefinition Width="34"/>
      </Grid.ColumnDefinitions>
      <!-- Header: title + inline min/avg/max stat glyphs (left), NOW/MIN/MAX over the value columns.
           ClipToBounds keeps the header from overdrawing the NOW/MIN/MAX cells if it runs wide. -->
      <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" ClipToBounds="True">
        <TextBlock Text="Power" Style="{StaticResource SummaryTileTitleTextBlockStyle}"/>
        <TextBlock Style="{StaticResource MetricStatLine}" Margin="12,0,0,0" VerticalAlignment="Center">
            <Run FontFamily="Segoe Fluent Icons" Text="&#xE70D; " Foreground="LightGreen"/><Run Text="{Binding PowerRails[0].Min, StringFormat={}{0:0.0}}"/>
            <Run FontFamily="Segoe Fluent Icons" Text=" &#xE738; " Foreground="{StaticResource AccentBrush}"/><Run Text="{Binding PowerRails[0].Avg, StringFormat={}{0:0.0}}"/>
            <Run FontFamily="Segoe Fluent Icons" Text=" &#xE70E; " Foreground="Crimson"/><Run Text="{Binding PowerRails[0].Max, StringFormat={}{0:0.0}}"/>
        </TextBlock>
      </StackPanel>
      <TextBlock Grid.Row="0" Grid.Column="2" Text="NOW" Style="{StaticResource MetricTableHeader}"/>
      <TextBlock Grid.Row="0" Grid.Column="3" Text="MIN" Style="{StaticResource MetricTableHeader}"/>
      <TextBlock Grid.Row="0" Grid.Column="4" Text="MAX" Style="{StaticResource MetricTableHeader}"/>

      <!-- Value block: value + unit + trend, then the limits subtitle. Spans the table rows. -->
      <Grid Grid.Row="1" Grid.Column="0" Grid.RowSpan="3" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="2,10,0,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" VerticalAlignment="Stretch" ShowGridLines="False" Margin="0,0,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="80"/>
            <ColumnDefinition Width="30"/>
            <ColumnDefinition Width="30"/>
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="{Binding Power, StringFormat={}{0:0.00}}" Style="{StaticResource TileMetricValue}" 
                     HorizontalAlignment="Right"/>
          <TextBlock Grid.Column="1" Text="W" Style="{StaticResource MetricUnit}" Margin="8,0,0,0"/>
          <TextBlock Grid.Column="2" Text="{Binding PowerRails[0].Trend, Converter={StaticResource TrendToGlyph}}"
                     Foreground="{Binding PowerRails[0].Trend, Converter={StaticResource TrendToBrush}}"
                     Style="{StaticResource MetricUnit}" Margin="6,0,0,0"/>
        </Grid>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,0">
          <!-- Intel RAPL power limits; hidden when not exposed (read 0 on AMD). -->
          <TextBlock Text="{Binding PowerLimitLongW, StringFormat=PL1 {0:0} W}">
            <TextBlock.Style>
              <Style TargetType="TextBlock" BasedOn="{StaticResource SummaryTileSubtitleTextBlockStyle}">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding PowerLimitLongW}" Value="0">
                    <Setter Property="Visibility" Value="Collapsed"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <TextBlock Text="{Binding PowerLimitShortW, StringFormat=PL2 {0:0} W}" Margin="10,0,0,0">
            <TextBlock.Style>
              <Style TargetType="TextBlock" BasedOn="{StaticResource SummaryTileSubtitleTextBlockStyle}">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding PowerLimitShortW}" Value="0">
                    <Setter Property="Visibility" Value="Collapsed"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <!-- AMD SMU package current; hidden when not exposed (read 0 on Intel). -->
          <TextBlock Text="{Binding TdcAmps, StringFormat=TDC {0:0} A}" Margin="10,0,0,0">
            <TextBlock.Style>
              <Style TargetType="TextBlock" BasedOn="{StaticResource SummaryTileSubtitleTextBlockStyle}">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding TdcAmps}" Value="0">
                    <Setter Property="Visibility" Value="Collapsed"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <TextBlock Text="{Binding EdcAmps, StringFormat=EDC {0:0} A}" Margin="10,0,0,0">
            <TextBlock.Style>
              <Style TargetType="TextBlock" BasedOn="{StaticResource SummaryTileSubtitleTextBlockStyle}">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding EdcAmps}" Value="0">
                    <Setter Property="Visibility" Value="Collapsed"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </StackPanel>
      </Grid>

      <!-- Rail table: label in col 1, values in cols 2-4 (aligned under NOW/MIN/MAX). -->
      <!-- Package -->
      <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PowerRails[0].Label}" Style="{StaticResource MetricTableLabel}"/>
      <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding PowerRails[0].Value, StringFormat={}{0:0.00}}" Style="{StaticResource MetricTableValue}" Margin="4,2,0,2"/>
      <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding PowerRails[0].Min, StringFormat={}{0:0.00}}"   Style="{StaticResource MetricTableValue}" Margin="4,2,0,2"/>
      <TextBlock Grid.Row="1" Grid.Column="4" Text="{Binding PowerRails[0].Max, StringFormat={}{0:0.00}}"   Style="{StaticResource MetricTableValue}" Margin="4,2,0,2"/>
      <!-- Cores -->
      <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding PowerRails[1].Label}" Style="{StaticResource MetricTableLabel}"/>
      <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding PowerRails[1].Value, StringFormat={}{0:0.00}}" Style="{StaticResource MetricTableValue}" Margin="4,2,0,2"/>
      <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding PowerRails[1].Min, StringFormat={}{0:0.00}}"   Style="{StaticResource MetricTableValue}" Margin="4,2,0,2"/>
      <TextBlock Grid.Row="2" Grid.Column="4" Text="{Binding PowerRails[1].Max, StringFormat={}{0:0.00}}"   Style="{StaticResource MetricTableValue}" Margin="4,2,0,2"/>
      <!-- DRAM -->
      <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding PowerRails[3].Label}" Style="{StaticResource MetricTableLabel}"/>
      <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding PowerRails[3].Value, StringFormat={}{0:0.00}}" Style="{StaticResource MetricTableValue}" Margin="4,2,0,2"/>
      <TextBlock Grid.Row="3" Grid.Column="3" Text="{Binding PowerRails[3].Min, StringFormat={}{0:0.00}}"   Style="{StaticResource MetricTableValue}" Margin="4,2,0,2"/>
      <TextBlock Grid.Row="3" Grid.Column="4" Text="{Binding PowerRails[3].Max, StringFormat={}{0:0.00}}"   Style="{StaticResource MetricTableValue}" Margin="4,2,0,2"/>

      <!-- Dot-style power history strip across the bottom of the tile. Self-registers under
           "Cpu.Power" (the same feed key the detail-view history graph uses; GraphFeedRegistry fans
           one sample out to every live graph on that key), so the SensorsViewModel feeds it each
           poll. SingleColor + accent blue instead of the default green→red gauge ramp. -->
      <graphs:PerformanceGraphLite 
        Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="5" GraphBackground="Transparent"
        Loaded="OnGraphLoaded" graphs:GraphIdentity.Id="Cpu.Power"
        HorizontalAlignment="Stretch" VerticalAlignment="Top"
        Height="24" Rows="10" Capacity="120"
        MinValue="0" MaxValue="100" CornerRadius="1"
        Style="{StaticResource PowerBandedSquareDotGraphLiteStyle}"
        Margin="0,0,0,0"/>
    </Grid>
  </Border>
</UserControl>
