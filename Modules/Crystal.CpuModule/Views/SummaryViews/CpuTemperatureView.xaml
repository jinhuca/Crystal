<UserControl x:Class="Crystal.CpuModule.Views.SummaryViews.CpuTemperatureView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:graphs="clr-namespace:Crystal.Controls.PerformanceGraphs;assembly=Crystal.Controls"
             mc:Ignorable="d"
             d:DesignHeight="90" d:DesignWidth="320">
  <!-- DataContext is the CPU SensorsViewModel, inherited from the host tile.
       Appearance (category / kind / accent / history) is applied at runtime from the saved graph
       settings, keyed by GraphIdentity.Id; only the metric-specific value range and min height stay
       fixed here. -->
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>
    <graphs:PerformanceGraphLite x:Name="CpuTemperatureGraph" Grid.Column="0"
                                 graphs:GraphIdentity.Id="Cpu.Temperature"
                                 Style="{StaticResource SquareDotGraphLiteStyle}"
                                 MinValue="30" MaxValue="120"
                                 MinHeight="{StaticResource SummaryGraphMinHeight}"/>
    <StackPanel Grid.Column="1" Style="{StaticResource SummaryStackPanelStyle}">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="{Binding Temperature, StringFormat={}{0:0.00}}" Style="{StaticResource MetricValue}"/>
        <TextBlock Text="°C" Style="{StaticResource MetricUnit}"/>
      </StackPanel>
      <TextBlock Text="Temperature" Style="{StaticResource MetricCaption}"/>
      <!-- Intel-only thermal headroom; hidden when not exposed (reads 0 on AMD). -->
      <TextBlock Text="{Binding DistanceToTjMax, StringFormat=TjMax +{0:0}°C}">
        <TextBlock.Style>
          <Style TargetType="TextBlock" BasedOn="{StaticResource MetricCaption}">
            <Style.Triggers>
              <DataTrigger Binding="{Binding DistanceToTjMax}" Value="0">
                <Setter Property="Visibility" Value="Collapsed"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>
    </StackPanel>
  </Grid>
</UserControl>
