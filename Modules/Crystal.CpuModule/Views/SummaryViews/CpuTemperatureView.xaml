<UserControl x:Class="Crystal.CpuModule.Views.SummaryViews.CpuTemperatureView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:graphs="clr-namespace:Crystal.Controls.PerformanceGraphs;assembly=Crystal.Controls"
             mc:Ignorable="d"
             d:DesignHeight="120" d:DesignWidth="520">
  <!-- DataContext is the CPU SensorsViewModel, inherited from the host tile. Two columns:
       (left) the metric title — label + inline TjMax headroom (Intel), live value on the right —
       over the temperature history graph; (right) the temperature-sensor breakdown table
       (Package / Core Max / Core Avg) with each sensor's value and session min/max in °C. The graph
       self-registers under "Cpu.Temperature" so the view model feeds it each poll. -->
  <Grid Background="Transparent">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>

    <!-- Left column: title + history graph -->
    <Grid Grid.Column="0" VerticalAlignment="Stretch">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <Grid Grid.Row="0" Margin="0,0,0,4">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Bottom">
          <TextBlock Text="Temperature" Style="{StaticResource MetricCaption}" Foreground="{StaticResource TextBrush}"/>
          <!-- Intel-only thermal headroom; hidden when not exposed (reads 0 on AMD). -->
          <TextBlock Text="{Binding DistanceToTjMax, StringFormat=TjMax +{0:0}°C}" Margin="10,0,0,0">
            <TextBlock.Style>
              <Style TargetType="TextBlock" BasedOn="{StaticResource MetricCaption}">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding DistanceToTjMax}" Value="0">
                    <Setter Property="Visibility" Value="Collapsed"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
          <TextBlock Text="{Binding Temperature, StringFormat={}{0:0.00}}" Style="{StaticResource TileMetricValue}"/>
          <TextBlock Text="°C" Style="{StaticResource MetricUnit}"/>
        </StackPanel>
      </Grid>

      <graphs:AdaptiveGraph x:Name="TemperatureGraph" Grid.Row="1"
                            graphs:GraphIdentity.Id="Cpu.Temperature"
                            Capacity="90" MinValue="30" MaxValue="120"
                            Accent="{StaticResource GraphAccentTemperature}" BandedLine="False" ShowChrome="True" MinHeight="40"
                            CellPitch="{StaticResource DashboardDotPitch}"/>
    </Grid>

    <!-- Right column: temperature-sensor table -->
    <Grid Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Top" HorizontalAlignment="Right">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- Column headers -->
      <TextBlock Grid.Row="0" Grid.Column="1" Text="Value" Style="{StaticResource MetricTableHeader}"/>
      <TextBlock Grid.Row="0" Grid.Column="2" Text="Min"   Style="{StaticResource MetricTableHeader}"/>
      <TextBlock Grid.Row="0" Grid.Column="3" Text="Max"   Style="{StaticResource MetricTableHeader}"/>

      <!-- Package -->
      <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding TemperatureRows[0].Label}" Style="{StaticResource MetricTableLabel}"/>
      <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding TemperatureRows[0].Value, StringFormat={}{0:0.00}}" Style="{StaticResource MetricTableValue}"/>
      <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding TemperatureRows[0].Min, StringFormat={}{0:0.00}}"   Style="{StaticResource MetricTableValue}"/>
      <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding TemperatureRows[0].Max, StringFormat={}{0:0.00}}"   Style="{StaticResource MetricTableValue}"/>

      <!-- Core Max -->
      <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding TemperatureRows[1].Label}" Style="{StaticResource MetricTableLabel}"/>
      <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding TemperatureRows[1].Value, StringFormat={}{0:0.00}}" Style="{StaticResource MetricTableValue}"/>
      <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding TemperatureRows[1].Min, StringFormat={}{0:0.00}}"   Style="{StaticResource MetricTableValue}"/>
      <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding TemperatureRows[1].Max, StringFormat={}{0:0.00}}"   Style="{StaticResource MetricTableValue}"/>

      <!-- Core Avg -->
      <TextBlock Grid.Row="3" Grid.Column="0" Text="{Binding TemperatureRows[2].Label}" Style="{StaticResource MetricTableLabel}"/>
      <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding TemperatureRows[2].Value, StringFormat={}{0:0.00}}" Style="{StaticResource MetricTableValue}"/>
      <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding TemperatureRows[2].Min, StringFormat={}{0:0.00}}"   Style="{StaticResource MetricTableValue}"/>
      <TextBlock Grid.Row="3" Grid.Column="3" Text="{Binding TemperatureRows[2].Max, StringFormat={}{0:0.00}}"   Style="{StaticResource MetricTableValue}"/>
    </Grid>

    <!-- Full-height accent divider: closes the group in the Temperature graph's accent color,
         separating it from the next metric group. -->
    <Border Grid.Column="2" Width="2" Margin="12,0,0,0" VerticalAlignment="Stretch">
      <Border.Background><SolidColorBrush Color="{StaticResource GraphAccentTemperature}"/></Border.Background>
    </Border>
  </Grid>
</UserControl>
