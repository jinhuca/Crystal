<UserControl x:Class="Crystal.CpuModule.Views.SummaryViews.CpuTemperatureView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:bars="clr-namespace:Crystal.Controls.RangeBars;assembly=Crystal.Controls"
             xmlns:conv="clr-namespace:Crystal.Controls.Converters;assembly=Crystal.Controls"
             mc:Ignorable="d"
             d:DesignHeight="90" d:DesignWidth="130">
  <!-- DataContext is the CPU SensorsViewModel, inherited from the host tile.
       Value-banded segmented range bar over the live temperature; the history graph moved to the detail view. -->
  <UserControl.Resources>
    <conv:ValueToBrushConverter x:Key="TemperatureFill" Minimum="30" Step="18" Fallback="#9AA0A6">
      <SolidColorBrush Color="#22B14C"/>
      <SolidColorBrush Color="#E8C22A"/>
      <SolidColorBrush Color="#FF7F27"/>
      <SolidColorBrush Color="#ED1C24"/>
      <SolidColorBrush Color="#B0171F"/>
    </conv:ValueToBrushConverter>
  </UserControl.Resources>
  <StackPanel Width="120" HorizontalAlignment="Left">
    <bars:RangeBar Height="5" Margin="0,0,0,4"
                   MinValue="30" MaxValue="120" Value="{Binding Temperature}"
                   Segmented="True" SegmentWidth="4" SegmentGap="2"
                   BarBackground="#141414" TrackBrush="#1E1E1E"
                   BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                   FillBrush="{Binding Value, RelativeSource={RelativeSource Self}, Converter={StaticResource TemperatureFill}}"/>
    <StackPanel Orientation="Horizontal">
      <TextBlock Text="{Binding Temperature, StringFormat={}{0:0.00}}" Style="{StaticResource MetricValue}"/>
      <TextBlock Text="°C" Style="{StaticResource MetricUnit}"/>
    </StackPanel>
    <TextBlock Text="Temperature" Style="{StaticResource MetricCaption}"/>
    <!-- Intel-only thermal headroom; hidden when not exposed (reads 0 on AMD). -->
    <TextBlock Text="{Binding DistanceToTjMax, StringFormat=TjMax +{0:0}°C}">
      <TextBlock.Style>
        <Style TargetType="TextBlock" BasedOn="{StaticResource MetricCaption}">
          <Style.Triggers>
            <DataTrigger Binding="{Binding DistanceToTjMax}" Value="0">
              <Setter Property="Visibility" Value="Collapsed"/>
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </TextBlock.Style>
    </TextBlock>
  </StackPanel>
</UserControl>
