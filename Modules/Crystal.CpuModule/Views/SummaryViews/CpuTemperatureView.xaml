<UserControl x:Class="Crystal.CpuModule.Views.SummaryViews.CpuTemperatureView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:graphs="clr-namespace:Crystal.Controls.PerformanceGraphs;assembly=Crystal.Controls"
             mc:Ignorable="d"
             d:DesignHeight="120" d:DesignWidth="520">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Crystal.Controls;component/Metrics/MetricEnrichmentResources.xaml"/>
        <ResourceDictionary Source="/Crystal.Resources;component/Styles/BorderStyles.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>
  <!-- DataContext is the CPU SensorsViewModel, inherited from the host tile. Same three-row layout
       as CpuPowerView for consistency: (row 0) title + inline min/avg/max stat glyphs + NOW/MIN/MAX
       table headers; (row 1) the live value + unit + trend and a TjMax-headroom subtitle on the
       left, the temperature-sensor breakdown table (Package / Core Max / Core Avg) on the right;
       (row 2) the dot-style history strip, self-registered under "Cpu.Temperature" so the view
       model feeds it each poll. -->
  <Border Style="{StaticResource SummaryTileBorderStyle}">
    <Grid HorizontalAlignment="Stretch" ShowGridLines="False">
      <Grid.RowDefinitions>
        <RowDefinition Height="18"/>
        <RowDefinition Height="50"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="90"/>
        <ColumnDefinition Width="140"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <!-- Header -->
      <TextBlock Grid.Row="0" Grid.Column="0" Text="Temperature" Style="{StaticResource SummaryTileTitleTextBlockStyle}"/>
      <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource MetricStatLine}">
          <Run FontFamily="Segoe Fluent Icons" Text="&#xE70D; " Foreground="LightGreen"/><Run Text="{Binding TemperatureRows[0].Min, StringFormat={}{0:0.0}}"/>
          <Run FontFamily="Segoe Fluent Icons" Text=" &#xE738; " Foreground="{StaticResource AccentBrush}"/><Run Text="{Binding TemperatureRows[0].Avg, StringFormat={}{0:0.0}}"/>
          <Run FontFamily="Segoe Fluent Icons" Text=" &#xE70E; " Foreground="Crimson"/><Run Text="{Binding TemperatureRows[0].Max, StringFormat={}{0:0.0}}"/>
      </TextBlock>
      <TextBlock Grid.Row="0" Grid.Column="2" Text="NOW" Style="{StaticResource MetricTableHeader}"/>
      <TextBlock Grid.Row="0" Grid.Column="3" Text="MIN" Style="{StaticResource MetricTableHeader}"/>
      <TextBlock Grid.Row="0" Grid.Column="4" Text="MAX" Style="{StaticResource MetricTableHeader}"/>
      <!-- Content -->
      <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="5" Background="Transparent" VerticalAlignment="Center" ShowGridLines="False">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="42"/>
          <ColumnDefinition Width="40"/>
          <ColumnDefinition Width="40"/>
          <ColumnDefinition Width="40"/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0" Grid.ColumnSpan="2" ShowGridLines="False">
          <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="18"/>
          </Grid.RowDefinitions>
          <Grid Grid.Row="0" HorizontalAlignment="Left" VerticalAlignment="Center" ShowGridLines="False">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="60"/>
              <ColumnDefinition Width="40"/>
              <ColumnDefinition Width="40"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding Temperature, StringFormat={}{0:0.00}}"
                       Style="{StaticResource TileMetricValue}"
                       Foreground="{Binding Temperature, Converter={StaticResource TemperatureToBrush}}"/>
            <TextBlock Grid.Column="1" Text="°C" Style="{StaticResource MetricUnit}"/>
            <TextBlock Grid.Column="2"
               Text="{Binding TemperatureRows[0].Trend, Converter={StaticResource TrendToGlyph}}"
               Foreground="{Binding TemperatureRows[0].Trend, Converter={StaticResource TrendToBrush}}"
               Style="{StaticResource MetricUnit}" />
          </Grid>
          <StackPanel Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Center" Orientation="Horizontal">
            <!-- Intel-only thermal headroom; hidden when not exposed (reads 0 on AMD). -->
            <TextBlock Text="{Binding DistanceToTjMax, StringFormat=TjMax +{0:0}°C}">
              <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource SummaryTileSubtitleTextBlockStyle}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding DistanceToTjMax}" Value="0">
                      <Setter Property="Visibility" Value="Collapsed"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </StackPanel>
        </Grid>

        <Grid Grid.Column="1" Grid.ColumnSpan="4">
          <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
          </Grid.ColumnDefinitions>
          <!-- Package -->
          <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding TemperatureRows[0].Label}" Style="{StaticResource MetricTableLabel}"/>
          <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding TemperatureRows[0].Value, StringFormat={}{0:0.00}}" Style="{StaticResource MetricTableValue}"/>
          <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding TemperatureRows[0].Min, StringFormat={}{0:0.00}}"   Style="{StaticResource MetricTableValue}"/>
          <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding TemperatureRows[0].Max, StringFormat={}{0:0.00}}"   Style="{StaticResource MetricTableValue}"/>

          <!-- Core Max -->
          <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding TemperatureRows[1].Label}" Style="{StaticResource MetricTableLabel}"/>
          <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding TemperatureRows[1].Value, StringFormat={}{0:0.00}}" Style="{StaticResource MetricTableValue}"/>
          <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding TemperatureRows[1].Min, StringFormat={}{0:0.00}}"   Style="{StaticResource MetricTableValue}"/>
          <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding TemperatureRows[1].Max, StringFormat={}{0:0.00}}"   Style="{StaticResource MetricTableValue}"/>

          <!-- Core Avg -->
          <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding TemperatureRows[2].Label}" Style="{StaticResource MetricTableLabel}"/>
          <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding TemperatureRows[2].Value, StringFormat={}{0:0.00}}" Style="{StaticResource MetricTableValue}"/>
          <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding TemperatureRows[2].Min, StringFormat={}{0:0.00}}"   Style="{StaticResource MetricTableValue}"/>
          <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding TemperatureRows[2].Max, StringFormat={}{0:0.00}}"   Style="{StaticResource MetricTableValue}"/>
        </Grid>
      </Grid>

      <!-- Dot-style temperature history strip; self-registers under "Cpu.Temperature" (shared feed
           key with the detail-view history graph). SingleColor + accent blue. -->
      <graphs:PerformanceGraphLite Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="5" GraphBackground="Transparent"
                                   Loaded="OnGraphLoaded" graphs:GraphIdentity.Id="Cpu.Temperature"
                                   HorizontalAlignment="Stretch" VerticalAlignment="Top"
                                   Height="15" Rows="5" Capacity="120"
                                   MinValue="30" MaxValue="120" CornerRadius="1"
                                   ColorMode="SingleColor" DotColor="{StaticResource AccentBrush}"
                                   Margin="0,6,0,0"/>
    </Grid>
  </Border>
</UserControl>
