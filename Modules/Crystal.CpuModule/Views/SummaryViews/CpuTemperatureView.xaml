<UserControl x:Class="Crystal.CpuModule.Views.SummaryViews.CpuTemperatureView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:graphs="clr-namespace:Crystal.Controls.PerformanceGraphs;assembly=Crystal.Controls"
             mc:Ignorable="d"
             d:DesignHeight="120" d:DesignWidth="520">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="/Crystal.CpuModule;component/Views/ViewResources.xaml"/>
			</ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>
  <!-- DataContext is the CPU SensorsViewModel, inherited from the host tile. Same three-row layout
       as CpuPowerView for consistency: (row 0) title + inline min/avg/max stat glyphs + NOW/MIN/MAX
       table headers; (row 1) the live value + unit + trend and a TjMax-headroom subtitle on the
       left, the temperature-sensor breakdown table (Package / Core Max / Core Avg) on the right;
       (row 2) the dot-style history strip, self-registered under "Cpu.Temperature" so the view
       model feeds it each poll. -->
  <Border Style="{StaticResource SummaryTileBorderStyle}">
    <!-- One shared grid so NOW/MIN/MAX (cols 2-4) line up exactly with the sensor value cells below;
         the value block spans the table rows on the left. Mirrors CpuPowerView. -->
    <Grid HorizontalAlignment="Stretch" ShowGridLines="False">
      <Grid.RowDefinitions>
        <RowDefinition Height="18"/>
        <RowDefinition Height="16"/>
        <RowDefinition Height="16"/>
        <RowDefinition Height="16"/>
        <RowDefinition Height="26"/>
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="34"/>
        <ColumnDefinition Width="34"/>
        <ColumnDefinition Width="34"/>
      </Grid.ColumnDefinitions>
      <!-- Header. ClipToBounds keeps the long "Temperature" title + stat glyphs from overflowing the
           star column and overdrawing the NOW/MIN/MAX cells to the right. -->
      <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" ClipToBounds="True">
        <TextBlock Text="Temperature" Style="{StaticResource SummaryTileTitleTextBlockStyle}"/>
        <TextBlock Style="{StaticResource MetricStatLine}" Margin="12,0,0,0" VerticalAlignment="Center">
            <Run FontFamily="Segoe Fluent Icons" Text="&#xE70D; " Foreground="LightGreen"/><Run Text="{Binding TemperatureRows[0].Min, StringFormat={}{0:0.0}}"/>
            <Run FontFamily="Segoe Fluent Icons" Text=" &#xE738; " Foreground="{StaticResource AccentBrush}"/><Run Text="{Binding TemperatureRows[0].Avg, StringFormat={}{0:0.0}}"/>
            <Run FontFamily="Segoe Fluent Icons" Text=" &#xE70E; " Foreground="Crimson"/><Run Text="{Binding TemperatureRows[0].Max, StringFormat={}{0:0.0}}"/>
        </TextBlock>
      </StackPanel>
      <TextBlock Grid.Row="0" Grid.Column="2" Text="NOW" Style="{StaticResource MetricTableHeader}"/>
      <TextBlock Grid.Row="0" Grid.Column="3" Text="MIN" Style="{StaticResource MetricTableHeader}"/>
      <TextBlock Grid.Row="0" Grid.Column="4" Text="MAX" Style="{StaticResource MetricTableHeader}"/>

      <!-- Value block: value + unit + trend, then the TjMax subtitle. Spans the table rows. -->
      <Grid Grid.Row="1" Grid.Column="0" Grid.RowSpan="3" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="2,10,0,0" 
            ShowGridLines="False">
        <Grid.RowDefinitions>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" VerticalAlignment="Stretch" ShowGridLines="False" Margin="0,0,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="80"/>
            <ColumnDefinition Width="30"/>
            <ColumnDefinition Width="30"/>
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" HorizontalAlignment="Right"
                     Text="{Binding Temperature, StringFormat={}{0:0.00}}" Style="{StaticResource TileMetricValue}"
                     Foreground="{Binding Temperature, Converter={StaticResource TemperatureToBrush}}"/>
          <TextBlock Grid.Column="1" 
                     Text="°C" Style="{StaticResource MetricUnit}" HorizontalAlignment="Left" Margin="8,0,0,0"/>
          <TextBlock Grid.Column="2" 
                     Text="{Binding TemperatureRows[0].Trend, Converter={StaticResource TrendToGlyph}}"
                     Foreground="{Binding TemperatureRows[0].Trend, Converter={StaticResource TrendToBrush}}"
                     Style="{StaticResource MetricUnit}" Margin="6,0,0,0"/>
        </Grid>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,2,0,0">
          <!-- Intel-only thermal headroom; hidden when not exposed (reads 0 on AMD). -->
          <TextBlock Text="{Binding DistanceToTjMax, StringFormat=TjMax +{0:0}°C}">
            <TextBlock.Style>
              <Style TargetType="TextBlock" BasedOn="{StaticResource SummaryTileSubtitleTextBlockStyle}">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding DistanceToTjMax}" Value="0">
                    <Setter Property="Visibility" Value="Collapsed"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </StackPanel>

      </Grid>

      <!-- Sensor table: label in col 1, values in cols 2-4 (aligned under NOW/MIN/MAX). -->
      <!-- Package -->
      <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding TemperatureRows[0].Label}" Style="{StaticResource MetricTableLabel}"/>
      <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding TemperatureRows[0].Value, StringFormat={}{0:0.00}}" Style="{StaticResource MetricTableValue}" Margin="4,2,0,2"/>
      <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding TemperatureRows[0].Min, StringFormat={}{0:0.00}}"   Style="{StaticResource MetricTableValue}" Margin="4,2,0,2"/>
      <TextBlock Grid.Row="1" Grid.Column="4" Text="{Binding TemperatureRows[0].Max, StringFormat={}{0:0.00}}"   Style="{StaticResource MetricTableValue}" Margin="4,2,0,2"/>
      <!-- Core Max -->
      <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding TemperatureRows[1].Label}" Style="{StaticResource MetricTableLabel}"/>
      <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding TemperatureRows[1].Value, StringFormat={}{0:0.00}}" Style="{StaticResource MetricTableValue}" Margin="4,2,0,2"/>
      <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding TemperatureRows[1].Min, StringFormat={}{0:0.00}}"   Style="{StaticResource MetricTableValue}" Margin="4,2,0,2"/>
      <TextBlock Grid.Row="2" Grid.Column="4" Text="{Binding TemperatureRows[1].Max, StringFormat={}{0:0.00}}"   Style="{StaticResource MetricTableValue}" Margin="4,2,0,2"/>
      <!-- Core Avg -->
      <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding TemperatureRows[2].Label}" Style="{StaticResource MetricTableLabel}"/>
      <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding TemperatureRows[2].Value, StringFormat={}{0:0.00}}" Style="{StaticResource MetricTableValue}" Margin="4,2,0,2"/>
      <TextBlock Grid.Row="3" Grid.Column="3" Text="{Binding TemperatureRows[2].Min, StringFormat={}{0:0.00}}"   Style="{StaticResource MetricTableValue}" Margin="4,2,0,2"/>
      <TextBlock Grid.Row="3" Grid.Column="4" Text="{Binding TemperatureRows[2].Max, StringFormat={}{0:0.00}}"   Style="{StaticResource MetricTableValue}" Margin="4,2,0,2"/>

      <!-- Adaptive (Line/Dot) temperature history strip; self-registers under "Cpu.Temperature"
           (shared feed key with the detail-view history graph). Follows the title-bar Line/Dot
           toggle; banded whitesmoke→red temperature ramp. -->
      <graphs:AdaptiveGraph
        Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="5"
        Loaded="OnGraphLoaded" graphs:GraphIdentity.Id="Cpu.Temperature"
        HorizontalAlignment="Stretch" VerticalAlignment="Top"
        Height="24" Rows="10" Capacity="{StaticResource SensorGraphCapacity}"
        MinValue="0" MaxValue="100"
        BandedLine="True" 
				BandStartColor="{StaticResource TemperatureAccentBandedColor1}" 
				BandEndColor="{StaticResource FanAccentBandedColor9}"
        Margin="0,0,0,0"/>
    </Grid>
  </Border>
</UserControl>
