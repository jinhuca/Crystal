<UserControl x:Class="Crystal.CpuModule.Views.SummaryViews.CpuCoreStripView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:bars="clr-namespace:Crystal.Controls.RangeBars;assembly=Crystal.Controls"
             xmlns:conv="clr-namespace:Crystal.Controls.Converters;assembly=Crystal.Controls"
             mc:Ignorable="d"
             d:DesignHeight="200" d:DesignWidth="400">
  <!-- DataContext is the CPU SensorsViewModel, inherited from the host tile.
       Per-core strip: a load bar (heat-coloured) stacked over a clock bar (accent, fixed 0-6 GHz
       scale) and a temperature bar, each using the shared SummaryRangeBarStyle so the core bars match
       the other CpuSummaryView tiles. Laid out in exactly two columns inside a scroll viewer whose
       scrollbars are hidden (mouse-wheel still scrolls when more cores than fit are present). -->
  <UserControl.Resources>
    <!-- Per-core category colors for the value readouts: clock=light blue, load=light green,
         temperature=bright brown. -->
    <SolidColorBrush x:Key="CoreClockBrush" Color="#6EB4F0"/>
    <SolidColorBrush x:Key="CoreLoadBrush" Color="#6FCF6F"/>
    <SolidColorBrush x:Key="CoreTempBrush" Color="#D2691E"/>

    <!-- Value-banded bar fills (green->red) matching the other CpuSummaryView tiles, so each core
         bar shifts color with its reading. Bands mirror CpuClockView/CpuTemperatureView and the
         load banding used on Gpu3DView. -->
    <conv:ValueToBrushConverter x:Key="CoreLoadFill" Minimum="0" Step="20" Fallback="#9AA0A6">
      <SolidColorBrush Color="#22B14C"/>
      <SolidColorBrush Color="#E8C22A"/>
      <SolidColorBrush Color="#FF7F27"/>
      <SolidColorBrush Color="#ED1C24"/>
      <SolidColorBrush Color="#B0171F"/>
    </conv:ValueToBrushConverter>
    <conv:ValueToBrushConverter x:Key="CoreClockFill" Minimum="0" Step="1.2" Fallback="#9AA0A6">
      <SolidColorBrush Color="#22B14C"/>
      <SolidColorBrush Color="#E8C22A"/>
      <SolidColorBrush Color="#FF7F27"/>
      <SolidColorBrush Color="#ED1C24"/>
      <SolidColorBrush Color="#B0171F"/>
    </conv:ValueToBrushConverter>
    <conv:ValueToBrushConverter x:Key="CoreTempFill" Minimum="30" Step="18" Fallback="#9AA0A6">
      <SolidColorBrush Color="#22B14C"/>
      <SolidColorBrush Color="#E8C22A"/>
      <SolidColorBrush Color="#FF7F27"/>
      <SolidColorBrush Color="#ED1C24"/>
      <SolidColorBrush Color="#B0171F"/>
    </conv:ValueToBrushConverter>
  </UserControl.Resources>

  <!-- Fixed to two columns: the item panel is exactly two item-widths wide so rows wrap after the
       second core, and the scroll viewer hides its bars while still allowing wheel scrolling. -->
  <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
    <ItemsControl ItemsSource="{Binding CoreLoads}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <WrapPanel Orientation="Horizontal" ItemHeight="42" ItemWidth="280"/>
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Grid Margin="0,6,30,0" VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="28"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="72"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Core label spans all three metric rows, aligned to the top of the stack. -->
            <TextBlock Grid.Column="0" Grid.RowSpan="3" Text="{Binding Label}" Foreground="{StaticResource LabelBrush}"
                       FontSize="{StaticResource CaptionFontSize}" FontFamily="{StaticResource MonoFontFamily}" VerticalAlignment="Top"/>

            <!-- Each metric occupies one row so its bar and value stay aligned. -->
            <bars:RangeBar Grid.Row="0" Grid.Column="1" Style="{StaticResource SummaryRangeBarStyle}" Margin="0,0,8,0" VerticalAlignment="Center"
                           MinValue="0" MaxValue="100" Value="{Binding Load}"
                           FillBrush="{Binding Value, RelativeSource={RelativeSource Self}, Converter={StaticResource CoreLoadFill}}"/>
            <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding Load, StringFormat={}{0:0}%}"
                       Foreground="{StaticResource CoreLoadBrush}" VerticalAlignment="Center"
                       FontSize="{StaticResource MicroFontSize}" FontFamily="{StaticResource MonoFontFamily}" TextAlignment="Right"/>

            <bars:RangeBar Grid.Row="1" Grid.Column="1" Style="{StaticResource SummaryRangeBarStyle}" Margin="0,0,8,0" VerticalAlignment="Center"
                           MinValue="0" MaxValue="6" Value="{Binding SpeedGhz}"
                           FillBrush="{Binding Value, RelativeSource={RelativeSource Self}, Converter={StaticResource CoreClockFill}}"/>
            <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding SpeedGhz, StringFormat={}{0:0.00} GHz}"
                       Foreground="{StaticResource CoreClockBrush}" VerticalAlignment="Center"
                       FontSize="{StaticResource MicroFontSize}" FontFamily="{StaticResource MonoFontFamily}" TextAlignment="Right"/>

            <bars:RangeBar Grid.Row="2" Grid.Column="1" Style="{StaticResource SummaryRangeBarStyle}" Margin="0,0,8,0" VerticalAlignment="Center"
                           MinValue="0" MaxValue="100" Value="{Binding Temperature}"
                           FillBrush="{Binding Value, RelativeSource={RelativeSource Self}, Converter={StaticResource CoreTempFill}}"/>
            <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding Temperature, StringFormat={}{0:0.00}℃}"
                       Foreground="{StaticResource CoreTempBrush}" VerticalAlignment="Center"
                       FontSize="{StaticResource MicroFontSize}" FontFamily="{StaticResource MonoFontFamily}" TextAlignment="Right"/>
          </Grid>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </ScrollViewer>
</UserControl>
