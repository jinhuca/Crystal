<UserControl x:Class="Crystal.CpuModule.Views.SummaryViews.CpuUtilizationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:graphs="clr-namespace:Crystal.Controls.PerformanceGraphs;assembly=Crystal.Controls"
             mc:Ignorable="d"
             d:DesignHeight="200" d:DesignWidth="500">
  <!-- DataContext is the CPU SensorsViewModel, inherited from the host tile. The full-height
       CPU-utilization history graph (self-registers so the view model feeds it on each poll), with the
       live utilization value pinned at its top-right. The static identity/specs now live in the header. -->
  <Grid VerticalAlignment="Stretch" Background="Transparent" ShowGridLines="False">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- Live utilization value, right-aligned above the graph. -->
    <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,0,4">
      <TextBlock Text="{Binding Load, StringFormat={}{0:0.00}}" Style="{StaticResource UtilizationCaption}" VerticalAlignment="Center"/>
      <TextBlock Text="%" Style="{StaticResource MetricUnit}" VerticalAlignment="Center"/>
    </StackPanel>

    <graphs:AdaptiveGraph x:Name="CpuUtilizationGraph" Grid.Row="1"
                          graphs:GraphIdentity.Id="Cpu.Utilization"
                          Capacity="120" MinValue="0" MaxValue="100"
                          Accent="#3BD15A" ShowChrome="True" MinHeight="90"
                          CellPitch="{StaticResource DashboardDotPitch}"/>
  </Grid>
</UserControl>
