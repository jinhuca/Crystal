<UserControl x:Class="Crystal.CpuModule.Views.SummaryViews.CpuUtilizationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:graphs="clr-namespace:Crystal.Controls.PerformanceGraphs;assembly=Crystal.Controls"
             mc:Ignorable="d"
             d:DesignHeight="200" d:DesignWidth="500">
  <!-- DataContext is the CPU SensorsViewModel, inherited from the host tile. The full-height
       CPU-utilization history graph (self-registers so the view model feeds it on each poll), with the
       live utilization value pinned at its top-right. The static identity/specs now live in the header. -->
  <Grid VerticalAlignment="Stretch" HorizontalAlignment="Right" Background="Transparent" Margin="0,0,20,0">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="100"/>
    </Grid.ColumnDefinitions>
    <graphs:AdaptiveGraph 
      Grid.Column="0"
      x:Name="CpuUtilizationGraph" 
      graphs:GraphIdentity.Id="Cpu.Utilization"
      Capacity="180" MinValue="0" MaxValue="100"
      Accent="{StaticResource GraphAccentUtilization}" 
      BandedLine="True" ShowChrome="True" MinHeight="40"
      CellPitch="{StaticResource DashboardDotPitch}"/>
    <Grid Grid.Column="1" Margin="0,0,10,0" HorizontalAlignment="Right">
      <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition/>
        <ColumnDefinition Width="20"/>
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Text="Utilization" VerticalAlignment="Top" 
                 HorizontalAlignment="Right" Style="{StaticResource SummaryTileTitleTextBlockStyle}"/>
      <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding Load, StringFormat={}{0:0.00}}" Style="{StaticResource TileMetricValue}"/>
      <TextBlock Grid.Row="1" Grid.Column="1" Text="%" Style="{StaticResource MetricUnit}"/>
    </Grid>
  </Grid>
</UserControl>
