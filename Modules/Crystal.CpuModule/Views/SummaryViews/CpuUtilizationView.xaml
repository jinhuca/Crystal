<UserControl x:Class="Crystal.CpuModule.Views.SummaryViews.CpuUtilizationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:graphs="clr-namespace:Crystal.Controls.PerformanceGraphs;assembly=Crystal.Controls"
             xmlns:root="clr-namespace:Crystal.CpuModule.Views"
             mc:Ignorable="d"
             d:DesignHeight="200" d:DesignWidth="500">
  <!-- DataContext is the CPU SensorsViewModel, inherited from the host tile.
       The full CPU-utilization history graph; self-registers so the view model feeds it on each poll. -->
  <Grid VerticalAlignment="Stretch" HorizontalAlignment="Center" Background="Transparent" ShowGridLines="False">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Caption: "Slot# <socket>" accent label + CPU brand, on the same row as (and aligned with)
         the utilization value, mirroring the GPU utilization tile below. The brand sits in a bounded
         (star) column with TextTrimming so a long brand ellipsizes instead of overflowing the value.
         Socket/Brand live on SpecsViewModel, reached via the owning CpuSummaryView (this view's own
         DataContext is the SensorsViewModel). -->
    <Grid Grid.Row="0" Grid.Column="0" VerticalAlignment="Stretch" Margin="0,0,12,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" Text="{Binding DataContext.SpecsViewModel.Socket, RelativeSource={RelativeSource AncestorType={x:Type root:CpuSummaryView}}, StringFormat=Slot# {0}}"
                 Foreground="{StaticResource AccentBrush}" FontSize="{StaticResource BodyFontSize}" FontWeight="SemiBold"
                 FontFamily="{StaticResource MonoFontFamily}" VerticalAlignment="Center"/>
      <TextBlock Grid.Column="1" Text="{Binding DataContext.SpecsViewModel.Brand, RelativeSource={RelativeSource AncestorType={x:Type root:CpuSummaryView}}}"
                 Foreground="{StaticResource LabelBrush}" FontSize="{StaticResource CaptionFontSize}"
                 FontFamily="{StaticResource MonoFontFamily}" VerticalAlignment="Center" Margin="8,0,0,0"
                 TextTrimming="CharacterEllipsis" ToolTip="{Binding DataContext.SpecsViewModel.Brand, RelativeSource={RelativeSource AncestorType={x:Type root:CpuSummaryView}}}"/>
    </Grid>

    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Right">
      <TextBlock Text="{Binding Load, StringFormat={}{0:0.00}}" Style="{StaticResource UtilizationCaption}" VerticalAlignment="Center"/>
      <TextBlock Text="%" Style="{StaticResource MetricUnit}" VerticalAlignment="Center"/>
    </StackPanel>

    <graphs:PerformanceGraphLite x:Name="CpuUtilizationGraph" Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1"
                                 graphs:GraphIdentity.Id="Cpu.Utilization"
                                 Style="{StaticResource UtilizationGraphLiteStyle}"
                                 Capacity="120" MinValue="0" MaxValue="100"
                                 HorizontalAlignment="Left" VerticalAlignment="Bottom"/>

    <!-- Static specs beneath the graph, centered under the utilization column. DataContext is the
         SpecsViewModel reached via the owning CpuSummaryView (this view binds the SensorsViewModel). -->
    <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal"
                HorizontalAlignment="Center" Margin="0,4,0,0"
                DataContext="{Binding DataContext.SpecsViewModel, RelativeSource={RelativeSource AncestorType={x:Type root:CpuSummaryView}}}">
      <TextBlock Text="{Binding PhysicalCores, StringFormat=Physical Cores: {0}}" Style="{StaticResource HeaderSpec}"/>
      <TextBlock Text="{Binding LogicalCores, StringFormat=Logical Cores: {0}}" Style="{StaticResource HeaderSpec}"/>
      <TextBlock Text="{Binding L1CacheKb, StringFormat=L1: {0:N0} KB}" Style="{StaticResource HeaderSpec}"/>
      <TextBlock Text="{Binding L2CacheKb, StringFormat=L2: {0:N0} KB}" Style="{StaticResource HeaderSpec}"/>
      <TextBlock Text="{Binding L3CacheKb, StringFormat=L3: {0:N0} KB}" Style="{StaticResource HeaderSpec}"/>
      <TextBlock Text="{Binding BaseSpeedMHz, StringFormat=Base Speed: {0:N0} MHz}" Style="{StaticResource HeaderSpec}"/>
    </StackPanel>
  </Grid>
</UserControl>
