<UserControl x:Class="Crystal.CpuModule.Views.SummaryViews.CpuUtilizationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:graphs="clr-namespace:Crystal.Controls.PerformanceGraphs;assembly=Crystal.Controls"
             mc:Ignorable="d"
             d:DesignHeight="200" d:DesignWidth="500">
  <!-- DataContext is the CPU SensorsViewModel, inherited from the host tile. The full-height
       CPU-utilization history graph (self-registers so the view model feeds it on each poll), with the
       live utilization value pinned at its top-right. The static identity/specs now live in the header. -->
  <Grid VerticalAlignment="Stretch" Background="Transparent" ShowGridLines="False">
    <!--<Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>-->
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>

    <!-- Metric label (left) and live utilization value (right), above the graph. -->
    <Grid Grid.Column="1" Margin="10,0,0,0">
      <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top">
        <TextBlock Text="Utilization" Style="{StaticResource MetricCaption}" Foreground="{StaticResource TextBrush}"/>
      </StackPanel>
      <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="left" VerticalAlignment="Bottom">
        <TextBlock Text="{Binding Load, StringFormat={}{0:0.00}}" Style="{StaticResource TileMetricValue}"/>
        <TextBlock Text="%" Style="{StaticResource MetricUnit}"/>
      </StackPanel>
    </Grid>

    <graphs:AdaptiveGraph x:Name="CpuUtilizationGraph" Grid.Column="0"
                          graphs:GraphIdentity.Id="Cpu.Utilization"
                          Capacity="180" MinValue="0" MaxValue="100"
                          Accent="{StaticResource GraphAccentUtilization}" BandedLine="True" ShowChrome="True" MinHeight="40"
                          CellPitch="{StaticResource DashboardDotPitch}"/>

    <!-- Full-height accent divider: closes the Utilization group in its graph's accent color,
         matching the metric tiles above. -->
    <Border Grid.Column="2" Width="2" Margin="12,0,0,0" VerticalAlignment="Stretch">
      <Border.Background><SolidColorBrush Color="{StaticResource GraphAccentUtilization}"/></Border.Background>
    </Border>
  </Grid>
</UserControl>
