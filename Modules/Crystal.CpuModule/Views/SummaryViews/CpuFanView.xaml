<UserControl x:Class="Crystal.CpuModule.Views.SummaryViews.CpuFanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:graphs="clr-namespace:Crystal.Controls.PerformanceGraphs;assembly=Crystal.Controls"
             mc:Ignorable="d"
             d:DesignHeight="120" d:DesignWidth="260">
  <!-- DataContext is the CPU SensorsViewModel, inherited from the host tile. Fan history graph,
       titled in the utilization pattern: metric label (left), live readout — RPM, or PWM percentage
       on tachometer-less laptops (right). Self-registers under "Cpu.Fan" so the view model feeds it
       on each poll; its upper bound tracks FanGraphMax (100% or 4000 RPM). -->
  <Grid VerticalAlignment="Stretch" Background="Transparent">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="0,0,0,4">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Bottom">
        <TextBlock Text="CPU Fan" Style="{StaticResource MetricCaption}" Foreground="{StaticResource TextBrush}"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
        <TextBlock Text="{Binding FanReadoutText}" Style="{StaticResource UtilizationCaption}" VerticalAlignment="Bottom"/>
        <TextBlock Text="{Binding FanReadoutUnit}" Style="{StaticResource MetricUnit}" VerticalAlignment="Bottom"/>
      </StackPanel>
    </Grid>

    <graphs:AdaptiveGraph x:Name="FanGraph" Grid.Row="1"
                          graphs:GraphIdentity.Id="Cpu.Fan"
                          Capacity="120" MinValue="0" MaxValue="{Binding FanGraphMax}"
                          Accent="#3BD15A" ShowChrome="True" MinHeight="40"
                          CellPitch="{StaticResource DashboardDotPitch}"/>
  </Grid>
</UserControl>
