<UserControl x:Class="Crystal.CpuModule.Views.SummaryViews.CpuFanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:graphs="clr-namespace:Crystal.Controls.PerformanceGraphs;assembly=Crystal.Controls"
             mc:Ignorable="d"
             d:DesignHeight="120" d:DesignWidth="260">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Crystal.Controls;component/Metrics/MetricEnrichmentResources.xaml"/>
        <ResourceDictionary Source="/Crystal.Resources;component/Styles/BorderStyles.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>
  <!-- DataContext is the CPU SensorsViewModel, inherited from the host tile. Fan history graph,
       titled in the utilization pattern: metric label (left), live readout — RPM, or PWM percentage
       on tachometer-less laptops (right). Self-registers under "Cpu.Fan" so the view model feeds it
       on each poll; its upper bound tracks FanGraphMax (100% or 4000 RPM). -->
  <Border Style="{StaticResource SummaryTileBorderStyle}">
    <Grid MinHeight="60" ShowGridLines="False">
      <Grid.RowDefinitions>
        <RowDefinition Height="20"/>
        <RowDefinition Height="1.6*"/>
        <RowDefinition Height=".7*"/>
      </Grid.RowDefinitions>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Bottom">
        <TextBlock Text="CPU Fan" Style="{StaticResource SummaryTileTitleTextBlockStyle}"/>
      </StackPanel>

      <Grid Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" ShowGridLines="False">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="60"/>
          <ColumnDefinition Width="40"/>
          <ColumnDefinition Width="40"/>
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" 
                   Text="{Binding FanReadoutText}" Style="{StaticResource TileMetricValue}"/>
        <TextBlock Grid.Column="1" 
                   Text="{Binding FanReadoutUnit}" Style="{StaticResource MetricUnit}"/>
        <TextBlock Grid.Column="2" 
                   Text="{Binding FanRow.Trend, Converter={StaticResource TrendToGlyph}}"
                   Foreground="{Binding FanRow.Trend, Converter={StaticResource TrendToBrush}}"
                   Style="{StaticResource MetricUnit}" Margin="4,0,0,0"/>
      </Grid>
      <StackPanel Grid.Row="2" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,0,0,0">
        <TextBlock Style="{StaticResource MetricStatLine}">
        <Run Text="min " Foreground="{StaticResource AccentBrush}"/><Run Text="{Binding FanRow.Min, StringFormat={}{0:0}}"/>
        <Run Text="   avg " Foreground="{StaticResource AccentBrush}"/><Run Text="{Binding FanRow.Avg, StringFormat={}{0:0}}"/>
        <Run Text="   max " Foreground="{StaticResource AccentBrush}"/><Run Text="{Binding FanRow.Max, StringFormat={}{0:0}}"/>
        </TextBlock>
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
