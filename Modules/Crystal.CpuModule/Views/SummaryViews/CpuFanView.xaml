<UserControl x:Class="Crystal.CpuModule.Views.SummaryViews.CpuFanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:bars="clr-namespace:Crystal.Controls.RangeBars;assembly=Crystal.Controls"
             xmlns:conv="clr-namespace:Crystal.Controls.Converters;assembly=Crystal.Controls"
             mc:Ignorable="d"
             d:DesignHeight="90" d:DesignWidth="130">
  <!-- DataContext is the CPU SensorsViewModel, inherited from the host tile.
       Value-banded segmented range bar over the live fan reading; the history graph moved to the detail view. -->
  <UserControl.Resources>
    <conv:ValueToBrushConverter x:Key="FanFill" Minimum="0" Step="800" Fallback="#9AA0A6">
      <SolidColorBrush Color="#22B14C"/>
      <SolidColorBrush Color="#E8C22A"/>
      <SolidColorBrush Color="#FF7F27"/>
      <SolidColorBrush Color="#ED1C24"/>
      <SolidColorBrush Color="#B0171F"/>
    </conv:ValueToBrushConverter>
  </UserControl.Resources>
  <StackPanel Width="120" HorizontalAlignment="Left">
		<StackPanel Orientation="Horizontal">
			<TextBlock Text="{Binding FanReadoutText}" Style="{StaticResource MetricValue}"/>
			<TextBlock Text="{Binding FanReadoutUnit}" Style="{StaticResource MetricUnit}"/>
		</StackPanel>
		<bars:RangeBar Style="{StaticResource SummaryRangeBarStyle}"
                   MinValue="0" MaxValue="{Binding FanGraphMax}" Value="{Binding FanReadoutValue}"
                   FillBrush="{Binding Value, RelativeSource={RelativeSource Self}, Converter={StaticResource FanFill}}"/>
    <TextBlock Text="CPU Fan" Style="{StaticResource MetricCaption}"/>
  </StackPanel>
</UserControl>
