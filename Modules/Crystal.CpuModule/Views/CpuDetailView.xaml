<UserControl x:Class="Crystal.CpuModule.Views.CpuDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:local="clr-namespace:Crystal.CpuModule.Views"
             xmlns:graphs="clr-namespace:Crystal.Controls.PerformanceGraphs;assembly=Crystal.Controls"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d"
             d:DesignHeight="820" d:DesignWidth="1600"
             Background="Black" Foreground="{StaticResource TextBrush}"
             FontFamily="{StaticResource UiFontFamily}">
  <UserControl.Resources>
    <local:LoadToBrushConverter x:Key="LoadToBrush"/>

    <!-- Module-specific: CPU's spec value is the OK-green readout, distinct from other modules'
         neutral SpecValue. Label tone is slightly lighter than the shared LabelBrush by design. -->
    <Style x:Key="SpecLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#9AA0A6"/>
      <Setter Property="FontSize" Value="{StaticResource BodyFontSize}"/>
      <Setter Property="Margin" Value="0,1"/>
    </Style>
    <Style x:Key="SpecValue" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource OkBrush}"/>
      <Setter Property="FontSize" Value="{StaticResource BodyFontSize}"/>
      <Setter Property="Margin" Value="6,1,0,1"/>
    </Style>
  </UserControl.Resources>

  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- ============ Header: back + title + static spec readout ============ -->
    <Grid Grid.Row="0" Margin="0,0,0,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <Button Grid.Column="0" Content="&#x2190; Back" Command="{Binding ShowDashboardCommand}"
              VerticalAlignment="Top" Margin="0,0,20,0"
              Style="{StaticResource DetailBackButtonStyle}"/>

      <Grid Grid.Column="1" DataContext="{Binding SpecsViewModel}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Column="0" Text="CPU" Foreground="{StaticResource AccentBrush}" FontSize="26"
                   FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,32,0"/>

        <!-- Identity block -->
        <Grid Grid.Column="1" Margin="0,0,28,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Grid.Column="0" Text="Vendor:" Style="{StaticResource SpecLabel}"/>
          <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Vendor}" Style="{StaticResource SpecValue}"/>
          <TextBlock Grid.Row="1" Grid.Column="0" Text="Socket:" Style="{StaticResource SpecLabel}"/>
          <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Socket}" Style="{StaticResource SpecValue}"/>
        </Grid>

        <!-- Brand / topology block -->
        <Grid Grid.Column="2" Margin="0,0,28,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Grid.Column="0" Text="Brand:" Style="{StaticResource SpecLabel}"/>
          <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Brand}" Style="{StaticResource SpecValue}"/>
          <TextBlock Grid.Row="1" Grid.Column="0" Text="Physical Cores:" Style="{StaticResource SpecLabel}"/>
          <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PhysicalCores}" Style="{StaticResource SpecValue}"/>
        </Grid>

        <!-- Family / logical block -->
        <Grid Grid.Column="3" Margin="0,0,28,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Grid.Column="0" Text="Family:" Style="{StaticResource SpecLabel}"/>
          <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Family}" Style="{StaticResource SpecValue}"/>
          <TextBlock Grid.Row="1" Grid.Column="0" Text="Logical Cores:" Style="{StaticResource SpecLabel}"/>
          <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding LogicalCores}" Style="{StaticResource SpecValue}"/>
        </Grid>

        <!-- Model / stepping / cache block -->
        <Grid Grid.Column="4" Margin="0,0,28,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Grid.Column="0" Text="Model:" Style="{StaticResource SpecLabel}"/>
          <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Model}" Style="{StaticResource SpecValue}"/>
          <TextBlock Grid.Row="1" Grid.Column="0" Text="Stepping:" Style="{StaticResource SpecLabel}"/>
          <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Stepping}" Style="{StaticResource SpecValue}"/>
          <TextBlock Grid.Row="2" Grid.Column="0" Text="L1 Cache Size:" Style="{StaticResource SpecLabel}"/>
          <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource SpecValue}"
                     Text="{Binding L1CacheKb, StringFormat={}{0:0.00} KB}"/>
        </Grid>

        <!-- Speeds / cache / virtualization block -->
        <Grid Grid.Column="5">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="40"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <TextBlock Grid.Row="0" Grid.Column="0" Text="Base Speed:" Style="{StaticResource SpecLabel}"/>
          <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource SpecValue}"
                     Text="{Binding BaseSpeedMHz, StringFormat={}{0:0.00} MHz}"/>
          <TextBlock Grid.Row="1" Grid.Column="0" Text="Bus Speed:" Style="{StaticResource SpecLabel}"/>
          <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource SpecValue}"
                     Text="{Binding BusSpeedMHz, StringFormat={}{0:0.00} MHz}"/>
          <TextBlock Grid.Row="2" Grid.Column="0" Text="Line Size:" Style="{StaticResource SpecLabel}"/>
          <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource SpecValue}"
                     Text="{Binding LineSizeBytes, StringFormat={}{0} B}"/>

          <TextBlock Grid.Row="0" Grid.Column="3" Text="L2 Cache Size:" Style="{StaticResource SpecLabel}"/>
          <TextBlock Grid.Row="0" Grid.Column="4" Style="{StaticResource SpecValue}"
                     Text="{Binding L2CacheKb, StringFormat={}{0:0.00} KB}"/>
          <TextBlock Grid.Row="1" Grid.Column="3" Text="L3 Cache Size:" Style="{StaticResource SpecLabel}"/>
          <TextBlock Grid.Row="1" Grid.Column="4" Style="{StaticResource SpecValue}"
                     Text="{Binding L3CacheKb, StringFormat={}{0:0.00} KB}"/>
          <TextBlock Grid.Row="2" Grid.Column="3" Text="Virtualization:" Style="{StaticResource SpecLabel}"/>
          <TextBlock Grid.Row="2" Grid.Column="4" Text="{Binding Virtualization}" Style="{StaticResource SpecValue}"/>
        </Grid>
      </Grid>
    </Grid>

    <!-- ============ Per-core clocks table ============ -->
    <StackPanel Grid.Row="1" Margin="0,0,0,0" DataContext="{Binding SensorsViewModel}">
      <!-- Shown while the ring-0 PawnIO driver is absent (or the process is unelevated):
           the per-core clocks read from MSRs and stay empty without it. -->
      <Border HorizontalAlignment="Left" Margin="0,0,0,8"
              Background="#3A1F1F" BorderBrush="#C0553A" BorderThickness="1"
              CornerRadius="4" Padding="12,6">
        <Border.Style>
          <Style TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
              <DataTrigger Binding="{Binding MsrSensorsAvailable}" Value="False">
                <Setter Property="Visibility" Value="Visible"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="&#x26A0;" Foreground="{StaticResource WarningBrush}" FontSize="{StaticResource SubHeadingFontSize}"
                     VerticalAlignment="Center" Margin="0,0,8,0"/>
          <TextBlock Foreground="#E7B7A8" FontSize="{StaticResource BodyFontSize}" VerticalAlignment="Center"
                     Text="MSR driver not available — per-core clocks require the PawnIO driver and Administrator privileges."/>
        </StackPanel>
      </Border>

      <!-- Throttle banner: the sensors VM decodes thermal / power-limit / PROCHOT throttling; surface
           it prominently only while active. -->
      <Border HorizontalAlignment="Left" Margin="0,0,0,8"
              Background="#3A1F1F" BorderBrush="#C0553A" BorderThickness="1"
              CornerRadius="4" Padding="12,6">
        <Border.Style>
          <Style TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsThrottling}" Value="True">
                <Setter Property="Visibility" Value="Visible"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="&#x26A0;" Foreground="{StaticResource WarningBrush}" FontSize="{StaticResource SubHeadingFontSize}"
                     VerticalAlignment="Center" Margin="0,0,8,0"/>
          <TextBlock Text="{Binding ThrottleStatus}" Foreground="#E7B7A8" FontSize="{StaticResource BodyFontSize}"
                     FontWeight="SemiBold" VerticalAlignment="Center"/>
        </StackPanel>
      </Border>

      <!-- Package sensor readout strip: live aggregates that were computed but never surfaced.
           Shown only when the MSR-backed sensors are present (they read 0 otherwise). -->
      <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
        <StackPanel.Style>
          <Style TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
              <DataTrigger Binding="{Binding MsrSensorsAvailable}" Value="True">
                <Setter Property="Visibility" Value="Visible"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </StackPanel.Style>
        <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
          <TextBlock Text="Load:" Style="{StaticResource SpecLabel}" VerticalAlignment="Center"/>
          <TextBlock Text="{Binding Load, StringFormat={}{0:0}%}" Style="{StaticResource SpecValue}" VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
          <TextBlock Text="Clock:" Style="{StaticResource SpecLabel}" VerticalAlignment="Center"/>
          <TextBlock Text="{Binding ClockReadoutLabel}" Style="{StaticResource SpecValue}" VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
          <TextBlock Text="Voltage:" Style="{StaticResource SpecLabel}" VerticalAlignment="Center"/>
          <TextBlock Text="{Binding Voltage, StringFormat={}{0:0.000} V}" Style="{StaticResource SpecValue}" VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
          <TextBlock Text="Temp:" Style="{StaticResource SpecLabel}" VerticalAlignment="Center"/>
          <TextBlock Text="{Binding TemperatureLabel}" Style="{StaticResource SpecValue}" VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="Package power:" Style="{StaticResource SpecLabel}" VerticalAlignment="Center"/>
          <TextBlock Text="{Binding PowerReadoutLabel}" Style="{StaticResource SpecValue}" VerticalAlignment="Center"/>
        </StackPanel>
      </StackPanel>

      <!-- AMD SoC voltage and package current (TDC/EDC). Shown only on AMD parts;
           Intel leaves these sensors at 0. -->
      <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
        <StackPanel.Style>
          <Style TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
              <DataTrigger Binding="{Binding HasAmdCurrentSensors}" Value="True">
                <Setter Property="Visibility" Value="Visible"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </StackPanel.Style>
        <TextBlock Text="SoC / current:" Style="{StaticResource SpecLabel}" VerticalAlignment="Center"/>
        <TextBlock Text="{Binding AmdCurrentLabel}" Style="{StaticResource SpecValue}" VerticalAlignment="Center"/>
      </StackPanel>

      <!-- Package C-state residency: how much time the package spent in each deep-idle state.
           Shown only when the platform reports residency (unexposed counters read 0). -->
      <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
        <StackPanel.Style>
          <Style TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
              <DataTrigger Binding="{Binding HasCStateResidency}" Value="True">
                <Setter Property="Visibility" Value="Visible"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </StackPanel.Style>
        <TextBlock Text="Package C-states:" Style="{StaticResource SpecLabel}" VerticalAlignment="Center"/>
        <TextBlock Text="{Binding PackageCStateLabel}" Style="{StaticResource SpecValue}" VerticalAlignment="Center"/>
      </StackPanel>

      <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
        <TextBlock Text="CPU Fan:" Style="{StaticResource SpecLabel}" VerticalAlignment="Center"/>
        <TextBlock Text="{Binding FanReadoutText}" Style="{StaticResource SpecValue}" VerticalAlignment="Center"/>
        <TextBlock Text="{Binding FanReadoutUnit}" Style="{StaticResource SpecLabel}"
                   Margin="4,1,0,1" VerticalAlignment="Center"/>
      </StackPanel>

      <!-- Metric history graphs relocated from the summary tiles. Each self-registers on load so
           this view's own SensorsViewModel feeds it every poll (the summary keeps only utilization). -->
      <TextBlock Text="History:" Foreground="{StaticResource TextMutedBrush}"
                 FontSize="{StaticResource SubHeadingFontSize}" Margin="0,0,0,6"/>
      <Grid Margin="0,0,0,12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="0,0,10,0">
          <TextBlock Text="Clock (GHz)" Style="{StaticResource MetricCaption}" Margin="0,0,0,4"/>
          <graphs:PerformanceGraphLite Loaded="OnGraphLoaded" graphs:GraphIdentity.Id="Cpu.Clock"
                                       Style="{StaticResource SquareDotGraphLiteStyle}"
                                       Capacity="120" MinValue="0" MaxValue="6"
                                       MinHeight="{StaticResource SummaryGraphMinHeight}"/>
        </StackPanel>

        <StackPanel Grid.Column="1" Margin="0,0,10,0">
          <TextBlock Text="Voltage (V)" Style="{StaticResource MetricCaption}" Margin="0,0,0,4"/>
          <graphs:PerformanceGraphLite Loaded="OnGraphLoaded" graphs:GraphIdentity.Id="Cpu.Voltage"
                                       Style="{StaticResource SquareDotGraphLiteStyle}"
                                       Capacity="120" MinValue="0" MaxValue="2"
                                       MinHeight="{StaticResource SummaryGraphMinHeight}"/>
        </StackPanel>

        <StackPanel Grid.Column="2" Margin="0,0,10,0">
          <TextBlock Text="Temperature (℃)" Style="{StaticResource MetricCaption}" Margin="0,0,0,4"/>
          <graphs:PerformanceGraphLite Loaded="OnGraphLoaded" graphs:GraphIdentity.Id="Cpu.Temperature"
                                       Style="{StaticResource SquareDotGraphLiteStyle}"
                                       Capacity="120" MinValue="30" MaxValue="120"
                                       MinHeight="{StaticResource SummaryGraphMinHeight}"/>
        </StackPanel>

        <StackPanel Grid.Column="3" Margin="0,0,10,0">
          <TextBlock Text="Power (W)" Style="{StaticResource MetricCaption}" Margin="0,0,0,4"/>
          <graphs:PerformanceGraphLite Loaded="OnGraphLoaded" graphs:GraphIdentity.Id="Cpu.Power"
                                       Style="{StaticResource SquareDotGraphLiteStyle}"
                                       Capacity="120" MinValue="0" MaxValue="100"
                                       MinHeight="{StaticResource SummaryGraphMinHeight}"/>
        </StackPanel>

        <StackPanel Grid.Column="4">
          <TextBlock Text="Fan" Style="{StaticResource MetricCaption}" Margin="0,0,0,4"/>
          <graphs:PerformanceGraphLite Loaded="OnGraphLoaded" graphs:GraphIdentity.Id="Cpu.Fan"
                                       Style="{StaticResource SquareDotGraphLiteStyle}"
                                       Capacity="120" MinValue="0" MaxValue="{Binding FanGraphMax}"
                                       MinHeight="{StaticResource SummaryGraphMinHeight}"/>
        </StackPanel>
      </Grid>

      <TextBlock Text="Per-Core Clocks:" Foreground="{StaticResource TextMutedBrush}"
                 FontSize="{StaticResource SubHeadingFontSize}" Margin="0,0,0,6"/>
      <ItemsControl ItemsSource="{Binding CoreLoads}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel Orientation="Vertical" Height="112"/>
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Grid Width="360" Margin="0,1,16,1">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="34"/>
                <ColumnDefinition Width="58"/>
                <ColumnDefinition Width="58"/>
                <ColumnDefinition Width="44"/>
                <ColumnDefinition Width="52"/>
                <ColumnDefinition Width="48"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="{Binding Label}" Foreground="{StaticResource LabelBrush}"
                         FontSize="{StaticResource CaptionFontSize}" FontFamily="{StaticResource MonoFontFamily}" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1" Text="{Binding SpeedGhz, StringFormat={}{0:0.00}G}"
                         Foreground="{StaticResource ValueBrush}" FontSize="{StaticResource CaptionFontSize}" FontFamily="{StaticResource MonoFontFamily}"
                         TextAlignment="Right" Margin="0,0,8,0" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="2" Text="{Binding EffectiveSpeedGhz, StringFormat=eff {0:0.00}}"
                         Foreground="{StaticResource UnitBrush}" FontSize="{StaticResource CaptionFontSize}" FontFamily="{StaticResource MonoFontFamily}"
                         TextAlignment="Right" Margin="0,0,8,0" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="3" Text="{Binding Multiplier, StringFormat={}{0:0.0}x}"
                         Foreground="{StaticResource UnitBrush}" FontSize="{StaticResource CaptionFontSize}" FontFamily="{StaticResource MonoFontFamily}"
                         TextAlignment="Right" Margin="0,0,8,0" VerticalAlignment="Center"/>
              <!-- Intel-only thermal headroom; reads 0 on parts that don't expose it. -->
              <TextBlock Grid.Column="4" Text="{Binding DistanceToTjMax, StringFormat=+{0:0}°}"
                         Foreground="{StaticResource UnitBrush}" FontSize="{StaticResource CaptionFontSize}" FontFamily="{StaticResource MonoFontFamily}"
                         TextAlignment="Right" Margin="0,0,8,0" VerticalAlignment="Center"/>
              <!-- AMD-only per-core power (SMU); reads 0 on parts that don't expose it. -->
              <TextBlock Grid.Column="5" Text="{Binding Power, StringFormat={}{0:0.0}W}"
                         Foreground="{StaticResource UnitBrush}" FontSize="{StaticResource CaptionFontSize}" FontFamily="{StaticResource MonoFontFamily}"
                         TextAlignment="Right" Margin="0,0,8,0" VerticalAlignment="Center"/>
              <!-- Per-logical-thread load: one heat-coloured mini bar per thread, stacked. -->
              <ItemsControl Grid.Column="6" ItemsSource="{Binding Threads}" VerticalAlignment="Center">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding Load}" Height="5" Margin="0,1"
                                 Background="#1A1A1A" BorderBrush="{StaticResource BorderBrush}"
                                 Foreground="{Binding Load, Converter={StaticResource LoadToBrush}}"/>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>

    <!-- ============ Instruction set grid ============ -->
    <StackPanel Grid.Row="2" Margin="0,10,0,0">
      <TextBlock Text="Instruction Set Features Available:" Foreground="{StaticResource TextMutedBrush}"
                 FontSize="{StaticResource SubHeadingFontSize}" Margin="0,0,0,6"/>
      <ItemsControl DataContext="{Binding SpecsViewModel}" ItemsSource="{Binding InstructionSet}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel Orientation="Vertical" Height="90"/>
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding Name}" FontSize="{StaticResource CaptionFontSize}" FontWeight="SemiBold"
                       Width="96" Margin="0,1,12,1">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Foreground" Value="#4A4A4A"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsAvailable}" Value="True">
                      <Setter Property="Foreground" Value="{StaticResource OkBrush}"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </Grid>
</UserControl>
