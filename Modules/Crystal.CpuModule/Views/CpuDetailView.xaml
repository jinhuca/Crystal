<UserControl x:Class="Crystal.CpuModule.Views.CpuDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:dv="clr-namespace:Crystal.CpuModule.Views.DetailViews"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d"
             d:DesignHeight="820" d:DesignWidth="1600"
             Background="Black" Foreground="{StaticResource TextBrush}"
             FontFamily="{StaticResource UiFontFamily}">
  <!-- Thin composing layout: the detail view is assembled from per-section sub-views in
       Views/DetailViews, mirroring how CpuSummaryView composes Views/SummaryViews. The header
       inherits the root ICpuViewModel; the middle column binds SensorsViewModel; the instruction
       grid binds SpecsViewModel. -->
  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <dv:CpuDetailHeaderView Grid.Row="0" Margin="0,0,0,10"/>

    <StackPanel Grid.Row="1" DataContext="{Binding SensorsViewModel}">
      <dv:CpuStatusBannersView/>
      <dv:CpuPackageReadoutView/>
      <dv:CpuHistoryGraphsView Margin="0,0,0,12"/>
      <dv:CpuCoreClocksView/>
    </StackPanel>

    <dv:CpuInstructionSetView Grid.Row="2" Margin="0,10,0,0" DataContext="{Binding SpecsViewModel}"/>
  </Grid>
</UserControl>
