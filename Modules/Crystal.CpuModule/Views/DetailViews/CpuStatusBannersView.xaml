<UserControl x:Class="Crystal.CpuModule.Views.DetailViews.CpuStatusBannersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="60" d:DesignWidth="600"
             Foreground="{StaticResource TextBrush}" FontFamily="{StaticResource UiFontFamily}">
  <!-- DataContext is the CPU sensors view model, inherited from the host layout. Two alert banners
       that surface only while active: MSR driver missing, and active throttling. -->
  <StackPanel>
    <!-- Shown while the ring-0 PawnIO driver is absent (or the process is unelevated):
         the per-core clocks read from MSRs and stay empty without it. -->
    <Border HorizontalAlignment="Left" Margin="0,0,0,8"
            Background="#3A1F1F" BorderBrush="#C0553A" BorderThickness="1"
            CornerRadius="4" Padding="12,6">
      <Border.Style>
        <Style TargetType="Border">
          <Setter Property="Visibility" Value="Collapsed"/>
          <Style.Triggers>
            <DataTrigger Binding="{Binding MsrSensorsAvailable}" Value="False">
              <Setter Property="Visibility" Value="Visible"/>
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Style>
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="&#x26A0;" Foreground="{StaticResource WarningBrush}" FontSize="{StaticResource SubHeadingFontSize}"
                   VerticalAlignment="Center" Margin="0,0,8,0"/>
        <TextBlock Foreground="#E7B7A8" FontSize="{StaticResource BodyFontSize}" VerticalAlignment="Center"
                   Text="MSR driver not available — per-core clocks require the PawnIO driver and Administrator privileges."/>
      </StackPanel>
    </Border>

    <!-- Throttle banner: the sensors VM decodes thermal / power-limit / PROCHOT throttling; surface
         it prominently only while active. -->
    <Border HorizontalAlignment="Left" Margin="0,0,0,8"
            Background="#3A1F1F" BorderBrush="#C0553A" BorderThickness="1"
            CornerRadius="4" Padding="12,6">
      <Border.Style>
        <Style TargetType="Border">
          <Setter Property="Visibility" Value="Collapsed"/>
          <Style.Triggers>
            <DataTrigger Binding="{Binding IsThrottling}" Value="True">
              <Setter Property="Visibility" Value="Visible"/>
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Style>
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="&#x26A0;" Foreground="{StaticResource WarningBrush}" FontSize="{StaticResource SubHeadingFontSize}"
                   VerticalAlignment="Center" Margin="0,0,8,0"/>
        <TextBlock Text="{Binding ThrottleStatus}" Foreground="#E7B7A8" FontSize="{StaticResource BodyFontSize}"
                   FontWeight="SemiBold" VerticalAlignment="Center"/>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
