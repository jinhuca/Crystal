<Window x:Class="Crystal.ProcessModule.Views.RunNewTaskDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Run new task"
        Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False"
        Background="#0D0D0D" Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource UiFontFamily}" WindowStyle="ToolWindow">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Crystal.ProcessModule;component/Views/ProcessResources.xaml"/>
      </ResourceDictionary.MergedDictionaries>

      <!-- Dialog buttons reuse the shared flat dark button (ProcessResources.xaml) verbatim, so the
           dialog and the process toolbar stay visually identical from one definition. -->
      <Style x:Key="DialogButtonStyle" TargetType="Button" BasedOn="{StaticResource FlatDarkButtonStyle}"/>

      <!-- Default action (Run): same flat body, but an accent border at rest marks it as the default. -->
      <Style x:Key="DialogDefaultButtonStyle" TargetType="Button" BasedOn="{StaticResource DialogButtonStyle}">
        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
      </Style>
    </ResourceDictionary>
  </Window.Resources>
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" Foreground="#B0B0B0" FontSize="{StaticResource BodyFontSize}"
               TextWrapping="Wrap" Margin="0,0,0,10"
               Text="Type the name of a program, folder, document, or the path to a resource, and Crystal will open it for you."/>

    <TextBox x:Name="CommandBox" Grid.Row="1"
             Background="#0A0A0A" Foreground="{StaticResource TextPrimaryBrush}" CaretBrush="{StaticResource TextPrimaryBrush}"
             BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="6,4"
             FontFamily="{StaticResource MonoFontFamily}" FontSize="{StaticResource BodyFontSize}"
             KeyDown="OnCommandKeyDown"/>

    <CheckBox x:Name="AdminCheck" Grid.Row="2" Margin="0,12,0,0"
              Foreground="#B0B0B0" FontSize="{StaticResource BodyFontSize}"
              Content="Run with administrator privileges"/>

    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right"
                Margin="0,16,0,0">
      <Button Content="Run" Width="80" Height="26" Margin="0,0,8,0"
              FontSize="{StaticResource BodyFontSize}" IsDefault="True" Click="OnRun"
              Style="{StaticResource DialogDefaultButtonStyle}"/>
      <Button Content="Cancel" Width="80" Height="26"
              FontSize="{StaticResource BodyFontSize}" IsCancel="True"
              Style="{StaticResource DialogButtonStyle}"/>
    </StackPanel>
  </Grid>
</Window>
