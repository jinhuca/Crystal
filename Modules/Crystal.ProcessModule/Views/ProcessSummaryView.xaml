<UserControl x:Class="Crystal.ProcessModule.Views.ProcessSummaryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d"
             d:DesignHeight="140" d:DesignWidth="240"
             Background="Transparent" Foreground="{StaticResource TextBrush}"
             FontFamily="{StaticResource UiFontFamily}">
  <UserControl.Resources>
    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource LabelBrush}"/>
      <Setter Property="FontSize" Value="{StaticResource CaptionFontSize}"/>
    </Style>
    <Style x:Key="FieldValue" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource ValueBrush}"/>
      <Setter Property="FontSize" Value="{StaticResource SectionFontSize}"/>
      <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
  </UserControl.Resources>

  <!-- Whole tile is the double-click target: opens the full process list in its own window. -->
  <Border Background="Transparent" Cursor="Hand" MouseLeftButtonDown="OnTileClick"
          ToolTip="Double-click to open the full process list">
    <Grid Margin="10">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- Dense header bar: accent tick + title, thin divider rule below. -->
      <Border Grid.Row="0" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1"
              Padding="0,0,0,4" Margin="0,0,0,8">
        <StackPanel Orientation="Horizontal">
          <Border Width="3" Background="{StaticResource AccentBrush}" Margin="0,1,8,1"/>
          <TextBlock Text="PROCESSES, THREADS, HANDLES" Foreground="{StaticResource ValueBrush}"
                     FontSize="{StaticResource BodyFontSize}" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </StackPanel>
      </Border>

      <Grid Grid.Row="1" VerticalAlignment="Top">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0">
          <TextBlock Text="Processes" Style="{StaticResource FieldLabel}"/>
          <TextBlock Text="{Binding ProcessCountLabel}" Style="{StaticResource FieldValue}"/>
        </StackPanel>
        <StackPanel Grid.Column="1">
          <TextBlock Text="Threads" Style="{StaticResource FieldLabel}"/>
          <TextBlock Text="{Binding ThreadCountLabel}" Style="{StaticResource FieldValue}"/>
        </StackPanel>
        <StackPanel Grid.Column="2">
          <TextBlock Text="Handles" Style="{StaticResource FieldLabel}"/>
          <TextBlock Text="{Binding HandleCountLabel}" Style="{StaticResource FieldValue}"/>
        </StackPanel>
      </Grid>
    </Grid>
  </Border>
</UserControl>
