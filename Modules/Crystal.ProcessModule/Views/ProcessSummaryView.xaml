<UserControl x:Class="Crystal.ProcessModule.Views.ProcessSummaryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:local="clr-namespace:Crystal.ProcessModule.Views"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d"
             d:DesignHeight="360" d:DesignWidth="1400"
             Background="Transparent" Foreground="{StaticResource TextBrush}"
             FontFamily="{StaticResource UiFontFamily}">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Crystal.Controls;component/Themes/ScrollBarStyles.xaml"/>
        <ResourceDictionary Source="/Crystal.ProcessModule;component/Views/ProcessResources.xaml"/>
      </ResourceDictionary.MergedDictionaries>

      <local:ByteRateConverter x:Key="ByteRate"/>
      <local:NullablePercentConverter x:Key="NullablePercent"/>
      <local:LoadToBrushConverter x:Key="LoadToBrush"/>
      <local:NullToVisibilityConverter x:Key="NullToVisibility"/>

      <!-- Dense, sharp-edged column header matching the HWiNFO tile styling. -->
      <Style x:Key="HeaderStyle" TargetType="GridViewColumnHeader">
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Padding" Value="8,0,8,0"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="Background" Value="#141414"/>
        <Setter Property="Foreground" Value="{StaticResource LabelBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,1,1"/>
        <Setter Property="FontSize" Value="{StaticResource CaptionFontSize}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="GridViewColumnHeader">
              <Grid>
                <Border x:Name="HeaderBorder" Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                  <ContentPresenter x:Name="HeaderContent" Margin="{TemplateBinding Padding}"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    RecognizesAccessKey="True"
                                    SnapsToDevicePixels="True"/>
                </Border>
                <!-- Drag handle at the right edge for resizing the column. -->
                <Thumb x:Name="PART_HeaderGripper" HorizontalAlignment="Right"
                       Width="8" Cursor="SizeWE" Background="Transparent">
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Border Background="{TemplateBinding Background}" Padding="0">
                        <Rectangle Width="1" HorizontalAlignment="Center" Fill="{StaticResource DividerBrush}"/>
                      </Border>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="HeaderBorder" Property="Background" Value="#1C1C1C"/>
                  <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- Compact dark search box embedded in the Name/PID column headers. -->
      <Style x:Key="HeaderSearchBoxStyle" TargetType="TextBox">
        <Setter Property="Background" Value="#0A0A0A"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="CaretBrush" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="4,1"/>
        <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}"/>
        <Setter Property="FontSize" Value="{StaticResource CaptionFontSize}"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="TextBox">
              <Border x:Name="Bd" Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}">
                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                              VerticalAlignment="Center"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                  <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- Dark, flat menu item matching the dashboard palette: no icon gutter, flat accent-blue
           hover, thin separators. Scoped to the row context menu below via its Resources. -->
      <Style x:Key="RowMenuItemStyle" TargetType="MenuItem">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="MenuItem">
              <Border x:Name="Bd" Background="{TemplateBinding Background}"
                      Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                <ContentPresenter ContentSource="Header" VerticalAlignment="Center"
                                  RecognizesAccessKey="True"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                  <Setter TargetName="Bd" Property="Background" Value="#1E3A52"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter Property="Foreground" Value="#5A6470"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- Toolbar sizing/typography over the shared FlatDarkButtonStyle (ProcessResources.xaml).
           The destructive/record variants below still derive from this so they inherit the same
           compact metrics; DangerButtonStyle overrides the template with a red palette. -->
      <Style x:Key="ToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource FlatDarkButtonStyle}">
        <Setter Property="Height" Value="18"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="FontSize" Value="{StaticResource CaptionFontSize}"/>
        <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}"/>
      </Style>

      <!-- Destructive variant (End task): red resting palette, brighter red on hover/press so the
           terminate action stays visually distinct from the neutral toolbar buttons. -->
      <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolbarButtonStyle}">
        <Setter Property="Foreground" Value="#E8A0A0"/>
        <Setter Property="Background" Value="#2A1414"/>
        <Setter Property="BorderBrush" Value="#7A2E2E"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="Bd" Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      SnapsToDevicePixels="True">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Bd" Property="Background" Value="#3A1A1A"/>
                  <Setter TargetName="Bd" Property="BorderBrush" Value="#A03A3A"/>
                  <Setter Property="Foreground" Value="#F5C0C0"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="Bd" Property="Background" Value="{StaticResource DangerBrush}"/>
                  <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource DangerBrush}"/>
                  <Setter Property="Foreground" Value="#0A0A0A"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="Bd" Property="Background" Value="#1A1010"/>
                  <Setter TargetName="Bd" Property="BorderBrush" Value="#4A2626"/>
                  <Setter Property="Foreground" Value="#6E5050"/>
                  <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- Record toggle: neutral like the other toolbar buttons when idle, but while recording it
           takes a steady accent fill so the active state is unmistakable next to Run/End. -->
      <Style x:Key="RecordButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolbarButtonStyle}">
        <Style.Triggers>
          <DataTrigger Binding="{Binding IsRecording}" Value="True">
            <Setter Property="Background" Value="#1C3A52"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="#8FD0FF"/>
          </DataTrigger>
        </Style.Triggers>
      </Style>

      <Style x:Key="RowMenuSeparatorStyle" TargetType="Separator">
        <Setter Property="Margin" Value="0,3"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Separator">
              <Border Height="1" Background="{StaticResource DividerBrush}"/>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- Right-click menu for a process row, shared by every row via RowStyle. Defined as a keyed
           resource (not inline in the setter) so its Click handlers wire up correctly. The chrome is
           templated to a flat dark surface instead of the default 3D popup. -->
      <ContextMenu x:Key="RowContextMenu" Background="#161616" BorderBrush="{StaticResource BorderBrush}"
                   Foreground="{StaticResource TextPrimaryBrush}" FontFamily="{StaticResource MonoFontFamily}" FontSize="{StaticResource CaptionFontSize}"
                   HasDropShadow="True">
        <ContextMenu.Resources>
          <Style TargetType="MenuItem" BasedOn="{StaticResource RowMenuItemStyle}"/>
          <Style TargetType="Separator" BasedOn="{StaticResource RowMenuSeparatorStyle}"/>
        </ContextMenu.Resources>
        <ContextMenu.Template>
          <ControlTemplate TargetType="ContextMenu">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                    Padding="2" SnapsToDevicePixels="True">
              <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
            </Border>
          </ControlTemplate>
        </ContextMenu.Template>

        <MenuItem Header="End task" Foreground="#E8A0A0" Click="OnEndTask"/>
        <Separator/>
        <MenuItem Header="Open file location" Click="OnOpenFileLocation"/>
        <MenuItem Header="Copy name" Click="OnCopyName"/>
        <MenuItem Header="Copy PID" Click="OnCopyPid"/>
        <MenuItem Header="Copy image path" Click="OnCopyImagePath"/>
      </ContextMenu>

      <!-- Flat, tight rows; hover and selection are flat fills (no rounded highlight). Ordering
           matters: IsMouseOver comes first so the selection fill (below) wins on a hovered
           selected row, and the MultiTrigger gives a slightly brighter blue for selected+hover. -->
      <Style x:Key="RowStyle" TargetType="ListViewItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Height" Value="22"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <!-- Right-click actions on a row. Opening the menu selects the row (WPF selects on
             right-press), so the VM's SelectedRow is the target by the time End task fires. The
             menu lives as a keyed resource, not inline here: an event handler on an element inside
             a Style setter misaligns WPF's connection-id wiring at load. -->
        <Setter Property="ContextMenu" Value="{StaticResource RowContextMenu}"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ListViewItem">
              <Border x:Name="Bd" Background="{TemplateBinding Background}"
                      BorderBrush="Transparent" BorderThickness="0"
                      SnapsToDevicePixels="True">
                <GridViewRowPresenter VerticalAlignment="Center"
                                      SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Bd" Property="Background" Value="#1B2733"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                  <Setter TargetName="Bd" Property="Background" Value="#1E3A52"/>
                  <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                </Trigger>
                <MultiTrigger>
                  <MultiTrigger.Conditions>
                    <Condition Property="IsSelected" Value="True"/>
                    <Condition Property="IsMouseOver" Value="True"/>
                  </MultiTrigger.Conditions>
                  <Setter TargetName="Bd" Property="Background" Value="#254B69"/>
                </MultiTrigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- Full ListView chrome: flat dark surface, no default 3D border, GridView header + scroll. -->
      <Style x:Key="ProcessListViewStyle" TargetType="ListView">
        <Setter Property="Background" Value="#0D0D0D"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <!-- Visible (not Auto): the list re-sorts/refreshes every second, and Auto would re-decide
             whether the scrollbar is needed on each tick — toggling the GridView header's right-edge
             padding filler and making the grey block above the scrollbar flicker. Reserving the
             scrollbar space permanently stops that flash. -->
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Visible"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ListView">
              <Border BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      Background="{TemplateBinding Background}"
                      SnapsToDevicePixels="True">
                <ScrollViewer Padding="{TemplateBinding Padding}"
                              Style="{DynamicResource {x:Static GridView.GridViewScrollViewerStyleKey}}">
                  <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                </ScrollViewer>
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </UserControl.Resources>

  <Grid Margin="10">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- Dense header bar: accent tick + title on the left, Name/PID search on the right -->
    <Border Grid.Row="0" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1"
            Padding="0,0,0,4" Margin="0,0,0,6">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Orientation="Horizontal">
          <Border Width="3" Background="{StaticResource AccentBrush}" Margin="0,1,8,1"/>
          <TextBlock Text="PROCESSES" Foreground="{StaticResource ValueBrush}" FontSize="{StaticResource BodyFontSize}" FontWeight="SemiBold"
                     VerticalAlignment="Center" Margin="0,0,12,0"/>
          <TextBlock Text="{Binding Rows.Count, StringFormat={}{0} active}"
                     Foreground="{StaticResource LabelBrush}" FontSize="{StaticResource CaptionFontSize}" FontFamily="{StaticResource MonoFontFamily}"
                     VerticalAlignment="Center"/>

          <!-- System-wide totals, right after the active count -->
          <TextBlock Text="{Binding ProcessCount, StringFormat=Processes: {0:N0}}"
                     Foreground="{StaticResource LabelBrush}" FontSize="{StaticResource CaptionFontSize}" FontFamily="{StaticResource MonoFontFamily}"
                     VerticalAlignment="Center" Margin="16,0,0,0"/>
          <TextBlock Text="{Binding ThreadCount, StringFormat=Threads: {0:N0}}"
                     Foreground="{StaticResource LabelBrush}" FontSize="{StaticResource CaptionFontSize}" FontFamily="{StaticResource MonoFontFamily}"
                     VerticalAlignment="Center" Margin="16,0,0,0"/>
          <TextBlock Text="{Binding HandleCount, StringFormat=Handles: {0:N0}}"
                     Foreground="{StaticResource LabelBrush}" FontSize="{StaticResource CaptionFontSize}" FontFamily="{StaticResource MonoFontFamily}"
                     VerticalAlignment="Center" Margin="16,0,0,0"/>

          <!-- Sustained-hog badge: amber, shown only when at least one process has crossed a peak
               threshold this session. -->
          <Border Background="#3A2A12" BorderBrush="#7A5A1E" BorderThickness="1"
                  Padding="8,1" Margin="16,0,0,0" VerticalAlignment="Center">
            <Border.Style>
              <Style TargetType="Border">
                <Setter Property="Visibility" Value="Visible"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding HogCount}" Value="0">
                    <Setter Property="Visibility" Value="Collapsed"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Border.Style>
            <TextBlock Foreground="#E0B84C" FontSize="{StaticResource CaptionFontSize}" FontFamily="{StaticResource MonoFontFamily}"
                       Text="{Binding HogCount, StringFormat={}{0} hog(s)}"
                       ToolTip="Processes whose session CPU or memory peak crossed the hog threshold"/>
          </Border>

          <!-- Warning shown only when the ETW session failed to start; explains blank GPU/Disk/Network. -->
          <Border Background="#3A2A12" BorderBrush="#7A5A1E" BorderThickness="1"
                  Padding="8,1" Margin="12,0,0,0" VerticalAlignment="Center"
                  Visibility="{Binding HasMetricsStatusError, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Foreground="#E0B84C" FontSize="{StaticResource CaptionFontSize}" FontFamily="{StaticResource MonoFontFamily}"
                       Text="{Binding MetricsStatusError, StringFormat=GPU/Disk/Network unavailable: {0}}"/>
          </Border>

          <!-- Red toast for a failed End task / Run new task, shown only while there's a message. -->
          <Border Background="#2A1414" BorderBrush="#7A2E2E" BorderThickness="1"
                  Padding="8,1" Margin="12,0,0,0" VerticalAlignment="Center"
                  Visibility="{Binding HasActionStatus, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Foreground="#E8A0A0" FontSize="{StaticResource CaptionFontSize}" FontFamily="{StaticResource MonoFontFamily}"
                       Text="{Binding ActionStatus}"/>
          </Border>
        </StackPanel>

        <!-- Name / PID filters, moved up from the column headers. Left margin keeps a gap from the
             left panel's trailing badge (e.g. the hog count) when the window narrows. -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
          <TextBlock Text="Name" Foreground="{StaticResource LabelBrush}" FontSize="{StaticResource CaptionFontSize}" FontFamily="{StaticResource MonoFontFamily}"
                     VerticalAlignment="Center" Margin="0,0,6,0"/>
          <TextBox Style="{StaticResource HeaderSearchBoxStyle}" Width="110" Height="18"
                   ToolTip="Filter by process name"
                   Text="{Binding NameFilter, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>
          <TextBlock Text="PID" Foreground="{StaticResource LabelBrush}" FontSize="{StaticResource CaptionFontSize}" FontFamily="{StaticResource MonoFontFamily}"
                     VerticalAlignment="Center" Margin="16,0,6,0"/>
          <TextBox Style="{StaticResource HeaderSearchBoxStyle}" Width="80" Height="18"
                   ToolTip="Filter by PID"
                   Text="{Binding PidFilter, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>
          <Button Content="Copy" Margin="16,0,0,0" Style="{StaticResource ToolbarButtonStyle}"
                  ToolTip="Copy the visible rows to the clipboard as tab-separated text"
                  IsEnabled="{Binding HasVisibleRows}" Click="OnCopyRows"/>
          <Button Content="Save…" Margin="6,0,0,0" Style="{StaticResource ToolbarButtonStyle}"
                  ToolTip="Save the visible rows to a file"
                  IsEnabled="{Binding HasVisibleRows}" Click="OnSaveRows"/>
          <Button Content="Reset pk" Margin="6,0,0,0" Style="{StaticResource ToolbarButtonStyle}"
                  ToolTip="Reset all session CPU/memory peaks to the current readings"
                  IsEnabled="{Binding HasVisibleRows}" Click="OnResetPeaks"/>
          <Button Content="Run new task" Margin="16,0,0,0" Style="{StaticResource ToolbarButtonStyle}"
                  ToolTip="Launch a new process (optionally as administrator)"
                  Click="OnRunNewTask"/>
          <!-- Toggle: records the selected process's per-poll readings to a CSV; enabled once a row
               is selected, then stays enabled (as "Stop rec") until stopped or the process exits. -->
          <Button Content="{Binding RecordButtonLabel}" Margin="6,0,0,0" Style="{StaticResource RecordButtonStyle}"
                  ToolTip="Record the selected process's CPU/memory/GPU/disk/network to a CSV file"
                  IsEnabled="{Binding CanStartRecording}" Click="OnToggleRecord"/>
          <!-- Destructive, so it reads red and is disabled until a row is selected. -->
          <Button Content="End task" Margin="6,0,0,0" Style="{StaticResource DangerButtonStyle}"
                  ToolTip="Terminate the selected process"
                  IsEnabled="{Binding CanEndSelectedTask}" Click="OnEndTask"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Master (list) on the left, detail panel on the right, split by a draggable separator. -->
    <Grid Grid.Row="1" x:Name="MasterDetailGrid">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="MasterColumn" Width="*" MinWidth="400"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition x:Name="DetailColumn" Width="360" MinWidth="240"/>
      </Grid.ColumnDefinitions>

      <ListView Grid.Column="0" ItemsSource="{Binding RowsView}"
                SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                SelectionMode="Single"
                GridViewColumnHeader.Click="OnColumnHeaderClick"
                Style="{StaticResource ProcessListViewStyle}"
                ItemContainerStyle="{StaticResource RowStyle}"
                VirtualizingPanel.IsVirtualizing="True"
                VirtualizingPanel.VirtualizationMode="Recycling"
                VirtualizingPanel.IsVirtualizingWhenGrouping="True">
        <ListView.Resources>
          <!-- Restyle the list's built-in scrollbars to match the dashboard palette. -->
          <Style TargetType="ScrollBar" BasedOn="{StaticResource CrystalScrollBarStyle}"/>
        </ListView.Resources>
        <ListView.GroupStyle>
          <GroupStyle>
            <GroupStyle.HeaderTemplate>
              <DataTemplate>
                <Border Background="#141414" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1"
                        Padding="8,3">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource AccentBrush}" FontSize="{StaticResource CaptionFontSize}"
                               FontWeight="SemiBold" FontFamily="{StaticResource MonoFontFamily}"/>
                    <TextBlock Text="{Binding ItemCount, StringFormat={}({0})}"
                               Foreground="#5A6470" FontSize="{StaticResource CaptionFontSize}" FontFamily="{StaticResource MonoFontFamily}"
                               Margin="6,0,0,0"/>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </GroupStyle.HeaderTemplate>
          </GroupStyle>
        </ListView.GroupStyle>
        <ListView.View>
          <GridView x:Name="ProcessGridView" ColumnHeaderContainerStyle="{StaticResource HeaderStyle}">
            <GridViewColumn Header="Name" Width="160" local:GridViewSort.SortProperty="Name">
              <GridViewColumn.CellTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal" Margin="8,2">
                    <!-- Per-process shell icon (Task Manager-style). Fixed 16px box so rows stay
                         aligned whether or not the icon has resolved yet; RenderOptions keeps the
                         small bitmap crisp instead of blurred. -->
                    <Image Source="{Binding IconSource}" Width="16" Height="16"
                           Margin="0,0,6,0" VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="NearestNeighbor"
                           SnapsToDevicePixels="True"/>
                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextPrimaryBrush}"
                               FontFamily="{StaticResource MonoFontFamily}" FontSize="{StaticResource CaptionFontSize}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                  </StackPanel>
                </DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Header="PID" Width="80" local:GridViewSort.SortProperty="ProcessId">
              <GridViewColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding ProcessId}" Foreground="{StaticResource LabelBrush}"
                             FontFamily="{StaticResource MonoFontFamily}" FontSize="{StaticResource CaptionFontSize}" Margin="8,2"
                             TextAlignment="Right"/>
                </DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Header="Status" Width="90" local:GridViewSort.SortProperty="Status">
              <GridViewColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Status}" Foreground="{StaticResource TextMutedBrush}"
                             FontFamily="{StaticResource MonoFontFamily}" FontSize="{StaticResource CaptionFontSize}" Margin="8,2"
                             TextTrimming="CharacterEllipsis"/>
                </DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Header="CPU" Width="70" local:GridViewSort.SortProperty="CpuPercent">
              <GridViewColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding CpuPercent, StringFormat={}{0:0.0}%}"
                             Foreground="{Binding CpuPercent, Converter={StaticResource LoadToBrush}}"
                             FontFamily="{StaticResource MonoFontFamily}" FontSize="{StaticResource CaptionFontSize}" Margin="8,2"
                             TextAlignment="Right"/>
                </DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Header="CPU pk" Width="70" local:GridViewSort.SortProperty="PeakCpuPercent">
              <GridViewColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding PeakCpuPercent, StringFormat={}{0:0.0}%}"
                             FontFamily="{StaticResource MonoFontFamily}" FontSize="{StaticResource CaptionFontSize}"
                             Margin="8,2" TextAlignment="Right"
                             ToolTip="Session peak CPU">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <!-- Dim by default; tint amber once the peak crossed the sustained-hog
                             threshold, flagging a process that spiked hard even if idle now. -->
                        <Setter Property="Foreground" Value="#6E7A86"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsSustainedCpuHog}" Value="True">
                            <Setter Property="Foreground" Value="#E8B32A"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Header="GPU" Width="70" local:GridViewSort.SortProperty="GpuPercent">
              <GridViewColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding GpuPercent, Converter={StaticResource NullablePercent}}"
                             Foreground="{StaticResource TextMutedBrush}" FontFamily="{StaticResource MonoFontFamily}" FontSize="{StaticResource CaptionFontSize}"
                             Margin="8,2" TextAlignment="Right"/>
                </DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Header="Memory" Width="80" local:GridViewSort.SortProperty="WorkingSetMb">
              <GridViewColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding WorkingSetMb, StringFormat={}{0:0} MB}"
                             Foreground="{StaticResource TextMutedBrush}" FontFamily="{StaticResource MonoFontFamily}" FontSize="{StaticResource CaptionFontSize}"
                             Margin="8,2" TextAlignment="Right"/>
                </DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Header="Mem pk" Width="80" local:GridViewSort.SortProperty="PeakWorkingSetMb">
              <GridViewColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding PeakWorkingSetMb, StringFormat={}{0:0} MB}"
                             FontFamily="{StaticResource MonoFontFamily}" FontSize="{StaticResource CaptionFontSize}"
                             Margin="8,2" TextAlignment="Right"
                             ToolTip="Session peak working set">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="#6E7A86"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsMemoryHog}" Value="True">
                            <Setter Property="Foreground" Value="#E8B32A"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Header="Disk" Width="85" local:GridViewSort.SortProperty="DiskBytesPerSec">
              <GridViewColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding DiskBytesPerSec, Converter={StaticResource ByteRate}}"
                             Foreground="{StaticResource TextMutedBrush}" FontFamily="{StaticResource MonoFontFamily}" FontSize="{StaticResource CaptionFontSize}"
                             Margin="8,2" TextAlignment="Right"/>
                </DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Header="Network" Width="85" local:GridViewSort.SortProperty="NetBytesPerSec">
              <GridViewColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding NetBytesPerSec, Converter={StaticResource ByteRate}}"
                             Foreground="{StaticResource TextMutedBrush}" FontFamily="{StaticResource MonoFontFamily}" FontSize="{StaticResource CaptionFontSize}"
                             Margin="8,2" TextAlignment="Right"/>
                </DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
          </GridView>
        </ListView.View>
      </ListView>

      <!-- Draggable separator: resizes the master list vs. detail panel. A thin accent rule is
           centered in the wider hit area so the grab target is comfortable but reads as a hairline. -->
      <GridSplitter Grid.Column="1" Width="7" HorizontalAlignment="Center"
                    VerticalAlignment="Stretch" Background="Transparent"
                    ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"
                    ShowsPreview="False" Cursor="SizeWE">
        <GridSplitter.Template>
          <ControlTemplate TargetType="GridSplitter">
            <Grid Background="{TemplateBinding Background}">
              <Border x:Name="Rule" Width="1" Background="{StaticResource DividerBrush}" HorizontalAlignment="Center"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Rule" Property="Background" Value="{StaticResource AccentBrush}"/>
                <Setter TargetName="Rule" Property="Width" Value="2"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </GridSplitter.Template>
      </GridSplitter>

      <!-- Detail panel: live metrics for the selected process -->
      <Border Grid.Column="2" Background="#101010" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1">
        <Grid>
          <!-- Empty-state hint when nothing is selected -->
          <TextBlock Text="Select a process to view details"
                     Foreground="#5A6470" FontSize="{StaticResource CaptionFontSize}" FontFamily="{StaticResource MonoFontFamily}"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     Visibility="{Binding SelectedRow, Converter={StaticResource NullToVisibility}, ConverterParameter=invert}"/>

          <StackPanel Margin="12,10" DataContext="{Binding SelectedRow}"
                      Visibility="{Binding Converter={StaticResource NullToVisibility}}">
            <!-- Process identity -->
            <TextBlock Text="{Binding Name}" Foreground="{StaticResource ValueBrush}" FontSize="{StaticResource SubHeadingFontSize}"
                       FontWeight="SemiBold" FontFamily="{StaticResource MonoFontFamily}"
                       TextTrimming="CharacterEllipsis"/>
            <StackPanel Orientation="Horizontal" Margin="0,2,0,10">
              <TextBlock Text="{Binding ProcessId, StringFormat=PID {0}}"
                         Foreground="{StaticResource LabelBrush}" FontSize="{StaticResource CaptionFontSize}" FontFamily="{StaticResource MonoFontFamily}"
                         Margin="0,0,12,0"/>
              <TextBlock Text="{Binding Status}" Foreground="{StaticResource LabelBrush}"
                         FontSize="{StaticResource CaptionFontSize}" FontFamily="{StaticResource MonoFontFamily}" Margin="0,0,12,0"/>
              <TextBlock Text="{Binding CategoryName}" Foreground="{StaticResource TextMutedBrush}"
                         FontSize="{StaticResource CaptionFontSize}" FontFamily="{StaticResource MonoFontFamily}"/>
            </StackPanel>

            <Border BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0" Margin="0,0,0,8"/>

            <!-- Live metric rows -->
            <Grid Margin="0,2">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="CPU" Foreground="{StaticResource LabelBrush}"
                         FontSize="{StaticResource BodyFontSize}" FontFamily="{StaticResource MonoFontFamily}"/>
              <TextBlock Grid.Column="1" Text="{Binding CpuPercent, StringFormat={}{0:0.0}%}"
                         Foreground="{Binding CpuPercent, Converter={StaticResource LoadToBrush}}"
                         FontSize="{StaticResource BodyFontSize}" FontFamily="{StaticResource MonoFontFamily}" TextAlignment="Right"/>
            </Grid>
            <Grid Margin="0,1">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="CPU peak" Foreground="#5A6470"
                         FontSize="{StaticResource CaptionFontSize}" FontFamily="{StaticResource MonoFontFamily}"/>
              <TextBlock Grid.Column="1" Text="{Binding PeakCpuPercent, StringFormat={}{0:0.0}%}"
                         Foreground="#6E7A86" FontSize="{StaticResource CaptionFontSize}" FontFamily="{StaticResource MonoFontFamily}" TextAlignment="Right"/>
            </Grid>
            <Grid Margin="0,2">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="GPU" Foreground="{StaticResource LabelBrush}"
                         FontSize="{StaticResource BodyFontSize}" FontFamily="{StaticResource MonoFontFamily}"/>
              <TextBlock Grid.Column="1" Text="{Binding GpuPercent, Converter={StaticResource NullablePercent}}"
                         Foreground="{StaticResource TextPrimaryBrush}" FontSize="{StaticResource BodyFontSize}" FontFamily="{StaticResource MonoFontFamily}" TextAlignment="Right"/>
            </Grid>
            <Grid Margin="0,2">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="Memory" Foreground="{StaticResource LabelBrush}"
                         FontSize="{StaticResource BodyFontSize}" FontFamily="{StaticResource MonoFontFamily}"/>
              <TextBlock Grid.Column="1" Text="{Binding WorkingSetMb, StringFormat={}{0:0} MB}"
                         Foreground="{StaticResource TextPrimaryBrush}" FontSize="{StaticResource BodyFontSize}" FontFamily="{StaticResource MonoFontFamily}" TextAlignment="Right"/>
            </Grid>
            <Grid Margin="0,1">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="Memory peak" Foreground="#5A6470"
                         FontSize="{StaticResource CaptionFontSize}" FontFamily="{StaticResource MonoFontFamily}"/>
              <TextBlock Grid.Column="1" Text="{Binding PeakWorkingSetMb, StringFormat={}{0:0} MB}"
                         Foreground="#6E7A86" FontSize="{StaticResource CaptionFontSize}" FontFamily="{StaticResource MonoFontFamily}" TextAlignment="Right"/>
            </Grid>
            <Grid Margin="0,2">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="Disk" Foreground="{StaticResource LabelBrush}"
                         FontSize="{StaticResource BodyFontSize}" FontFamily="{StaticResource MonoFontFamily}"/>
              <TextBlock Grid.Column="1" Text="{Binding DiskBytesPerSec, Converter={StaticResource ByteRate}}"
                         Foreground="{StaticResource TextPrimaryBrush}" FontSize="{StaticResource BodyFontSize}" FontFamily="{StaticResource MonoFontFamily}" TextAlignment="Right"/>
            </Grid>
            <Grid Margin="0,2">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="Network" Foreground="{StaticResource LabelBrush}"
                         FontSize="{StaticResource BodyFontSize}" FontFamily="{StaticResource MonoFontFamily}"/>
              <TextBlock Grid.Column="1" Text="{Binding NetBytesPerSec, Converter={StaticResource ByteRate}}"
                         Foreground="{StaticResource TextPrimaryBrush}" FontSize="{StaticResource BodyFontSize}" FontFamily="{StaticResource MonoFontFamily}" TextAlignment="Right"/>
            </Grid>

            <!-- Image path: the full on-disk location, wrapped. "Path unavailable" when WMI can't read it. -->
            <Border BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0" Margin="0,10,0,8"/>
            <TextBlock Text="Image path" Foreground="{StaticResource LabelBrush}"
                       FontSize="{StaticResource CaptionFontSize}" FontFamily="{StaticResource MonoFontFamily}" Margin="0,0,0,2"/>
            <TextBlock Text="{Binding ExecutablePathLabel}" Foreground="{StaticResource TextMutedBrush}"
                       FontSize="{StaticResource CaptionFontSize}" FontFamily="{StaticResource MonoFontFamily}" TextWrapping="Wrap"/>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
