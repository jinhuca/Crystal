<UserControl x:Class="Crystal.GpuModule.Views.GpuSummaryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:sv="clr-namespace:Crystal.GpuModule.Views.SummaryViews"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d"
             d:DesignHeight="200" d:DesignWidth="1000"
             Background="Transparent" Foreground="{StaticResource TextBrush}"
             FontFamily="{StaticResource UiFontFamily}">
  <!-- Two asymmetric blocks per GpuSV.png: the integrated GPU (left) shows a 2x2 meter block
       (Temperature/Memory Used over Power/3D) beside its utilization graph; the dedicated GPU
       (right) shows a 3x2 meter block (Temperature/Memory Used/Clock over Hot Spot/3D/Power)
       beside its utilization graph and a PCIe Rx/Tx column. Each block collapses when the machine
       lacks that adapter. The per-metric tiles live in Views/SummaryViews. -->
  <UserControl.Resources>
    <!-- A block collapses when its adapter is absent (DataContext bound to a null adapter). -->
    <Style x:Key="AdapterBlockStyle" TargetType="Border">
      <Style.Triggers>
        <DataTrigger Binding="{Binding}" Value="{x:Null}">
          <Setter Property="Visibility" Value="Collapsed"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>

  <Border Background="Transparent" MouseLeftButtonDown="OnTileClick">
    <Grid Margin="5">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- Section title: accent tick + "GPU". -->
      <Border Grid.Row="0" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1"
              Padding="0,0,0,4" Margin="0,0,0,6">
        <StackPanel Orientation="Horizontal">
          <Border Width="3" Background="{StaticResource AccentBrush}" Margin="0,1,8,1"/>
          <TextBlock Text="GPU" Foreground="{StaticResource ValueBrush}" FontSize="{StaticResource BodyFontSize}" FontWeight="SemiBold"
                     VerticalAlignment="Center"/>
        </StackPanel>
      </Border>

      <Grid Grid.Row="1" VerticalAlignment="Top">
        <!-- Content-sized so an absent (collapsed) adapter block reserves no width, and neither
             block's utilization graph is stretched wider than the other. -->
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Integrated GPU block. -->
        <Border Grid.Column="0" DataContext="{Binding IntegratedAdapter}" Style="{StaticResource AdapterBlockStyle}"
                Margin="0,0,16,0">
          <Grid VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 2x2 meter block. -->
            <Grid Grid.Column="0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <sv:GpuTemperatureView Grid.Row="0" Grid.Column="0" Margin="0,0,20,14"/>
              <sv:GpuMemoryView      Grid.Row="0" Grid.Column="1" Margin="0,0,0,14"/>
              <sv:GpuPowerView       Grid.Row="1" Grid.Column="0" Margin="0,0,20,0"/>
              <sv:Gpu3DView          Grid.Row="1" Grid.Column="1" Margin="0,0,0,0"/>
            </Grid>

            <!-- Utilization graph, captioned with the adapter identity. -->
            <sv:GpuUtilizationView Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Stretch"/>
          </Grid>
        </Border>

        <!-- Dedicated GPU block. -->
        <Border Grid.Column="1" DataContext="{Binding DedicatedAdapter}" Style="{StaticResource AdapterBlockStyle}"
                BorderBrush="{StaticResource DividerBrush}" BorderThickness="1,0,0,0" Padding="16,0,0,0">
          <Grid VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 3x2 meter block. -->
            <Grid Grid.Column="0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <sv:GpuTemperatureView Grid.Row="0" Grid.Column="0" Margin="0,0,20,14"/>
              <sv:GpuMemoryView      Grid.Row="0" Grid.Column="1" Margin="0,0,20,14"/>
              <sv:GpuClockView       Grid.Row="0" Grid.Column="2" Margin="0,0,0,14"/>
              <sv:GpuHotSpotView     Grid.Row="1" Grid.Column="0" Margin="0,0,20,0"/>
              <sv:Gpu3DView          Grid.Row="1" Grid.Column="1" Margin="0,0,20,0"/>
              <sv:GpuPowerView       Grid.Row="1" Grid.Column="2" Margin="0,0,0,0"/>
            </Grid>

            <!-- Utilization graph, captioned with the adapter identity. -->
            <sv:GpuUtilizationView Grid.Column="1" Margin="20,0,20,0" VerticalAlignment="Stretch"/>

            <!-- PCIe Rx/Tx throughput column. -->
            <sv:GpuPcieView Grid.Column="2" Width="170" VerticalAlignment="Stretch"/>
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </Border>
</UserControl>
