<UserControl x:Class="Crystal.GpuModule.Views.GpuSummaryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:graphs="clr-namespace:Crystal.Controls.PerformanceGraphs;assembly=Crystal.Controls"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d"
             d:DesignHeight="240" d:DesignWidth="760"
             Background="Transparent" Foreground="White"
             FontFamily="Segoe UI">
  <!-- MetricValue/MetricUnit/MetricCaption now shared via Crystal.Resources -->


  <Border Background="Transparent" MouseLeftButtonDown="OnTileClick">
    <Grid Margin="5">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- Dense header bar: accent tick + title. Per-adapter identity rides directly above each
           adapter's graph block below, so the label sits with the graphs it owns. -->
      <Border Grid.Row="0" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1"
              Padding="0,0,0,4" Margin="0,0,0,2">
        <StackPanel Orientation="Horizontal">
          <Border Width="3" Background="{StaticResource AccentBrush}" Margin="0,1,8,1"/>
          <TextBlock Text="GPU" Foreground="{StaticResource ValueBrush}" FontSize="12" FontWeight="SemiBold"
                     VerticalAlignment="Center"/>
        </StackPanel>
      </Border>

      <!-- One block per adapter, laid out side by side. Each block leads with an identity strip
           (accent tick + kind + name) so the label sits directly over the graphs it owns, then two
           graph columns (Utilization + Temperature | Clock + Power) span the adapter's full width. -->
      <ItemsControl Grid.Row="1" ItemsSource="{Binding Adapters}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Rows="1"/>
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <!-- Left accent bar binds the adapter's identity + graphs into one visual panel. -->
            <Border Margin="0,0,16,0" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1,0,0,0"
                    Padding="8,0,0,0" VerticalAlignment="Top">
              <Grid VerticalAlignment="Top">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Identity strip: kind (accent) + name (dim), directly above this adapter's graphs. -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                  <TextBlock Text="{Binding KindLabel}" Foreground="{StaticResource AccentBrush}" FontSize="11"
                             FontWeight="SemiBold" VerticalAlignment="Center"/>
                  <TextBlock Text="{Binding Name}" Foreground="{StaticResource LabelBrush}" FontSize="11" FontFamily="Consolas"
                             VerticalAlignment="Center" Margin="8,0,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <!-- Two graph columns spanning the adapter's full width. -->
                <Grid Grid.Row="1" VerticalAlignment="Top">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>

                  <!-- Left: Utilization (top) + Temperature (bottom) stacked graphs. -->
                  <Grid Grid.Column="0" VerticalAlignment="Top" Margin="0,0,16,0">
                    <Grid.RowDefinitions>
                      <RowDefinition/>
                      <RowDefinition/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,6">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <graphs:PerformanceGraph Grid.Column="0"
                                             Loaded="OnLoadGraphLoaded"
                                             MinHeight="40" MinValue="0" MaxValue="100"/>
                      <StackPanel Grid.Column="1" Style="{StaticResource SummaryStackPanelStyle}">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="{Binding Load, StringFormat={}{0:0.00}}" Style="{StaticResource MetricValue}"/>
                          <TextBlock Text="%" Style="{StaticResource MetricUnit}"/>
                        </StackPanel>
                        <TextBlock Text="Utilization" Style="{StaticResource MetricCaption}"/>
                      </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <graphs:PerformanceGraph Grid.Column="0"
                                             Loaded="OnTemperatureGraphLoaded"
                                             MinHeight="40" MinValue="0" MaxValue="120"/>
                      <StackPanel Grid.Column="1" Style="{StaticResource SummaryStackPanelStyle}">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="{Binding TemperatureC, StringFormat={}{0:0.00}, TargetNullValue=0.00}" Style="{StaticResource MetricValue}"/>
                          <TextBlock Text="°C" Style="{StaticResource MetricUnit}"/>
                        </StackPanel>
                        <TextBlock Text="Temperature" Style="{StaticResource MetricCaption}"/>
                      </StackPanel>
                    </Grid>
                  </Grid>

                  <!-- Right: Clock (top) + Power (bottom) stacked graphs. -->
                  <Grid Grid.Column="1" VerticalAlignment="Top">
                    <Grid.RowDefinitions>
                      <RowDefinition/>
                      <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,6">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <graphs:PerformanceGraph Grid.Column="0" Loaded="OnClockGraphLoaded" MinHeight="40" MinValue="0" MaxValue="3000"/>
                      <StackPanel Grid.Column="1" Style="{StaticResource SummaryStackPanelStyle}">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="{Binding ClockMhz, StringFormat={}{0:0}, TargetNullValue=—}" Style="{StaticResource MetricValue}"/>
                          <TextBlock Text="MHz" Style="{StaticResource MetricUnit}"/>
                        </StackPanel>
                        <TextBlock Text="Clock" Style="{StaticResource MetricCaption}"/>
                      </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <graphs:PerformanceGraph Grid.Column="0"
                                             Loaded="OnPowerGraphLoaded"
                                             MinHeight="40" MinValue="0" MaxValue="450"/>
                      <StackPanel Grid.Column="1" Style="{StaticResource SummaryStackPanelStyle}">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="{Binding PowerW, StringFormat={}{0:0.0}, TargetNullValue=—}" Style="{StaticResource MetricValue}"/>
                          <TextBlock Text="Watts" Style="{StaticResource MetricUnit}"/>
                        </StackPanel>
                        <TextBlock Text="Power" Style="{StaticResource MetricCaption}"/>
                      </StackPanel>
                    </Grid>
                  </Grid>
                </Grid>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Grid>
  </Border>
</UserControl>
