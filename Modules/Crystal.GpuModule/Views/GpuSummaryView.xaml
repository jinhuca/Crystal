<UserControl x:Class="Crystal.GpuModule.Views.GpuSummaryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:sv="clr-namespace:Crystal.GpuModule.Views.SummaryViews"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d"
             d:DesignHeight="240" d:DesignWidth="760"
             Background="Transparent" Foreground="{StaticResource TextBrush}"
             FontFamily="{StaticResource UiFontFamily}">
  <!-- MetricValue/MetricUnit/MetricCaption now shared via Crystal.Resources -->

  <Border Background="Transparent" MouseLeftButtonDown="OnTileClick">
    <Grid Margin="5">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- Section title: accent tick + "GPU". -->
      <Border Grid.Row="0" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1"
              Padding="0,0,0,4" Margin="0,0,0,2">
        <StackPanel Orientation="Horizontal">
          <Border Width="3" Background="{StaticResource AccentBrush}" Margin="0,1,8,1"/>
          <TextBlock Text="GPU" Foreground="{StaticResource ValueBrush}" FontSize="{StaticResource BodyFontSize}" FontWeight="SemiBold"
                     VerticalAlignment="Center"/>
        </StackPanel>
      </Border>

      <!-- Per-adapter caption row, column-aligned with the graph row below: same UniformGrid +
           same Margin/Border/Padding per item, so the two rows' column boundaries match exactly.
           Caption is centered within its column, directly above the graphs it labels. -->
      <ItemsControl Grid.Row="0" ItemsSource="{Binding Adapters}" Margin="0,0,0,6" VerticalAlignment="Center">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Rows="1"/>
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Margin="0,0,16,0" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1,0,0,0"
                    Padding="8,0,0,0">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <TextBlock Width="33"/>
                <TextBlock Text="{Binding KindLabel}" Foreground="{StaticResource AccentBrush}" FontSize="{StaticResource CaptionFontSize}"
                           FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Name}" Foreground="{StaticResource LabelBrush}" FontSize="{StaticResource CaptionFontSize}" FontFamily="{StaticResource MonoFontFamily}"
                           VerticalAlignment="Center" Margin="8,0,0,0" MaxWidth="120" TextTrimming="None"
                           ToolTip="{Binding Name}"/>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- One block per adapter: two graph columns (Utilization + Temperature | Clock + Power)
           spanning the adapter's full width. Same left-border decoration and Margin as the
           caption row above, so the vertical divider runs continuously through both rows. -->
      <ItemsControl Grid.Row="2" ItemsSource="{Binding Adapters}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Rows="1"/>
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Margin="0,0,16,0" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1,0,0,0"
                    Padding="8,0,0,0" VerticalAlignment="Top">
              <Grid VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Utilization (top) + Temperature (bottom) stacked graphs. -->
                <Grid Grid.Column="0" VerticalAlignment="Top" Margin="0,0,16,0">
                  <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                  </Grid.RowDefinitions>
                  <sv:GpuUtilizationView Grid.Row="0" Margin="0,0,0,6"/>
                  <sv:GpuTemperatureView Grid.Row="1"/>
                </Grid>

                <!-- Right: Clock (top) + Power (bottom) stacked graphs. -->
                <Grid Grid.Column="1" VerticalAlignment="Top">
                  <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                  </Grid.RowDefinitions>
                  <sv:GpuClockView Grid.Row="0" Margin="0,0,0,6"/>
                  <sv:GpuPowerView Grid.Row="1"/>
                </Grid>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Grid>
  </Border>
</UserControl>