<UserControl x:Class="Crystal.GpuModule.Views.SummaryViews.GpuClockView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:graphs="clr-namespace:Crystal.Controls.PerformanceGraphs;assembly=Crystal.Controls"
             mc:Ignorable="d"
             d:DesignHeight="44" d:DesignWidth="300">
  <!-- DataContext is a GpuAdapterViewModel, inherited from the per-adapter item. -->
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>
    <graphs:PerformanceGraph x:Name="ClockGraph" Grid.Column="0"
                             graphs:GraphIdentity.Id="Gpu.Clock"
                             MinHeight="40" MinValue="0" MaxValue="3000"/>
    <StackPanel Grid.Column="1" Style="{StaticResource SummaryStackPanelStyle}">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="{Binding ClockMhz, StringFormat={}{0:0}, TargetNullValue=—}" Style="{StaticResource MetricValue}"/>
        <TextBlock Text="MHz" Style="{StaticResource MetricUnit}"/>
      </StackPanel>
      <TextBlock Text="Clock" Style="{StaticResource MetricCaption}"/>
    </StackPanel>
  </Grid>
</UserControl>
