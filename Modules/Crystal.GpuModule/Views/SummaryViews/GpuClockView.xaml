<UserControl x:Class="Crystal.GpuModule.Views.SummaryViews.GpuClockView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:bars="clr-namespace:Crystal.Controls.RangeBars;assembly=Crystal.Controls"
             mc:Ignorable="d"
             d:DesignHeight="44" d:DesignWidth="130">
  <!-- DataContext is a GpuAdapterViewModel, inherited from the per-adapter block.
       Segmented range bar over the live core clock (a high clock is desirable, not a warning, so a
       steady accent fill rather than a green-to-red band); the history graph lives in the detail view. -->
  <StackPanel Width="130" HorizontalAlignment="Left">
    <StackPanel Orientation="Horizontal">
      <TextBlock Text="{Binding ClockMhz, StringFormat={}{0:0}, TargetNullValue=—}" Style="{StaticResource MetricValue}"/>
      <TextBlock Text="MHz" Style="{StaticResource MetricUnit}"/>
    </StackPanel>
    <bars:RangeBar Style="{StaticResource SummaryRangeBarStyle}"
                   MinValue="0" MaxValue="{Binding ClockScaleMax}" Value="{Binding ClockMhz, TargetNullValue=0}"
                   FillBrush="{StaticResource AccentBrush}"/>
    <TextBlock Text="Clock" Style="{StaticResource MetricCaption}"/>
  </StackPanel>
</UserControl>
