<UserControl x:Class="Crystal.GpuModule.Views.SummaryViews.GpuPcieRxView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:graphs="clr-namespace:Crystal.Controls.PerformanceGraphs;assembly=Crystal.Controls"
             mc:Ignorable="d"
             d:DesignHeight="88" d:DesignWidth="130">
  <!-- DataContext is a GpuAdapterViewModel, inherited from the per-adapter block. Header (title left,
       live value right) over the PCIe Rx throughput history graph, tracking the adapter's
       auto-ranging Rx scale (PcieRxScaleMax). Throughput is not a warning gauge, so BandedLine is
       off: a steady amber line matching the other PCIe tile. Self-registers so the view model feeds
       it on each poll. -->
  <Grid Width="130">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <Grid Grid.Row="0" Margin="0,0,0,2">
      <TextBlock Text="PCIe Rx" Style="{StaticResource MetricCaption}" HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
        <TextBlock Text="{Binding PcieRxMBps, StringFormat={}{0:0.0}, TargetNullValue=0.0}" Style="{StaticResource TileMetricValue}"/>
        <TextBlock Text="MB/s" Style="{StaticResource MetricUnit}"/>
      </StackPanel>
    </Grid>
    <graphs:AdaptiveGraph x:Name="Graph" Grid.Row="1" graphs:GraphIdentity.Id="Gpu.PcieRx"
                          Capacity="90" MinValue="0" MaxValue="{Binding PcieRxScaleMax}"
                          Accent="#E8C22A" BandedLine="False"
                          ShowChrome="True" MinHeight="40"
                          CellPitch="{StaticResource DashboardDotPitch}"/>
  </Grid>
</UserControl>
