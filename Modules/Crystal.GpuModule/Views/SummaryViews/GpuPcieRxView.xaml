<UserControl x:Class="Crystal.GpuModule.Views.SummaryViews.GpuPcieRxView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:bars="clr-namespace:Crystal.Controls.RangeBars;assembly=Crystal.Controls"
             mc:Ignorable="d"
             d:DesignHeight="44" d:DesignWidth="130">
  <!-- DataContext is a GpuAdapterViewModel, inherited from the per-adapter block. Live PCIe Rx
       throughput over a segmented range bar, styled to match the other meter tiles; the bar tracks
       the adapter's auto-ranging Rx scale (PcieRxScaleMax). -->
  <StackPanel Width="130" HorizontalAlignment="Left">
    <StackPanel Orientation="Horizontal">
      <TextBlock Text="{Binding PcieRxMBps, StringFormat={}{0:0.0}, TargetNullValue=0.0}" Style="{StaticResource MetricValue}"/>
      <TextBlock Text="MB/s" Style="{StaticResource MetricUnit}"/>
    </StackPanel>
    <bars:RangeBar Style="{StaticResource SummaryRangeBarStyle}"
                   MinValue="0" MaxValue="{Binding PcieRxScaleMax}" Value="{Binding PcieRxMBps, TargetNullValue=0}"
                   FillBrush="#E8C22A"/>
    <TextBlock Text="PCIe Rx" Style="{StaticResource MetricCaption}"/>
  </StackPanel>
</UserControl>
