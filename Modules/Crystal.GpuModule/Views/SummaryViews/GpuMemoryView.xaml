<UserControl x:Class="Crystal.GpuModule.Views.SummaryViews.GpuMemoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Crystal.GpuModule.Views.SummaryViews"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:graphs="clr-namespace:Crystal.Controls.PerformanceGraphs;assembly=Crystal.Controls"
             mc:Ignorable="d"
             d:DesignHeight="120" d:DesignWidth="210">
  <!-- DataContext is a GpuAdapterViewModel, inherited from the per-adapter block. Boxed sensor tile
       matching the CpuSummaryView pattern: accent title, "used / total GB" value + unit + trend glyph,
       and a session min/avg/max stat line. The trend and stats track used-percent, so they reflect
       pressure even as the GB figure ticks. -->
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Crystal.Controls;component/Metrics/MetricEnrichmentResources.xaml"/>
        <ResourceDictionary Source="/Crystal.Resources;component/Styles/BorderStyles.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>
  <Border Style="{StaticResource SummaryTileBorderStyle}" Width="{x:Static local:GpuSummaryViewConstants.GraphWidth}">
    <Grid MinHeight="60" ShowGridLines="False">
      <Grid.RowDefinitions>
        <RowDefinition Height="20"/>
        <RowDefinition Height="1.6*"/>
        <RowDefinition Height=".7*"/>
      </Grid.RowDefinitions>

      <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="4,0,0,4">
        <TextBlock Text="Memory Used" Style="{StaticResource SummaryTileTitleTextBlockStyle}"/>
      </StackPanel>

      <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Style="{StaticResource TileMetricValue}">
          <TextBlock.Text>
            <MultiBinding StringFormat="{}{0:0.0} / {1:0.0}">
              <Binding Path="MemoryUsedGB" TargetNullValue="0.0"/>
              <Binding Path="MemoryTotalGB" TargetNullValue="0.0"/>
            </MultiBinding>
          </TextBlock.Text>
        </TextBlock>
        <TextBlock Text="GB" Style="{StaticResource MetricUnit}"/>
        <TextBlock Text="{Binding MemoryRow.Trend, Converter={StaticResource TrendToGlyph}}"
                   Foreground="{Binding MemoryRow.Trend, Converter={StaticResource TrendToBrush}}"
                   Style="{StaticResource MetricUnit}" Margin="4,0,0,2"/>
      </StackPanel>

      <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Style="{StaticResource MetricStatLine}">
          <Run Text="min " Foreground="{StaticResource AccentBrush}"/><Run Text="{Binding MemoryRow.Min, StringFormat={}{0:0}}"/><Run Text="%"/>
          <Run Text="   avg " Foreground="{StaticResource AccentBrush}"/><Run Text="{Binding MemoryRow.Avg, StringFormat={}{0:0}}"/><Run Text="%"/>
          <Run Text="   max " Foreground="{StaticResource AccentBrush}"/><Run Text="{Binding MemoryRow.Max, StringFormat={}{0:0}}"/><Run Text="%"/>
        </TextBlock>
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
