<UserControl x:Class="Crystal.GpuModule.Views.SummaryViews.GpuMemoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Crystal.GpuModule.Views.SummaryViews"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:graphs="clr-namespace:Crystal.Controls.PerformanceGraphs;assembly=Crystal.Controls"
             mc:Ignorable="d"
             d:DesignHeight="88" d:DesignWidth="170">
  <!-- DataContext is a GpuAdapterViewModel, inherited from the per-adapter block. Header ("Memory
       Used" left, "used / total GB (percent)" right) over a value-banded history graph driven by the
       used-percent; self-registers so the view model feeds it on each poll. -->
  <!-- Graph replaced with a header-only value+unit readout plus a trend glyph (test/minimal-graphs).
       The glyph tracks used-percent, so it reflects pressure even as the GB figure ticks. -->
  <UserControl.Resources>
    <ResourceDictionary Source="/Crystal.Controls;component/Metrics/MetricEnrichmentResources.xaml"/>
  </UserControl.Resources>
  <Grid Width="{x:Static local:GpuSummaryViewConstants.GraphWidth}" VerticalAlignment="Stretch">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" Text="Memory Used" Style="{StaticResource MetricCaption}"
               Foreground="{StaticResource TextBrush}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="0,0,0,4"/>

    <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
        <TextBlock Style="{StaticResource TileMetricValue}">
          <TextBlock.Text>
            <MultiBinding StringFormat="{}{0:0.0} / {1:0.0}">
              <Binding Path="MemoryUsedGB" TargetNullValue="0.0"/>
              <Binding Path="MemoryTotalGB" TargetNullValue="0.0"/>
            </MultiBinding>
          </TextBlock.Text>
        </TextBlock>
        <TextBlock Text="GB" Style="{StaticResource MetricUnit}"/>
        <TextBlock Text="{Binding MemoryRow.Trend, Converter={StaticResource TrendToGlyph}}"
                   Foreground="{Binding MemoryRow.Trend, Converter={StaticResource TrendToBrush}}"
                   Style="{StaticResource MetricUnit}" Margin="4,0,0,0"/>
      </StackPanel>
      <TextBlock Style="{StaticResource MetricStatLine}">
        <Run Text="min "/><Run Text="{Binding MemoryRow.Min, StringFormat={}{0:0}}"/><Run Text="%"/>
        <Run Text="   avg "/><Run Text="{Binding MemoryRow.Avg, StringFormat={}{0:0}}"/><Run Text="%"/>
        <Run Text="   max "/><Run Text="{Binding MemoryRow.Max, StringFormat={}{0:0}}"/><Run Text="%"/>
      </TextBlock>
    </StackPanel>
  </Grid>
</UserControl>
