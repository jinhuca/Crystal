<UserControl x:Class="Crystal.GpuModule.Views.SummaryViews.GpuFanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Crystal.GpuModule.Views.SummaryViews"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:graphs="clr-namespace:Crystal.Controls.PerformanceGraphs;assembly=Crystal.Controls"
             mc:Ignorable="d"
             d:DesignHeight="120" d:DesignWidth="210">
  <!-- DataContext is a GpuAdapterViewModel, inherited from the per-adapter block. Boxed sensor tile
       matching the CpuSummaryView pattern: accent title, live fan-speed value + unit + trend glyph,
       a session min/avg/max stat line, and a dot history strip. -->
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Crystal.Controls;component/Metrics/MetricEnrichmentResources.xaml"/>
        <ResourceDictionary Source="/Crystal.Resources;component/Styles/BorderStyles.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>
  <Border Style="{StaticResource SummaryTileBorderStyle}" Width="{x:Static local:GpuSummaryViewConstants.GraphWidth}">
    <Grid MinHeight="60" ShowGridLines="False">
      <Grid.RowDefinitions>
        <RowDefinition Height="20"/>
        <RowDefinition Height="40"/>
        <RowDefinition Height="24"/>
      </Grid.RowDefinitions>
      <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="0,0,0,0">
        <TextBlock Text="GPU Fan" Style="{StaticResource SummaryTileTitleTextBlockStyle}"/>
        <TextBlock Style="{StaticResource MetricStatLine}" Margin="20,0,0,0">
          <Run FontFamily="Segoe Fluent Icons" Text="&#xE70D; " Foreground="LightGreen"/>
          <Run Text="{Binding FanRow.Min, StringFormat={}{0:0}}"/>
          <Run FontFamily="Segoe Fluent Icons" Text=" &#xE738; " Foreground="{StaticResource AccentBrush}"/>
          <Run Text="{Binding FanRow.Avg, StringFormat={}{0:0}}"/>
          <Run FontFamily="Segoe Fluent Icons" Text=" &#xE70E; " Foreground="Crimson"/>
          <Run Text="{Binding FanRow.Max, StringFormat={}{0:0}}"/>
        </TextBlock>
      </StackPanel>
      <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Text="{Binding FanRpm, StringFormat={}{0:0}, TargetNullValue=—}" Style="{StaticResource TileMetricValue}"/>
        <TextBlock Text="RPM" Style="{StaticResource MetricUnit}"/>
        <TextBlock Text="{Binding FanRow.Trend, Converter={StaticResource TrendToGlyph}}"
                   Foreground="{Binding FanRow.Trend, Converter={StaticResource TrendToBrush}}"
                   Style="{StaticResource MetricUnit}" Margin="4,0,0,2"/>
      </StackPanel>

      <!-- Dot-style fan-speed history strip; self-registers under "Gpu.Fan". Ceiling ratchets over
           the running RPM peak so a slow case fan and a spun-up card each plot on a sensible axis. -->
      <graphs:PerformanceGraphLite
        Grid.Row="2" GraphBackground="Transparent"
        Loaded="OnGraphLoaded" graphs:GraphIdentity.Id="Gpu.Fan"
        HorizontalAlignment="Stretch" VerticalAlignment="Top"
        Height="24" Rows="8" Capacity="120"
        MinValue="0" MaxValue="{Binding FanScaleMax}" CornerRadius="1"
        Style="{StaticResource BandedSquareDotGraphLiteStyle}"/>
    </Grid>
  </Border>
</UserControl>
