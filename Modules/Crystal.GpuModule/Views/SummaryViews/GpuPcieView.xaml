<UserControl x:Class="Crystal.GpuModule.Views.SummaryViews.GpuPcieView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:graphs="clr-namespace:Crystal.Controls.PerformanceGraphs;assembly=Crystal.Controls"
             mc:Ignorable="d"
             d:DesignHeight="120" d:DesignWidth="180"
             FontFamily="{StaticResource UiFontFamily}">
  <!-- DataContext is a GpuAdapterViewModel, inherited from the per-adapter block. PCIe Rx over Tx,
       each a label + live throughput and a dot-matrix sparkline this view self-registers with the
       view model. The two directions scale independently (PcieRxScaleMax / PcieTxScaleMax) so a
       busy Rx trace can't flatten a low-but-live Tx trace, and each dot column is tinted to match
       its direction's ▲ marker (green Rx, amber Tx). -->
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Orientation="Horizontal">
      <TextBlock Text="&#x25B2;" Foreground="{StaticResource OkBrush}" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
      <TextBlock Text="PCIe Rx" Foreground="{StaticResource ValueBrush}" FontSize="{StaticResource BodyFontSize}"
                 FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
      <TextBlock Text="{Binding PcieRxMBps, StringFormat={}{0:0.0} MB/s, TargetNullValue=—}"
                 Foreground="{StaticResource LabelBrush}" FontSize="{StaticResource CaptionFontSize}"
                 FontFamily="{StaticResource MonoFontFamily}" VerticalAlignment="Center"/>
    </StackPanel>
    <graphs:PerformanceGraphLite x:Name="PcieRxGraph" Grid.Row="1"
                                 graphs:GraphIdentity.Id="Gpu.PcieRx"
                                 Style="{StaticResource SquareDotGraphLiteStyle}"
                                 ColorMode="SingleColor" DotColor="{StaticResource OkBrush}"
                                 Capacity="40" Rows="20" MinValue="0" MaxValue="{Binding PcieRxScaleMax}"
                                 Margin="0,4,0,8" VerticalAlignment="Center"/>

    <StackPanel Grid.Row="2" Orientation="Horizontal">
      <TextBlock Text="&#x25B2;" Foreground="#E89B2A" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
      <TextBlock Text="PCIe Tx" Foreground="{StaticResource ValueBrush}" FontSize="{StaticResource BodyFontSize}"
                 FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
      <TextBlock Text="{Binding PcieTxMBps, StringFormat={}{0:0.0} MB/s, TargetNullValue=—}"
                 Foreground="{StaticResource LabelBrush}" FontSize="{StaticResource CaptionFontSize}"
                 FontFamily="{StaticResource MonoFontFamily}" VerticalAlignment="Center"/>
    </StackPanel>
    <graphs:PerformanceGraphLite x:Name="PcieTxGraph" Grid.Row="3"
                                 graphs:GraphIdentity.Id="Gpu.PcieTx"
                                 Style="{StaticResource SquareDotGraphLiteStyle}"
                                 ColorMode="SingleColor" DotColor="#E89B2A"
                                 Capacity="40" Rows="20" MinValue="0" MaxValue="{Binding PcieTxScaleMax}"
                                 Margin="0,4,0,0" VerticalAlignment="Center"/>
  </Grid>
</UserControl>
