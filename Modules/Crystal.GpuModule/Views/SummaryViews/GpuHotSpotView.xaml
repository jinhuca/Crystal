<UserControl x:Class="Crystal.GpuModule.Views.SummaryViews.GpuHotSpotView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Crystal.GpuModule.Views.SummaryViews"
             xmlns:graphs="clr-namespace:Crystal.Controls.PerformanceGraphs;assembly=Crystal.Controls"
             mc:Ignorable="d"
             d:DesignHeight="88" d:DesignWidth="130">
  <!-- DataContext is a GpuAdapterViewModel, inherited from the per-adapter block. Header (title left,
       live value right) over a value-banded history graph of the hot-spot temperature (dedicated
       cards only); self-registers so the view model feeds it on each poll. -->
  <Grid Width="{x:Static local:GpuSummaryViewConstants.GraphWidth}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <Grid Grid.Row="0" Margin="0,0,0,2">
      <TextBlock Text="Hot Spot" Style="{StaticResource MetricCaption}" HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
        <TextBlock Text="{Binding HotSpotTemperatureC, StringFormat={}{0:0.00}, TargetNullValue=0.00}" Style="{StaticResource TileMetricValue}"/>
        <TextBlock Text="°C" Style="{StaticResource MetricUnit}"/>
      </StackPanel>
    </Grid>
    <graphs:AdaptiveGraph x:Name="Graph" Grid.Row="1" graphs:GraphIdentity.Id="Gpu.HotSpot"
                          Capacity="90" MinValue="30" MaxValue="120" Accent="#3BD15A"
                          ShowChrome="True" MinHeight="40"
                          CellPitch="{StaticResource DashboardDotPitch}"/>
  </Grid>
</UserControl>
