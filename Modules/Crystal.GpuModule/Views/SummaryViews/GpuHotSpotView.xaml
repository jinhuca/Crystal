<UserControl x:Class="Crystal.GpuModule.Views.SummaryViews.GpuHotSpotView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Crystal.GpuModule.Views.SummaryViews"
             xmlns:graphs="clr-namespace:Crystal.Controls.PerformanceGraphs;assembly=Crystal.Controls"
             mc:Ignorable="d"
             d:DesignHeight="120" d:DesignWidth="210">
  <!-- DataContext is a GpuAdapterViewModel, inherited from the per-adapter block. Boxed sensor tile
       matching the CpuSummaryView pattern: accent title, severity-colored hot-spot value + unit +
       trend glyph, and a session min/avg/max stat line (dedicated cards only). -->
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="/Crystal.GpuModule;component/Views/GpuViewResources.xaml"/>
			</ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>
  <Border Style="{StaticResource SummaryTileBorderStyle}" Width="{x:Static local:GpuSummaryViewConstants.GraphWidth}">
    <Grid MinHeight="60" ShowGridLines="False">
      <Grid.RowDefinitions>
        <RowDefinition Height="20"/>
        <RowDefinition Height="40"/>
        <RowDefinition Height="24"/>
      </Grid.RowDefinitions>

      <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="4,0,0,4">
        <TextBlock Text="Hot Spot" Style="{StaticResource SummaryTileTitleTextBlockStyle}"/>
        <TextBlock Style="{StaticResource MetricStatLine}" Margin="20,0,0,0">
          <Run FontFamily="Segoe Fluent Icons" Text="&#xE70D; " Foreground="LightGreen"/>
          <Run Text="{Binding HotSpotRow.Min, StringFormat={}{0:0}}"/>
          <Run FontFamily="Segoe Fluent Icons" Text=" &#xE738; " Foreground="{StaticResource AccentBrush}"/>
          <Run Text="{Binding HotSpotRow.Avg, StringFormat={}{0:0}}"/>
          <Run FontFamily="Segoe Fluent Icons" Text=" &#xE70E; " Foreground="Crimson"/>
          <Run Text="{Binding HotSpotRow.Max, StringFormat={}{0:0}}"/>
        </TextBlock>
      </StackPanel>

      <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Text="{Binding HotSpotTemperatureC, StringFormat={}{0:0.00}, TargetNullValue=0.00}"
                   Foreground="{Binding HotSpotTemperatureC, Converter={StaticResource TemperatureToBrush}}"
                   Style="{StaticResource TileMetricValue}"/>
        <TextBlock Text="°C" Style="{StaticResource MetricUnit}"/>
        <TextBlock Text="{Binding HotSpotRow.Trend, Converter={StaticResource TrendToGlyph}}"
                   Foreground="{Binding HotSpotRow.Trend, Converter={StaticResource TrendToBrush}}"
                   Style="{StaticResource MetricUnit}" Margin="4,0,0,2"/>
      </StackPanel>

      <!-- Adaptive (Line/Dot) hot-spot history strip; self-registers under "Gpu.HotSpot". Follows the
           title-bar Line/Dot toggle; banded whitesmoke→red temperature ramp. -->
      <graphs:PerformanceGraph
        Style="{StaticResource AdaptiveGraphNoChromeStyle}"
        Grid.Row="2"
        Loaded="OnGraphLoaded" graphs:GraphIdentity.Id="Gpu.HotSpot"
        HorizontalAlignment="Stretch" VerticalAlignment="Top"
        Height="24" Rows="8" 
				HistoryLength="{StaticResource GpuSensorGraphCapacity}"
        MinValue="30" MaxValue="120"
        BandedLine="True" 
				BandStartColor="{StaticResource GpuHotspotBandedColor1}" 
				BandEndColor="{StaticResource GpuHotspotBandedColor9}"/>
    </Grid>
  </Border>
</UserControl>
