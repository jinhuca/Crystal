<UserControl x:Class="Crystal.GpuModule.Views.SummaryViews.GpuHotSpotView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Crystal.GpuModule.Views.SummaryViews"
             xmlns:graphs="clr-namespace:Crystal.Controls.PerformanceGraphs;assembly=Crystal.Controls"
             mc:Ignorable="d"
             d:DesignHeight="88" d:DesignWidth="130">
  <!-- DataContext is a GpuAdapterViewModel, inherited from the per-adapter block. Header carries the
       title, the session Min/Max of the hot-spot temperature inline, and the live value on the right,
       over a value-banded history graph (dedicated cards only); self-registers so the view model feeds
       it on each poll. -->
  <Grid Width="{x:Static local:GpuSummaryViewConstants.GraphWidth}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <Grid Grid.Row="0" Margin="0,0,0,2">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Bottom">
        <TextBlock Text="Hot Spot" Style="{StaticResource MetricCaption}" Foreground="{StaticResource TextBrush}"/>
        <TextBlock Text="Min" Style="{StaticResource MetricCaption}" Margin="10,0,0,0"/>
        <TextBlock Text="{Binding HotSpotTemperatureMinC, StringFormat={}{0:0}, TargetNullValue=—}" Style="{StaticResource MetricCaption}" Foreground="{StaticResource TextBrush}" Margin="4,0,0,0"/>
        <TextBlock Text="Max" Style="{StaticResource MetricCaption}" Margin="8,0,0,0"/>
        <TextBlock Text="{Binding HotSpotTemperatureMaxC, StringFormat={}{0:0}, TargetNullValue=—}" Style="{StaticResource MetricCaption}" Foreground="{StaticResource TextBrush}" Margin="4,0,0,0"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
        <TextBlock Text="{Binding HotSpotTemperatureC, StringFormat={}{0:0.00}, TargetNullValue=0.00}" Style="{StaticResource TileMetricValue}"/>
        <TextBlock Text="°C" Style="{StaticResource MetricUnit}"/>
      </StackPanel>
    </Grid>
    <graphs:AdaptiveGraph x:Name="Graph" Grid.Row="1" graphs:GraphIdentity.Id="Gpu.HotSpot"
                          Capacity="90" MinValue="30" MaxValue="120" Accent="{StaticResource GraphAccentTemperature}"
                          BandedLine="False" ShowChrome="True" MinHeight="40"
                          CellPitch="{StaticResource DashboardDotPitch}"/>
  </Grid>
</UserControl>
