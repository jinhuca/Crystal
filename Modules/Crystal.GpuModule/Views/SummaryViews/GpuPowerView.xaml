<UserControl x:Class="Crystal.GpuModule.Views.SummaryViews.GpuPowerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Crystal.GpuModule.Views.SummaryViews"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:graphs="clr-namespace:Crystal.Controls.PerformanceGraphs;assembly=Crystal.Controls"
             mc:Ignorable="d"
             d:DesignHeight="88" d:DesignWidth="320">
  <!-- DataContext is a GpuAdapterViewModel, inherited from the per-adapter block. Two columns, matching
       the CPU summary tiles: (left) title + live value over a value-banded history graph; (right) the
       value/min/max table (W) — the aggregate package rail followed by any per-rail breakdown the
       adapter exposes (empty on cards that report only a package figure). Self-registers so the view
       model feeds it on each poll. -->
  <Grid Background="Transparent">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>

    <!-- Left column: title + history graph -->
    <Grid Grid.Column="0" Width="{x:Static local:GpuSummaryViewConstants.GraphWidth}" VerticalAlignment="Stretch">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <Grid Grid.Row="0" Margin="0,0,0,2">
        <TextBlock Text="Power" Style="{StaticResource MetricCaption}" Foreground="{StaticResource TextBrush}" HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
          <TextBlock Text="{Binding PowerW, StringFormat={}{0:0.00}, TargetNullValue=0.00}" Style="{StaticResource TileMetricValue}"/>
          <TextBlock Text="Watts" Style="{StaticResource MetricUnit}"/>
        </StackPanel>
      </Grid>
      <graphs:AdaptiveGraph x:Name="Graph" Grid.Row="1" graphs:GraphIdentity.Id="Gpu.Power"
                            Capacity="90" MinValue="0" MaxValue="{Binding PowerScaleMax}" Accent="{StaticResource GraphAccentPower}"
                            BandedLine="False" ShowChrome="True" MinHeight="40"
                            CellPitch="{StaticResource DashboardDotPitch}"/>
    </Grid>

    <!-- Right column: value/min/max table (W): package rail + per-rail breakdown. Shared-size groups
         keep the numeric columns aligned between the package Grid and each per-rail item Grid. Shown
         only on dedicated adapters; the integrated tile hides it so its Power meter aligns with the
         other integrated tiles (which carry no side table). -->
    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Top" Grid.IsSharedSizeScope="True"
                Visibility="{Binding IsDedicated, Converter={StaticResource BoolToVisibility}}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto" SharedSizeGroup="PVal"/>
          <ColumnDefinition Width="Auto" SharedSizeGroup="PMin"/>
          <ColumnDefinition Width="Auto" SharedSizeGroup="PMax"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="1" Text="Value" Style="{StaticResource MetricTableHeader}"/>
        <TextBlock Grid.Row="0" Grid.Column="2" Text="Min"   Style="{StaticResource MetricTableHeader}"/>
        <TextBlock Grid.Row="0" Grid.Column="3" Text="Max"   Style="{StaticResource MetricTableHeader}"/>

        <!-- Package (the headline aggregate) -->
        <TextBlock Grid.Row="1" Grid.Column="0" Text="Package" Style="{StaticResource MetricTableLabel}"/>
        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PowerW, StringFormat={}{0:0.0}}"    Style="{StaticResource MetricTableValue}"/>
        <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding PowerMinW, StringFormat={}{0:0.0}, TargetNullValue=—}" Style="{StaticResource MetricTableValue}"/>
        <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding PowerMaxW, StringFormat={}{0:0.0}, TargetNullValue=—}" Style="{StaticResource MetricTableValue}"/>
      </Grid>

      <!-- Per-rail breakdown (empty when the adapter exposes only a package figure). -->
      <ItemsControl ItemsSource="{Binding PowerRails}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto" SharedSizeGroup="PVal"/>
                <ColumnDefinition Width="Auto" SharedSizeGroup="PMin"/>
                <ColumnDefinition Width="Auto" SharedSizeGroup="PMax"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="{Binding Name}" Style="{StaticResource MetricTableLabel}"/>
              <TextBlock Grid.Column="1" Text="{Binding PowerW, StringFormat={}{0:0.0}}"    Style="{StaticResource MetricTableValue}"/>
              <TextBlock Grid.Column="2" Text="{Binding MinW, StringFormat={}{0:0.0}, TargetNullValue=—}" Style="{StaticResource MetricTableValue}"/>
              <TextBlock Grid.Column="3" Text="{Binding MaxW, StringFormat={}{0:0.0}, TargetNullValue=—}" Style="{StaticResource MetricTableValue}"/>
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </Grid>
</UserControl>
