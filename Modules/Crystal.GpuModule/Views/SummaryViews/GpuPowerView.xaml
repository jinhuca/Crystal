<UserControl x:Class="Crystal.GpuModule.Views.SummaryViews.GpuPowerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Crystal.GpuModule.Views.SummaryViews"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:graphs="clr-namespace:Crystal.Controls.PerformanceGraphs;assembly=Crystal.Controls"
             mc:Ignorable="d"
             d:DesignHeight="88" d:DesignWidth="210">
  <!-- DataContext is a GpuAdapterViewModel, inherited from the per-adapter block. Title + live value
       over a value-banded history graph; self-registers so the view model feeds it on each poll. The
       package/per-rail value/min/max table now lives in GpuDetailView. -->
  <!-- Graph replaced with a header-only value+unit readout plus a trend glyph (test/minimal-graphs). -->
  <UserControl.Resources>
    <ResourceDictionary Source="/Crystal.Controls;component/Metrics/MetricEnrichmentResources.xaml"/>
  </UserControl.Resources>
  <Grid Width="{x:Static local:GpuSummaryViewConstants.GraphWidth}" VerticalAlignment="Stretch">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" Text="Power" Style="{StaticResource MetricCaption}"
               Foreground="{StaticResource TextBrush}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="0,0,0,4"/>

    <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
        <TextBlock Text="{Binding PowerW, StringFormat={}{0:0.00}, TargetNullValue=0.00}" Style="{StaticResource TileMetricValue}"/>
        <TextBlock Text="Watts" Style="{StaticResource MetricUnit}"/>
        <TextBlock Text="{Binding PowerRow.Trend, Converter={StaticResource TrendToGlyph}}"
                   Foreground="{Binding PowerRow.Trend, Converter={StaticResource TrendToBrush}}"
                   Style="{StaticResource MetricUnit}" Margin="4,0,0,0"/>
      </StackPanel>
      <TextBlock Style="{StaticResource MetricStatLine}">
        <Run Text="min "/><Run Text="{Binding PowerRow.Min, StringFormat={}{0:0.0}}"/>
        <Run Text="   avg "/><Run Text="{Binding PowerRow.Avg, StringFormat={}{0:0.0}}"/>
        <Run Text="   max "/><Run Text="{Binding PowerRow.Max, StringFormat={}{0:0.0}}"/>
      </TextBlock>
    </StackPanel>
  </Grid>
</UserControl>
