<UserControl x:Class="Crystal.GpuModule.Views.SummaryViews.GpuUtilizationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Crystal.GpuModule.Views.SummaryViews"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:graphs="clr-namespace:Crystal.Controls.PerformanceGraphs;assembly=Crystal.Controls"
             mc:Ignorable="d"
             d:DesignHeight="120" d:DesignWidth="500"
             FontFamily="{StaticResource UiFontFamily}">
	<UserControl.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="/Crystal.GpuModule;component/Views/GpuViewResources.xaml"/>
			</ResourceDictionary.MergedDictionaries>
		</ResourceDictionary>
	</UserControl.Resources>
	<!-- DataContext is a GpuAdapterViewModel, inherited from the per-adapter block. Mirrors
       CpuUtilizationView: the full-height core-load history graph fills the left; the live readout on
       the right is a bordered tile matching the other summary tiles, carrying the value, its trend,
       and the session min/avg/max. Self-registers so the view model feeds it on each poll. -->
	<Grid VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Background="{StaticResource PanelBackgroundBrush}">
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="*"/>
			<ColumnDefinition Width="Auto"/>
		</Grid.ColumnDefinitions>
		<graphs:PerformanceGraph
      Style="{StaticResource SummaryTileGraphStyle}"
      Grid.Column="0"
      x:Name="UtilizationGraph"
      graphs:GraphIdentity.Id="Gpu.Utilization"
      HistoryLength="{Binding Capacity, RelativeSource={RelativeSource AncestorType=UserControl}}"
      MinValue="0" MaxValue="100"
      Accent="{StaticResource GraphAccentUtilization}"
      BandedLine="True" 
			BandStartColor="{StaticResource GpuUtilizationBandedColor1}" 
			BandEndColor="{StaticResource GpuUtilizationBandedColor9}"
      MinHeight="40"
      CellPitch="{StaticResource DashboardDotPitch}"/>

		<!-- Readout tile: same width and row structure as the other summary tiles (GpuFanView/GpuVoltageView),
         with the session min/avg/max on the title row rather than beneath the value. -->
		<Border Grid.Column="1" Style="{StaticResource SummaryTileBorderStyle}"
            Width="{x:Static local:GpuSummaryViewConstants.GraphWidth}"
            VerticalAlignment="Stretch" Margin="10,0,0,0">
			<Grid MinHeight="60" ShowGridLines="False">
				<Grid.RowDefinitions>
					<RowDefinition Height="20"/>
					<RowDefinition Height="40"/>
					<RowDefinition Height="24"/>
				</Grid.RowDefinitions>

				<StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Bottom">
					<TextBlock Text="Utilization" Style="{StaticResource SummaryTileTitleTextBlockStyle}"/>
				</StackPanel>

				<StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
					<TextBlock Text="{Binding Load, StringFormat={}{0:0.00}, TargetNullValue=0.00}" Style="{StaticResource TileMetricValue}"/>
					<TextBlock Text="%" Style="{StaticResource MetricUnit}"/>
					<TextBlock Text="{Binding LoadRow.Trend, Converter={StaticResource TrendToGlyph}}"
                     Foreground="{Binding LoadRow.Trend, Converter={StaticResource TrendToBrush}}"
                     Style="{StaticResource MetricUnit}" Margin="4,0,0,2"/>
				</StackPanel>

				<StackPanel Grid.Row="2" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,0,0,0">
					<TextBlock Style="{StaticResource MetricStatLine}" Margin="12,0,0,0" VerticalAlignment="Center">
            <Run FontFamily="Segoe Fluent Icons" Text="&#xE70D; " Foreground="LightGreen"/>
            <Run Text="{Binding LoadRow.Min, StringFormat={}{0:0.#}%}"/>
            <Run FontFamily="Segoe Fluent Icons" Text=" &#xE738; " Foreground="{StaticResource AccentBrush}"/>
            <Run Text="{Binding LoadRow.Avg, StringFormat={}{0:0.#}%}"/>
            <Run FontFamily="Segoe Fluent Icons" Text=" &#xE70E; " Foreground="Crimson"/>
            <Run Text="{Binding LoadRow.Max, StringFormat={}{0:0.#}%}"/>
					</TextBlock>
				</StackPanel>
			</Grid>
		</Border>
	</Grid>
</UserControl>
