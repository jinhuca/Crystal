<UserControl x:Class="Crystal.GpuModule.Views.SummaryViews.GpuUtilizationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:graphs="clr-namespace:Crystal.Controls.PerformanceGraphs;assembly=Crystal.Controls"
             mc:Ignorable="d"
             d:DesignHeight="120" d:DesignWidth="320"
             FontFamily="{StaticResource UiFontFamily}">
  <!-- DataContext is a GpuAdapterViewModel, inherited from the per-adapter block. The adapter's
       core-load history graph, captioned with the adapter identity and the live utilization value;
       self-registers so the view model feeds it on each poll. -->
  <Grid VerticalAlignment="Stretch" HorizontalAlignment="Center" ShowGridLines="False">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>

    <!-- Caption: "<Integrated/Dedicated> GPU" accent label + the adapter product name. The name sits
         in a bounded (star) column with TextTrimming so a long dedicated-GPU name ellipsizes inside
         this cell instead of overflowing rightward and painting over the load value beside it. -->
    <Grid Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" Text="{Binding KindLabel}" Foreground="{StaticResource AccentBrush}"
                 FontSize="{StaticResource BodyFontSize}" FontWeight="SemiBold" VerticalAlignment="Center"/>
      <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="{StaticResource LabelBrush}" FontSize="{StaticResource CaptionFontSize}"
                 FontFamily="{StaticResource MonoFontFamily}" VerticalAlignment="Center" Margin="8,0,0,0"
                 TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
    </Grid>

    <!-- Live utilization value, right-aligned above the graph. -->
    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Right">
      <TextBlock Text="{Binding Load, StringFormat={}{0:0.00}}" Style="{StaticResource UtilizationCaption}" VerticalAlignment="Center"/>
      <TextBlock Text="%" Style="{StaticResource MetricUnit}" VerticalAlignment="Center"/>
    </StackPanel>

    <!-- Framed history graph mirroring the Memory tile: border + grid + gradient-filled line in Line
         mode, stretch-to-fill dot matrix in Dot mode. Stretches to fill the row so both modes occupy
         the same space (no reflow on toggle). 10px bottom margin lines it up with the tile's base. -->
    <graphs:AdaptiveGraph x:Name="UtilizationGraph" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                          graphs:GraphIdentity.Id="Gpu.Utilization" VerticalAlignment="Center"
                          Capacity="90" MinValue="0" MaxValue="100"
                          Accent="#3BD15A" ShowChrome="True" Margin="0,6,0,10"
                          CellPitch="{StaticResource DashboardDotPitch}"/>
  </Grid>
</UserControl>
