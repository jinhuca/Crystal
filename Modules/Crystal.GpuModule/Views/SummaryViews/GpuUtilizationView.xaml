<UserControl x:Class="Crystal.GpuModule.Views.SummaryViews.GpuUtilizationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Crystal.GpuModule.Views.SummaryViews"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:graphs="clr-namespace:Crystal.Controls.PerformanceGraphs;assembly=Crystal.Controls"
             mc:Ignorable="d"
             d:DesignHeight="120" d:DesignWidth="260"
             FontFamily="{StaticResource UiFontFamily}">
  <!-- DataContext is a GpuAdapterViewModel, inherited from the per-adapter block. Header ("Utilization"
       left, live load value right) over the adapter's core-load history graph; the adapter identity
       lives in the tile header row, not here. Self-registers so the view model feeds it on each poll. -->
  <Grid Width="{x:Static local:GpuSummaryViewConstants.UtilizationGraphWidth}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <Grid Grid.Row="0" Margin="0,0,0,2">
      <TextBlock Text="Utilization" Style="{StaticResource MetricCaption}" HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
        <TextBlock Text="{Binding Load, StringFormat={}{0:0.00}, TargetNullValue=0.00}" Style="{StaticResource TileMetricValue}"/>
        <TextBlock Text="%" Style="{StaticResource MetricUnit}"/>
      </StackPanel>
    </Grid>
    <graphs:AdaptiveGraph x:Name="UtilizationGraph" Grid.Row="1"
                          graphs:GraphIdentity.Id="Gpu.Utilization"
                          Capacity="90" MinValue="0" MaxValue="100"
                          Accent="#3BD15A" ShowChrome="True" MinHeight="40"
                          CellPitch="{StaticResource DashboardDotPitch}"/>
  </Grid>
</UserControl>
