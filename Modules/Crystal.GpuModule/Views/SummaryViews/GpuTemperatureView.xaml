<UserControl x:Class="Crystal.GpuModule.Views.SummaryViews.GpuTemperatureView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:bars="clr-namespace:Crystal.Controls.RangeBars;assembly=Crystal.Controls"
             xmlns:conv="clr-namespace:Crystal.Controls.Converters;assembly=Crystal.Controls"
             mc:Ignorable="d"
             d:DesignHeight="44" d:DesignWidth="130">
  <!-- DataContext is a GpuAdapterViewModel, inherited from the per-adapter block.
       Value-banded segmented range bar over the live core temperature; the history graph lives in the detail view. -->
  <UserControl.Resources>
    <conv:ValueToBrushConverter x:Key="TemperatureFill" Minimum="30" Step="18" Fallback="#9AA0A6">
      <SolidColorBrush Color="#22B14C"/>
      <SolidColorBrush Color="#E8C22A"/>
      <SolidColorBrush Color="#FF7F27"/>
      <SolidColorBrush Color="#ED1C24"/>
      <SolidColorBrush Color="#B0171F"/>
    </conv:ValueToBrushConverter>
  </UserControl.Resources>
  <StackPanel Width="130" HorizontalAlignment="Left">
    <StackPanel Orientation="Horizontal">
      <TextBlock Text="{Binding TemperatureC, StringFormat={}{0:0.00}, TargetNullValue=0.00}" Style="{StaticResource MetricValue}"/>
      <TextBlock Text="°C" Style="{StaticResource MetricUnit}"/>
    </StackPanel>
    <bars:RangeBar Height="5" Margin="0,0,0,4"
                   MinValue="30" MaxValue="120" Value="{Binding TemperatureC, TargetNullValue=0}"
                   Segmented="True" SegmentWidth="4" SegmentGap="2"
                   BarBackground="#141414" TrackBrush="#1E1E1E"
                   BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                   FillBrush="{Binding Value, RelativeSource={RelativeSource Self}, Converter={StaticResource TemperatureFill}}"/>
    <TextBlock Text="Temperature" Style="{StaticResource MetricCaption}"/>
  </StackPanel>
</UserControl>
