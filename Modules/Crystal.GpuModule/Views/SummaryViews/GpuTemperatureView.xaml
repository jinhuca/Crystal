<UserControl x:Class="Crystal.GpuModule.Views.SummaryViews.GpuTemperatureView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Crystal.GpuModule.Views.SummaryViews"
             xmlns:graphs="clr-namespace:Crystal.Controls.PerformanceGraphs;assembly=Crystal.Controls"
             mc:Ignorable="d"
             d:DesignHeight="88" d:DesignWidth="130">
  <!-- DataContext is a GpuAdapterViewModel, inherited from the per-adapter block. Header carries the
       title, the session Min/Max of the core temperature inline, and the live value on the right, over
       a value-banded history graph; self-registers so the view model feeds it on each poll. -->
  <!-- Graph replaced with a header-only readout (test/minimal-graphs): inline session Min/Max, a
       severity-colored live value, and a trend glyph. -->
  <UserControl.Resources>
    <ResourceDictionary Source="/Crystal.Controls;component/Metrics/MetricEnrichmentResources.xaml"/>
  </UserControl.Resources>
  <Grid Width="{x:Static local:GpuSummaryViewConstants.GraphWidth}" VerticalAlignment="Stretch">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" Text="Temperature" Style="{StaticResource MetricCaption}"
               Foreground="{StaticResource TextBrush}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="0,0,0,4"/>

    <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
        <TextBlock Text="{Binding TemperatureC, StringFormat={}{0:0.00}, TargetNullValue=0.00}"
                   Foreground="{Binding TemperatureC, Converter={StaticResource TemperatureToBrush}}"
                   Style="{StaticResource TileMetricValue}"/>
        <TextBlock Text="°C" Style="{StaticResource MetricUnit}"/>
        <TextBlock Text="{Binding TemperatureRow.Trend, Converter={StaticResource TrendToGlyph}}"
                   Foreground="{Binding TemperatureRow.Trend, Converter={StaticResource TrendToBrush}}"
                   Style="{StaticResource MetricUnit}" Margin="4,0,0,0"/>
      </StackPanel>
      <TextBlock Style="{StaticResource MetricStatLine}">
        <Run Text="min "/><Run Text="{Binding TemperatureRow.Min, StringFormat={}{0:0}}"/>
        <Run Text="   avg "/><Run Text="{Binding TemperatureRow.Avg, StringFormat={}{0:0}}"/>
        <Run Text="   max "/><Run Text="{Binding TemperatureRow.Max, StringFormat={}{0:0}}"/>
      </TextBlock>
    </StackPanel>
  </Grid>
</UserControl>
