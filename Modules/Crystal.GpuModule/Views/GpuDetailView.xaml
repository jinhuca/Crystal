<UserControl x:Class="Crystal.GpuModule.Views.GpuDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:graphs="clr-namespace:Crystal.Controls.PerformanceGraphs.Controls;assembly=Crystal.Controls"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="1100"
             Background="{StaticResource PanelBackgroundBrush}" Foreground="White"
             FontFamily="Segoe UI">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
  </UserControl.Resources>
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- Header + Back control -->
    <Grid Grid.Row="0" Margin="0,0,0,16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Button Grid.Column="0" Content="&#x2190; Back"
              Style="{StaticResource DetailBackButtonStyle}"
              Command="{Binding ShowDashboardCommand}"/>
      <TextBlock Grid.Column="1" Text="GPU" Foreground="{StaticResource AccentBrush}" FontSize="28"
                 FontWeight="SemiBold" VerticalAlignment="Center" Margin="16,0,0,0"/>
    </Grid>

    <!-- One full-height panel per adapter, side by side (integrated left, dedicated right) -->
    <ItemsControl Grid.Row="1" ItemsSource="{Binding Adapters}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <UniformGrid Rows="1"/>
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Border Margin="8" Padding="18" Background="{StaticResource SurfaceBackgroundBrush}" CornerRadius="8">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>

              <TextBlock Grid.Row="0" Text="{Binding KindLabel}" Foreground="{StaticResource AccentBrush}"
                         FontSize="18" FontWeight="SemiBold"/>
              <TextBlock Grid.Row="1" Text="{Binding Name}" Foreground="White"
                         FontSize="15" TextWrapping="Wrap" Margin="0,4,0,12"/>

              <!-- Static specs -->
              <Grid Grid.Row="2" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Video RAM" Foreground="{StaticResource LabelBrush}" Margin="0,2,16,2"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Foreground="White" Margin="0,2">
                  <TextBlock.Text>
                    <Binding Path="VideoRamGB" StringFormat="{}{0:0.#} GB" TargetNullValue="—"/>
                  </TextBlock.Text>
                </TextBlock>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Video Processor" Foreground="{StaticResource LabelBrush}" Margin="0,2,16,2"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding VideoProcessor, TargetNullValue=—}" Foreground="White" Margin="0,2" TextWrapping="Wrap"/>
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Display Mode" Foreground="{StaticResource LabelBrush}" Margin="0,2,16,2"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DisplayMode}" Foreground="White" Margin="0,2" TextWrapping="Wrap"/>
                <TextBlock Grid.Row="3" Grid.Column="0" Text="Physical Location" Foreground="{StaticResource LabelBrush}" Margin="0,2,16,2"/>
                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding PhysicalLocation, TargetNullValue=—}" Foreground="White" Margin="0,2" TextWrapping="Wrap"/>
                <TextBlock Grid.Row="4" Grid.Column="0" Text="Driver Version" Foreground="{StaticResource LabelBrush}" Margin="0,2,16,2"/>
                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding DriverVersion, TargetNullValue=—}" Foreground="White" Margin="0,2"/>
                <TextBlock Grid.Row="5" Grid.Column="0" Text="Driver Date" Foreground="{StaticResource LabelBrush}" Margin="0,2,16,2"/>
                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding DriverDate, StringFormat={}{0:yyyy-MM-dd}, TargetNullValue=—}" Foreground="White" Margin="0,2"/>
                <TextBlock Grid.Row="6" Grid.Column="0" Text="Refresh Rate" Foreground="{StaticResource LabelBrush}" Margin="0,2,16,2"/>
                <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding RefreshRateHz, StringFormat={}{0} Hz, TargetNullValue=—}" Foreground="White" Margin="0,2"/>
              </Grid>

              <!-- Live sensor readouts (dense HWiNFO-style): VRAM, memory clock, fan, core voltage.
                   Each shows "—" when the adapter exposes no matching sensor (common on the iGPU). -->
              <Grid Grid.Row="3" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Memory Used" Foreground="{StaticResource LabelBrush}" Margin="0,2,16,2"/>
                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,2">
                  <TextBlock Foreground="White">
                    <TextBlock.Text>
                      <MultiBinding StringFormat="{}{0:0.0} / {1:0.0} GB">
                        <Binding Path="MemoryUsedGB" TargetNullValue="—"/>
                        <Binding Path="MemoryTotalGB" TargetNullValue="—"/>
                      </MultiBinding>
                    </TextBlock.Text>
                  </TextBlock>
                  <TextBlock Foreground="{StaticResource LabelBrush}" Margin="8,0,0,0"
                             Text="{Binding MemoryUsedPercent, StringFormat={}({0:0}%)}"/>
                </StackPanel>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Memory Clock" Foreground="{StaticResource LabelBrush}" Margin="0,2,16,2"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Foreground="White" Margin="0,2"
                           Text="{Binding MemoryClockMhz, StringFormat={}{0:0} MHz, TargetNullValue=—}"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Fan Speed" Foreground="{StaticResource LabelBrush}" Margin="0,2,16,2"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Foreground="White" Margin="0,2"
                           Text="{Binding FanRpm, StringFormat={}{0:0} RPM, TargetNullValue=—}"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Core Voltage" Foreground="{StaticResource LabelBrush}" Margin="0,2,16,2"/>
                <TextBlock Grid.Row="3" Grid.Column="1" Foreground="White" Margin="0,2"
                           Text="{Binding CoreVoltageV, StringFormat={}{0:0.000} V, TargetNullValue=—}"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="Hot Spot" Foreground="{StaticResource LabelBrush}" Margin="0,2,16,2"/>
                <TextBlock Grid.Row="4" Grid.Column="1" Foreground="White" Margin="0,2"
                           Text="{Binding HotSpotTemperatureC, StringFormat={}{0:0.0} °C, TargetNullValue=—}"/>

                <TextBlock Grid.Row="5" Grid.Column="0" Text="Memory Temp" Foreground="{StaticResource LabelBrush}" Margin="0,2,16,2"/>
                <TextBlock Grid.Row="5" Grid.Column="1" Foreground="White" Margin="0,2"
                           Text="{Binding MemoryTemperatureC, StringFormat={}{0:0.0} °C, TargetNullValue=—}"/>

                <TextBlock Grid.Row="6" Grid.Column="0" Text="PCIe Rx" Foreground="{StaticResource LabelBrush}" Margin="0,2,16,2"/>
                <TextBlock Grid.Row="6" Grid.Column="1" Foreground="White" Margin="0,2"
                           Text="{Binding PcieRxMBps, StringFormat={}{0:0.0} MB/s, TargetNullValue=—}"/>

                <TextBlock Grid.Row="7" Grid.Column="0" Text="PCIe Tx" Foreground="{StaticResource LabelBrush}" Margin="0,2,16,2"/>
                <TextBlock Grid.Row="7" Grid.Column="1" Foreground="White" Margin="0,2"
                           Text="{Binding PcieTxMBps, StringFormat={}{0:0.0} MB/s, TargetNullValue=—}"/>
              </Grid>

              <!-- Per-engine utilization breakdown (D3D 3D / Video Decode / Copy / …). Hidden when the
                   adapter exposes no engine sensors, which keeps the iGPU-only case from showing an empty label. -->
              <StackPanel Grid.Row="4" Margin="0,0,0,16"
                          Visibility="{Binding HasEngineLoads, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="Engine Load" Foreground="{StaticResource LabelBrush}" Margin="0,0,0,4"/>
                <ItemsControl ItemsSource="{Binding EngineLoads}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid Margin="0,1">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="140"/>
                          <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="White"/>
                        <TextBlock Grid.Column="1" Foreground="White"
                                   Text="{Binding LoadPercent, StringFormat={}{0:0}%}"/>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>

              <!-- Per-rail power breakdown (AMD PPT/SoC/Core, NVIDIA 12VHPWR connector + pins).
                   Hidden when the adapter exposes only the aggregate package rail. -->
              <StackPanel Grid.Row="5" Margin="0,0,0,16"
                          Visibility="{Binding HasPowerRails, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="Power Rails" Foreground="{StaticResource LabelBrush}" Margin="0,0,0,4"/>
                <ItemsControl ItemsSource="{Binding PowerRails}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid Margin="0,1">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="140"/>
                          <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="White"/>
                        <TextBlock Grid.Column="1" Foreground="White"
                                   Text="{Binding PowerW, StringFormat={}{0:0.0} W}"/>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>

              <!-- Live history: one readout + graph per core metric (load, temperature, clock, power).
                   Load and temperature use fixed 0-100 axes; clock and power ratchet to the VM's
                   running-peak scale so an iGPU and a dGPU each plot sensibly. -->
              <Grid Grid.Row="6">
                <Grid.RowDefinitions>
                  <RowDefinition Height="120"/>
                  <RowDefinition Height="120"/>
                  <RowDefinition Height="120"/>
                  <RowDefinition Height="120"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="8,0">
                    <TextBlock Text="{Binding Load, StringFormat={}{0:0}}" Style="{StaticResource MetricValue}"/>
                    <TextBlock Text="%" Style="{StaticResource MetricUnit}"/>
                    <TextBlock Text="Load" Style="{StaticResource MetricCaption}"/>
                  </StackPanel>
                  <graphs:PerformanceGraphView Grid.Column="1" Margin="12,0"
                                               Loaded="OnLoadGraphLoaded"
                                               Title="Load Percentage" MinValue="0" MaxValue="100"
                                               MaxValueFormat="{}{0}%" MaxTime="60"
                                               MaxTimeFormat="{}{0}s" MinTime="0"/>
                </Grid>

                <Grid Grid.Row="1" Margin="0,0,0,8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="8,0">
                    <TextBlock Text="{Binding TemperatureC, StringFormat={}{0:0}, TargetNullValue=—}" Style="{StaticResource MetricValue}"/>
                    <TextBlock Text="°C" Style="{StaticResource MetricUnit}"/>
                    <TextBlock Text="Temperature" Style="{StaticResource MetricCaption}"/>
                  </StackPanel>
                  <graphs:PerformanceGraphView Grid.Column="1" Margin="12,0"
                                               Loaded="OnTemperatureGraphLoaded"
                                               Title="Temperature" MinValue="0" MaxValue="100"
                                               MaxValueFormat="{}{0} °C" MaxTime="60"
                                               MaxTimeFormat="{}{0}s" MinTime="0"/>
                </Grid>

                <Grid Grid.Row="2" Margin="0,0,0,8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="8,0">
                    <TextBlock Text="{Binding ClockMhz, StringFormat={}{0:0}, TargetNullValue=—}" Style="{StaticResource MetricValue}"/>
                    <TextBlock Text="MHz" Style="{StaticResource MetricUnit}"/>
                    <TextBlock Text="Core Clock" Style="{StaticResource MetricCaption}"/>
                  </StackPanel>
                  <graphs:PerformanceGraphView Grid.Column="1" Margin="12,0"
                                               Loaded="OnClockGraphLoaded"
                                               Title="Core Clock" MinValue="0"
                                               MaxValue="{Binding ClockScaleMax}"
                                               MaxValueFormat="{}{0} MHz" MaxTime="60"
                                               MaxTimeFormat="{}{0}s" MinTime="0"/>
                </Grid>

                <Grid Grid.Row="3">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="8,0">
                    <TextBlock Text="{Binding PowerW, StringFormat={}{0:0}, TargetNullValue=—}" Style="{StaticResource MetricValue}"/>
                    <TextBlock Text="W" Style="{StaticResource MetricUnit}"/>
                    <TextBlock Text="Power" Style="{StaticResource MetricCaption}"/>
                  </StackPanel>
                  <graphs:PerformanceGraphView Grid.Column="1" Margin="12,0"
                                               Loaded="OnPowerGraphLoaded"
                                               Title="Power" MinValue="0"
                                               MaxValue="{Binding PowerScaleMax}"
                                               MaxValueFormat="{}{0} W" MaxTime="60"
                                               MaxTimeFormat="{}{0}s" MinTime="0"/>
                </Grid>
              </Grid>
            </Grid>
            </ScrollViewer>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </Grid>
</UserControl>
