<UserControl x:Class="Crystal.StorageModule.Views.StorageDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:graphs="clr-namespace:Crystal.Controls.PerformanceGraphs;assembly=Crystal.Controls"
             xmlns:conv="clr-namespace:Crystal.StorageModule.Converters"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d"
             d:DesignHeight="760" d:DesignWidth="1100"
             Background="{StaticResource PanelBackgroundBrush}" Foreground="{StaticResource TextBrush}"
             FontFamily="{StaticResource UiFontFamily}">
  <UserControl.Resources>
    <conv:FractionToStarConverter x:Key="FractionToStar"/>
    <!-- StatCaption/StatValue/SpecCaption/SpecValue provided app-wide via Crystal.Resources (TextStyles.xaml). -->
  </UserControl.Resources>

  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- ============ Header ============ -->
    <Grid Grid.Row="0" Margin="0,0,0,16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Button Grid.Column="0" Content="&#x2190; Back"
              Style="{StaticResource DetailBackButtonStyle}"
              Command="{Binding ShowDashboardCommand}"/>
      <TextBlock Grid.Column="1" Text="Storage" Foreground="{StaticResource AccentBrush}" FontSize="{StaticResource TitleFontSize}"
                 FontWeight="SemiBold" VerticalAlignment="Center" Margin="16,0,0,0"/>
    </Grid>

    <!-- ============ Disk selector (left) + selected disk detail (right) ============ -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="260"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- Disk selector list: one entry per physical disk, mirroring Task Manager's left rail. -->
      <ListBox Grid.Column="0" Margin="0,0,20,0"
               Background="Transparent" BorderThickness="0"
               ItemsSource="{Binding Drives}"
               SelectedItem="{Binding SelectedDisk}"
               HorizontalContentAlignment="Stretch"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.ItemContainerStyle>
          <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                  <Border x:Name="Bd" Background="{StaticResource SurfaceBackgroundBrush}" BorderBrush="#242C36"
                          BorderThickness="1" CornerRadius="4" Padding="12,10">
                    <ContentPresenter/>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                      <Setter TargetName="Bd" Property="Background" Value="#17324B"/>
                      <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                    </Trigger>
                    <MultiTrigger>
                      <MultiTrigger.Conditions>
                        <Condition Property="IsMouseOver" Value="True"/>
                        <Condition Property="IsSelected" Value="False"/>
                      </MultiTrigger.Conditions>
                      <Setter TargetName="Bd" Property="Background" Value="#1C2530"/>
                    </MultiTrigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel>
              <TextBlock Text="{Binding HeaderLabel}" Foreground="{StaticResource ValueBrush}" FontSize="{StaticResource SubHeadingFontSize}" FontWeight="SemiBold"/>
              <TextBlock Text="{Binding Model}" Foreground="{StaticResource LabelBrush}" FontSize="{StaticResource CaptionFontSize}"
                         TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
              <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <TextBlock Text="{Binding ActivityLabel}" Foreground="{StaticResource AccentBrush}" FontSize="{StaticResource BodyFontSize}" FontFamily="{StaticResource MonoFontFamily}"/>
                <TextBlock Text="{Binding CapacityLabel}" Foreground="{StaticResource LabelBrush}" FontSize="{StaticResource BodyFontSize}"
                           FontFamily="{StaticResource MonoFontFamily}" Margin="12,0,0,0"/>
              </StackPanel>
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <!-- Selected disk: activity + transfer graphs, stats grid, and identity. -->
      <ContentControl Grid.Column="1" Content="{Binding SelectedDisk}">
        <ContentControl.ContentTemplate>
          <DataTemplate>
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- disk title -->
                <RowDefinition Height="Auto"/>  <!-- active time caption -->
                <RowDefinition Height="*"/>     <!-- activity graph -->
                <RowDefinition Height="Auto"/>  <!-- transfer caption -->
                <RowDefinition Height="*"/>     <!-- transfer graph -->
                <RowDefinition Height="Auto"/>  <!-- capacity bar -->
                <RowDefinition Height="Auto"/>  <!-- stats grid -->
                <RowDefinition Height="Auto"/>  <!-- endurance panel -->
              </Grid.RowDefinitions>

              <Grid Grid.Row="0" Margin="0,0,0,10">
                <TextBlock Text="{Binding HeaderLabel}" Foreground="{StaticResource ValueBrush}" FontSize="20"
                           FontWeight="Light" HorizontalAlignment="Left"/>
                <TextBlock Text="{Binding Model}" Foreground="{StaticResource LabelBrush}" FontSize="{StaticResource SpecFontSize}"
                           HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
              </Grid>

              <!-- Active time -->
              <Grid Grid.Row="1" Margin="0,0,0,2">
                <TextBlock Text="Active time" Foreground="{StaticResource SpecValueBrush}" FontSize="{StaticResource SpecFontSize}" HorizontalAlignment="Left"/>
                <TextBlock Text="{Binding ActivityLabel}" Foreground="{StaticResource LabelBrush}" FontSize="{StaticResource SpecFontSize}" HorizontalAlignment="Right"/>
              </Grid>
              <graphs:PerformanceGraph Grid.Row="2" Margin="0,0,0,12"
                                       Loaded="OnActivityGraphLoaded"
                                       Kind="Line" MinValue="0" MaxValue="100"/>

              <!-- Disk transfer rate -->
              <Grid Grid.Row="3" Margin="0,0,0,2">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                  <TextBlock Text="Disk transfer rate" Foreground="{StaticResource SpecValueBrush}" FontSize="{StaticResource SpecFontSize}" VerticalAlignment="Center"/>
                  <Rectangle Width="11" Height="11" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="16,0,6,0"/>
                  <TextBlock Text="Read" Foreground="{StaticResource LabelBrush}" FontSize="{StaticResource BodyFontSize}" VerticalAlignment="Center"/>
                  <TextBlock Text="{Binding ReadSpeedLabel}" Foreground="{StaticResource SpecValueBrush}" FontSize="{StaticResource BodyFontSize}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                  <Rectangle Width="11" Height="11" Fill="#E89B2A" VerticalAlignment="Center" Margin="16,0,6,0"/>
                  <TextBlock Text="Write" Foreground="{StaticResource LabelBrush}" FontSize="{StaticResource BodyFontSize}" VerticalAlignment="Center"/>
                  <TextBlock Text="{Binding WriteSpeedLabel}" Foreground="{StaticResource SpecValueBrush}" FontSize="{StaticResource BodyFontSize}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Foreground="{StaticResource LabelBrush}" FontSize="{StaticResource SpecFontSize}" HorizontalAlignment="Right" VerticalAlignment="Center">
                  <Run Text="Peak"/><Run Text=" "/><Run Text="{Binding PeakTransferLabel, Mode=OneWay}"/>
                </TextBlock>
              </Grid>
              <graphs:PerformanceGraph Grid.Row="4" Margin="0,0,0,14"
                                       Loaded="OnTransferGraphLoaded"
                                       Kind="Line" MinValue="0"
                                       MaxValue="{Binding TransferMaxMBps}"/>

              <!-- Capacity: used vs free of the disk's mounted volumes -->
              <StackPanel Grid.Row="5" Margin="0,0,0,16">
                <Grid Margin="0,0,0,2">
                  <TextBlock Text="Capacity" Foreground="{StaticResource SpecValueBrush}" FontSize="{StaticResource SpecFontSize}" HorizontalAlignment="Left"/>
                  <TextBlock Text="{Binding CapacityUsageLabel}" Foreground="{StaticResource LabelBrush}" FontSize="{StaticResource SpecFontSize}" HorizontalAlignment="Right"/>
                </Grid>
                <Border BorderBrush="{StaticResource UsageBarBorderBrush}" BorderThickness="1" Background="{StaticResource UsageBarTrackBrush}" Height="28">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="{Binding UsedSpaceFraction, Converter={StaticResource FractionToStar}}"/>
                      <ColumnDefinition Width="{Binding FreeSpaceFraction, Converter={StaticResource FractionToStar}}"/>
                    </Grid.ColumnDefinitions>
                    <Rectangle Grid.Column="0" Fill="{StaticResource UsageBarUsedBrush}" ToolTip="{Binding UsedSpaceLabel}"/>
                    <Rectangle Grid.Column="1" Fill="{StaticResource UsageBarFreeBrush}" ToolTip="{Binding FreeSpaceLabel}"/>
                    <TextBlock Grid.ColumnSpan="2" Text="{Binding UsedSpacePercentLabel}" Foreground="{StaticResource TextBrush}"
                               FontSize="{StaticResource BodyFontSize}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Grid>
                </Border>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                  <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                    <Rectangle Width="11" Height="11" Fill="{StaticResource UsageBarUsedBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="Used" Foreground="{StaticResource LabelBrush}" FontSize="{StaticResource BodyFontSize}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding UsedSpaceLabel}" Foreground="{StaticResource SpecValueBrush}" FontSize="{StaticResource BodyFontSize}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal">
                    <Rectangle Width="11" Height="11" Fill="{StaticResource UsageBarFreeBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="Free" Foreground="{StaticResource LabelBrush}" FontSize="{StaticResource BodyFontSize}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding FreeSpaceLabel}" Foreground="{StaticResource SpecValueBrush}" FontSize="{StaticResource BodyFontSize}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                  </StackPanel>
                </StackPanel>
              </StackPanel>

              <!-- Stats grid -->
              <Grid Grid.Row="6">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="1.4*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                  <StackPanel Margin="0,0,0,14">
                    <TextBlock Text="Active time" Style="{StaticResource StatCaption}"/>
                    <TextBlock Text="{Binding ActivityLabel}" Style="{StaticResource StatValue}"/>
                  </StackPanel>
                  <StackPanel Margin="0,0,0,14">
                    <TextBlock Text="Read speed" Style="{StaticResource StatCaption}"/>
                    <TextBlock Text="{Binding ReadSpeedLabel}" Style="{StaticResource StatValue}"/>
                  </StackPanel>
                  <StackPanel Margin="0,0,0,14">
                    <TextBlock Text="Temperature" Style="{StaticResource StatCaption}"/>
                    <TextBlock Text="{Binding TemperatureLabel}" Style="{StaticResource StatValue}"/>
                  </StackPanel>
                  <StackPanel>
                    <TextBlock Text="Read activity" Style="{StaticResource StatCaption}"/>
                    <TextBlock Text="{Binding ReadActivityLabel}" Style="{StaticResource StatValue}"/>
                  </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1">
                  <StackPanel Margin="0,0,0,14">
                    <TextBlock Text="Average response time" Style="{StaticResource StatCaption}"/>
                    <TextBlock Text="{Binding ResponseLabel}" Style="{StaticResource StatValue}"/>
                  </StackPanel>
                  <StackPanel Margin="0,0,0,14">
                    <TextBlock Text="Write speed" Style="{StaticResource StatCaption}"/>
                    <TextBlock Text="{Binding WriteSpeedLabel}" Style="{StaticResource StatValue}"/>
                  </StackPanel>
                  <StackPanel Margin="0,0,0,14">
                    <TextBlock Text="Health (Life)" Style="{StaticResource StatCaption}"/>
                    <TextBlock Text="{Binding HealthLabel}" Style="{StaticResource StatValue}"/>
                  </StackPanel>
                  <StackPanel>
                    <TextBlock Text="Write activity" Style="{StaticResource StatCaption}"/>
                    <TextBlock Text="{Binding WriteActivityLabel}" Style="{StaticResource StatValue}"/>
                  </StackPanel>
                </StackPanel>

                <Grid Grid.Column="2" VerticalAlignment="Top">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>
                  <TextBlock Grid.Row="0" Grid.Column="0" Text="Capacity:" Style="{StaticResource SpecCaption}"/>
                  <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CapacityLabel}" Style="{StaticResource SpecValue}"/>
                  <TextBlock Grid.Row="1" Grid.Column="0" Text="Type:" Style="{StaticResource SpecCaption}"/>
                  <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding MediaType}" Style="{StaticResource SpecValue}"/>
                  <TextBlock Grid.Row="2" Grid.Column="0" Text="Interface:" Style="{StaticResource SpecCaption}"/>
                  <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding InterfaceType}" Style="{StaticResource SpecValue}"/>
                  <TextBlock Grid.Row="3" Grid.Column="0" Text="Partitions:" Style="{StaticResource SpecCaption}"/>
                  <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding PartitionsLabel}" Style="{StaticResource SpecValue}"/>
                  <TextBlock Grid.Row="4" Grid.Column="0" Text="Firmware:" Style="{StaticResource SpecCaption}"/>
                  <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding FirmwareRevision}" Style="{StaticResource SpecValue}"/>
                  <TextBlock Grid.Row="5" Grid.Column="0" Text="Manufacturer:" Style="{StaticResource SpecCaption}"/>
                  <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Manufacturer}" Style="{StaticResource SpecValue}"/>
                  <TextBlock Grid.Row="6" Grid.Column="0" Text="Serial:" Style="{StaticResource SpecCaption}"/>
                  <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding SerialNumber}" Style="{StaticResource SpecValue}"
                             TextTrimming="CharacterEllipsis"/>
                </Grid>
              </Grid>

              <!-- Endurance (SMART): lifetime host writes/reads and power-on history -->
              <StackPanel Grid.Row="7" Margin="0,18,0,0">
                <TextBlock Text="Endurance (SMART)" Foreground="{StaticResource SpecValueBrush}" FontSize="{StaticResource SpecFontSize}" Margin="0,0,0,8"/>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1.4*"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0">
                    <TextBlock Text="Data written" Style="{StaticResource StatCaption}"/>
                    <TextBlock Text="{Binding DataWrittenLabel}" Style="{StaticResource StatValue}"/>
                  </StackPanel>
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="Data read" Style="{StaticResource StatCaption}"/>
                    <TextBlock Text="{Binding DataReadLabel}" Style="{StaticResource StatValue}"/>
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="Power on" Style="{StaticResource StatCaption}"/>
                    <TextBlock Text="{Binding PowerOnHoursLabel}" Style="{StaticResource StatValue}"/>
                  </StackPanel>
                  <StackPanel Grid.Column="3">
                    <TextBlock Text="Power cycles" Style="{StaticResource StatCaption}"/>
                    <TextBlock Text="{Binding PowerOnCountLabel}" Style="{StaticResource StatValue}"/>
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ContentControl.ContentTemplate>
      </ContentControl>
    </Grid>
  </Grid>
</UserControl>
