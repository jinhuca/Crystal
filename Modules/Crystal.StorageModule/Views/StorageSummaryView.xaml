<UserControl x:Class="Crystal.StorageModule.Views.StorageSummaryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:graphs="clr-namespace:Crystal.Controls.PerformanceGraphs;assembly=Crystal.Controls"
             xmlns:conv="clr-namespace:Crystal.StorageModule.Converters"
             xmlns:sv="clr-namespace:Crystal.StorageModule.Views.SummaryViews"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d"
             d:DesignHeight="360" d:DesignWidth="1100"
             Background="Transparent" Foreground="{StaticResource TextBrush}"
             FontFamily="{StaticResource UiFontFamily}">
  <UserControl.Resources>
    <conv:FractionToStarConverter x:Key="FractionToStar"/>

    <!-- Spec pairs mirroring the Memory tile's bottom hardware-spec row: caption font for both halves,
         brighter value brush. Keeps the Storage tile's endurance line reading as a sibling of it. -->
    <Style x:Key="TileSpecCaption" TargetType="TextBlock" BasedOn="{StaticResource MetricCaption}">
      <Setter Property="Margin" Value="0"/>
    </Style>
    <Style x:Key="TileSpecValue" TargetType="TextBlock" BasedOn="{StaticResource MetricCaption}">
      <Setter Property="Foreground" Value="{StaticResource SpecValueBrush}"/>
      <Setter Property="Margin" Value="10,0,0,0"/>
    </Style>

    <!-- Live stat groups (Active time / Response time / … , and the SMART/temperature column):
         matched to the Memory tile's "In use (Compressed)" readout — MetricCaption caption over a
         light Consolas value at 16px — so both tiles' stat blocks read identically. -->
    <Style x:Key="TileStatCaption" TargetType="TextBlock" BasedOn="{StaticResource MetricCaption}">
      <Setter Property="Margin" Value="0,0,0,1"/>
    </Style>
    <Style x:Key="TileStatValue" TargetType="TextBlock" BasedOn="{StaticResource MetricValue}">
      <Setter Property="FontWeight" Value="Light"/>
      <Setter Property="FontSize" Value="16"/>
    </Style>

    <!-- Section heading + legend styles mirroring the Memory tile's "Memory composition" row so the
         Capacity section and its bar read identically to the composition section on the sibling tile. -->
    <Style x:Key="TileSectionLabel" TargetType="TextBlock" BasedOn="{StaticResource MetricCaption}">
      <Setter Property="Foreground" Value="{StaticResource SpecValueBrush}"/>
    </Style>
    <Style x:Key="TileLegendCaption" TargetType="TextBlock" BasedOn="{StaticResource MetricCaption}">
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="TileLegendValue" TargetType="TextBlock" BasedOn="{StaticResource MetricCaption}">
      <Setter Property="Foreground" Value="{StaticResource SpecValueBrush}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Identity/spec header lines above the graphs: compact caption-scale pairs so the two-line
         block matches the height of the Memory tile's two-row slot list. -->
    <Style x:Key="IdSpecCaption" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource LabelBrush}"/>
      <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}"/>
      <Setter Property="FontSize" Value="{StaticResource CaptionFontSize}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="IdSpecValue" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource SpecValueBrush}"/>
      <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}"/>
      <Setter Property="FontSize" Value="{StaticResource CaptionFontSize}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="6,0,0,0"/>
    </Style>
  </UserControl.Resources>
  <Grid Margin="8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <!-- Header + disk-selector tabs on one line, with a single full-width divider below. -->
    <Border Grid.Row="0" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <sv:StorageHeaderView Grid.Column="0" VerticalAlignment="Top"/>

        <!-- Disk selector: one tab per physical disk. The system disk (first) is selected by
             default; selecting a tab swaps the detail below. -->
        <ListBox Grid.Column="1" Margin="10,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                 Background="Transparent" BorderThickness="0"
                 VerticalContentAlignment="Top"
                 ItemsSource="{Binding Drives}"
                 SelectedItem="{Binding SelectedDisk}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Disabled">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Top"/>
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="Padding" Value="0"/>
              <Setter Property="Margin" Value="0,0,0,0"/>
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent"
                            BorderThickness="1" CornerRadius="4" Padding="10,0">
                      <TextBlock Text="{Binding HeaderLabel}" Foreground="{StaticResource LabelBrush}"
                                 FontSize="{StaticResource BodyFontSize}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsSelected" Value="True">
                        <Setter TargetName="Bd" Property="Background" Value="#1A222C"/>
                        <Setter TargetName="Bd" Property="BorderBrush" Value="#4A5562"/>
                      </Trigger>
                      <MultiTrigger>
                        <MultiTrigger.Conditions>
                          <Condition Property="IsMouseOver" Value="True"/>
                          <Condition Property="IsSelected" Value="False"/>
                        </MultiTrigger.Conditions>
                        <Setter TargetName="Bd" Property="Background" Value="#141A22"/>
                      </MultiTrigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </ListBox.ItemContainerStyle>
        </ListBox>
      </Grid>
    </Border>
    <!-- Selected disk -->
    <ContentControl Grid.Row="1" Content="{Binding SelectedDisk}" Margin="0,0,0,0">
      <ContentControl.ContentTemplate>
        <DataTemplate>
          <Grid ShowGridLines="False">
            <!-- Row order mirrors the Memory tile so the graphs and the capacity/composition bars
                 line up across both tiles: identity + spec header (fixed 50 total), then the graphs
                 (fixed 105), then the capacity bar, then endurance. -->
            <Grid.RowDefinitions>
              <RowDefinition Height="18"/>
              <RowDefinition Height="16"/>
              <RowDefinition Height="108"/>
              <RowDefinition Height="40"/>
              <RowDefinition Height="24"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="240"/>
              <ColumnDefinition Width="240"/>
              <ColumnDefinition/>
              <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <!-- Identity strip: model (brand) + live activity/capacity at left, serial at right. -->
            <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4" VerticalAlignment="Center" Margin="2,0,0,0">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top">
                <TextBlock Text="{Binding Model}"
                             Foreground="{StaticResource ValueBrush}"
                             FontSize="{StaticResource CaptionFontSize}" 
                           FontWeight="SemiBold"
                             VerticalAlignment="Top"/>
                <TextBlock Text="{Binding ActivityLabel}"
                             Foreground="{StaticResource AccentBrush}"
                             FontSize="{StaticResource CaptionFontSize}"
                             FontFamily="{StaticResource MonoFontFamily}"
                             VerticalAlignment="Center"
                             Margin="24,0,0,0"/>
                <TextBlock Text="{Binding CapacityLabel}"
                             Foreground="{StaticResource LabelBrush}"
                             FontSize="{StaticResource CaptionFontSize}"
                             FontFamily="{StaticResource MonoFontFamily}"
                             VerticalAlignment="Center" Margin="12,0,0,0"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock Text="Serial:" Style="{StaticResource IdSpecCaption}"/>
                <TextBlock Text="{Binding SerialNumber}" Style="{StaticResource IdSpecValue}" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
            </Grid>

            <!-- Specs -->
            <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4" Margin="2,0,0,3">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="0.5*"/>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="1.5*"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" Orientation="Horizontal">
                <TextBlock Text="Type:" Style="{StaticResource IdSpecCaption}"/>
                <TextBlock Text="{Binding MediaType}" Style="{StaticResource IdSpecValue}"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal">
                <TextBlock Text="Interface:" Style="{StaticResource IdSpecCaption}"/>
                <TextBlock Text="{Binding InterfaceType}" Style="{StaticResource IdSpecValue}"/>
              </StackPanel>
              <StackPanel Grid.Column="2" Orientation="Horizontal">
                <TextBlock Text="Partitions:" Style="{StaticResource IdSpecCaption}"/>
                <TextBlock Text="{Binding PartitionsLabel}" Style="{StaticResource IdSpecValue}"/>
              </StackPanel>
              <StackPanel Grid.Column="3" Orientation="Horizontal">
                <TextBlock Text="Firmware:" Style="{StaticResource IdSpecCaption}"/>
                <TextBlock Text="{Binding FirmwareRevision}" Style="{StaticResource IdSpecValue}"/>
              </StackPanel>
              <StackPanel Grid.Column="4" Orientation="Horizontal">
                <TextBlock Text="Manufacturer:" Style="{StaticResource IdSpecCaption}"/>
                <TextBlock Text="{Binding Manufacturer}" Style="{StaticResource IdSpecValue}"
                 TextTrimming="CharacterEllipsis"/>
              </StackPanel>
            </Grid>

            <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="4" ShowGridLines="False">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <!-- Active time -->
              <Grid Grid.Column="0" Margin="2,2,2,2">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Bottom">
                    <TextBlock Text="Active time" Style="{StaticResource MetricCaption}" Foreground="{StaticResource TextBrush}"/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                    <TextBlock Text="{Binding ActivityLabel}" Style="{StaticResource TileLegendCaption}"/>
                  </StackPanel>
                </Grid>
                <graphs:AdaptiveGraph 
                  Grid.Row="1" 
                  MinHeight="40" 
                  Width="230"
                  VerticalAlignment="Stretch"
                  HorizontalAlignment="Left"
                  Loaded="OnActivityGraphLoaded"
                  Capacity="60" MinValue="0" MaxValue="100" 
                  Accent="{StaticResource GraphAccentStorage}" 
                  BandedLine="False" ShowChrome="True"
                  CellPitch="{StaticResource DashboardDotPitch}"/>
              </Grid>
              <!-- Disk transfer rate -->
              <Grid Grid.Column="1" Margin="2,2,2,2">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Bottom">
                    <TextBlock Text="Transfer rate" Style="{StaticResource MetricCaption}" Foreground="{StaticResource TextBrush}"/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                    <TextBlock Style="{StaticResource TileLegendCaption}">
                    <Run Text="Peak"/><Run Text=" "/><Run Text="{Binding PeakTransferLabel, Mode=OneWay}"/>
                    </TextBlock>
                  </StackPanel>
                </Grid>
                <graphs:AdaptiveGraph 
                  Grid.Row="1" 
                  MinHeight="40" 
                  Width="230"
                  VerticalAlignment="Stretch"
                  HorizontalAlignment="Left"
                  Loaded="OnTransferGraphLoaded"
                  Capacity="60" MinValue="0" MaxValue="{Binding TransferMaxMBps}"
                  Accent="#3E9BE8" BandedLine="False" ShowChrome="True"
                  CellPitch="{StaticResource DashboardDotPitch}"/>
              </Grid>

              <Grid Grid.Column="2" Margin="12,2,2,2">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="*"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition/>
                  <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Active time" Style="{StaticResource TileStatCaption}"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding ActivityLabel}" Style="{StaticResource TileStatValue}"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="Response time" Style="{StaticResource TileStatCaption}"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ResponseLabel}" Style="{StaticResource TileStatValue}"/>
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Read speed" Style="{StaticResource TileStatCaption}"/>
                <TextBlock Grid.Row="3" Grid.Column="0" Text="{Binding ReadSpeedLabel}" Style="{StaticResource TileStatValue}"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Text="Write speed" Style="{StaticResource TileStatCaption}"/>
                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding WriteSpeedLabel}" Style="{StaticResource TileStatValue}"/>
              </Grid>

              <Grid Grid.Column="3" Margin="12,2,2,2">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="*"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition/>
                  <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Temperature" Style="{StaticResource TileStatCaption}"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding TemperatureLabel}" Style="{StaticResource TileStatValue}"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="Health (Life)" Style="{StaticResource TileStatCaption}"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding HealthLabel}" Style="{StaticResource TileStatValue}"/>
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Read activity" Style="{StaticResource TileStatCaption}"/>
                <TextBlock Grid.Row="3" Grid.Column="0" Text="{Binding ReadActivityLabel}" Style="{StaticResource TileStatValue}"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Text="Write activity" Style="{StaticResource TileStatCaption}"/>
                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding WriteActivityLabel}" Style="{StaticResource TileStatValue}"/>
              </Grid>
            </Grid>

            <!-- Capacity: used vs free of the disk's mounted volumes -->
            <Grid Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="4" Margin="2,0,0,0">
              <Grid.RowDefinitions>
                <RowDefinition Height="24"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <Grid Grid.Row="0" Margin="0,0,0,4">
                <TextBlock Text="Capacity" 
                           Style="{StaticResource TileSectionLabel}"
                           HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                  <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                    <Rectangle Width="9" Height="9" Fill="{StaticResource UsageBarUsedBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock Text="Used" Style="{StaticResource TileLegendCaption}"/>
                    <TextBlock Text="{Binding UsedSpaceLabel}" Style="{StaticResource TileLegendValue}" Margin="4,0,0,0"/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                    <Rectangle Width="9" Height="9" Fill="{StaticResource UsageBarFreeBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock Text="Free" Style="{StaticResource TileLegendCaption}"/>
                    <TextBlock Text="{Binding FreeSpaceLabel}" Style="{StaticResource TileLegendValue}" Margin="4,0,0,0"/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal">
                    <Rectangle Width="9" Height="9" Fill="White" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock Text="Total" Style="{StaticResource TileLegendCaption}"/>
                    <TextBlock Text="{Binding TotalSpaceLabel}" Style="{StaticResource TileLegendValue}" Margin="4,0,0,0"/>
                  </StackPanel>
                </StackPanel>
              </Grid>
              <Border Grid.Row="1" Margin="0,0,0,0" BorderThickness="1" Height="18"
                      BorderBrush="{StaticResource UsageBarBorderBrush}"
                      Background="{StaticResource UsageBarTrackBrush}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{Binding UsedSpaceFraction, Converter={StaticResource FractionToStar}}"/>
                    <ColumnDefinition Width="{Binding FreeSpaceFraction, Converter={StaticResource FractionToStar}}"/>
                  </Grid.ColumnDefinitions>
                  <Rectangle Grid.Column="0" Fill="{StaticResource UsageBarUsedBrush}" ToolTip="{Binding UsedSpaceLabel}"/>
                  <Rectangle Grid.Column="1" Fill="{StaticResource UsageBarFreeBrush}" ToolTip="{Binding FreeSpaceLabel}"/>
                </Grid>
              </Border>
            </Grid>

            <!-- Lifetime host writes/reads and power-on history (SMART), as spec pairs matching the
                 Memory tile's bottom hardware-spec row. -->
            <Grid Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="4" VerticalAlignment="Center" Margin="2,0,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" Orientation="Horizontal">
                <TextBlock Text="Data written:" Style="{StaticResource TileSpecCaption}"/>
                <TextBlock Text="{Binding DataWrittenLabel}" Style="{StaticResource TileSpecValue}"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal">
                <TextBlock Text="Data read:" Style="{StaticResource TileSpecCaption}"/>
                <TextBlock Text="{Binding DataReadLabel}" Style="{StaticResource TileSpecValue}"/>
              </StackPanel>
              <StackPanel Grid.Column="2" Orientation="Horizontal">
                <TextBlock Text="Power on:" Style="{StaticResource TileSpecCaption}"/>
                <TextBlock Text="{Binding PowerOnHoursLabel}" Style="{StaticResource TileSpecValue}"/>
              </StackPanel>
              <StackPanel Grid.Column="3" Orientation="Horizontal">
                <TextBlock Text="Power cycles:" Style="{StaticResource TileSpecCaption}"/>
                <TextBlock Text="{Binding PowerOnCountLabel}" Style="{StaticResource TileSpecValue}"/>
              </StackPanel>
            </Grid>
          </Grid>
        </DataTemplate>
      </ContentControl.ContentTemplate>
    </ContentControl>
  </Grid>
</UserControl>
