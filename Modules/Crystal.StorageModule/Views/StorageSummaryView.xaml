<UserControl x:Class="Crystal.StorageModule.Views.StorageSummaryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:graphs="clr-namespace:Crystal.Controls.PerformanceGraphs;assembly=Crystal.Controls"
             xmlns:conv="clr-namespace:Crystal.StorageModule.Converters"
             xmlns:sv="clr-namespace:Crystal.StorageModule.Views.SummaryViews"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d"
             d:DesignHeight="360" d:DesignWidth="1100"
             Background="Transparent" Foreground="{StaticResource TextBrush}"
             FontFamily="{StaticResource UiFontFamily}">
  <UserControl.Resources>
    <ResourceDictionary>
    <ResourceDictionary.MergedDictionaries>
      <ResourceDictionary Source="/Crystal.Controls;component/Metrics/MetricEnrichmentResources.xaml"/>
      <ResourceDictionary Source="/Crystal.Resources;component/Styles/BorderStyles.xaml"/>
    </ResourceDictionary.MergedDictionaries>
    <conv:FractionToStarConverter x:Key="FractionToStar"/>

    <!-- Spec pairs mirroring the Memory tile's bottom hardware-spec row: caption font for both halves,
         brighter value brush. Keeps the Storage tile's endurance line reading as a sibling of it. -->
    <Style x:Key="TileSpecCaption" TargetType="TextBlock" BasedOn="{StaticResource MetricCaption}">
      <Setter Property="Margin" Value="0"/>
    </Style>
    <Style x:Key="TileSpecValue" TargetType="TextBlock" BasedOn="{StaticResource MetricCaption}">
      <Setter Property="Foreground" Value="{StaticResource SpecValueBrush}"/>
      <Setter Property="Margin" Value="10,0,0,0"/>
    </Style>

    <!-- Live stat groups (Active time / Response time / … , and the SMART/temperature column):
         matched to the Memory tile's "In use (Compressed)" readout — MetricCaption caption over a
         light Consolas value at 16px — so both tiles' stat blocks read identically. -->
    <Style x:Key="TileStatCaption" TargetType="TextBlock" BasedOn="{StaticResource MetricCaption}">
      <Setter Property="Margin" Value="0,0,0,1"/>
    </Style>
    <Style x:Key="TileStatValue" TargetType="TextBlock" BasedOn="{StaticResource MetricValue}">
      <Setter Property="FontWeight" Value="Light"/>
      <Setter Property="FontSize" Value="16"/>
    </Style>

    <!-- Section heading + legend styles mirroring the Memory tile's "Memory composition" row so the
         Capacity section and its bar read identically to the composition section on the sibling tile. -->
    <Style x:Key="TileSectionLabel" TargetType="TextBlock" BasedOn="{StaticResource MetricCaption}">
      <Setter Property="Foreground" Value="{StaticResource SpecValueBrush}"/>
    </Style>
    <Style x:Key="TileLegendCaption" TargetType="TextBlock" BasedOn="{StaticResource MetricCaption}">
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="TileLegendValue" TargetType="TextBlock" BasedOn="{StaticResource MetricCaption}">
      <Setter Property="Foreground" Value="{StaticResource SpecValueBrush}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Identity/spec header lines above the graphs: compact caption-scale pairs so the two-line
         block matches the height of the Memory tile's two-row slot list. -->
    <Style x:Key="IdSpecCaption" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource LabelBrush}"/>
      <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}"/>
      <Setter Property="FontSize" Value="{StaticResource CaptionFontSize}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="IdSpecValue" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource SpecValueBrush}"/>
      <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}"/>
      <Setter Property="FontSize" Value="{StaticResource CaptionFontSize}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="6,0,0,0"/>
    </Style>
    </ResourceDictionary>
  </UserControl.Resources>
  <Border Background="Transparent" Cursor="Hand" MouseLeftButtonDown="OnTileClick">
  <Grid Margin="8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <!-- Header + disk-selector tabs on one line, with a single full-width divider below. -->
    <Border Grid.Row="0" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <sv:StorageHeaderView Grid.Column="0" VerticalAlignment="Top"/>

        <!-- Disk selector: one tab per physical disk. The system disk (first) is selected by
             default; selecting a tab swaps the detail below. -->
        <ListBox Grid.Column="1" Margin="10,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                 Background="Transparent" BorderThickness="0"
                 VerticalContentAlignment="Top"
                 ItemsSource="{Binding Drives}"
                 SelectedItem="{Binding SelectedDisk}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Disabled">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Top"/>
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="Padding" Value="0"/>
              <Setter Property="Margin" Value="0,0,0,0"/>
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent"
                            BorderThickness="1" CornerRadius="4" Padding="10,0">
                      <TextBlock Text="{Binding HeaderLabel}" Foreground="{StaticResource LabelBrush}"
                                 FontSize="{StaticResource BodyFontSize}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsSelected" Value="True">
                        <Setter TargetName="Bd" Property="Background" Value="#1A222C"/>
                        <Setter TargetName="Bd" Property="BorderBrush" Value="#4A5562"/>
                      </Trigger>
                      <MultiTrigger>
                        <MultiTrigger.Conditions>
                          <Condition Property="IsMouseOver" Value="True"/>
                          <Condition Property="IsSelected" Value="False"/>
                        </MultiTrigger.Conditions>
                        <Setter TargetName="Bd" Property="Background" Value="#141A22"/>
                      </MultiTrigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </ListBox.ItemContainerStyle>
        </ListBox>
      </Grid>
    </Border>
    <!-- Selected disk -->
    <ContentControl Grid.Row="1" Content="{Binding SelectedDisk}" Margin="0,0,0,0">
      <ContentControl.ContentTemplate>
        <DataTemplate>
          <Grid ShowGridLines="False">
            <!-- Row order mirrors the Memory tile so the graphs and the capacity bars line up across
                 both tiles: the two graph cards (stretch), then the relocated stat groups, then the
                 capacity bar, then endurance. Disk identity/specs live in the detail view. -->
            <Grid.RowDefinitions>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="240"/>
              <ColumnDefinition Width="240"/>
              <ColumnDefinition/>
              <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <!-- Two graph cards (Active time / Transfer rate) mirroring the CPU/Memory summary card:
                 blue section title + session min/avg/max on the top line, the live value with its
                 trend glyph, and a self-registering per-disk history sparkline filling the rest. Each
                 graph self-registers on load against the selected disk's view model (the handler
                 re-fires with a fresh graph whenever the disk selection swaps the template). -->
            <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4" MinHeight="120" ShowGridLines="False">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>

              <Border Grid.Column="0" Style="{StaticResource SummaryTileBorderStyle}" Margin="2,2,4,2">
                <Grid Margin="10,4,10,6">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                  </Grid.RowDefinitions>
                  <Grid Grid.Row="0">
                    <TextBlock Text="Active time" Style="{StaticResource SummaryTileTitleTextBlockStyle}"
                               HorizontalAlignment="Left" VerticalAlignment="Center"/>
                    <TextBlock Style="{StaticResource MetricStatLine}" HorizontalAlignment="Right" VerticalAlignment="Center">
                      <Run FontFamily="Segoe Fluent Icons" Text="&#xE70D; " Foreground="LightGreen"/>
                      <Run Text="{Binding ActivityRow.Min, StringFormat={}{0:0.#}%}"/>
                      <Run FontFamily="Segoe Fluent Icons" Text=" &#xE738; " Foreground="{StaticResource AccentBrush}"/>
                      <Run Text="{Binding ActivityRow.Avg, StringFormat={}{0:0.#}%}"/>
                      <Run FontFamily="Segoe Fluent Icons" Text=" &#xE70E; " Foreground="Crimson"/>
                      <Run Text="{Binding ActivityRow.Max, StringFormat={}{0:0.#}%}"/>
                    </TextBlock>
                  </Grid>
                  <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,2,0,4">
                    <TextBlock Text="{Binding ActivityLabel}" Style="{StaticResource TileMetricValue}"/>
                    <TextBlock Text="{Binding ActivityRow.Trend, Converter={StaticResource TrendToGlyph}}"
                               Foreground="{Binding ActivityRow.Trend, Converter={StaticResource TrendToBrush}}"
                               Style="{StaticResource MetricUnit}" Margin="4,0,0,0"/>
                  </StackPanel>
                  <graphs:PerformanceGraph Grid.Row="2" Loaded="OnActivityGraphLoaded"
                      Style="{StaticResource AdaptiveGraphStyle}"
                      HistoryLength="180" MinValue="0" MaxValue="100"
                      Accent="{StaticResource GraphAccentStorage}"
                      BandedLine="True" MinHeight="40"
                      CellPitch="{StaticResource DashboardDotPitch}"/>
                </Grid>
              </Border>

              <Border Grid.Column="1" Style="{StaticResource SummaryTileBorderStyle}" Margin="4,2,2,2">
                <Grid Margin="10,4,10,6">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                  </Grid.RowDefinitions>
                  <Grid Grid.Row="0">
                    <TextBlock Text="Transfer rate" Style="{StaticResource SummaryTileTitleTextBlockStyle}"
                               HorizontalAlignment="Left" VerticalAlignment="Center"/>
                    <TextBlock Style="{StaticResource MetricStatLine}" HorizontalAlignment="Right" VerticalAlignment="Center">
                      <Run FontFamily="Segoe Fluent Icons" Text="&#xE70D; " Foreground="LightGreen"/>
                      <Run Text="{Binding TransferRow.Min, StringFormat={}{0:0.#}}"/>
                      <Run FontFamily="Segoe Fluent Icons" Text=" &#xE738; " Foreground="{StaticResource AccentBrush}"/>
                      <Run Text="{Binding TransferRow.Avg, StringFormat={}{0:0.#}}"/>
                      <Run FontFamily="Segoe Fluent Icons" Text=" &#xE70E; " Foreground="Crimson"/>
                      <Run Text="{Binding TransferRow.Max, StringFormat={}{0:0.#}}"/>
                    </TextBlock>
                  </Grid>
                  <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,2,0,4">
                    <TextBlock Text="{Binding CurrentTransferLabel}" Style="{StaticResource TileMetricValue}"/>
                    <TextBlock Text="{Binding TransferRow.Trend, Converter={StaticResource TrendToGlyph}}"
                               Foreground="{Binding TransferRow.Trend, Converter={StaticResource TrendToBrush}}"
                               Style="{StaticResource MetricUnit}" Margin="4,0,0,0"/>
                  </StackPanel>
                  <graphs:PerformanceGraph Grid.Row="2" Loaded="OnTransferGraphLoaded"
                      Style="{StaticResource AdaptiveGraphStyle}"
                      HistoryLength="180" MinValue="0" MaxValue="{Binding TransferMaxMBps}"
                      Accent="{StaticResource GraphAccentStorage}"
                      BandedLine="False" MinHeight="40"
                      CellPitch="{StaticResource DashboardDotPitch}"/>
                </Grid>
              </Border>
            </Grid>

            <!-- Per-disk stats moved below the cards: two 4-column caption-over-value groups, one
                 under each card (activity/response under Active time, media/health under Transfer). -->
            <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4" Margin="2,8,2,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>

              <Grid Grid.Column="0" Margin="8,0,4,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Response time" Style="{StaticResource TileStatCaption}"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding ResponseLabel}" Style="{StaticResource TileStatValue}"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="Read speed" Style="{StaticResource TileStatCaption}"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ReadSpeedLabel}" Style="{StaticResource TileStatValue}"/>
                <TextBlock Grid.Row="0" Grid.Column="2" Text="Read activity" Style="{StaticResource TileStatCaption}"/>
                <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding ReadActivityLabel}" Style="{StaticResource TileStatValue}"/>
                <TextBlock Grid.Row="0" Grid.Column="3" Text="Write speed" Style="{StaticResource TileStatCaption}"/>
                <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding WriteSpeedLabel}" Style="{StaticResource TileStatValue}"/>
              </Grid>

              <Grid Grid.Column="1" Margin="8,0,4,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Write activity" Style="{StaticResource TileStatCaption}"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding WriteActivityLabel}" Style="{StaticResource TileStatValue}"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="Temperature" Style="{StaticResource TileStatCaption}"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding TemperatureLabel}" Style="{StaticResource TileStatValue}"/>
                <TextBlock Grid.Row="0" Grid.Column="2" Text="Health (Life)" Style="{StaticResource TileStatCaption}"/>
                <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding HealthLabel}" Style="{StaticResource TileStatValue}"/>
                <TextBlock Grid.Row="0" Grid.Column="3" Text="Peak" Style="{StaticResource TileStatCaption}"/>
                <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding PeakTransferLabel}" Style="{StaticResource TileStatValue}"/>
              </Grid>
            </Grid>

            <!-- Capacity: used vs free of the disk's mounted volumes -->
            <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="4" Margin="2,0,0,0">
              <Grid.RowDefinitions>
                <RowDefinition Height="24"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <Grid Grid.Row="0" Margin="0,0,0,4">
                <TextBlock Text="Capacity" 
                           Style="{StaticResource TileSectionLabel}"
                           HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                  <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                    <Rectangle Width="9" Height="9" Fill="{StaticResource UsageBarUsedBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock Text="Used" Style="{StaticResource TileLegendCaption}"/>
                    <TextBlock Text="{Binding UsedSpaceLabel}" Style="{StaticResource TileLegendValue}" Margin="4,0,0,0"/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                    <Rectangle Width="9" Height="9" Fill="{StaticResource UsageBarFreeBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock Text="Free" Style="{StaticResource TileLegendCaption}"/>
                    <TextBlock Text="{Binding FreeSpaceLabel}" Style="{StaticResource TileLegendValue}" Margin="4,0,0,0"/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal">
                    <Rectangle Width="9" Height="9" Fill="White" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock Text="Total" Style="{StaticResource TileLegendCaption}"/>
                    <TextBlock Text="{Binding TotalSpaceLabel}" Style="{StaticResource TileLegendValue}" Margin="4,0,0,0"/>
                  </StackPanel>
                </StackPanel>
              </Grid>
              <Border Grid.Row="1" Margin="0,0,0,0" BorderThickness="1" Height="18"
                      BorderBrush="{StaticResource UsageBarBorderBrush}"
                      Background="{StaticResource UsageBarTrackBrush}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{Binding UsedSpaceFraction, Converter={StaticResource FractionToStar}}"/>
                    <ColumnDefinition Width="{Binding FreeSpaceFraction, Converter={StaticResource FractionToStar}}"/>
                  </Grid.ColumnDefinitions>
                  <Rectangle Grid.Column="0" Fill="{StaticResource UsageBarUsedBrush}" ToolTip="{Binding UsedSpaceLabel}"/>
                  <Rectangle Grid.Column="1" Fill="{StaticResource UsageBarFreeBrush}" ToolTip="{Binding FreeSpaceLabel}"/>
                </Grid>
              </Border>
            </Grid>

            <!-- Lifetime host writes/reads and power-on history (SMART), as spec pairs matching the
                 Memory tile's bottom hardware-spec row. -->
            <Grid Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="4" VerticalAlignment="Center" Margin="2,8,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" Orientation="Horizontal">
                <TextBlock Text="Data written:" Style="{StaticResource TileSpecCaption}"/>
                <TextBlock Text="{Binding DataWrittenLabel}" Style="{StaticResource TileSpecValue}"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal">
                <TextBlock Text="Data read:" Style="{StaticResource TileSpecCaption}"/>
                <TextBlock Text="{Binding DataReadLabel}" Style="{StaticResource TileSpecValue}"/>
              </StackPanel>
              <StackPanel Grid.Column="2" Orientation="Horizontal">
                <TextBlock Text="Power on:" Style="{StaticResource TileSpecCaption}"/>
                <TextBlock Text="{Binding PowerOnHoursLabel}" Style="{StaticResource TileSpecValue}"/>
              </StackPanel>
              <StackPanel Grid.Column="3" Orientation="Horizontal">
                <TextBlock Text="Power cycles:" Style="{StaticResource TileSpecCaption}"/>
                <TextBlock Text="{Binding PowerOnCountLabel}" Style="{StaticResource TileSpecValue}"/>
              </StackPanel>
            </Grid>
          </Grid>
        </DataTemplate>
      </ContentControl.ContentTemplate>
    </ContentControl>
  </Grid>
  </Border>
</UserControl>
