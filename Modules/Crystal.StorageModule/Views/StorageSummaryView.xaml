<UserControl x:Class="Crystal.StorageModule.Views.StorageSummaryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:graphs="clr-namespace:Crystal.Controls.PerformanceGraphs;assembly=Crystal.Controls"
             xmlns:conv="clr-namespace:Crystal.StorageModule.Converters"
             xmlns:sv="clr-namespace:Crystal.StorageModule.Views.SummaryViews"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="1100"
             Background="Transparent" Foreground="{StaticResource TextBrush}"
             FontFamily="{StaticResource UiFontFamily}">
  <UserControl.Resources>
    <conv:FractionToStarConverter x:Key="FractionToStar"/>

    <!-- Detail-panel readouts sized/typed to match the other dashboard tiles (e.g. GpuSummaryView):
         Consolas numerics, MetricValue/MetricCaption scale. -->
    <Style x:Key="DiskStatCaption" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource LabelBrush}"/>
      <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}"/>
      <Setter Property="FontSize" Value="{StaticResource CaptionFontSize}"/>
      <Setter Property="Margin" Value="0,0,0,1"/>
    </Style>
    <Style x:Key="DiskStatValue" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource ValueBrush}"/>
      <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}"/>
      <Setter Property="FontSize" Value="{StaticResource CaptionFontSize}"/>
    </Style>
  </UserControl.Resources>
  <Grid Margin="8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <!-- Header + disk-selector tabs on one line, with a single full-width divider below. -->
    <Border Grid.Row="0" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <sv:StorageHeaderView Grid.Column="0" VerticalAlignment="Top"/>

        <!-- Disk selector: one tab per physical disk. The system disk (first) is selected by
             default; selecting a tab swaps the detail below. -->
        <ListBox Grid.Column="1" Margin="10,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                 Background="Transparent" BorderThickness="0"
                 VerticalContentAlignment="Top"
                 ItemsSource="{Binding Drives}"
                 SelectedItem="{Binding SelectedDisk}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Disabled">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Top"/>
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="Padding" Value="0"/>
              <Setter Property="Margin" Value="0,0,0,0"/>
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent"
                            BorderThickness="1" CornerRadius="4" Padding="10,0">
                      <TextBlock Text="{Binding HeaderLabel}" Foreground="{StaticResource LabelBrush}"
                                 FontSize="{StaticResource BodyFontSize}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsSelected" Value="True">
                        <Setter TargetName="Bd" Property="Background" Value="#1A222C"/>
                        <Setter TargetName="Bd" Property="BorderBrush" Value="#4A5562"/>
                      </Trigger>
                      <MultiTrigger>
                        <MultiTrigger.Conditions>
                          <Condition Property="IsMouseOver" Value="True"/>
                          <Condition Property="IsSelected" Value="False"/>
                        </MultiTrigger.Conditions>
                        <Setter TargetName="Bd" Property="Background" Value="#141A22"/>
                      </MultiTrigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </ListBox.ItemContainerStyle>
        </ListBox>
      </Grid>
    </Border>
    <!-- Selected disk -->
    <ContentControl Grid.Row="1" Content="{Binding SelectedDisk}" Margin="0,2,0,0">
      <ContentControl.ContentTemplate>
        <DataTemplate>
          <Grid ShowGridLines="False">
            <Grid.RowDefinitions>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition/>
              <ColumnDefinition/>
              <ColumnDefinition/>
              <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <!-- Active time -->
            <Grid Grid.Row="0" Grid.Column="0">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <Grid Grid.Row="0">
                <TextBlock Text="Active time" 
                           Foreground="{StaticResource SpecValueBrush}" 
                           FontSize="{StaticResource SpecFontSize}" 
                           HorizontalAlignment="Left"/>
                <TextBlock Text="{Binding ActivityLabel}" 
                           Foreground="{StaticResource LabelBrush}" 
                           FontFamily="{StaticResource MonoFontFamily}" 
                           FontSize="{StaticResource SpecFontSize}" 
                           HorizontalAlignment="Right" Margin="0,0,5,0"/>
              </Grid>
              <graphs:AdaptiveGraph Grid.Row="1" Margin="0,0,5,5" MinHeight="40" Width="230"
                                    Loaded="OnActivityGraphLoaded"
                                    Capacity="60" MinValue="0" MaxValue="100" 
                                    Accent="{StaticResource GraphAccentStorage}" 
                                    BandedLine="False" ShowChrome="True"
                                    CellPitch="{StaticResource DashboardDotPitch}"/>
            </Grid>
            <!-- Disk transfer rate -->
            <Grid Grid.Row="0" Grid.Column="1">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <Grid Grid.Row="0" Margin="0,0,0,2">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                  <TextBlock Text="Transfer rate" 
                               Foreground="{StaticResource SpecValueBrush}" 
                               FontSize="{StaticResource SpecFontSize}" 
                               VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Foreground="{StaticResource LabelBrush}" 
                             FontFamily="{StaticResource MonoFontFamily}" 
                             FontSize="{StaticResource SpecFontSize}" 
                             HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0">
                    <Run Text="Peak"/><Run Text=" "/><Run Text="{Binding PeakTransferLabel, Mode=OneWay}"/>
                </TextBlock>
              </Grid>
              <graphs:AdaptiveGraph Grid.Row="1" Margin="0,0,0,5" MinHeight="40" Width="230"
                                      Loaded="OnTransferGraphLoaded"
                                      Capacity="60" MinValue="0" MaxValue="{Binding TransferMaxMBps}"
                                      Accent="#3E9BE8" ShowChrome="True"
                                      CellPitch="{StaticResource DashboardDotPitch}"/>
            </Grid>

            <Grid Grid.Row="0" Grid.Column="2" Margin="10,0,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
              </Grid.RowDefinitions>
              <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,0">
                <TextBlock Text="Active time" Style="{StaticResource DiskStatCaption}"/>
                <TextBlock Text="{Binding ActivityLabel}" Style="{StaticResource DiskStatValue}"/>
              </StackPanel>
              <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,0">
                <TextBlock Text="Response time" Style="{StaticResource DiskStatCaption}"/>
                <TextBlock Text="{Binding ResponseLabel}" Style="{StaticResource DiskStatValue}"/>
              </StackPanel>
              <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,0">
                <TextBlock Text="Read speed" Style="{StaticResource DiskStatCaption}"/>
                <TextBlock Text="{Binding ReadSpeedLabel}" Style="{StaticResource DiskStatValue}"/>
              </StackPanel>
              <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,0">
                <TextBlock Text="Write speed" Style="{StaticResource DiskStatCaption}"/>
                <TextBlock Text="{Binding WriteSpeedLabel}" Style="{StaticResource DiskStatValue}"/>
              </StackPanel>
            </Grid>

            <Grid Grid.Row="0" Grid.Column="3" Margin="10,0,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
              </Grid.RowDefinitions>
              <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,0">
                <TextBlock Text="Temperature" Style="{StaticResource DiskStatCaption}"/>
                <TextBlock Text="{Binding TemperatureLabel}" Style="{StaticResource DiskStatValue}"/>
              </StackPanel>
              <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,0">
                <TextBlock Text="Health (Life)" Style="{StaticResource DiskStatCaption}"/>
                <TextBlock Text="{Binding HealthLabel}" Style="{StaticResource DiskStatValue}"/>
              </StackPanel>
              <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,0">
                <TextBlock Text="Read activity" Style="{StaticResource DiskStatCaption}"/>
                <TextBlock Text="{Binding ReadActivityLabel}" Style="{StaticResource DiskStatValue}"/>
              </StackPanel>
              <StackPanel Grid.Row="1" Grid.Column="1">
                <TextBlock Text="Write activity" Style="{StaticResource DiskStatCaption}"/>
                <TextBlock Text="{Binding WriteActivityLabel}" Style="{StaticResource DiskStatValue}"/>
              </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4" Margin="0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="0.5*"/>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="1.5*"/>
              </Grid.ColumnDefinitions>
              <!--<StackPanel Grid.Column="0" Orientation="Horizontal">
                  <TextBlock Text="Capacity:" Style="{StaticResource SpecCaption}"/>
                  <TextBlock Text="{Binding CapacityLabel}" Style="{StaticResource SpecValue}"/>
                </StackPanel>-->
              <StackPanel Grid.Column="0" Orientation="Horizontal">
                <TextBlock Text="Type:" Style="{StaticResource SpecCaption}"/>
                <TextBlock Text="{Binding MediaType}" Style="{StaticResource SpecValue}"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal">
                <TextBlock Text="Interface:" Style="{StaticResource SpecCaption}"/>
                <TextBlock Text="{Binding InterfaceType}" Style="{StaticResource SpecValue}"/>
              </StackPanel>
              <StackPanel Grid.Column="2" Orientation="Horizontal">
                <TextBlock Text="Partitions:" Style="{StaticResource SpecCaption}"/>
                <TextBlock Text="{Binding PartitionsLabel}" Style="{StaticResource SpecValue}"/>
              </StackPanel>
              <StackPanel Grid.Column="3" Orientation="Horizontal">
                <TextBlock Text="Firmware:" Style="{StaticResource SpecCaption}"/>
                <TextBlock Text="{Binding FirmwareRevision}" Style="{StaticResource SpecValue}"/>
              </StackPanel>
              <StackPanel Grid.Column="4" Orientation="Horizontal">
                <TextBlock Text="Manufacturer:" Style="{StaticResource SpecCaption}"/>
                <TextBlock Text="{Binding Manufacturer}" Style="{StaticResource SpecValue}"
                             TextTrimming="CharacterEllipsis"/>
              </StackPanel>
            </Grid>

            <!-- Capacity: used vs free of the disk's mounted volumes -->
            <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="4">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <Grid Grid.Row="0" Margin="0,0,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                  <TextBlock Text="Capacity" Foreground="{StaticResource SpecValueBrush}" FontSize="{StaticResource SpecFontSize}" VerticalAlignment="Center"/>
                  <Rectangle Width="11" Height="11" Fill="{StaticResource UsageBarUsedBrush}" VerticalAlignment="Center" Margin="16,0,6,0"/>
                  <TextBlock Text="Used" Foreground="{StaticResource LabelBrush}" FontSize="{StaticResource BodyFontSize}" VerticalAlignment="Center"/>
                  <TextBlock Text="{Binding UsedSpaceLabel}" Foreground="{StaticResource SpecValueBrush}" FontFamily="{StaticResource MonoFontFamily}" FontSize="{StaticResource BodyFontSize}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                  <Rectangle Width="11" Height="11" Fill="{StaticResource UsageBarFreeBrush}" VerticalAlignment="Center" Margin="16,0,6,0"/>
                  <TextBlock Text="Free" Foreground="{StaticResource LabelBrush}" FontSize="{StaticResource BodyFontSize}" VerticalAlignment="Center"/>
                  <TextBlock Text="{Binding FreeSpaceLabel}" Foreground="{StaticResource SpecValueBrush}" FontFamily="{StaticResource MonoFontFamily}" FontSize="{StaticResource BodyFontSize}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="{Binding CapacityUsageLabel}" Foreground="{StaticResource LabelBrush}" FontFamily="{StaticResource MonoFontFamily}" FontSize="{StaticResource SpecFontSize}" HorizontalAlignment="Right"/>
              </Grid>
              <Border Grid.Row="1" BorderBrush="{StaticResource UsageBarBorderBrush}" BorderThickness="1"
                        Background="{StaticResource UsageBarTrackBrush}" Height="18" Margin="0,2,0,10">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{Binding UsedSpaceFraction, Converter={StaticResource FractionToStar}}"/>
                    <ColumnDefinition Width="{Binding FreeSpaceFraction, Converter={StaticResource FractionToStar}}"/>
                  </Grid.ColumnDefinitions>
                  <Rectangle Grid.Column="0" Fill="{StaticResource UsageBarUsedBrush}" ToolTip="{Binding UsedSpaceLabel}"/>
                  <Rectangle Grid.Column="1" Fill="{StaticResource UsageBarFreeBrush}" ToolTip="{Binding FreeSpaceLabel}"/>
                  <TextBlock Grid.ColumnSpan="2" Text="{Binding UsedSpacePercentLabel}" Foreground="{StaticResource TextBrush}"
                               FontFamily="{StaticResource MonoFontFamily}" FontSize="{StaticResource BodyFontSize}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
              </Border>
            </Grid>

            <!-- Endurance (SMART): label at left, lifetime host writes/reads and power-on history. -->
            <Grid Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="4" ShowGridLines="True">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="Endurance (SMART)" Foreground="{StaticResource SpecValueBrush}" FontSize="{StaticResource SpecFontSize}"
                             VerticalAlignment="Top" Margin="0,0,24,0"/>
              <StackPanel Grid.Column="1" Orientation="Horizontal">
                <TextBlock Text="Data written" Style="{StaticResource DiskStatCaption}"/>
                <TextBlock Text="{Binding DataWrittenLabel}" Style="{StaticResource DiskStatValue}" Margin="12,0,0,0"/>
              </StackPanel>
              <StackPanel Grid.Column="2" Orientation="Horizontal">
                <TextBlock Text="Data read" Style="{StaticResource DiskStatCaption}"/>
                <TextBlock Text="{Binding DataReadLabel}" Style="{StaticResource DiskStatValue}" Margin="12,0,0,0"/>
              </StackPanel>
              <StackPanel Grid.Column="3" Orientation="Horizontal">
                <TextBlock Text="Power on" Style="{StaticResource DiskStatCaption}"/>
                <TextBlock Text="{Binding PowerOnHoursLabel}" Style="{StaticResource DiskStatValue}" Margin="12,0,0,0"/>
              </StackPanel>
              <StackPanel Grid.Column="4" Orientation="Horizontal">
                <TextBlock Text="Power cycles" Style="{StaticResource DiskStatCaption}"/>
                <TextBlock Text="{Binding PowerOnCountLabel}" Style="{StaticResource DiskStatValue}" Margin="12,0,0,0"/>
              </StackPanel>

            </Grid>

            <!-- Identity strip: model (brand) + live activity/capacity at left, serial at right. -->
            <Grid Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="4">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <TextBlock Text="{Binding Model}" 
                             Foreground="{StaticResource ValueBrush}" 
                             FontSize="{StaticResource SubHeadingFontSize}" 
                             VerticalAlignment="Center"/>
                <TextBlock Text="{Binding ActivityLabel}" 
                             Foreground="{StaticResource AccentBrush}" 
                             FontSize="{StaticResource SpecFontSize}"
                             FontFamily="{StaticResource MonoFontFamily}" 
                             VerticalAlignment="Center" 
                             Margin="24,0,0,0"/>
                <TextBlock Text="{Binding CapacityLabel}" 
                             Foreground="{StaticResource LabelBrush}" 
                             FontSize="{StaticResource SpecFontSize}"
                             FontFamily="{StaticResource MonoFontFamily}" 
                             VerticalAlignment="Center" Margin="12,0,0,0"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock Text="Serial:" Style="{StaticResource SpecCaption}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding SerialNumber}" Style="{StaticResource SpecValue}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
            </Grid>
          </Grid>
        </DataTemplate>
      </ContentControl.ContentTemplate>
    </ContentControl>
  </Grid>
</UserControl>
