<UserControl x:Class="Crystal.StorageModule.Views.StorageSummaryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:sv="clr-namespace:Crystal.StorageModule.Views.SummaryViews"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d"
             d:DesignHeight="240" d:DesignWidth="380"
             Background="Transparent" Foreground="{StaticResource TextBrush}"
             FontFamily="{StaticResource UiFontFamily}">
  <!-- Layout only: the header and each tile live in Views/SummaryViews. All tiles inherit the root
       IStorageViewModel DataContext; each graph-owning tile self-registers its history graph on
       load. -->
  <Border Background="Transparent" MouseLeftButtonDown="OnTileClick">
    <Grid Margin="10">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <sv:StorageHeaderView Grid.Row="0"/>

      <!-- Activity (top) + Transfer (bottom) stacked graph tiles. -->
      <Grid Grid.Row="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="*"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <sv:StorageActivityView Grid.Row="0" Margin="0,0,0,6"/>
        <sv:StorageTransferView Grid.Row="1"/>
      </Grid>
    </Grid>
  </Border>
</UserControl>
