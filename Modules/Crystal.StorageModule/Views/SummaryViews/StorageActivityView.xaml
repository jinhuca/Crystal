<UserControl x:Class="Crystal.StorageModule.Views.SummaryViews.StorageActivityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:graphs="clr-namespace:Crystal.Controls.PerformanceGraphs;assembly=Crystal.Controls"
             mc:Ignorable="d"
             d:DesignHeight="90" d:DesignWidth="380"
             Foreground="{StaticResource TextBrush}" FontFamily="{StaticResource UiFontFamily}">
  <!-- DataContext is the root IStorageViewModel, inherited from the host tile. Active-time-% history
       graph with a big-value readout. Appearance is owned by the graph-settings feature (keyed by
       GraphIdentity.Id); the view self-registers its graph so the VM can push samples. -->
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>
    <graphs:PerformanceGraph x:Name="ActivityGraph" Grid.Column="0"
                             graphs:GraphIdentity.Id="Storage.Activity"
                             MinValue="0" MaxValue="100"/>
    <StackPanel Grid.Column="1" Style="{StaticResource SummaryStackPanelStyle}">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="{Binding Load, StringFormat={}{0:0.00}}" Style="{StaticResource MetricValue}"/>
        <TextBlock Text="%" Style="{StaticResource MetricUnit}"/>
      </StackPanel>
      <TextBlock Text="Active time" Style="{StaticResource MetricCaption}"/>
      <TextBlock Text="{Binding BusiestDriveLabel}" Style="{StaticResource MetricCaption}"
                 Foreground="{StaticResource SpecValueBrush}"
                 Visibility="{Binding ShowBusiestDrive, Converter={StaticResource BoolToVisibility}}"/>
    </StackPanel>
  </Grid>
</UserControl>
