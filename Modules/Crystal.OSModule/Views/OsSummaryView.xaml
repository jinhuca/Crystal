<UserControl x:Class="Crystal.OSModule.Views.OsSummaryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d"
             d:DesignHeight="240" d:DesignWidth="380"
             Background="Transparent" Foreground="{StaticResource TextBrush}"
             FontFamily="{StaticResource UiFontFamily}">
  <UserControl.Resources>
    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource LabelBrush}"/>
      <Setter Property="FontSize" Value="{StaticResource CaptionFontSize}"/>
    </Style>
    <Style x:Key="FieldValue" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource ValueBrush}"/>
      <Setter Property="FontSize" Value="{StaticResource SpecFontSize}"/>
      <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
      <Setter Property="Margin" Value="0,0,16,0"/>
    </Style>
    <Style x:Key="FieldCell" TargetType="StackPanel">
      <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>
  </UserControl.Resources>

  <Border Background="Transparent" MouseLeftButtonDown="OnTileClick">
    <Grid Margin="10">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- Dense header bar: accent tick + title + inline OS name, thin divider rule below. -->
      <Border Grid.Row="0" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1"
              Padding="0,0,0,4" Margin="0,0,0,8">
        <StackPanel Orientation="Horizontal">
          <Border Width="3" Background="{StaticResource AccentBrush}" Margin="0,1,8,1"/>
          <TextBlock Text="OPERATING SYSTEM" Foreground="{StaticResource ValueBrush}" FontSize="{StaticResource BodyFontSize}" FontWeight="SemiBold"
                     VerticalAlignment="Center" Margin="0,0,16,0"/>
          <TextBlock Text="{Binding OsName}" Foreground="{StaticResource ValueBrush}" FontSize="{StaticResource CaptionFontSize}" FontFamily="{StaticResource MonoFontFamily}"
                     VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
      </Border>

      <StackPanel Grid.Row="1" VerticalAlignment="Top">
        <!-- Version / build / architecture triplet -->
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Style="{StaticResource FieldCell}">
            <TextBlock Text="Version" Style="{StaticResource FieldLabel}"/>
            <TextBlock Text="{Binding DisplayVersion}" Style="{StaticResource FieldValue}"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Style="{StaticResource FieldCell}">
            <TextBlock Text="Build" Style="{StaticResource FieldLabel}"/>
            <TextBlock Text="{Binding BuildLabel}" Style="{StaticResource FieldValue}"/>
          </StackPanel>
          <StackPanel Grid.Column="2" Style="{StaticResource FieldCell}">
            <TextBlock Text="Architecture" Style="{StaticResource FieldLabel}"/>
            <TextBlock Text="{Binding Architecture}" Style="{StaticResource FieldValue}"/>
          </StackPanel>
        </Grid>

        <!-- Uptime section rule + header. Uptime is the live value (green tick); last boot and
             install date are the fixed timestamps that frame it. -->
        <Border BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0" Margin="0,2,0,8" Padding="0,8,0,0">
          <StackPanel Orientation="Horizontal">
            <Border Width="6" Height="6" CornerRadius="3" Background="{StaticResource OkBrush}"
                    VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBlock Text="UPTIME" Foreground="{StaticResource LabelBrush}" FontSize="{StaticResource MicroFontSize}" FontWeight="SemiBold"
                       VerticalAlignment="Center"/>
          </StackPanel>
        </Border>

        <!-- Live uptime, prominent across the width. -->
        <StackPanel Style="{StaticResource FieldCell}">
          <TextBlock Text="Uptime" Style="{StaticResource FieldLabel}"/>
          <TextBlock Text="{Binding UptimeLabel}" Style="{StaticResource FieldValue}" FontSize="{StaticResource SectionFontSize}"/>
        </StackPanel>

        <!-- Fixed timestamps: last boot + install date. -->
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Style="{StaticResource FieldCell}">
            <TextBlock Text="Last boot" Style="{StaticResource FieldLabel}"/>
            <TextBlock Text="{Binding LastBootTimeLabel}" Style="{StaticResource FieldValue}"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Style="{StaticResource FieldCell}">
            <TextBlock Text="Installed" Style="{StaticResource FieldLabel}"/>
            <TextBlock Text="{Binding InstallDateLabel}" Style="{StaticResource FieldValue}"/>
          </StackPanel>
        </Grid>

        <!-- Processes / Threads / Handles sub-tile. Double-clicking opens the full process list in a
             detail window (handled in code-behind, which marks the event handled so it doesn't also
             trip the outer tile's open-OS-detail double-click). -->
        <Border x:Name="ProcessesTile" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1"
                Background="#101010" CornerRadius="4" Padding="8,6" Cursor="Hand"
                MouseLeftButtonDown="OnProcessesTileClick"
                ToolTip="Double-click to open the full process list">
          <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
              <Border Width="3" Background="{StaticResource AccentBrush}" Margin="0,1,8,1"/>
              <TextBlock Text="PROCESSES, THREADS, HANDLES" Foreground="{StaticResource LabelBrush}"
                         FontSize="{StaticResource MicroFontSize}" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Text="Processes" Style="{StaticResource FieldLabel}"/>
                <TextBlock Text="{Binding ProcessCountLabel}" Style="{StaticResource FieldValue}" FontSize="{StaticResource SectionFontSize}"/>
              </StackPanel>
              <StackPanel Grid.Column="1">
                <TextBlock Text="Threads" Style="{StaticResource FieldLabel}"/>
                <TextBlock Text="{Binding ThreadCountLabel}" Style="{StaticResource FieldValue}" FontSize="{StaticResource SectionFontSize}"/>
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="Handles" Style="{StaticResource FieldLabel}"/>
                <TextBlock Text="{Binding HandleCountLabel}" Style="{StaticResource FieldValue}" FontSize="{StaticResource SectionFontSize}"/>
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
