<UserControl x:Class="StorageModule.Views.StorageDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:graphs="clr-namespace:Crystal.Controls.PerformanceGraphs;assembly=Crystal.Controls"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d"
             d:DesignHeight="760" d:DesignWidth="1100"
             Background="{StaticResource PanelBackgroundBrush}" Foreground="White"
             FontFamily="Segoe UI">
  <UserControl.Resources>
    <!-- StatCaption moved to Crystal.Resources (TextStyles.xaml); resolved app-wide as a shared style. -->
    <Style x:Key="StatValue" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource ValueBrush}"/>
      <Setter Property="FontSize" Value="22"/>
      <Setter Property="FontWeight" Value="Light"/>
    </Style>
    <Style x:Key="SpecCaption" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource LabelBrush}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Margin" Value="0,3"/>
    </Style>
    <Style x:Key="SpecValue" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource SpecValueBrush}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Margin" Value="24,3,0,3"/>
    </Style>
  </UserControl.Resources>

  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- ============ Header ============ -->
    <Grid Grid.Row="0" Margin="0,0,0,16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Button Grid.Column="0" Content="&#x2190; Back" Padding="14,6"
              Background="#1E2A38" Foreground="White" BorderThickness="0"
              Command="{Binding ShowDashboardCommand}"/>
      <TextBlock Grid.Column="1" Text="Storage" Foreground="{StaticResource AccentBrush}" FontSize="28"
                 FontWeight="SemiBold" VerticalAlignment="Center" Margin="16,0,0,0"/>
    </Grid>

    <!-- ============ Disk selector (left) + selected disk detail (right) ============ -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="260"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- Disk selector list: one entry per physical disk, mirroring Task Manager's left rail. -->
      <ListBox Grid.Column="0" Margin="0,0,20,0"
               Background="Transparent" BorderThickness="0"
               ItemsSource="{Binding Drives}"
               SelectedItem="{Binding SelectedDisk}"
               HorizontalContentAlignment="Stretch"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.ItemContainerStyle>
          <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                  <Border x:Name="Bd" Background="{StaticResource SurfaceBackgroundBrush}" BorderBrush="#242C36"
                          BorderThickness="1" CornerRadius="4" Padding="12,10">
                    <ContentPresenter/>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                      <Setter TargetName="Bd" Property="Background" Value="#17324B"/>
                      <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                    </Trigger>
                    <MultiTrigger>
                      <MultiTrigger.Conditions>
                        <Condition Property="IsMouseOver" Value="True"/>
                        <Condition Property="IsSelected" Value="False"/>
                      </MultiTrigger.Conditions>
                      <Setter TargetName="Bd" Property="Background" Value="#1C2530"/>
                    </MultiTrigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel>
              <TextBlock Text="{Binding HeaderLabel}" Foreground="{StaticResource ValueBrush}" FontSize="14" FontWeight="SemiBold"/>
              <TextBlock Text="{Binding Model}" Foreground="{StaticResource LabelBrush}" FontSize="11"
                         TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
              <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <TextBlock Text="{Binding ActivityLabel}" Foreground="{StaticResource AccentBrush}" FontSize="12" FontFamily="Consolas"/>
                <TextBlock Text="{Binding CapacityLabel}" Foreground="{StaticResource LabelBrush}" FontSize="12"
                           FontFamily="Consolas" Margin="12,0,0,0"/>
              </StackPanel>
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <!-- Selected disk: activity + transfer graphs, stats grid, and identity. -->
      <ContentControl Grid.Column="1" Content="{Binding SelectedDisk}">
        <ContentControl.ContentTemplate>
          <DataTemplate>
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- disk title -->
                <RowDefinition Height="Auto"/>  <!-- active time caption -->
                <RowDefinition Height="*"/>     <!-- activity graph -->
                <RowDefinition Height="Auto"/>  <!-- transfer caption -->
                <RowDefinition Height="*"/>     <!-- transfer graph -->
                <RowDefinition Height="Auto"/>  <!-- stats grid -->
              </Grid.RowDefinitions>

              <Grid Grid.Row="0" Margin="0,0,0,10">
                <TextBlock Text="{Binding HeaderLabel}" Foreground="{StaticResource ValueBrush}" FontSize="20"
                           FontWeight="Light" HorizontalAlignment="Left"/>
                <TextBlock Text="{Binding Model}" Foreground="{StaticResource LabelBrush}" FontSize="13"
                           HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
              </Grid>

              <!-- Active time -->
              <Grid Grid.Row="1" Margin="0,0,0,2">
                <TextBlock Text="Active time" Foreground="{StaticResource SpecValueBrush}" FontSize="13" HorizontalAlignment="Left"/>
                <TextBlock Text="{Binding ActivityLabel}" Foreground="{StaticResource LabelBrush}" FontSize="13" HorizontalAlignment="Right"/>
              </Grid>
              <graphs:PerformanceGraph Grid.Row="2" Margin="0,0,0,12"
                                       Loaded="OnActivityGraphLoaded"
                                       Kind="Line" MinValue="0" MaxValue="100"/>

              <!-- Disk transfer rate -->
              <Grid Grid.Row="3" Margin="0,0,0,2">
                <TextBlock Text="Disk transfer rate" Foreground="{StaticResource SpecValueBrush}" FontSize="13" HorizontalAlignment="Left"/>
              </Grid>
              <graphs:PerformanceGraph Grid.Row="4" Margin="0,0,0,14"
                                       Loaded="OnTransferGraphLoaded"
                                       Kind="Line" MinValue="0"
                                       MaxValue="{Binding TransferMaxMBps}"/>

              <!-- Stats grid -->
              <Grid Grid.Row="5">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="1.4*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                  <StackPanel Margin="0,0,0,14">
                    <TextBlock Text="Active time" Style="{StaticResource StatCaption}"/>
                    <TextBlock Text="{Binding ActivityLabel}" Style="{StaticResource StatValue}"/>
                  </StackPanel>
                  <StackPanel>
                    <TextBlock Text="Read speed" Style="{StaticResource StatCaption}"/>
                    <TextBlock Text="{Binding ReadSpeedLabel}" Style="{StaticResource StatValue}"/>
                  </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1">
                  <StackPanel Margin="0,0,0,14">
                    <TextBlock Text="Average response time" Style="{StaticResource StatCaption}"/>
                    <TextBlock Text="{Binding ResponseLabel}" Style="{StaticResource StatValue}"/>
                  </StackPanel>
                  <StackPanel>
                    <TextBlock Text="Write speed" Style="{StaticResource StatCaption}"/>
                    <TextBlock Text="{Binding WriteSpeedLabel}" Style="{StaticResource StatValue}"/>
                  </StackPanel>
                </StackPanel>

                <Grid Grid.Column="2" VerticalAlignment="Top">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>
                  <TextBlock Grid.Row="0" Grid.Column="0" Text="Capacity:" Style="{StaticResource SpecCaption}"/>
                  <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CapacityLabel}" Style="{StaticResource SpecValue}"/>
                  <TextBlock Grid.Row="1" Grid.Column="0" Text="Type:" Style="{StaticResource SpecCaption}"/>
                  <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding MediaType}" Style="{StaticResource SpecValue}"/>
                  <TextBlock Grid.Row="2" Grid.Column="0" Text="Interface:" Style="{StaticResource SpecCaption}"/>
                  <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding InterfaceType}" Style="{StaticResource SpecValue}"/>
                  <TextBlock Grid.Row="3" Grid.Column="0" Text="Partitions:" Style="{StaticResource SpecCaption}"/>
                  <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding PartitionsLabel}" Style="{StaticResource SpecValue}"/>
                  <TextBlock Grid.Row="4" Grid.Column="0" Text="Firmware:" Style="{StaticResource SpecCaption}"/>
                  <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding FirmwareRevision}" Style="{StaticResource SpecValue}"/>
                </Grid>
              </Grid>
            </Grid>
          </DataTemplate>
        </ContentControl.ContentTemplate>
      </ContentControl>
    </Grid>
  </Grid>
</UserControl>
