<UserControl x:Class="StorageModule.Views.StorageSummaryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:graphs="clr-namespace:Crystal.Controls.PerformanceGraphs;assembly=Crystal.Controls"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d"
             d:DesignHeight="240" d:DesignWidth="380"
             Background="Transparent" Foreground="White"
             FontFamily="Segoe UI">
  <UserControl.Resources>
    <!-- MetricValue, MetricUnit, MetricCaption, HeaderSpec moved to Crystal.Resources
         (TextStyles.xaml); resolved app-wide as shared styles. -->
  </UserControl.Resources>

  <Border Background="Transparent" MouseLeftButtonDown="OnTileClick">
    <Grid Margin="10">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- Dense header bar: accent tick + title + inline roll-up (total · drive count), thin
           divider rule below. The per-disk inventory lives in the detail view. -->
      <Border Grid.Row="0" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1"
              Padding="0,0,0,4" Margin="0,0,0,2">
        <StackPanel Orientation="Horizontal">
          <Border Width="3" Background="{StaticResource AccentBrush}" Margin="0,1,8,1"/>
          <TextBlock Text="STORAGE" Foreground="{StaticResource ValueBrush}" FontSize="12" FontWeight="SemiBold"
                     VerticalAlignment="Center" Margin="0,0,16,0"/>
          <TextBlock Style="{StaticResource HeaderSpec}">
            <Run Text="{Binding TotalCapacityLabel, Mode=OneWay}" Foreground="{StaticResource ValueBrush}"/><Run Text=" total"/>
          </TextBlock>
          <TextBlock Text="{Binding DriveCountLabel}" Style="{StaticResource HeaderSpec}"/>
        </StackPanel>
      </Border>

      <!-- Activity (top) + Transfer (bottom) stacked graphs, each with a big value / unit / caption
           readout to the right — matching the Memory/GPU tile layout. -->
      <Grid Grid.Row="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="*"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,6">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <graphs:PerformanceGraph Grid.Column="0"
                                   Loaded="OnLoadGraphLoaded"
                                   Kind="Line"
                                   MinValue="0" MaxValue="100"/>
          <StackPanel Grid.Column="1" Style="{StaticResource SummaryStackPanelStyle}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{Binding Load, StringFormat={}{0:0.00}}" Style="{StaticResource MetricValue}"/>
              <TextBlock Text="%" Style="{StaticResource MetricUnit}"/>
            </StackPanel>
            <TextBlock Text="Active time" Style="{StaticResource MetricCaption}"/>
          </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <graphs:PerformanceGraph Grid.Column="0"
                                   Loaded="OnTransferGraphLoaded"
                                   Kind="Line"
                                   MinValue="0"
                                   MaxValue="{Binding TransferMaxMBps}"/>
          <StackPanel Grid.Column="1" Style="{StaticResource SummaryStackPanelStyle}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{Binding TransferRateMBps, StringFormat={}{0:0.0}}" Style="{StaticResource MetricValue}"/>
              <TextBlock Text="MB/s" Style="{StaticResource MetricUnit}"/>
            </StackPanel>
            <TextBlock Text="Transfer" Style="{StaticResource MetricCaption}"/>
          </StackPanel>
        </Grid>
      </Grid>
    </Grid>
  </Border>
</UserControl>
