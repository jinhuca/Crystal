<UserControl x:Class="Crystal.NetworkModule.Views.NetworkDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:graphs="clr-namespace:Crystal.Controls.PerformanceGraphs.Controls;assembly=Crystal.Controls"
             xmlns:local="clr-namespace:Crystal.NetworkModule.Views"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="1100"
             Background="{StaticResource PanelBackgroundBrush}" Foreground="{StaticResource TextBrush}"
             FontFamily="{StaticResource UiFontFamily}">
  <UserControl.Resources>
    <!-- Dense, sharp-edged column header matching the HWiNFO tile styling (mirrors the Process tile). -->
    <Style x:Key="TalkerHeaderStyle" TargetType="GridViewColumnHeader">
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Padding" Value="8,0"/>
      <Setter Property="Height" Value="24"/>
      <Setter Property="Background" Value="#141414"/>
      <Setter Property="Foreground" Value="{StaticResource LabelBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}"/>
      <Setter Property="BorderThickness" Value="0,0,1,1"/>
      <Setter Property="FontSize" Value="{StaticResource CaptionFontSize}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="GridViewColumnHeader">
            <Border x:Name="HeaderBorder" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}">
              <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                RecognizesAccessKey="True" SnapsToDevicePixels="True"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="HeaderBorder" Property="Background" Value="#1C1C1C"/>
                <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Flat, tight rows; hover is a flat fill (no selection needed here). -->
    <Style x:Key="TalkerRowStyle" TargetType="ListViewItem">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Height" Value="22"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="SnapsToDevicePixels" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListViewItem">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderThickness="0"
                    SnapsToDevicePixels="True">
              <GridViewRowPresenter VerticalAlignment="Center"
                                    SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#1B2733"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Flat dark ListView chrome, no default 3D border. -->
    <Style x:Key="TalkerListViewStyle" TargetType="ListView">
      <Setter Property="Background" Value="#0D0D0D"/>
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="SnapsToDevicePixels" Value="True"/>
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
      <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListView">
            <Border BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
              <ScrollViewer Padding="{TemplateBinding Padding}"
                            Style="{DynamicResource {x:Static GridView.GridViewScrollViewerStyleKey}}">
                <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
              </ScrollViewer>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Header + Back control -->
    <Grid Grid.Row="0" Margin="0,0,0,16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Button Grid.Column="0" Content="&#x2190; Back"
              Style="{StaticResource DetailBackButtonStyle}"
              Command="{Binding ShowDashboardCommand}"/>
      <TextBlock Grid.Column="1" Text="Network" Foreground="{StaticResource AccentBrush}" FontSize="{StaticResource TitleFontSize}"
                 FontWeight="SemiBold" VerticalAlignment="Center" Margin="16,0,0,0"/>
    </Grid>

    <!-- One panel per connected interface, wrapping across the available width -->
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <ItemsControl ItemsSource="{Binding Adapters}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel Orientation="Horizontal"/>
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Margin="8" Padding="18" Background="{StaticResource SurfaceBackgroundBrush}" CornerRadius="8"
                    Width="500" Height="440">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="{Binding Name}" Foreground="{StaticResource AccentBrush}"
                           FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>

                <!-- Current throughput readout -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,8">
                  <StackPanel Orientation="Horizontal" Margin="0,0,24,0">
                    <TextBlock Text="&#x25BC; " Foreground="{StaticResource OkBrush}"/>
                    <TextBlock Text="{Binding DownloadLabel}" Foreground="{StaticResource TextBrush}" FontFamily="{StaticResource MonoFontFamily}"/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#x25B2; " Foreground="#E89B2A"/>
                    <TextBlock Text="{Binding UploadLabel}" Foreground="{StaticResource TextBrush}" FontFamily="{StaticResource MonoFontFamily}"/>
                  </StackPanel>
                </StackPanel>

                <!-- Dense spec strip: utilization, link speed, and cumulative session totals -->
                <WrapPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,12">
                  <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                    <TextBlock Text="Util " Foreground="{StaticResource LabelBrush}" FontFamily="{StaticResource MonoFontFamily}"/>
                    <TextBlock Text="{Binding UtilizationLabel}" Foreground="{StaticResource TextBrush}" FontFamily="{StaticResource MonoFontFamily}"/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                    <TextBlock Text="Link " Foreground="{StaticResource LabelBrush}" FontFamily="{StaticResource MonoFontFamily}"/>
                    <TextBlock Text="{Binding LinkSpeedLabel}" Foreground="{StaticResource TextBrush}" FontFamily="{StaticResource MonoFontFamily}"/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                    <TextBlock Text="&#x25BC; total " Foreground="{StaticResource LabelBrush}" FontFamily="{StaticResource MonoFontFamily}"/>
                    <TextBlock Text="{Binding DataDownloadedLabel}" Foreground="{StaticResource TextBrush}" FontFamily="{StaticResource MonoFontFamily}"/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#x25B2; total " Foreground="{StaticResource LabelBrush}" FontFamily="{StaticResource MonoFontFamily}"/>
                    <TextBlock Text="{Binding DataUploadedLabel}" Foreground="{StaticResource TextBrush}" FontFamily="{StaticResource MonoFontFamily}"/>
                  </StackPanel>
                </WrapPanel>

                <!-- Wi-Fi radio detail (only for an associated wireless adapter) -->
                <Border Grid.Row="3" Margin="0,0,0,12" Padding="10,8" Background="#11161D"
                        CornerRadius="4" Visibility="{Binding IsWifi, Converter={StaticResource BoolToVisibility}}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="SSID" Foreground="{StaticResource LabelBrush}" Margin="0,0,12,2"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding WifiSsid}"
                               Foreground="{StaticResource TextBrush}" FontFamily="{StaticResource MonoFontFamily}" TextTrimming="CharacterEllipsis"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Signal" Foreground="{StaticResource LabelBrush}" Margin="0,0,12,2"/>
                    <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Orientation="Horizontal">
                      <TextBlock Text="{Binding WifiSignalBars}" Foreground="{StaticResource OkBrush}"
                                 FontFamily="{StaticResource MonoFontFamily}" Margin="0,0,8,0"/>
                      <TextBlock Text="{Binding WifiSignal}" Foreground="{StaticResource TextBrush}" FontFamily="{StaticResource MonoFontFamily}"/>
                    </StackPanel>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Radio" Foreground="{StaticResource LabelBrush}" Margin="0,0,12,0"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding WifiPhyType}"
                               Foreground="{StaticResource TextBrush}" FontFamily="{StaticResource MonoFontFamily}"/>
                    <TextBlock Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2" Foreground="{StaticResource TextBrush}"
                               FontFamily="{StaticResource MonoFontFamily}" Margin="0,0,0,0">
                      <Run Text="{Binding WifiBand, Mode=OneWay}"/>
                      <Run Text="{Binding WifiChannel, Mode=OneWay, StringFormat=(ch {0})}" Foreground="{StaticResource LabelBrush}"/>
                    </TextBlock>

                    <!-- Live signal-strength history, fixed 0-100% scale -->
                    <graphs:PerformanceGraphView Grid.Row="3" Grid.ColumnSpan="4" Height="56" Margin="0,8,0,0"
                                                 x:Name="SignalView" Loaded="OnSignalGraphLoaded"
                                                 Title="Signal" MinValue="0" MaxValue="100"
                                                 MaxValueFormat="{}{0:0}%" MaxTime="60"
                                                 MaxTimeFormat="{}{0}s" MinTime="0"/>
                  </Grid>
                </Border>

                <!-- Download over upload history graphs -->
                <Grid Grid.Row="4">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                  </Grid.RowDefinitions>
                  <graphs:PerformanceGraphView Grid.Row="0" Margin="0,0,0,6"
                                               x:Name="DownloadView" Loaded="OnDownloadGraphLoaded"
                                               Title="Download" MinValue="0"
                                               MaxValue="{Binding DownloadScaleMax}"
                                               MaxValueFormat="{}{0:0} KiB/s" MaxTime="60"
                                               MaxTimeFormat="{}{0}s" MinTime="0"/>
                  <graphs:PerformanceGraphView Grid.Row="1"
                                               x:Name="UploadView" Loaded="OnUploadGraphLoaded"
                                               Title="Upload" MinValue="0"
                                               MaxValue="{Binding UploadScaleMax}"
                                               MaxValueFormat="{}{0:0} KiB/s" MaxTime="60"
                                               MaxTimeFormat="{}{0}s" MinTime="0"/>
                </Grid>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <!-- Per-process network top talkers: which processes are using the network right now, ranked
         by current combined throughput. Backed by the shared ETW session. -->
    <Border Grid.Row="2" Margin="8,16,8,0" Padding="18,14" Background="{StaticResource SurfaceBackgroundBrush}" CornerRadius="8">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Top talkers" Foreground="{StaticResource AccentBrush}"
                   FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>

        <!-- Status line when the per-process backend isn't running (typically not elevated) -->
        <TextBlock Grid.Row="1" Text="{Binding TopTalkersStatusLabel}" Foreground="{StaticResource LabelBrush}"
                   FontFamily="{StaticResource MonoFontFamily}" TextWrapping="Wrap"
                   Visibility="{Binding HasTopTalkersStatus, Converter={StaticResource BoolToVisibility}}"/>

        <ListView Grid.Row="2" ItemsSource="{Binding TopTalkersView}" MaxHeight="240"
                  GridViewColumnHeader.Click="OnTopTalkersHeaderClick"
                  Style="{StaticResource TalkerListViewStyle}"
                  ItemContainerStyle="{StaticResource TalkerRowStyle}">
          <ListView.View>
            <GridView ColumnHeaderContainerStyle="{StaticResource TalkerHeaderStyle}">
              <GridViewColumn Header="Process" Width="300" local:GridViewSort.SortProperty="Name">
                <GridViewColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource ValueBrush}" FontFamily="{StaticResource MonoFontFamily}"
                               FontSize="{StaticResource BodyFontSize}" Margin="8,2" TextTrimming="CharacterEllipsis"/>
                  </DataTemplate>
                </GridViewColumn.CellTemplate>
              </GridViewColumn>
              <GridViewColumn Header="PID" Width="90" local:GridViewSort.SortProperty="ProcessId">
                <GridViewColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding ProcessId}" Foreground="{StaticResource LabelBrush}" FontFamily="{StaticResource MonoFontFamily}"
                               FontSize="{StaticResource BodyFontSize}" Margin="8,2" TextAlignment="Right"/>
                  </DataTemplate>
                </GridViewColumn.CellTemplate>
              </GridViewColumn>
              <GridViewColumn Header="Network" Width="120"
                              local:GridViewSort.SortProperty="RateBytesPerSecond">
                <GridViewColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding RateLabel}" Foreground="{StaticResource OkBrush}" FontFamily="{StaticResource MonoFontFamily}"
                               FontSize="{StaticResource BodyFontSize}" Margin="8,2" TextAlignment="Right"/>
                  </DataTemplate>
                </GridViewColumn.CellTemplate>
              </GridViewColumn>
            </GridView>
          </ListView.View>
        </ListView>
      </Grid>
    </Border>
  </Grid>
</UserControl>
