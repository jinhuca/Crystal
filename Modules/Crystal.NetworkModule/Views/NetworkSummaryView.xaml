<UserControl x:Class="Crystal.NetworkModule.Views.NetworkSummaryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:sv="clr-namespace:Crystal.NetworkModule.Views.SummaryViews"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d"
             d:DesignHeight="240" d:DesignWidth="380"
             Background="Transparent" Foreground="{StaticResource TextBrush}"
             FontFamily="{StaticResource UiFontFamily}">
	<!-- Layout only: the header and each tile live in Views/SummaryViews and inherit the root
       INetworkViewModel as DataContext. The throughput tile owns and self-registers the two
       sparklines. -->
	<Border Background="Transparent" MouseLeftButtonDown="OnTileClick">
		<Grid Margin="8" ShowGridLines="False">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="*"/>
			</Grid.RowDefinitions>
			<sv:NetworkHeaderView Grid.Row="0" Margin="0,0,0,0"/>
			<Grid Grid.Row="1" ShowGridLines="False">
				<Grid.RowDefinitions>
					<RowDefinition Height="*"/>
					<RowDefinition Height="48"/>
					<RowDefinition Height="42"/>
					<RowDefinition Height="22"/>
				</Grid.RowDefinitions>
				<sv:NetworkThroughputView Grid.Row="0" Grid.Column="0" VerticalAlignment="Top" HorizontalAlignment="Stretch"/>
				<!--<sv:NetworkTopTalkersView Grid.Row="1" Grid.Column="0" VerticalAlignment="Top" Margin="10,10,10,0"/>-->
				<sv:NetworkWifiView Grid.Row="1" Grid.RowSpan="2"
														Grid.Column="0" Grid.ColumnSpan="2" Margin="0,10,0,0"/>
			</Grid>
		</Grid>
	</Border>
</UserControl>
