<UserControl x:Class="Crystal.NetworkModule.Views.NetworkSummaryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:sv="clr-namespace:Crystal.NetworkModule.Views.SummaryViews"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d"
             d:DesignHeight="240" d:DesignWidth="380"
             Background="Transparent" Foreground="{StaticResource TextBrush}"
             FontFamily="{StaticResource UiFontFamily}">
	<!-- Layout only: the header and each tile live in Views/SummaryViews and inherit the root
       INetworkViewModel as DataContext. The throughput tile owns and self-registers the two
       sparklines. -->
	<Border Background="Transparent" MouseLeftButtonDown="OnTileClick">
		<Grid Margin="8" ShowGridLines="False">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="*"/>
			</Grid.RowDefinitions>
			<sv:NetworkHeaderView Grid.Row="0" Margin="0,0,0,0"/>
			<Grid Grid.Row="1" ShowGridLines="False">
				<Grid.ColumnDefinitions>
					<ColumnDefinition/>
					<ColumnDefinition/>
				</Grid.ColumnDefinitions>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
				</Grid.RowDefinitions>
				<sv:NetworkThroughputView Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" VerticalAlignment="Top"/>
				<sv:NetworkWifiView Grid.Row="1" Grid.Column="0" Margin="5,15,0,0"/>
				<sv:NetworkTopTalkersView Grid.Row="1" Grid.Column="1" VerticalAlignment="Top" Margin="10,15,10,0"/>
			</Grid>
		</Grid>
	</Border>
</UserControl>
