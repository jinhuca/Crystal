<UserControl x:Class="Crystal.NetworkModule.Views.SummaryViews.NetworkWifiView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="120" d:DesignWidth="260"
             Foreground="{StaticResource TextBrush}" FontFamily="{StaticResource UiFontFamily}">
  <!-- DataContext is the root INetworkViewModel, inherited from the host tile. A TaskManager-style
       detail block names the primary connection (adapter, SSID, DNS, type, addresses, signal); the
       Wi-Fi-only rows collapse for a wired primary. When nothing is connected the block stands down
       and a muted radio-state row takes its place. -->
  <UserControl.Resources>
    <Style x:Key="ConnLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource LabelBrush}"/>
      <Setter Property="FontSize" Value="{StaticResource CaptionFontSize}"/>
      <Setter Property="Width" Value="112"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="ConnValue" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource ValueBrush}"/>
			<Setter Property="FontSize" Value="{StaticResource BodyFontSize}"/>
      <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
  </UserControl.Resources>
  <StackPanel>
    <!-- Connection detail block for the primary interface. -->
    <StackPanel Visibility="{Binding HasConnection, Converter={StaticResource BoolToVisibility}}">
      <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
				<TextBlock Text="Adapter name:" Style="{StaticResource SummaryTileTitleTextBlockStyle}" Width="120"/>
        <TextBlock Text="{Binding ConnectionAdapterName}" Style="{StaticResource ConnValue}"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" Margin="0,0,0,2"
                  Visibility="{Binding HasWifi, Converter={StaticResource BoolToVisibility}}">
				<TextBlock Text="SSID:" Style="{StaticResource SummaryTileTitleTextBlockStyle}" Width="120"/>
        <TextBlock Text="{Binding ConnectionSsid}" Style="{StaticResource ConnValue}"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
				<TextBlock Text="DNS name:" Style="{StaticResource SummaryTileTitleTextBlockStyle}" Width="120"/>
        <TextBlock Text="{Binding ConnectionDnsName}" Style="{StaticResource ConnValue}"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" Margin="0,0,0,2"
                  >
				<TextBlock Text="Connection type:" Style="{StaticResource SummaryTileTitleTextBlockStyle}" Width="120"/>
        <TextBlock Text="{Binding ConnectionType}" Style="{StaticResource ConnValue}"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
				<TextBlock Text="IPv4 address:" Style="{StaticResource SummaryTileTitleTextBlockStyle}" Width="120"/>
        <TextBlock Text="{Binding ConnectionIPv4}" Style="{StaticResource ConnValue}"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
				<TextBlock Text="IPv6 address:" Style="{StaticResource SummaryTileTitleTextBlockStyle}" Width="120"/>
        <TextBlock Text="{Binding ConnectionIPv6}" Style="{StaticResource ConnValue}"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal"
                  Visibility="{Binding HasWifi, Converter={StaticResource BoolToVisibility}}">
				<TextBlock Text="Signal strength:" Style="{StaticResource SummaryTileTitleTextBlockStyle}" Width="120"/>
        <TextBlock Text="{Binding SignalBars}" Style="{StaticResource ConnValue}"
                   Foreground="{StaticResource AccentBrush}"/>
      </StackPanel>
    </StackPanel>

    <!-- No connection to detail: muted machine-level Wi-Fi radio state. -->
    <StackPanel Orientation="Horizontal"
                Visibility="{Binding HasWifiStatus, Converter={StaticResource BoolToVisibility}}">
      <TextBlock Text="&#x1F4F6;" Foreground="#5A6470" FontSize="{StaticResource SubHeadingFontSize}"
                 VerticalAlignment="Center" Margin="0,0,8,0"/>
      <TextBlock Text="{Binding WifiStatusLabel}" Foreground="{StaticResource LabelBrush}" FontSize="{StaticResource SpecFontSize}"
                 FontFamily="{StaticResource UiFontFamily}" VerticalAlignment="Center"/>
    </StackPanel>
  </StackPanel>
</UserControl>
