<UserControl x:Class="Crystal.MemoryModule.Views.MemorySummaryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:sv="clr-namespace:Crystal.MemoryModule.Views.SummaryViews"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d"
             d:DesignHeight="240" d:DesignWidth="380"
             Background="Transparent" Foreground="{StaticResource TextBrush}"
             FontFamily="{StaticResource UiFontFamily}">
  <!-- Layout only: the header and each metric tile live in Views/SummaryViews and inherit the root
       IMemoryViewModel DataContext. The used/commit graphs on the detail view are wired separately. -->
  <Border Background="Transparent" MouseLeftButtonDown="OnTileClick">
    <Grid Margin="10">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <sv:MemoryHeaderView Grid.Row="0"/>

      <!-- Utilization (top) + Used (bottom) stacked graphs, each with a big value / unit / caption. -->
      <Grid Grid.Row="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="*"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <sv:MemoryUtilizationView Grid.Row="0" Margin="0,0,0,6"/>
        <sv:MemoryUsedView Grid.Row="1"/>
      </Grid>
    </Grid>
  </Border>
</UserControl>
