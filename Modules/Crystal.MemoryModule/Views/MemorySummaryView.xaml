<UserControl x:Class="Crystal.MemoryModule.Views.MemorySummaryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:graphs="clr-namespace:Crystal.Controls.PerformanceGraphs;assembly=Crystal.Controls"
             xmlns:sv="clr-namespace:Crystal.MemoryModule.Views.SummaryViews"
             xmlns:conv="clr-namespace:Crystal.MemoryModule.Converters"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d"
             d:DesignHeight="360" d:DesignWidth="1100"
             Background="Transparent" Foreground="{StaticResource TextBrush}"
             FontFamily="{StaticResource UiFontFamily}">
  <UserControl.Resources>
    <ResourceDictionary>
    <ResourceDictionary.MergedDictionaries>
      <ResourceDictionary Source="/Crystal.Controls;component/Metrics/MetricEnrichmentResources.xaml"/>
      <ResourceDictionary Source="/Crystal.Resources;component/Styles/BorderStyles.xaml"/>
    </ResourceDictionary.MergedDictionaries>
    <conv:FractionToStarConverter x:Key="FractionToStar"/>

    <!-- Fonts mirror the CPU/GPU tiles: captions use MetricCaption (Consolas 11), values use
         MetricValue (Consolas 18). All local styles derive from those two so the tile reads as a
         sibling of the other summary tiles, not a differently-fonted clone. -->
    <Style x:Key="TileStatCaption" TargetType="TextBlock" BasedOn="{StaticResource MetricCaption}">
      <Setter Property="Margin" Value="0,0,0,1"/>
    </Style>
    <!-- Value font matches the CPU/GPU tiles (Consolas, light); sized down a touch from the shared
         18px so the two-column kernel readout stays narrow enough that the left column keeps room for
         the composition legend and the full slot list. -->
    <Style x:Key="TileStatValue" TargetType="TextBlock" BasedOn="{StaticResource MetricValue}">
      <Setter Property="FontWeight" Value="Light"/>
      <Setter Property="FontSize" Value="16"/>
    </Style>
    <!-- Section headings ("Memory usage", "Commit charge", …): caption font, brighter value brush. -->
    <Style x:Key="TileSectionLabel" TargetType="TextBlock" BasedOn="{StaticResource MetricCaption}">
      <Setter Property="Foreground" Value="{StaticResource SpecValueBrush}"/>
    </Style>
    <!-- Legend/inline caption in the caption font. -->
    <Style x:Key="TileLegendCaption" TargetType="TextBlock" BasedOn="{StaticResource MetricCaption}">
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="TileLegendValue" TargetType="TextBlock" BasedOn="{StaticResource MetricCaption}">
      <Setter Property="Foreground" Value="{StaticResource SpecValueBrush}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <!-- Spec pairs: caption font for both halves (value brighter), kept at caption size for density. -->
    <Style x:Key="TileSpecCaption" TargetType="TextBlock" BasedOn="{StaticResource MetricCaption}">
      <Setter Property="Margin" Value="0"/>
    </Style>
    <Style x:Key="TileSpecValue" TargetType="TextBlock" BasedOn="{StaticResource MetricCaption}">
      <Setter Property="Foreground" Value="{StaticResource SpecValueBrush}"/>
      <Setter Property="Margin" Value="10,0,0,0"/>
    </Style>
    </ResourceDictionary>
  </UserControl.Resources>
  <Border Background="Transparent" Cursor="Hand" MouseLeftButtonDown="OnTileClick">
  <Grid Margin="8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <sv:MemoryHeaderView Grid.Row="0" Margin="0,0,0,0"/>
    <Grid Grid.Row="1" ShowGridLines="False">
      <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- Two graph cards (Memory Usage / Commit charge), each mirroring the CPU/GPU summary card:
           blue section title + session min/avg/max on the top line, the live value with its trend
           glyph, and a self-registering history sparkline filling the rest. -->
      <Grid Grid.Row="0" MinHeight="120">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource SummaryTileBorderStyle}" Margin="2,2,4,2">
          <Grid Margin="10,4,10,6">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
              <TextBlock Text="Memory Usage" Style="{StaticResource SummaryTileTitleTextBlockStyle}"
                         HorizontalAlignment="Left" VerticalAlignment="Center"/>
              <TextBlock Style="{StaticResource MetricStatLine}" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Run FontFamily="Segoe Fluent Icons" Text="&#xE70D; " Foreground="LightGreen"/>
                <Run Text="{Binding UsageRow.Min, StringFormat={}{0:0.#}}"/>
                <Run FontFamily="Segoe Fluent Icons" Text=" &#xE738; " Foreground="{StaticResource AccentBrush}"/>
                <Run Text="{Binding UsageRow.Avg, StringFormat={}{0:0.#}}"/>
                <Run FontFamily="Segoe Fluent Icons" Text=" &#xE70E; " Foreground="Crimson"/>
                <Run Text="{Binding UsageRow.Max, StringFormat={}{0:0.#}}"/>
              </TextBlock>
            </Grid>
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,2,0,4">
              <TextBlock Text="{Binding UsageLabel}" Style="{StaticResource TileMetricValue}"/>
              <TextBlock Text="{Binding UsageRow.Trend, Converter={StaticResource TrendToGlyph}}"
                         Foreground="{Binding UsageRow.Trend, Converter={StaticResource TrendToBrush}}"
                         Style="{StaticResource MetricUnit}" Margin="4,0,0,0"/>
            </StackPanel>
            <graphs:AdaptiveGraph Grid.Row="2" x:Name="MemoryUsageGraph"
                Capacity="180" MinValue="0" MaxValue="100"
                Accent="{StaticResource GraphAccentUtilization}"
                BandedLine="True" ShowChrome="True" MinHeight="40"
                CellPitch="{StaticResource DashboardDotPitch}"/>
          </Grid>
        </Border>

        <Border Grid.Column="1" Style="{StaticResource SummaryTileBorderStyle}" Margin="4,2,2,2">
          <Grid Margin="10,4,10,6">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
              <TextBlock Text="Commit charge" Style="{StaticResource SummaryTileTitleTextBlockStyle}"
                         HorizontalAlignment="Left" VerticalAlignment="Center"/>
              <TextBlock Style="{StaticResource MetricStatLine}" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Run FontFamily="Segoe Fluent Icons" Text="&#xE70D; " Foreground="LightGreen"/>
                <Run Text="{Binding CommitRow.Min, StringFormat={}{0:0.#}}"/>
                <Run FontFamily="Segoe Fluent Icons" Text=" &#xE738; " Foreground="{StaticResource AccentBrush}"/>
                <Run Text="{Binding CommitRow.Avg, StringFormat={}{0:0.#}}"/>
                <Run FontFamily="Segoe Fluent Icons" Text=" &#xE70E; " Foreground="Crimson"/>
                <Run Text="{Binding CommitRow.Max, StringFormat={}{0:0.#}}"/>
              </TextBlock>
            </Grid>
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,2,0,4">
              <TextBlock Text="{Binding CommitUsageLabel}" Style="{StaticResource TileMetricValue}"/>
              <TextBlock Text="{Binding CommitRow.Trend, Converter={StaticResource TrendToGlyph}}"
                         Foreground="{Binding CommitRow.Trend, Converter={StaticResource TrendToBrush}}"
                         Style="{StaticResource MetricUnit}" Margin="4,0,0,0"/>
            </StackPanel>
            <graphs:AdaptiveGraph Grid.Row="2" x:Name="CommitChargeGraph"
                Capacity="180" MinValue="0"
                MaxValue="{Binding CommitLimitGB, FallbackValue=64, TargetNullValue=64}"
                Accent="{StaticResource GraphAccentUtilization}"
                BandedLine="True" ShowChrome="True" MinHeight="40"
                CellPitch="{StaticResource DashboardDotPitch}"/>
          </Grid>
        </Border>
      </Grid>

      <!-- Kernel/pool stats moved below the cards: two 4-column caption-over-value groups, one under
           each card (physical-memory figures under Usage, commit/pool figures under Commit charge). -->
      <Grid Grid.Row="1" Margin="2,8,2,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="8,0,4,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Grid.Column="0" Text="In use (Compressed)" Style="{StaticResource TileStatCaption}"/>
          <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding InUseLabel}" Style="{StaticResource TileStatValue}"/>
          <TextBlock Grid.Row="0" Grid.Column="1" Text="Committed" Style="{StaticResource TileStatCaption}"/>
          <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CommittedLabel}" Style="{StaticResource TileStatValue}"/>
          <TextBlock Grid.Row="0" Grid.Column="2" Text="Available" Style="{StaticResource TileStatCaption}"/>
          <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding AvailableLabel}" Style="{StaticResource TileStatValue}"/>
          <TextBlock Grid.Row="0" Grid.Column="3" Text="Cached" Style="{StaticResource TileStatCaption}"/>
          <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding CachedLabel}" Style="{StaticResource TileStatValue}"/>
        </Grid>

        <Grid Grid.Column="1" Margin="8,0,4,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Grid.Column="0" Text="Commit peak" Style="{StaticResource TileStatCaption}"/>
          <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding CommitPeakLabel}" Style="{StaticResource TileStatValue}"/>
          <TextBlock Grid.Row="0" Grid.Column="1" Text="Paged pool" Style="{StaticResource TileStatCaption}"/>
          <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PagedPoolLabel}" Style="{StaticResource TileStatValue}"/>
          <TextBlock Grid.Row="0" Grid.Column="2" Text="Non-paged pool" Style="{StaticResource TileStatCaption}"/>
          <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding NonPagedPoolLabel}" Style="{StaticResource TileStatValue}"/>
          <TextBlock Grid.Row="0" Grid.Column="3" Text="Pagefile (used/size)" Style="{StaticResource TileStatCaption}"/>
          <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding PageFileLabel}" Style="{StaticResource TileStatValue}"/>
        </Grid>
      </Grid>

      <!-- Memory composition title + the segment legend on one line: title left, legend right. -->
      <Grid Grid.Row="2" Margin="2,0,0,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="24"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,4">
          <TextBlock Text="Memory composition" 
                     Style="{StaticResource TileSectionLabel}"
                     HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
            <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
              <Rectangle Width="9" Height="9" Fill="{StaticResource UsageBarUsedBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
              <TextBlock Text="In use" Style="{StaticResource TileLegendCaption}"/>
              <TextBlock Text="{Binding CompositionInUseLabel}" Style="{StaticResource TileLegendValue}" Margin="4,0,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
              <Rectangle Width="9" Height="9" Fill="#C7902F" VerticalAlignment="Center" Margin="0,0,4,0"/>
              <TextBlock Text="Modified" Style="{StaticResource TileLegendCaption}"/>
              <TextBlock Text="{Binding CompositionModifiedLabel}" Style="{StaticResource TileLegendValue}" Margin="4,0,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
              <Rectangle Width="9" Height="9" Fill="#3F8E6E" VerticalAlignment="Center" Margin="0,0,4,0"/>
              <TextBlock Text="Standby" Style="{StaticResource TileLegendCaption}"/>
              <TextBlock Text="{Binding CompositionStandbyLabel}" Style="{StaticResource TileLegendValue}" Margin="4,0,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
              <Rectangle Width="9" Height="9" Fill="{StaticResource UsageBarFreeBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
              <TextBlock Text="Free" Style="{StaticResource TileLegendCaption}"/>
              <TextBlock Text="{Binding CompositionFreeLabel}" Style="{StaticResource TileLegendValue}" Margin="4,0,0,0"/>
            </StackPanel>
          </StackPanel>
        </Grid>
        <Border Grid.Row="1" Margin="0,0,0,0" BorderThickness="1" Height="18"
                BorderBrush="{StaticResource UsageBarBorderBrush}" 
                Background="{StaticResource UsageBarTrackBrush}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="{Binding CompositionInUseFraction, Converter={StaticResource FractionToStar}}"/>
              <ColumnDefinition Width="{Binding CompositionModifiedFraction, Converter={StaticResource FractionToStar}}"/>
              <ColumnDefinition Width="{Binding CompositionStandbyFraction, Converter={StaticResource FractionToStar}}"/>
              <ColumnDefinition Width="{Binding CompositionFreeFraction, Converter={StaticResource FractionToStar}}"/>
              <ColumnDefinition Width="{Binding CompositionRemainderFraction, Converter={StaticResource FractionToStar}}"/>
            </Grid.ColumnDefinitions>
            <Rectangle Grid.Column="0" Fill="{StaticResource UsageBarUsedBrush}" ToolTip="{Binding CompositionInUseLabel}"/>
            <Rectangle Grid.Column="1" Fill="#C7902F" ToolTip="{Binding CompositionModifiedLabel}"/>
            <Rectangle Grid.Column="2" Fill="#3F8E6E" ToolTip="{Binding CompositionStandbyLabel}"/>
            <Rectangle Grid.Column="3" Fill="{StaticResource UsageBarFreeBrush}" ToolTip="{Binding CompositionFreeLabel}"/>
          </Grid>
        </Border>
      </Grid>

      <!-- Hardware spec pairs -->
      <Grid Grid.Row="3" VerticalAlignment="Center" Margin="2,8,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Orientation="Horizontal">
          <TextBlock Text="Speed:" Style="{StaticResource TileSpecCaption}"/>
          <TextBlock Text="{Binding SpeedLabel}" Style="{StaticResource TileSpecValue}"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <TextBlock Text="Slots used:" Style="{StaticResource TileSpecCaption}"/>
          <TextBlock Text="{Binding SlotsUsedLabel}" Style="{StaticResource TileSpecValue}"/>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal">
          <TextBlock Text="Form factor:" Style="{StaticResource TileSpecCaption}"/>
          <TextBlock Text="{Binding FormFactorLabel}" Style="{StaticResource TileSpecValue}"/>
        </StackPanel>
        <StackPanel Grid.Column="3" Orientation="Horizontal">
          <TextBlock Grid.Row="0" Grid.Column="6" Text="Hardware reserved:" Style="{StaticResource TileSpecCaption}"/>
          <TextBlock Grid.Row="0" Grid.Column="7" Text="{Binding HardwareReservedLabel}" Style="{StaticResource TileSpecValue}"/>
        </StackPanel>
        <StackPanel Grid.Column="4" Orientation="Horizontal">
          <TextBlock Text="Pagefile peak:" Style="{StaticResource TileSpecCaption}"/>
          <TextBlock Text="{Binding PageFilePeakLabel}" Style="{StaticResource TileSpecValue}"/>
        </StackPanel>
      </Grid>
    </Grid>
  </Grid>
  </Border>
</UserControl>
