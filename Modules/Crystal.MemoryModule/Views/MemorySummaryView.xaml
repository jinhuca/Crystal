<UserControl x:Class="Crystal.MemoryModule.Views.MemorySummaryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:graphs="clr-namespace:Crystal.Controls.PerformanceGraphs;assembly=Crystal.Controls"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d"
             d:DesignHeight="240" d:DesignWidth="380"
             Background="Transparent" Foreground="{StaticResource TextBrush}"
             FontFamily="{StaticResource UiFontFamily}">
  <UserControl.Resources>
    <!-- MetricValue, MetricUnit, MetricCaption, HeaderSpec now provided app-wide via Crystal.Resources (TextStyles.xaml). -->
  </UserControl.Resources>

  <Border Background="Transparent" MouseLeftButtonDown="OnTileClick">
    <Grid Margin="10">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- Dense header bar: accent tick + title + inline roll-up (total · populated · max speed),
           thin divider rule below. The per-slot inventory lives in the detail view. -->
      <Border Grid.Row="0" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1"
              Padding="0,0,0,4" Margin="0,0,0,2">
        <StackPanel Orientation="Horizontal">
          <Border Width="3" Background="{StaticResource AccentBrush}" Margin="0,1,8,1"/>
          <TextBlock Text="MEMORY" Foreground="{StaticResource ValueBrush}" FontSize="{StaticResource BodyFontSize}" FontWeight="SemiBold"
                     VerticalAlignment="Center" Margin="0,0,16,0"/>
          <TextBlock Style="{StaticResource HeaderSpec}">
            <Run Text="{Binding TotalCapacityLabel, Mode=OneWay}" Foreground="{StaticResource ValueBrush}"/><Run Text=" total"/>
          </TextBlock>
          <TextBlock Text="{Binding SlotsLabel}" Style="{StaticResource HeaderSpec}"/>
          <TextBlock Text="{Binding MaxSpeedLabel}" Style="{StaticResource HeaderSpec}"/>
        </StackPanel>
      </Border>

      <!-- Utilization (top) + Used (bottom) stacked graphs, each with a big value / unit / caption
           readout to the right — matching the GPU tile layout. -->
      <Grid Grid.Row="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="*"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,6">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <graphs:PerformanceGraph Grid.Column="0"
                                   Loaded="OnLoadGraphLoaded"
                                   Kind="Line"
                                   MinValue="0" MaxValue="100"/>
          <StackPanel Grid.Column="1" Style="{StaticResource SummaryStackPanelStyle}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{Binding Load, StringFormat={}{0:0.00}}" Style="{StaticResource MetricValue}"/>
              <TextBlock Text="%" Style="{StaticResource MetricUnit}"/>
            </StackPanel>
            <TextBlock Text="Utilization" Style="{StaticResource MetricCaption}"/>
          </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <graphs:PerformanceGraph Grid.Column="0"
                                   Loaded="OnUsedGraphLoaded"
                                   Kind="Line"
                                   MinValue="0"
                                   MaxValue="{Binding TotalCapacityGB, TargetNullValue=64}"/>
          <StackPanel Grid.Column="1" Style="{StaticResource SummaryStackPanelStyle}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{Binding UsedGB, StringFormat={}{0:0.0}, TargetNullValue=—}" Style="{StaticResource MetricValue}"/>
              <TextBlock Text="GB" Style="{StaticResource MetricUnit}"/>
            </StackPanel>
            <TextBlock Text="Used" Style="{StaticResource MetricCaption}"/>
          </StackPanel>
        </Grid>
      </Grid>
    </Grid>
  </Border>
</UserControl>
