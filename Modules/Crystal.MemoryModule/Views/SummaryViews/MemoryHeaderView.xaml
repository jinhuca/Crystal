<UserControl x:Class="Crystal.MemoryModule.Views.SummaryViews.MemoryHeaderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="24" d:DesignWidth="380"
             Foreground="{StaticResource TextBrush}" FontFamily="{StaticResource UiFontFamily}">
  <!-- DataContext is the root IMemoryViewModel, inherited from the host tile.
       Dense header bar: accent tick + title + inline roll-up (total · populated · max speed),
       thin divider rule below. The per-slot inventory lives in the detail view. -->
  <Border BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1"
          Padding="0,0,0,4" Margin="0,0,0,2">
    <StackPanel Orientation="Horizontal">
      <Border Width="3" Background="{StaticResource AccentBrush}" Margin="0,1,8,1"/>
      <TextBlock Text="MEMORY" Foreground="{StaticResource ValueBrush}" FontSize="{StaticResource BodyFontSize}" FontWeight="SemiBold"
                 VerticalAlignment="Center" Margin="0,0,16,0"/>
      <TextBlock Style="{StaticResource HeaderSpec}">
        <Run Text="{Binding TotalCapacityLabel, Mode=OneWay}" Foreground="{StaticResource ValueBrush}"/><Run Text=" total"/>
      </TextBlock>
      <TextBlock Text="{Binding SlotsLabel}" Style="{StaticResource HeaderSpec}"/>
      <TextBlock Text="{Binding MaxSpeedLabel}" Style="{StaticResource HeaderSpec}"/>
    </StackPanel>
  </Border>
</UserControl>
