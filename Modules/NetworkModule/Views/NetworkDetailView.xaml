<UserControl x:Class="NetworkModule.Views.NetworkDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:graphs="clr-namespace:Crystal.Controls.PerformanceGraphs.Controls;assembly=Crystal.Controls"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="1100"
             Background="#101317" Foreground="White"
             FontFamily="Segoe UI">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
  </UserControl.Resources>
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- Header + Back control -->
    <Grid Grid.Row="0" Margin="0,0,0,16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Button Grid.Column="0" Content="&#x2190; Back" Padding="14,6"
              Background="#1E2A38" Foreground="White" BorderThickness="0"
              Command="{Binding ShowDashboardCommand}"/>
      <TextBlock Grid.Column="1" Text="Network" Foreground="#3E9BE8" FontSize="28"
                 FontWeight="SemiBold" VerticalAlignment="Center" Margin="16,0,0,0"/>
    </Grid>

    <!-- One panel per connected interface, wrapping across the available width -->
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <ItemsControl ItemsSource="{Binding Adapters}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel Orientation="Horizontal"/>
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Margin="8" Padding="18" Background="#161B22" CornerRadius="8"
                    Width="500" Height="440">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="{Binding Name}" Foreground="#3E9BE8"
                           FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>

                <!-- Current throughput readout -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,12">
                  <StackPanel Orientation="Horizontal" Margin="0,0,24,0">
                    <TextBlock Text="&#x25BC; " Foreground="#3BD15A"/>
                    <TextBlock Text="{Binding DownloadLabel}" Foreground="White" FontFamily="Consolas"/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#x25B2; " Foreground="#E89B2A"/>
                    <TextBlock Text="{Binding UploadLabel}" Foreground="White" FontFamily="Consolas"/>
                  </StackPanel>
                </StackPanel>

                <!-- Wi-Fi radio detail (only for an associated wireless adapter) -->
                <Border Grid.Row="2" Margin="0,0,0,12" Padding="10,8" Background="#11161D"
                        CornerRadius="4" Visibility="{Binding IsWifi, Converter={StaticResource BoolToVisibility}}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="SSID" Foreground="#8A94A0" Margin="0,0,12,2"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding WifiSsid}"
                               Foreground="White" FontFamily="Consolas" TextTrimming="CharacterEllipsis"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Signal" Foreground="#8A94A0" Margin="0,0,12,2"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding WifiSignal}"
                               Foreground="White" FontFamily="Consolas"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Radio" Foreground="#8A94A0" Margin="0,0,12,0"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding WifiPhyType}"
                               Foreground="White" FontFamily="Consolas"/>
                    <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding WifiBand}"
                               Foreground="White" FontFamily="Consolas" Margin="0,0,12,0"/>
                    <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding WifiChannel, StringFormat=ch {0}}"
                               Foreground="#8A94A0" FontFamily="Consolas"/>

                    <!-- Live signal-strength history, fixed 0-100% scale -->
                    <graphs:PerformanceGraphView Grid.Row="3" Grid.ColumnSpan="4" Height="56" Margin="0,8,0,0"
                                                 x:Name="SignalView" Loaded="OnSignalGraphLoaded"
                                                 Title="Signal" MinValue="0" MaxValue="100"
                                                 MaxValueFormat="{}{0:0}%" MaxTime="60"
                                                 MaxTimeFormat="{}{0}s" MinTime="0"/>
                  </Grid>
                </Border>

                <!-- Download over upload history graphs -->
                <Grid Grid.Row="3">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                  </Grid.RowDefinitions>
                  <graphs:PerformanceGraphView Grid.Row="0" Margin="0,0,0,6"
                                               x:Name="DownloadView" Loaded="OnDownloadGraphLoaded"
                                               Title="Download" MinValue="0"
                                               MaxValue="{Binding DownloadScaleMax}"
                                               MaxValueFormat="{}{0:0} KiB/s" MaxTime="60"
                                               MaxTimeFormat="{}{0}s" MinTime="0"/>
                  <graphs:PerformanceGraphView Grid.Row="1"
                                               x:Name="UploadView" Loaded="OnUploadGraphLoaded"
                                               Title="Upload" MinValue="0"
                                               MaxValue="{Binding UploadScaleMax}"
                                               MaxValueFormat="{}{0:0} KiB/s" MaxTime="60"
                                               MaxTimeFormat="{}{0}s" MinTime="0"/>
                </Grid>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </Grid>
</UserControl>
