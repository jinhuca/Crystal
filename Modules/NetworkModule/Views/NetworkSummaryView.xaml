<UserControl x:Class="NetworkModule.Views.NetworkSummaryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:graphs="clr-namespace:Crystal.Controls.PerformanceGraphs.Controls;assembly=Crystal.Controls"
             xmlns:gauges="clr-namespace:Crystal.Controls.MeterGauges.Controls;assembly=Crystal.Controls"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d"
             d:DesignHeight="240" d:DesignWidth="380"
             Background="Transparent" Foreground="White"
             FontFamily="Segoe UI"
             ToolTip="Double-click to open the Network detail view">
  <Border Background="Transparent" MouseLeftButtonDown="OnTileClick">
    <Grid Margin="14">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <TextBlock Grid.Row="0" Text="Network" Foreground="#3E9BE8" FontSize="20"
                 FontWeight="SemiBold" Margin="0,0,0,8"/>

      <!-- Interface count -->
      <TextBlock Grid.Row="1" Foreground="#8A94A0" FontSize="12" Margin="0,0,0,8">
        <Run Text="{Binding Adapters.Count, Mode=OneWay}"/>
        <Run Text="active interface(s)"/>
      </TextBlock>

      <!-- Live utilization: gauge + load-percentage graph -->
      <Grid Grid.Row="2">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="110"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <gauges:MeterGaugeView Grid.Column="0" Title="Utilization" Unit="%"
                               MinValue="0" MaxValue="100" ValueFormat="{}{0:0}"
                               Value="{Binding Load}"/>
        <graphs:PerformanceGraphView x:Name="UtilizationView" Grid.Column="1" Margin="8,0"
                                     Loaded="OnGraphLoaded"
                                     Title="Utilization Percentage" MinValue="0" MaxValue="100"
                                     MaxValueFormat="{}{0}%" MaxTime="60"
                                     MaxTimeFormat="{}{0}s" MinTime="0"/>
      </Grid>
    </Grid>
  </Border>
</UserControl>
