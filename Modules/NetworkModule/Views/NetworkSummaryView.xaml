<UserControl x:Class="NetworkModule.Views.NetworkSummaryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d"
             d:DesignHeight="240" d:DesignWidth="380"
             Background="Transparent" Foreground="White"
             FontFamily="Segoe UI">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
  </UserControl.Resources>
  <Border Background="Transparent" MouseLeftButtonDown="OnTileClick">
    <Grid Margin="10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- Dense header bar: accent tick + title, thin divider rule below -->
      <Border Grid.Row="0" Grid.ColumnSpan="2" BorderBrush="#2A2A2A" BorderThickness="0,0,0,1"
              Padding="0,0,0,4" Margin="0,0,0,6">
        <StackPanel Orientation="Horizontal">
          <Border Width="3" Background="#3E9BE8" Margin="0,1,8,1"/>
          <TextBlock Text="NETWORK" Foreground="#E6E6E6" FontSize="12" FontWeight="SemiBold"
                     VerticalAlignment="Center"/>
        </StackPanel>
      </Border>

      <!-- Interface count -->
      <TextBlock Grid.Row="1" Grid.Column="0" Foreground="#8A94A0" FontSize="11" FontFamily="Consolas"
                 Margin="0,0,0,8">
        <Run Text="{Binding Adapters.Count, Mode=OneWay}"/>
        <Run Text="active interface(s)"/>
      </TextBlock>

      <!-- Live throughput: download over upload -->
      <StackPanel Grid.Row="2" Grid.Column="0" VerticalAlignment="Top">
        <TextBlock Text="download" Foreground="#8A94A0" FontSize="12" FontFamily="Consolas"
                   Margin="0,0,0,2"/>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
          <TextBlock Text="&#x25BC;" Foreground="#3BD15A" FontSize="16"
                     VerticalAlignment="Center" Margin="0,0,8,0"/>
          <TextBlock Text="{Binding DownloadLabel}" Foreground="#E6E6E6" FontSize="18"
                     FontFamily="Consolas" VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
          <TextBlock Text="&#x25B2;" Foreground="#E89B2A" FontSize="16"
                     VerticalAlignment="Center" Margin="0,0,8,0"/>
          <TextBlock Text="{Binding UploadLabel}" Foreground="#E6E6E6" FontSize="18"
                     FontFamily="Consolas" VerticalAlignment="Center"/>
        </StackPanel>
        <TextBlock Text="upload" Foreground="#8A94A0" FontSize="12" FontFamily="Consolas"/>

        <!-- Wi-Fi block (only when a wireless adapter is connected): SSID + signal, then the
             negotiated link rate, security suite, and BSSID as dim spec rows. -->
        <StackPanel Margin="0,10,0,0"
                    Visibility="{Binding HasWifi, Converter={StaticResource BoolToVisibility}}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#x1F4F6;" Foreground="#3E9BE8" FontSize="14"
                       VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBlock Text="{Binding WifiLabel}" Foreground="#E6E6E6" FontSize="13"
                       FontFamily="Consolas" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"/>
          </StackPanel>
          <TextBlock Text="{Binding WifiLinkRate, StringFormat=Link: {0}}" Foreground="#8A94A0"
                     FontSize="11" FontFamily="Consolas" Margin="22,3,0,0"/>
          <TextBlock Text="{Binding WifiSecurity, StringFormat=Security: {0}}" Foreground="#8A94A0"
                     FontSize="11" FontFamily="Consolas" Margin="22,1,0,0"
                     TextTrimming="CharacterEllipsis"/>
          <TextBlock Text="{Binding WifiBssid, StringFormat=BSSID: {0}}" Foreground="#8A94A0"
                     FontSize="11" FontFamily="Consolas" Margin="22,1,0,0"
                     TextTrimming="CharacterEllipsis"/>
        </StackPanel>

        <!-- Present-but-not-connected radio: muted status in place of the connected block. Hidden
             entirely on machines with no wireless adapter. -->
        <StackPanel Orientation="Horizontal" Margin="0,10,0,0"
                    Visibility="{Binding HasWifiStatus, Converter={StaticResource BoolToVisibility}}">
          <TextBlock Text="&#x1F4F6;" Foreground="#5A6470" FontSize="14"
                     VerticalAlignment="Center" Margin="0,0,8,0"/>
          <TextBlock Text="{Binding WifiStatusLabel}" Foreground="#8A94A0" FontSize="13"
                     FontFamily="Consolas" VerticalAlignment="Center"/>
        </StackPanel>
      </StackPanel>

      <!-- Top talkers: the busiest processes on the network right now (rate descending, capped).
           Backed by the shared ETW session; blank with a muted note when it isn't running. -->
      <StackPanel Grid.Row="2" Grid.Column="1" Margin="20,0,0,0"
                  Width="200" VerticalAlignment="Top">
        <TextBlock Text="top talkers" Foreground="#8A94A0" FontSize="11" FontFamily="Consolas"
                   Margin="0,0,0,4"/>
        <TextBlock Text="{Binding TopTalkersStatusLabel}" Foreground="#5A6470" FontSize="10"
                   FontFamily="Consolas" TextWrapping="Wrap"
                   Visibility="{Binding HasTopTalkersStatus, Converter={StaticResource BoolToVisibility}}"/>
        <ItemsControl ItemsSource="{Binding SummaryTopTalkers}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid Margin="0,1">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="#E6E6E6" FontSize="11"
                           FontFamily="Consolas" TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>
                <TextBlock Grid.Column="1" Text="{Binding RateLabel}" Foreground="#3BD15A" FontSize="11"
                           FontFamily="Consolas" TextAlignment="Right"/>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
