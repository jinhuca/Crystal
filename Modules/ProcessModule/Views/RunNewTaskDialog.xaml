<Window x:Class="ProcessModule.Views.RunNewTaskDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Run new task"
        Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False"
        Background="#0D0D0D" Foreground="#DDDDDD"
        FontFamily="Segoe UI" WindowStyle="ToolWindow">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" Foreground="#B0B0B0" FontSize="12"
               TextWrapping="Wrap" Margin="0,0,0,10"
               Text="Type the name of a program, folder, document, or the path to a resource, and Crystal will open it for you."/>

    <TextBox x:Name="CommandBox" Grid.Row="1"
             Background="#0A0A0A" Foreground="#DDDDDD" CaretBrush="#DDDDDD"
             BorderBrush="#3A3A3A" BorderThickness="1" Padding="6,4"
             FontFamily="Consolas" FontSize="12"
             KeyDown="OnCommandKeyDown"/>

    <CheckBox x:Name="AdminCheck" Grid.Row="2" Margin="0,12,0,0"
              Foreground="#B0B0B0" FontSize="12"
              Content="Run with administrator privileges"/>

    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right"
                Margin="0,16,0,0">
      <Button Content="Run" Width="80" Height="26" Margin="0,0,8,0"
              Foreground="#DDDDDD" Background="#1C3A52" BorderBrush="#3E9BE8"
              FontSize="12" IsDefault="True" Click="OnRun"/>
      <Button Content="Cancel" Width="80" Height="26"
              Foreground="#C8C8C8" Background="#1C1C1C" BorderBrush="#3A3A3A"
              FontSize="12" IsCancel="True"/>
    </StackPanel>
  </Grid>
</Window>
