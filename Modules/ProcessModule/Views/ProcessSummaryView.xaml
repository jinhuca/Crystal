<UserControl x:Class="ProcessModule.Views.ProcessSummaryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:local="clr-namespace:ProcessModule.Views"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d"
             d:DesignHeight="360" d:DesignWidth="1400"
             Background="Transparent" Foreground="White"
             FontFamily="Segoe UI">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Crystal.Controls;component/Themes/ScrollBarStyles.xaml"/>
      </ResourceDictionary.MergedDictionaries>

      <local:ByteRateConverter x:Key="ByteRate"/>
      <local:NullablePercentConverter x:Key="NullablePercent"/>
      <local:LoadToBrushConverter x:Key="LoadToBrush"/>
      <local:NullToVisibilityConverter x:Key="NullToVisibility"/>
      <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

      <!-- Dense, sharp-edged column header matching the HWiNFO tile styling. -->
      <Style x:Key="HeaderStyle" TargetType="GridViewColumnHeader">
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Padding" Value="8,0,8,0"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="Background" Value="#141414"/>
        <Setter Property="Foreground" Value="#8A94A0"/>
        <Setter Property="BorderBrush" Value="#2A2A2A"/>
        <Setter Property="BorderThickness" Value="0,0,1,1"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="GridViewColumnHeader">
              <Grid>
                <Border x:Name="HeaderBorder" Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                  <ContentPresenter x:Name="HeaderContent" Margin="{TemplateBinding Padding}"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    RecognizesAccessKey="True"
                                    SnapsToDevicePixels="True"/>
                </Border>
                <!-- Drag handle at the right edge for resizing the column. -->
                <Thumb x:Name="PART_HeaderGripper" HorizontalAlignment="Right"
                       Width="8" Cursor="SizeWE" Background="Transparent">
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Border Background="{TemplateBinding Background}" Padding="0">
                        <Rectangle Width="1" HorizontalAlignment="Center" Fill="#2A2A2A"/>
                      </Border>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="HeaderBorder" Property="Background" Value="#1C1C1C"/>
                  <Setter Property="Foreground" Value="#C8C8C8"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- Compact dark search box embedded in the Name/PID column headers. -->
      <Style x:Key="HeaderSearchBoxStyle" TargetType="TextBox">
        <Setter Property="Background" Value="#0A0A0A"/>
        <Setter Property="Foreground" Value="#DDDDDD"/>
        <Setter Property="CaretBrush" Value="#DDDDDD"/>
        <Setter Property="BorderBrush" Value="#3A3A3A"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="4,1"/>
        <Setter Property="FontFamily" Value="Consolas"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="TextBox">
              <Border x:Name="Bd" Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}">
                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                              VerticalAlignment="Center"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                  <Setter TargetName="Bd" Property="BorderBrush" Value="#3E9BE8"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- Flat, tight rows; hover and selection are flat fills (no rounded highlight). Ordering
           matters: IsMouseOver comes first so the selection fill (below) wins on a hovered
           selected row, and the MultiTrigger gives a slightly brighter blue for selected+hover. -->
      <Style x:Key="RowStyle" TargetType="ListViewItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#DDDDDD"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Height" Value="22"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ListViewItem">
              <Border x:Name="Bd" Background="{TemplateBinding Background}"
                      BorderBrush="Transparent" BorderThickness="0"
                      SnapsToDevicePixels="True">
                <GridViewRowPresenter VerticalAlignment="Center"
                                      SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Bd" Property="Background" Value="#1B2733"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                  <Setter TargetName="Bd" Property="Background" Value="#1E3A52"/>
                  <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
                <MultiTrigger>
                  <MultiTrigger.Conditions>
                    <Condition Property="IsSelected" Value="True"/>
                    <Condition Property="IsMouseOver" Value="True"/>
                  </MultiTrigger.Conditions>
                  <Setter TargetName="Bd" Property="Background" Value="#254B69"/>
                </MultiTrigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- Full ListView chrome: flat dark surface, no default 3D border, GridView header + scroll. -->
      <Style x:Key="ProcessListViewStyle" TargetType="ListView">
        <Setter Property="Background" Value="#0D0D0D"/>
        <Setter Property="Foreground" Value="#DDDDDD"/>
        <Setter Property="BorderBrush" Value="#2A2A2A"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <!-- Visible (not Auto): the list re-sorts/refreshes every second, and Auto would re-decide
             whether the scrollbar is needed on each tick — toggling the GridView header's right-edge
             padding filler and making the grey block above the scrollbar flicker. Reserving the
             scrollbar space permanently stops that flash. -->
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Visible"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ListView">
              <Border BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      Background="{TemplateBinding Background}"
                      SnapsToDevicePixels="True">
                <ScrollViewer Padding="{TemplateBinding Padding}"
                              Style="{DynamicResource {x:Static GridView.GridViewScrollViewerStyleKey}}">
                  <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                </ScrollViewer>
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </UserControl.Resources>

  <Grid Margin="10">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- Dense header bar: accent tick + title on the left, Name/PID search on the right -->
    <Border Grid.Row="0" BorderBrush="#2A2A2A" BorderThickness="0,0,0,1"
            Padding="0,0,0,4" Margin="0,0,0,6">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Orientation="Horizontal">
          <Border Width="3" Background="#3E9BE8" Margin="0,1,8,1"/>
          <TextBlock Text="PROCESSES" Foreground="#E6E6E6" FontSize="12" FontWeight="SemiBold"
                     VerticalAlignment="Center" Margin="0,0,12,0"/>
          <TextBlock Text="{Binding Rows.Count, StringFormat={}{0} active}"
                     Foreground="#8A94A0" FontSize="11" FontFamily="Consolas"
                     VerticalAlignment="Center"/>

          <!-- System-wide totals, right after the active count -->
          <TextBlock Text="{Binding ProcessCount, StringFormat=Processes: {0:N0}}"
                     Foreground="#8A94A0" FontSize="11" FontFamily="Consolas"
                     VerticalAlignment="Center" Margin="16,0,0,0"/>
          <TextBlock Text="{Binding ThreadCount, StringFormat=Threads: {0:N0}}"
                     Foreground="#8A94A0" FontSize="11" FontFamily="Consolas"
                     VerticalAlignment="Center" Margin="16,0,0,0"/>
          <TextBlock Text="{Binding HandleCount, StringFormat=Handles: {0:N0}}"
                     Foreground="#8A94A0" FontSize="11" FontFamily="Consolas"
                     VerticalAlignment="Center" Margin="16,0,0,0"/>

          <!-- Warning shown only when the ETW session failed to start; explains blank GPU/Disk/Network. -->
          <Border Background="#3A2A12" BorderBrush="#7A5A1E" BorderThickness="1"
                  Padding="8,1" Margin="12,0,0,0" VerticalAlignment="Center"
                  Visibility="{Binding HasMetricsStatusError, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Foreground="#E0B84C" FontSize="11" FontFamily="Consolas"
                       Text="{Binding MetricsStatusError, StringFormat=GPU/Disk/Network unavailable: {0}}"/>
          </Border>
        </StackPanel>

        <!-- Name / PID filters, moved up from the column headers -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="Name" Foreground="#8A94A0" FontSize="11" FontFamily="Consolas"
                     VerticalAlignment="Center" Margin="0,0,6,0"/>
          <TextBox Style="{StaticResource HeaderSearchBoxStyle}" Width="160" Height="18"
                   ToolTip="Filter by process name"
                   Text="{Binding NameFilter, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>
          <TextBlock Text="PID" Foreground="#8A94A0" FontSize="11" FontFamily="Consolas"
                     VerticalAlignment="Center" Margin="16,0,6,0"/>
          <TextBox Style="{StaticResource HeaderSearchBoxStyle}" Width="80" Height="18"
                   ToolTip="Filter by PID"
                   Text="{Binding PidFilter, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Master (list) on the left, detail panel on the right, split by a draggable separator. -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MinWidth="400"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="360" MinWidth="240"/>
      </Grid.ColumnDefinitions>

      <ListView Grid.Column="0" ItemsSource="{Binding RowsView}"
                SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                SelectionMode="Single"
                GridViewColumnHeader.Click="OnColumnHeaderClick"
                Style="{StaticResource ProcessListViewStyle}"
                ItemContainerStyle="{StaticResource RowStyle}"
                VirtualizingPanel.IsVirtualizing="True"
                VirtualizingPanel.VirtualizationMode="Recycling"
                VirtualizingPanel.IsVirtualizingWhenGrouping="True">
        <ListView.Resources>
          <!-- Restyle the list's built-in scrollbars to match the dashboard palette. -->
          <Style TargetType="ScrollBar" BasedOn="{StaticResource CrystalScrollBarStyle}"/>
        </ListView.Resources>
        <ListView.GroupStyle>
          <GroupStyle>
            <GroupStyle.HeaderTemplate>
              <DataTemplate>
                <Border Background="#141414" BorderBrush="#2A2A2A" BorderThickness="0,0,0,1"
                        Padding="8,3">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Name}" Foreground="#3E9BE8" FontSize="11"
                               FontWeight="SemiBold" FontFamily="Consolas"/>
                    <TextBlock Text="{Binding ItemCount, StringFormat={}({0})}"
                               Foreground="#5A6470" FontSize="11" FontFamily="Consolas"
                               Margin="6,0,0,0"/>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </GroupStyle.HeaderTemplate>
          </GroupStyle>
        </ListView.GroupStyle>
        <ListView.View>
          <GridView ColumnHeaderContainerStyle="{StaticResource HeaderStyle}">
            <GridViewColumn Header="Name" Width="260" local:GridViewSort.SortProperty="Name">
              <GridViewColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Name}" Foreground="#DDDDDD"
                             FontFamily="Consolas" FontSize="11" Margin="8,2"
                             TextTrimming="CharacterEllipsis"/>
                </DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Header="PID" Width="130" local:GridViewSort.SortProperty="ProcessId">
              <GridViewColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding ProcessId}" Foreground="#8A94A0"
                             FontFamily="Consolas" FontSize="11" Margin="8,2"
                             TextAlignment="Right"/>
                </DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Header="Status" Width="90" local:GridViewSort.SortProperty="Status">
              <GridViewColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Status}" Foreground="#C8C8C8"
                             FontFamily="Consolas" FontSize="11" Margin="8,2"
                             TextTrimming="CharacterEllipsis"/>
                </DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Header="CPU" Width="90" local:GridViewSort.SortProperty="CpuPercent">
              <GridViewColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding CpuPercent, StringFormat={}{0:0.0}%}"
                             Foreground="{Binding CpuPercent, Converter={StaticResource LoadToBrush}}"
                             FontFamily="Consolas" FontSize="11" Margin="8,2"
                             TextAlignment="Right"/>
                </DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Header="GPU" Width="80" local:GridViewSort.SortProperty="GpuPercent">
              <GridViewColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding GpuPercent, Converter={StaticResource NullablePercent}}"
                             Foreground="#C8C8C8" FontFamily="Consolas" FontSize="11"
                             Margin="8,2" TextAlignment="Right"/>
                </DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Header="Memory" Width="100" local:GridViewSort.SortProperty="WorkingSetMb">
              <GridViewColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding WorkingSetMb, StringFormat={}{0:0} MB}"
                             Foreground="#C8C8C8" FontFamily="Consolas" FontSize="11"
                             Margin="8,2" TextAlignment="Right"/>
                </DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Header="Disk" Width="100" local:GridViewSort.SortProperty="DiskBytesPerSec">
              <GridViewColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding DiskBytesPerSec, Converter={StaticResource ByteRate}}"
                             Foreground="#C8C8C8" FontFamily="Consolas" FontSize="11"
                             Margin="8,2" TextAlignment="Right"/>
                </DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Header="Network" Width="100" local:GridViewSort.SortProperty="NetBytesPerSec">
              <GridViewColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding NetBytesPerSec, Converter={StaticResource ByteRate}}"
                             Foreground="#C8C8C8" FontFamily="Consolas" FontSize="11"
                             Margin="8,2" TextAlignment="Right"/>
                </DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
          </GridView>
        </ListView.View>
      </ListView>

      <!-- Draggable separator: resizes the master list vs. detail panel. A thin accent rule is
           centered in the wider hit area so the grab target is comfortable but reads as a hairline. -->
      <GridSplitter Grid.Column="1" Width="7" HorizontalAlignment="Center"
                    VerticalAlignment="Stretch" Background="Transparent"
                    ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"
                    ShowsPreview="False" Cursor="SizeWE">
        <GridSplitter.Template>
          <ControlTemplate TargetType="GridSplitter">
            <Grid Background="{TemplateBinding Background}">
              <Border x:Name="Rule" Width="1" Background="#2A2A2A" HorizontalAlignment="Center"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Rule" Property="Background" Value="#3E9BE8"/>
                <Setter TargetName="Rule" Property="Width" Value="2"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </GridSplitter.Template>
      </GridSplitter>

      <!-- Detail panel: live metrics for the selected process -->
      <Border Grid.Column="2" Background="#101010" BorderBrush="#2A2A2A" BorderThickness="1">
        <Grid>
          <!-- Empty-state hint when nothing is selected -->
          <TextBlock Text="Select a process to view details"
                     Foreground="#5A6470" FontSize="11" FontFamily="Consolas"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     Visibility="{Binding SelectedRow, Converter={StaticResource NullToVisibility}, ConverterParameter=invert}"/>

          <StackPanel Margin="12,10" DataContext="{Binding SelectedRow}"
                      Visibility="{Binding Converter={StaticResource NullToVisibility}}">
            <!-- Process identity -->
            <TextBlock Text="{Binding Name}" Foreground="#E6E6E6" FontSize="14"
                       FontWeight="SemiBold" FontFamily="Consolas"
                       TextTrimming="CharacterEllipsis"/>
            <StackPanel Orientation="Horizontal" Margin="0,2,0,10">
              <TextBlock Text="{Binding ProcessId, StringFormat=PID {0}}"
                         Foreground="#8A94A0" FontSize="11" FontFamily="Consolas"
                         Margin="0,0,12,0"/>
              <TextBlock Text="{Binding Status}" Foreground="#8A94A0"
                         FontSize="11" FontFamily="Consolas"/>
            </StackPanel>

            <Border BorderBrush="#2A2A2A" BorderThickness="0,1,0,0" Margin="0,0,0,8"/>

            <!-- Live metric rows -->
            <Grid Margin="0,2">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="CPU" Foreground="#8A94A0"
                         FontSize="12" FontFamily="Consolas"/>
              <TextBlock Grid.Column="1" Text="{Binding CpuPercent, StringFormat={}{0:0.0}%}"
                         Foreground="{Binding CpuPercent, Converter={StaticResource LoadToBrush}}"
                         FontSize="12" FontFamily="Consolas" TextAlignment="Right"/>
            </Grid>
            <Grid Margin="0,2">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="GPU" Foreground="#8A94A0"
                         FontSize="12" FontFamily="Consolas"/>
              <TextBlock Grid.Column="1" Text="{Binding GpuPercent, Converter={StaticResource NullablePercent}}"
                         Foreground="#DDDDDD" FontSize="12" FontFamily="Consolas" TextAlignment="Right"/>
            </Grid>
            <Grid Margin="0,2">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="Memory" Foreground="#8A94A0"
                         FontSize="12" FontFamily="Consolas"/>
              <TextBlock Grid.Column="1" Text="{Binding WorkingSetMb, StringFormat={}{0:0} MB}"
                         Foreground="#DDDDDD" FontSize="12" FontFamily="Consolas" TextAlignment="Right"/>
            </Grid>
            <Grid Margin="0,2">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="Disk" Foreground="#8A94A0"
                         FontSize="12" FontFamily="Consolas"/>
              <TextBlock Grid.Column="1" Text="{Binding DiskBytesPerSec, Converter={StaticResource ByteRate}}"
                         Foreground="#DDDDDD" FontSize="12" FontFamily="Consolas" TextAlignment="Right"/>
            </Grid>
            <Grid Margin="0,2">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="Network" Foreground="#8A94A0"
                         FontSize="12" FontFamily="Consolas"/>
              <TextBlock Grid.Column="1" Text="{Binding NetBytesPerSec, Converter={StaticResource ByteRate}}"
                         Foreground="#DDDDDD" FontSize="12" FontFamily="Consolas" TextAlignment="Right"/>
            </Grid>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
